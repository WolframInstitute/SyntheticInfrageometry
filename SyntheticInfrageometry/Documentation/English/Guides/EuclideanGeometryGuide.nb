Cell["FindInfraReflection", "Item",ExpressionUUID->"0ffdd290-d6fd-423d-b73f-64b874ee0eb8"],

Cell["CompleteInfraEquilateralTriangle", "Item",ExpressionUUID->"6f8182d5-a4dc-4e2e-ae77-36ae9fb9ca5a"],

Cell["InfraAngle", "Item",ExpressionUUID->"f700ba16-8474-4c88-b0eb-7b9fc3781330"],

Cell["InfraSegmentLineAngle", "Item",ExpressionUUID->"bc8ab91e-6ea2-434b-9ccb-9b12078be3b1"],

Cell["Predicates", "Section",ExpressionUUID->"58f338bf-77f4-401c-bafa-a753a9ec67a0"],

Cell["InfraSegmentQ", "Item",ExpressionUUID->"75d4be00-dfc4-4191-8e54-5ef39a0f9864"],

Cell["UniqueInfraSegmentQ", "Item",ExpressionUUID->"aac6c812-16e7-4d8f-a373-a13fc10e1698"],

Cell["InfraLineQ", "Item",ExpressionUUID->"a2a5cb63-def4-4e8d-80a4-42b9b7199fed"],

Cell["InfraParallelQ", "Item",ExpressionUUID->"3405d9c6-a364-410b-8ef8-fbce9353de19"],

Cell["InfraShellQ", "Item",ExpressionUUID->"3ff0af08-3e4a-4b5a-a554-13b7ba2da778"],

Cell["FindInfraShellParameters", "Item",ExpressionUUID->"cd7da929-8eec-417a-9dc8-52909499a8dc"],

Cell["SeparatesQ", "Item",ExpressionUUID->"9c002fe0-9beb-4416-bbde-69106dc930ff"],

Cell["InfraCircleQ", "Item",ExpressionUUID->"a8f3374e-886f-4d20-b6a1-090169db8137"],

Cell["Wrapper heads", "Section",ExpressionUUID->"73e270df-0c78-4e4a-8aff-028d946e21b0"],

Cell["\<\
Every Find* returns a List of unary wrappers; wrapping that List with the \
head collapses to the multi form via auto-flatten.\
\>", "Text",ExpressionUUID->"bf83bef2-f609-4945-9e02-f7ce6c5967f9"],

Cell["InfraPoint", "Item",ExpressionUUID->"aeed309f-8dc8-4e0a-878d-ef1afa5b63a8"],

Cell["InfraSegment", "Item",ExpressionUUID->"d2a82d85-52ec-42dd-ac6b-dfcbca3a4372"],

Cell["InfraRay", "Item",ExpressionUUID->"16dbc22a-fb83-4153-b4f8-9138b8c1413c"],

Cell["InfraShell", "Item",ExpressionUUID->"5edfd01f-e643-46d4-af4c-ea89cc3863d8"],

Cell["InfraCircle", "Item",ExpressionUUID->"a802ee83-64cf-41d6-9e84-72ddadc2d445"],

Cell["InfraPlane", "Item",ExpressionUUID->"a898ddc9-c536-4885-b158-6cf9f524c818"],

Cell["\<\
Method axis on FindInfraSegment / FindInfraLine / ExtendInfraSegment\
\>", "Section",ExpressionUUID->"377ec41f-2e2b-437e-a8b4-e12eeff9e986"],

Cell["\<\
All three share the same allow-list and pass sub-options through the Method \
spec.\
\>", "Text",ExpressionUUID->"cd2e6590-1fc0-4207-b4ec-94e34bc9e3f9"],

Cell["\<\
\"Shortest\" (default) \[LongDash] every geodesic via the built-in \
shortest-path machinery.\
\>", "Item",ExpressionUUID->"67f45eaf-9c65-4850-a448-6800ef689d39"],

Cell["\<\
\"ShortestPathExtension\" \[LongDash] recency-lex frontier sweep over simple \
paths. Sub-options \"ShortestPathWindow\" (K = 1 / 2 / All), \"Pruning\".\
\>", "Item",ExpressionUUID->"9a220458-527f-4811-a114-7c3da47d3cc1"],

Cell["\<\
\"CurvatureMinimizing\" \[LongDash] rope-pulled-tight sweep minimising an \
edge-level curvature. Sub-options \"Curvature\" (\"Forman\" / \"Wolfram\" / \
\"Ollivier\"), \"Pool\", \"Pruning\".\
\>", "Item",ExpressionUUID->"e95ae1db-831d-4488-addb-067fd58cb3fe"],

Cell["\<\
\"Embedding\" \[LongDash] Hausdorff-rank candidate paths against the straight \
Euclidean segment p1-p2 under the graph drawing. Sub-options \"Coordinates\", \
\"Pool\", \"Pruning\".\
\>", "Item",ExpressionUUID->"07bc5298-5507-4932-9648-28802cd608a8"],

Cell["Pool values", "Section",ExpressionUUID->"d16fb6fb-0bad-4580-83b2-bb6cdd391fd8"],

Cell["\<\
Path-shaped consumers (FindInfraSegment / FindInfraLine / ExtendInfraSegment \
/ FindInfraMidpoint / FindInfraPerpendicular): \"ShortestPaths\" (default) \
restrict to the geodesic DAG, \"AllPaths\" use the full adjacency.\
\>", "Item",ExpressionUUID->"8b0a91b7-4957-44de-b3a4-b8e8f06931c3"],

Cell["\<\
Shell-shaped consumers (FindInfraShell / FindInfraCircle / \
FindInfraParallel): \"LevelSet\" (default) restrict to the metric level \
surface, \"AllVertices\" use the full vertex set.\
\>", "Item",ExpressionUUID->"d18bf8f9-438f-4609-8a73-ccd80667a783"],

Cell["Path-space post-filters", "Section",ExpressionUUID->"56c8f76c-b094-4c12-beee-7ac91ca77810"],

Cell["\<\
Pipe Find* output through the path-space selectors to keep the central / \
peripheral / embedding-closest representatives.\
\>", "Text",ExpressionUUID->"ab846486-8340-47c3-830f-1cd907491272"],

Cell["\<\
SelectInfraPath (criteria \"Central\", \"Peripheral\", \"MostVisited\")\
\>", "Item",ExpressionUUID->"e3e5359b-378e-4348-8081-cc1792b7994e"],

Cell["SelectInfraCycle", "Item",ExpressionUUID->"9c950b34-d44e-45a2-a520-9b07ad98124a"],

Cell["EmbeddingClosest", "Item",ExpressionUUID->"22701f97-7cec-49fc-88af-323e8c1ddcac"],

Cell["EmbeddingClosest", "Item",ExpressionUUID->"2c565cda-dcfd-4fb5-a82f-8dbbf66c8aa7"],

Cell["Examples on large graphs", "Section",ExpressionUUID->"79e66057-5d1d-4ef8-8cfa-64a5d092b33e"],

Cell["\<\
Each construction below runs identically on three large substrates from the \
example-graphs collection. Every Find* returns a multi-object whose \
realisations are drawn diffusely by InfraSceneHighlight, so the branching of \
the construction is part of the picture.\
\>", "Text",ExpressionUUID->"6592a056-86f7-44e1-9286-fcb7ff4ee93e"],

Cell["\<\
Define the three flat substrates (generators from the Infrageometry paclet).\
\>", "CodeText",ExpressionUUID->"fccf9f2c-e46f-4566-9c71-c7833d0e5e4a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`Infrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graphs", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"g", " ", "|->", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
         RowBox[{"Graph", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", 
            RowBox[{"GraphEmbedding", "[", 
             RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
             "]"}]}], ",", "\n", "       ", 
           RowBox[{"EdgeStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
           "       ", 
           RowBox[{"VertexStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
       "]"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"InteriorMeshGraph", "[", 
         RowBox[{"DiscretizeRegion", "[", 
          RowBox[{
           RowBox[{"Rectangle", "[", "]"}], ",", " ", 
           RowBox[{"MaxCellMeasure", " ", "->", " ", "0.003"}], ",", " ", 
           RowBox[{"PrecisionGoal", " ", "->", " ", "Infinity"}]}], "]"}], 
         "]"}]}], ")"}], ",", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"25", ",", " ", "25"}], "}"}], "]"}], "]"}], ",", "\n", 
      "   ", 
      RowBox[{"TessellationGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"20", ",", " ", "15"}], "}"}]}], "]"}]}], "}"}]}]}], 
  ";"}]}], "Code",
 InitializationCell->
  True,ExpressionUUID->"0bf72222-e3f8-465e-9c3c-138b42d442f8"],

Cell["\<\
Postulates 1 and 2: the geodesic bundle between two points, its \
path-space-central representative (thick), and the fan of maximal per-step \
geodesic extensions.\
\>", "CodeText",ExpressionUUID->"cdc7a009-b84d-4614-865b-33f05063c516"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "d", ",", " ", "seed"}], "}"}], " ", "|->", 
       "\n", "     ", 
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"a", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
               "]"}]}]}], ")"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"b", " ", "=", " ", 
           RowBox[{"First", " ", "@", " ", 
            RowBox[{"FindInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"\"\<From\>\"", " ", "->", " ", 
               RowBox[{"a", " ", "->", " ", "d"}]}]}], "]"}]}]}], "}"}], ",", 
         "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"bundle", " ", "=", " ", 
           RowBox[{"FindInfraSegment", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"chosen", " ", "=", " ", 
           RowBox[{"SelectInfraPath", "[", 
            RowBox[{"g", ",", " ", "bundle", ",", " ", "1", ",", " ", 
             RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"extensions", " ", "=", " ", 
           RowBox[{"ExtendInfraPath", "[", 
            RowBox[{
            "g", ",", " ", "chosen", ",", " ", "All", ",", "\n", "          ", 
             RowBox[{"Properties", " ", "->", " ", 
              RowBox[{"{", 
               RowBox[{"\"\<Simple\>\"", ",", " ", "\"\<ShortestPath\>\""}], 
               "}"}]}], ",", " ", 
             RowBox[{"\"\<Length\>\"", " ", "->", " ", "4"}]}], "]"}]}], 
          "}"}], ",", "\n", "       ", 
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", "\n", "         ", 
           RowBox[{"{", 
            RowBox[{"extensions", ",", " ", "bundle", ",", " ", 
             RowBox[{"chosen", " ", "->", " ", 
              RowBox[{"Directive", "[", 
               RowBox[{"$InfraSegmentColor", ",", " ", 
                RowBox[{"AbsoluteThickness", "[", "6", "]"}]}], "]"}]}], ",", 
             " ", "a", ",", " ", "b"}], "}"}], ",", "\n", "         ", 
           RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "8", ",", " ", "8"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}],
     "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"bb5dde61-398d-42c7-91ea-733bbeaea581"],

Cell["\<\
Define the three combinatorial balls: flat square, flat triangular, \
hyperbolic {3, 7}.\
\>", "CodeText",ExpressionUUID->"a284ef1b-8631-47d9-b37a-b0fa69a4c0d6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"balls", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"g", " ", "|->", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
         RowBox[{"Graph", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", 
            RowBox[{"GraphEmbedding", "[", 
             RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
             "]"}]}], ",", "\n", "       ", 
           RowBox[{"EdgeStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
           "       ", 
           RowBox[{"VertexStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
       "]"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", "8"}], "]"}], "]"}], 
      ",", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "8"}], "]"}], "]"}], 
      ",", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", "5"}], "]"}], 
       "]"}]}], "}"}]}]}], ";"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"1b0feb7a-a79e-4e7b-bfd7-f09225712d03"],

Cell["\<\
Postulate 3: the metric ball and the canonical infra-circle (shortest \
separating cycle in a level band). On the bipartite square lattice an \
exact-radius level set is an independent set with no cycles at all, so the \
circle needs a two-thick radius band; the triangular ball supports an \
exact-radius circle.\
\>", "CodeText",ExpressionUUID->"1bee9f70-a8c7-4539-969f-8927ea23f7e3"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "br", ",", " ", "cr", ",", " ", "seed"}], 
        "}"}], " ", "|->", "\n", "     ", 
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
               "]"}]}]}], ")"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", "\n", "         ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"FindInfraBall", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "br"}], "]"}], ",", " ", 
             RowBox[{"FindInfraCircle", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "cr", ",", " ", "All"}], 
              "]"}], ",", " ", "c"}], "}"}], ",", "\n", "         ", 
           RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"balls", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "1"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"2", ",", " ", "2"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}],
     "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"163e7fbe-617b-480b-a174-8690092aaf4c"],

