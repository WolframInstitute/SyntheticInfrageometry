Cell["ExtendInfraSegment", "Item",ExpressionUUID->"aa9406ee-8e6d-4033-8f93-fb089e23cb9c"],

Cell["FindInfraShell", "Item",ExpressionUUID->"0a5e2b6a-a069-4433-b5ef-8e1d0a216ebe"],

Cell["FindInfraCircle", "Item",ExpressionUUID->"50282100-de77-4b3a-a10d-c04814363759"],

Cell["FindInfraParallel", "Item",ExpressionUUID->"8d4f8edd-e1ce-44fd-ab27-5160716699bf"],

