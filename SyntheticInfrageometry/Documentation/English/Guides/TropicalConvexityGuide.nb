Notebook[{
Cell["Tropical Convexity", "Title",ExpressionUUID->"af61d5e4-f12c-4008-a456-c4215bef726c"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"860e76f7-f5e6-470d-9bce-de41a48fcfc6"],

Cell["\<\
The tropical convexity layer studies vertex subsets closed under the metric \
interval operation \[LongDash] the graph-intrinsic shadow of tropical / \
min-plus convexity. The hull operation is FindSegmentHull; the closure \
predicate is SegmentHullQ (strong and weak).\
\>", "Text",ExpressionUUID->"ecb52fd9-07db-4478-b662-adce98fd5c72"],

Cell["Setup", "Section",ExpressionUUID->"68e50196-0e44-4c12-86de-cbb0ed6f76c0"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"18d8c2f3-a901-4187-8071-8955f4dab40c"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"5989daf0-74cd-4492-a49b-d6495f40b070"],

Cell["Hull and closure", "Section",ExpressionUUID->"4a8ba636-629d-4dae-a53a-9864c8b33e59"],

Cell["FindSegmentHull", "Item",ExpressionUUID->"aed14569-6345-48d4-8b74-e4cff2e90769"],

Cell["SegmentHullQ", "Item",ExpressionUUID->"0f6991dd-666f-462b-a6f4-2aa25828e97a"],

Cell["Interval structure", "Section",ExpressionUUID->"12b964ef-c7c6-4943-9ed9-c455b11c1101"],

Cell["MetricInterval", "Item",ExpressionUUID->"6e6e4a7b-d033-4a3a-b808-d1807c11cd73"],

Cell["MedianVertices", "Item",ExpressionUUID->"962dcb2b-afd5-4289-a361-713cdf63d559"],

Cell["Examples on large graphs", "Section",ExpressionUUID->"be207a6e-738a-470f-974e-261de0cde3ba"],

Cell["\<\
The segment hull (closure under geodesic intervals) of three mutually distant \
seeds on a large grid interior -- the graph-intrinsic shadow of tropical \
convexity.\
\>", "Text",ExpressionUUID->"c9995eee-2a02-4907-bf97-59fd6dcecf18"],

Cell["Define the substrate.", "CodeText",ExpressionUUID->"adbf92be-32c0-4d9d-bb43-2cf59fcf6cd9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`Infrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graph", " ", "=", " ", 
   RowBox[{"First", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"g", " ", "|->", " ", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"h", " ", "=", " ", 
           RowBox[{"Graph", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n",
          "     ", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
          RowBox[{"Graph", "[", 
           RowBox[{"h", ",", " ", 
            RowBox[{"VertexCoordinates", " ", "->", " ", 
             RowBox[{"GraphEmbedding", "[", 
              RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
              "]"}]}], ",", "\n", "       ", 
            RowBox[{"EdgeStyle", " ", "->", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{"StandardGray", ",", " ", 
               RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
            "       ", 
            RowBox[{"VertexStyle", " ", "->", " ", 
             RowBox[{"Directive", "[", 
              RowBox[{"StandardGray", ",", " ", 
               RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
        "]"}]}], ")"}], " ", "/@", " ", 
     RowBox[{"{", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"25", ",", " ", "25"}], "}"}], "]"}], "]"}], "}"}]}], 
    "]"}]}], ";"}]}], "Code",
 InitializationCell->
  True,ExpressionUUID->"4a0d8bf2-5043-4bfc-ab00-0f188f4f1fcc"],

Cell["\<\
Three seeds in the central ball at mutual distance 6 to 8, and their segment \
hull.\
\>", "CodeText",ExpressionUUID->"ad78c9d6-42fb-4ce5-bea7-c78f00a50075"],

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"center", " ", "=", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"SeedRandom", "[", "2", "]"}], ";", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraPoint", "[", 
         RowBox[{"graph", ",", " ", 
          RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
         "]"}]}]}], ")"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seeds", " ", "=", " ", 
     RowBox[{"SelectInfraPoint", "[", 
      RowBox[{"graph", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraBall", "[", 
          RowBox[{"graph", ",", " ", "center", ",", " ", "6"}], "]"}]}]}], ",",
        "\n", "     ", "3", ",", " ", 
       RowBox[{"\"\<Distance\>\"", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "8"}], "}"}]}], ",", " ", 
       RowBox[{"\"\<MaxCliques\>\"", " ", "->", " ", "20"}]}], "]"}]}], "}"}],
    ",", "\n", "  ", 
   RowBox[{"InfraSceneHighlight", "[", 
    RowBox[{"graph", ",", " ", 
     RowBox[{"Join", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"FindSegmentHull", "[", 
         RowBox[{"graph", ",", " ", "seeds"}], "]"}], "}"}], ",", " ", 
       "seeds"}], "]"}], ",", " ", 
     RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]], "Input",\
ExpressionUUID->"1ea39e50-c4f1-4a3e-8bb7-ca1c5e436ad4"],

Cell["Tutorial", "Section",ExpressionUUID->"0105065f-be7b-4444-8323-496cac195167"],

Cell["See TropicalConvexityTutorial for runnable examples.", "Item",ExpressionUUID->"100a09fd-a9a9-46ae-89c2-5aba1eb20f0b"],

Cell["Notes on the tropical connection", "Section",ExpressionUUID->"94a1d823-4aba-46c1-9fdb-9a339264e62c"],

Cell["\<\
On Z^n with the L1 metric, tropical convex hulls coincide with geodesic \
convex hulls. On a graph, FindSegmentHull is the graph-intrinsic closure \
under the interval operator I(u, v) = MetricInterval(g, u, v) and recovers \
the L1 / min-plus picture on median graphs and Cayley graphs of Z^n with \
standard generators.\
\>", "Text",ExpressionUUID->"41efb387-8309-44fe-84c5-58b478ff7a93"],

Cell["References", "Section",ExpressionUUID->"bd22b379-61e0-47c3-baed-e1d0eba0ad03"],

Cell["\<\
Maclagan and Sturmfels, Introduction to Tropical Geometry, AMS GSM 161, 2015, \
https://janos.cs.technion.ac.il/COURSES/238900-13/Tropical/MaclaganSturmfels.\
pdf\
\>", "Item",ExpressionUUID->"429e7716-4b63-415b-a9cc-44f2d405367f"],

Cell["\<\
Develin and Sturmfels, Tropical convexity, Doc. Math. 9, 1-27, 2004, \
https://www.math.uni-bielefeld.de/documenta/vol-09/02.pdf\
\>", "Item",ExpressionUUID->"2708f3e1-c847-4024-8f3a-e54c92c26119"],

Cell["\<\
Joswig, Essentials of Tropical Combinatorics, AMS GSM 219, 2021\
\>", "Item",ExpressionUUID->"81e5d65c-3a58-4874-a1a2-8dce0298870d"],

Cell["\<\
Imrich and Klavzar, Product Graphs: Structure and Recognition, Wiley 2000 \
(median / partial cube structures)\
\>", "Item",ExpressionUUID->"8ac026d9-2afb-443f-9a73-47fb7f09f57d"]
},
