Notebook[{
Cell["Coordinatization", "Title",ExpressionUUID->"88fdebc0-72e7-4a2f-8b53-28784e3f0a85"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"9b1e8ee9-5ee4-4b67-9d10-1b9d62f4ecdf"],

Cell["\<\
Coordinatisation makes the graph-intrinsic vertex space into a coordinate \
space the infra-observer can compute with: radar coordinates (distance \
vectors to a resolving / radar basis), orthogonal coordinates along a fixed \
frame, and resistance-matching spectral coordinates from the Laplacian.\
\>", "Text",ExpressionUUID->"cf681dc6-5823-4b80-9678-de290be6ee1a"],

Cell["Setup", "Section",ExpressionUUID->"e578aab0-3848-4cc3-a172-4738cfe73166"],

Cell["\<\
Load the paclet and its sibling Infrageometry, which owns the radar and \
resistance maps.\
\>", "CodeText",ExpressionUUID->"95de53f1-f777-446c-bd5e-82a79657d5eb"],

Cell["\<\
Needs[\"WolframInstitute`SyntheticInfrageometry`\"];
Needs[\"WolframInstitute`Infrageometry`\"];\
\>", "Code",
 InitializationCell->
  True,ExpressionUUID->"54d56b52-3926-42ba-9ef6-b2dd525ef5c2"],

Cell["Radar coordinates", "Section",ExpressionUUID->"c2fa33e2-4c7a-4b08-8cf9-89f066f9952f"],

Cell["Distance vectors to a chosen resolving set (a radar basis).", "Text",ExpressionUUID->"74243e70-17eb-4090-acc5-966c95d2574c"],

Cell["FindInfraRadarBasis", "Item",ExpressionUUID->"c4e7a3ff-a9c1-43e9-ad6f-81a220e44985"],

Cell["InfraRadarBasisQ", "Item",ExpressionUUID->"9f332064-4b44-4f6a-bf74-c926b96d69f3"],

Cell["RadarCoordinates", "Item",ExpressionUUID->"f7e2274a-1f7d-4ccd-81ce-b1694cb94ac1"],

Cell["\<\
RadarCoordinates lives in the sibling Infrageometry paclet. \
SyntheticInfrageometry adds the InfraPoint query point and InfraSet basis \
anchors, aggregated by \"InfraPointAggregation\" (Min, the infra-observer's \
nearest-anchor reading, by default).\
\>", "Text",ExpressionUUID->"2697ce69-1bb2-4018-92c7-1d3c3052385b"],

Cell["Orthogonal coordinates", "Section",ExpressionUUID->"d2cb5478-ca05-4b72-9bc9-dacd2887ecc1"],

Cell["Z-valued displacements along axes through a centre vertex.", "Text",ExpressionUUID->"c0e65153-12d5-460e-9de5-879f920408d7"],

Cell["FindInfraOrthogonalFrame", "Item",ExpressionUUID->"daf88845-119f-4c17-883e-f2c915400b54"],

Cell["OrthogonalCoordinates", "Item",ExpressionUUID->"f8a49081-8172-4558-9afa-5d1566afce1a"],

Cell["FindInfraSpanningAxes", "Item",ExpressionUUID->"2b462b02-407b-42ca-ae4a-6dfccc8c3a3a"],

Cell["Resistance coordinates", "Section",ExpressionUUID->"83c2cef5-71af-47e0-a96c-6b772469ed48"],

Cell["\<\
Spectral coordinates rescaled so that Euclidean distance matches effective \
resistance.\
\>", "Text",ExpressionUUID->"d5f21e9e-69aa-4d76-9e02-6c1a5372c380"],

Cell["ResistanceCoordinates", "Item",ExpressionUUID->"afec0542-6ea1-4f1c-b69f-57007208a179"],

Cell["\<\
ResistanceCoordinates also lives in the sibling Infrageometry paclet; \
SyntheticInfrageometry adds the InfraPoint / InfraSet overloads.\
\>", "Text",ExpressionUUID->"7f168a9f-9bbf-484c-81ed-2e9b5aec8d6b"],

Cell["Examples on large graphs", "Section",ExpressionUUID->"884687f6-faad-4045-a98f-5c7175303b24"],

Cell["\<\
An orthogonal frame of metric-line axes at the center of each substrate, and \
the Z-valued orthogonal coordinates it induces.\
\>", "Text",ExpressionUUID->"cf21242c-fe2b-4f2a-98e6-45eda9909ab0"],

Cell["Define the three substrates.", "CodeText",ExpressionUUID->"924c6377-cbf3-4596-89eb-302c73a17107"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`Infrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graphs", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"g", " ", "|->", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
         RowBox[{"Graph", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", 
            RowBox[{"GraphEmbedding", "[", 
             RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
             "]"}]}], ",", "\n", "       ", 
           RowBox[{"EdgeStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
           "       ", 
           RowBox[{"VertexStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
       "]"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"25", ",", " ", "25"}], "}"}], "]"}], "]"}], ",", "\n", 
      "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", "8"}], "]"}], "]"}], 
      ",", "\n", "   ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"InteriorMeshGraph", "[", 
         RowBox[{"DiscretizeRegion", "[", 
          RowBox[{
           RowBox[{"Rectangle", "[", "]"}], ",", " ", 
           RowBox[{"MaxCellMeasure", " ", "->", " ", "0.003"}], ",", " ", 
           RowBox[{"PrecisionGoal", " ", "->", " ", "Infinity"}]}], "]"}], 
         "]"}]}], ")"}]}], "}"}]}]}], ";"}]}], "Code",
 InitializationCell->
  True,ExpressionUUID->"a5ddd46c-7ea7-456e-b697-fdcbeaa1051f"],

Cell["\<\
One frame per substrate (axis half-depth 4 on the lattices, 3 on the mesh).\
\>", "CodeText",ExpressionUUID->"8c7bbe7a-60f8-44d9-9a03-7d059fa0e30c"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "len", ",", " ", "seed"}], "}"}], " ", "|->", 
       "\n", "     ", 
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
               "]"}]}]}], ")"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"frame", " ", "=", " ", 
           RowBox[{"FindInfraOrthogonalFrame", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"c", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "len"}], 
            "]"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{"frame", ",", " ", "c"}], "}"}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4", ",", " ", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}],
     "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"d00974ae-d5e0-46a4-8c91-243d24777f98"],

Cell["\<\
Orthogonal coordinates of a probe vertex at distance 3 from the center, \
relative to each frame.\
\>", "CodeText",ExpressionUUID->"4cdace29-b8d9-4f77-8119-3dd765ff9854"],

Cell[BoxData[
 RowBox[{"MapThread", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", " ", "len", ",", " ", "seed"}], "}"}], " ", "|->", 
    "\n", "    ", 
    RowBox[{"With", "[", "\n", "      ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"FindInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
            "]"}]}]}], ")"}]}], "}"}], ",", "\n", "      ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"frame", " ", "=", " ", 
         RowBox[{"FindInfraOrthogonalFrame", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"c", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "len"}], 
          "]"}]}], ",", "\n", "       ", 
        RowBox[{"v", " ", "=", " ", 
         RowBox[{
          RowBox[{"First", "[", 
           RowBox[{"FindInfraPoint", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"\"\<From\>\"", " ", "->", " ", 
              RowBox[{"c", " ", "->", " ", "3"}]}]}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}]}], "}"}], ",", "\n", 
      "      ", 
      RowBox[{"OrthogonalCoordinates", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"c", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "frame", ",", 
        " ", "v"}], "]"}]}], "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graphs", ",", " ", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4", ",", " ", "3"}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"b9813825-96e9-49ce-91d9-f70a0cb14170"],

Cell["Tutorial", "Section",ExpressionUUID->"4ebc67b3-281e-4221-9e08-16c7d9786570"],

Cell["See CoordinatizationTutorial for runnable examples.", "Item",ExpressionUUID->"e0ad9861-27d3-4ee6-bf7f-3e2fbbc3b925"],

Cell["References", "Section",ExpressionUUID->"19335553-6618-4daa-9f4d-0489e30fd5d8"],

Cell["\<\
Slater, Leaves of trees, Congressus Numerantium 14, 549-559, 1975 (resolving \
sets)\
\>", "Item",ExpressionUUID->"f65b3a9f-f4f2-4d72-8ad0-98adb0883dd1"],

Cell["\<\
Chartrand, Eroh, Johnson, Oellermann, Resolvability in graphs and the metric \
dimension of a graph, Discrete Appl. Math. 105, 99-113, 2000\
\>", "Item",ExpressionUUID->"32405189-c6b0-4205-8908-dad3a74e6087"],

Cell["\<\
Klein and Randic, Resistance distance, J. Math. Chem. 12, 81-95, 1993\
\>", "Item",ExpressionUUID->"2081cbf7-8714-4b4f-bc9f-6d35016a92ed"],

Cell["\<\
Doyle and Snell, Random Walks and Electric Networks, MAA Carus Monograph 22, \
1984 (resistance metric)\
\>", "Item",ExpressionUUID->"23d3404d-e853-4d57-9ac3-ce7929e18fab"],

Cell["\<\
Coifman and Lafon, Diffusion maps, Appl. Comput. Harmon. Anal. 21(1), 5-30, \
2006\
\>", "Item",ExpressionUUID->"6da526fc-dcc8-434c-87e3-f7c68ab1854f"]
},
