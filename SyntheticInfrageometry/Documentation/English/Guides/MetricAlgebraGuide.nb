Notebook[{
Cell["Metric Algebra", "Title",ExpressionUUID->"0ddac17f-1cc0-4201-8f91-242278658bf2"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"5b382065-75da-4fdb-b61f-4e4327f1e0b6"],

Cell["\<\
The metric-algebra layer is the algebraic substrate that turns the \
shortest-path metric into something the infra-observer can compute on \
\[LongDash] inner products from distances, angles from triples of vertices, \
and comparison-triangle / CAT(k) curvature bounds from triangles.\
\>", "Text",ExpressionUUID->"ee8f961b-0690-429f-b3c3-eca94d1f51d2"],

Cell["Setup", "Section",ExpressionUUID->"654fadc5-39bf-40e0-86ba-b501a555de65"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"ba41de4b-b165-42be-8c04-1413e86558be"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"f3a3bd90-87a0-4b11-bb7f-c624b0df55bd"],

Cell["Inner product and linear combinations", "Section",ExpressionUUID->"a92faf42-169c-4f00-a486-2c511650ec7c"],

Cell["InfraScalarProduct", "Item",ExpressionUUID->"f31989ff-dc20-4f57-9a5f-70bf5f5c3d05"],

Cell["FindInfraLinearCombination", "Item",ExpressionUUID->"09698839-877e-4868-91f8-eb8cef09eb5e"],

Cell["Angles", "Section",ExpressionUUID->"ae43a261-13d5-4604-8c93-25cde993b2c8"],

Cell["InfraAngle", "Item",ExpressionUUID->"07bcffad-9922-471c-99f1-138858ab2485"],

Cell["InfraSegmentLineAngle", "Item",ExpressionUUID->"04508e8f-6a9e-4483-accb-53219899ccfc"],

Cell["Comparison triangles and Alexandrov curvature", "Section",ExpressionUUID->"7c2e4c63-d6d1-44cb-a164-a3893555996d"],

Cell["ComparisonTriangle", "Item",ExpressionUUID->"36a30932-d836-4951-99ce-cac4e9ac745a"],

Cell["InfraComparisonTriangle", "Item",ExpressionUUID->"2783b102-827a-4154-8e3f-fab3da278f76"],

Cell["CATInequalityQ", "Item",ExpressionUUID->"dfe4c78b-bfe8-4496-a569-7e939c3a58cd"],

Cell["InfraCurvature", "Item",ExpressionUUID->"7eb19eb6-dac4-4f5c-ad01-b5ef65f3efbe"],

Cell["Examples on large graphs", "Section",ExpressionUUID->"442c546e-3e87-4945-af70-40dea6ef7592"],

Cell["\<\
A geodesic triangle across three curvature regimes: a flat uniform-length \
disc mesh, a positively curved uniform-length ellipsoid surface, and a \
negatively curved hyperbolic {3, 7} ball. Each side is the full geodesic \
interval DAG between two corners, so the sides thicken where the substrate \
spreads geodesics.\
\>", "Text",ExpressionUUID->"7ee36c12-b64a-44cf-bc79-6e949b5ab738"],

Cell["Define the curvature trio.", "CodeText",ExpressionUUID->"61d060c0-ece3-4187-b786-194e92589cee"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`Infrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graphs", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"g", " ", "|->", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
         RowBox[{"Graph", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", 
            RowBox[{"GraphEmbedding", "[", 
             RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
             "]"}]}], ",", "\n", "       ", 
           RowBox[{"EdgeStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
           "       ", 
           RowBox[{"VertexStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
       "]"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{
          RowBox[{"Disk", "[", "]"}], ",", " ", "600"}], "]"}]}], ")"}], ",", 
      "\n", "   ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
        RowBox[{"UniformLengthGraph", "[", 
         RowBox[{
          RowBox[{"BoundaryDiscretizeRegion", "[", 
           RowBox[{"Ellipsoid", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", " ", "0", ",", " ", "0"}], "}"}], ",", " ", 
             RowBox[{"{", 
              RowBox[{"1", ",", " ", "2", ",", " ", "3"}], "}"}]}], "]"}], 
           "]"}], ",", " ", "600"}], "]"}]}], ")"}], ",", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", "5"}], "]"}], 
       "]"}]}], "}"}]}]}], ";"}]}], "Code",
 InitializationCell->
  True,ExpressionUUID->"d3c86bff-203f-4a32-abdf-eee17ff0cad1"],

Cell["\<\
Three mutually distant corners inside the central ball, joined by \
geodesic-bundle sides.\
\>", "CodeText",ExpressionUUID->"6a534734-f1df-4687-8186-62bfd9d787af"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "seed"}], "}"}], " ", "|->", "\n", "     ", 
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
               "]"}]}]}], ")"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"pts", " ", "=", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "&"}], " ", "/@",
             " ", 
            RowBox[{"SelectInfraPoint", "[", 
             RowBox[{"g", ",", "\n", "           ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"First", " ", "@", " ", 
                RowBox[{"FindInfraBall", "[", 
                 RowBox[{"g", ",", " ", "c", ",", " ", 
                  RowBox[{"Floor", "[", 
                   RowBox[{
                    RowBox[{"GraphDiameter", "[", "g", "]"}], "/", "3"}], 
                   "]"}]}], "]"}]}]}], ",", "\n", "           ", "3", ",", 
              " ", 
              RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}], ",",
               " ", 
              RowBox[{"\"\<MaxCliques\>\"", " ", "->", " ", "20"}]}], 
             "]"}]}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", "\n", "         ", 
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"FindInfraSegment", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], " ", "&"}], " ", "/@",
               " ", 
              RowBox[{"Subsets", "[", 
               RowBox[{"pts", ",", " ", 
                RowBox[{"{", "2", "}"}]}], "]"}]}], ",", "\n", "           ", 
             
             RowBox[{
              RowBox[{
               RowBox[{"InfraPoint", "[", 
                RowBox[{"{", "#", "}"}], "]"}], " ", "&"}], " ", "/@", " ", 
              "pts"}]}], "]"}], ",", "\n", "         ", 
           RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}],
     "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"fb5a32b7-4525-4cb6-85fa-0420e9027197"],

Cell["\<\
The normalized median defect (d(a, m)^2 - (2 d(a, b)^2 + 2 d(a, c)^2 - d(b, \
c)^2)/4) / d(b, c)^2, with m the metric midpoint of side bc: zero in flat \
space by the parallelogram law, positive under positive curvature, negative \
under negative curvature.\
\>", "CodeText",ExpressionUUID->"366398c8-b42a-4104-9375-3ed914cdaa1b"],

Cell[BoxData[
 RowBox[{"MapThread", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", " ", "seed"}], "}"}], " ", "|->", "\n", "    ", 
    RowBox[{"With", "[", "\n", "      ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"pts", " ", "=", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], " ", "&"}], " ", "/@",
            " ", 
           RowBox[{"SelectInfraPoint", "[", 
            RowBox[{"g", ",", "\n", "          ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"First", " ", "@", " ", 
               RowBox[{"FindInfraBall", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"First", " ", "@", " ", 
                  RowBox[{"FindInfraPoint", "[", 
                   RowBox[{"g", ",", " ", 
                    
                    RowBox[{"\"\<From\>\"", " ", "->", 
                    " ", "\"\<Center\>\""}]}], "]"}]}], ",", "\n", 
                 "            ", 
                 RowBox[{"Floor", "[", 
                  RowBox[{
                   RowBox[{"GraphDiameter", "[", "g", "]"}], "/", "3"}], 
                  "]"}]}], "]"}]}]}], ",", "\n", "          ", "3", ",", " ", 
             
             RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}], ",",
              " ", 
             RowBox[{"\"\<MaxCliques\>\"", " ", "->", " ", "20"}]}], 
            "]"}]}]}], ")"}]}], "}"}], ",", "\n", "      ", 
      RowBox[{"{", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"FindInfraMidpoint", "[", 
           RowBox[{"g", ",", " ", 
            RowBox[{"pts", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
            RowBox[{"pts", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "      ", 
      RowBox[{"N", "[", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", 
             RowBox[{"pts", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", " ", "m"}], "]"}], "^", 
           "2"}], " ", "-", "\n", "         ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "^", "2"}]}], " ", 
             "+", " ", 
             RowBox[{"2", " ", 
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", 
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
                 RowBox[{"pts", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "^", "2"}]}], " ", 
             "-", "\n", "           ", 
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"pts", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
                RowBox[{"pts", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "^", "2"}]}], ")"}],
            "/", "4"}]}], ")"}], "/", 
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"pts", "[", 
            RowBox[{"[", "2", "]"}], "]"}], ",", " ", 
           RowBox[{"pts", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "^", "2"}]}], "]"}]}], 
     "]"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graphs", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"3f09042a-4b98-4abb-a3af-ac589cfb5f81"],

Cell["Tutorial", "Section",ExpressionUUID->"cf8771ad-85ad-430a-b0da-25b295c60d97"],

Cell["See MetricAlgebraTutorial for runnable examples.", "Item",ExpressionUUID->"4f0587a7-540c-464f-af6e-02c6096999c2"],

Cell["References", "Section",ExpressionUUID->"971a7d5d-ab7c-41d0-8162-e9ae63f44687"],

Cell["\<\
Schoenberg, Remarks to Maurice Frechet's article \"Sur la definition \
axiomatique d'une classe d'espace distancies vectoriellement applicable sur \
l'espace de Hilbert\", Ann. Math. 36, 724-732, 1935\
\>", "Item",ExpressionUUID->"0277c8c6-1cc6-4d60-84b5-d8be63a10adc"],

Cell["\<\
Burago, Burago and Ivanov, A Course in Metric Geometry, AMS GSM 33, 2001 \
(CAT(k) and Alexandrov geometry)\
\>", "Item",ExpressionUUID->"fcfeef4a-1dfb-4edb-a20e-c41be7b52c7d"],

Cell["\<\
Alexandrov, A theorem on triangles in a metric space and some applications, \
Trudy Mat. Inst. Steklov. 38, 5-23, 1951\
\>", "Item",ExpressionUUID->"9a361f15-0108-414c-858e-f78afa08e150"],

Cell["\<\
Bridson and Haefliger, Metric Spaces of Non-Positive Curvature, Springer 1999\
\
\>", "Item",ExpressionUUID->"1d7925a0-b53d-4c65-ac01-e7010870a60a"]
},
