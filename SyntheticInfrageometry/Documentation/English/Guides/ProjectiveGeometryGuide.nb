Notebook[{
Cell["Projective Geometry", "Title",ExpressionUUID->"6954daae-25b3-4479-a7cb-79b6127d7aa8"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"83d23b14-f0ff-42ce-b1de-421efa8074db"],

Cell["\<\
The projective layer treats incidence \[LongDash] points on lines, lines \
through points, directions at a centre \[LongDash] as first-class graph \
predicates. It exposes the Whitehead axiom triple W1\[Dash]W3 and a synthetic \
projective-plane test.\
\>", "Text",ExpressionUUID->"f14709b7-898b-4f5f-95f6-32cf6ddf8d70"],

Cell["Setup", "Section",ExpressionUUID->"dd71bb3e-2018-457f-bac0-b9208c04d519"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"150075b2-9749-4720-aa95-f3c4d88e53b5"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"5e1051ed-0f1b-416e-9499-a39117dc2246"],

Cell["Pointwise predicates", "Section",ExpressionUUID->"a271cd2d-2b04-4c53-a3ed-4c0c37fe90fb"],

Cell["SameDirectionQ", "Item",ExpressionUUID->"0725beca-8aeb-43f1-bd38-ad9276b6a8d6"],

Cell["CollinearQ", "Item",ExpressionUUID->"5441fc46-563e-4112-b000-1ab95b9e4585"],

Cell["ConcurrentQ", "Item",ExpressionUUID->"dc6ff3a3-fe0b-4917-b4ec-207e69670794"],

Cell["Uniqueness predicates", "Section",ExpressionUUID->"2567d73f-e945-4bff-b17b-83ce88546d0d"],

Cell["UniquePencilQ", "Item",ExpressionUUID->"9dfb97f8-6501-414e-8edb-3e7d647b4fd2"],

Cell["UniqueCollinearQ", "Item",ExpressionUUID->"83b6cd87-c50d-4469-aa27-11fd94d55613"],

Cell["UniqueConcurrentQ", "Item",ExpressionUUID->"e0c30020-b4e6-41de-9cee-6c1878d4bb37"],

Cell["Pencil readouts", "Section",ExpressionUUID->"ac39fdd7-497b-4b74-9b02-2ea4ecb43ffe"],

Cell["PencilDirections", "Item",ExpressionUUID->"c4b9e748-68f7-4884-9b32-3babb12c337f"],

Cell["PencilCardinality", "Item",ExpressionUUID->"7cd4be1b-9395-4189-8e25-12f4f25b6f40"],

Cell["LineCount", "Item",ExpressionUUID->"b05ecd81-f1c1-4993-84ea-de0bae83b18c"],

Cell["Whitehead axioms", "Section",ExpressionUUID->"b88ae61a-204f-41e9-89d0-3bb979f65a4d"],

Cell["WhiteheadW1Q \[LongDash] every line has at least three vertices", "Item",ExpressionUUID->"c49a45fa-46d7-47e3-8972-d77456598cc3"],

Cell["\<\
WhiteheadW2Q \[LongDash] through any two distinct vertices there is exactly \
one line\
\>", "Item",ExpressionUUID->"b245afc8-022f-48ab-8d8c-074cc0b97263"],

Cell["WhiteheadW3Q \[LongDash] intersection / Pasch-type axiom", "Item",ExpressionUUID->"cee3bbe9-4912-4a8b-a122-c8f2e5ceb56c"],

Cell["ProjectivePlaneGraphQ \[LongDash] W1 \[And] W2 \[And] W3 with \
non-degeneracy", "Item",ExpressionUUID->"1bd335b3-02ed-4939-9a8e-\
2f0e23acae86"],

Cell["Find-shaped primitives", "Section",ExpressionUUID->"15366d5b-a460-49f7-80e0-caca86943983"],

Cell["FindInfraRay", "Item",ExpressionUUID->"f33b7e98-dc1e-4099-9cd0-d829e442c0c1"],

Cell["FindInfraCommonLine", "Item",ExpressionUUID->"189c54fa-cea9-4e62-b765-8a1e0ab9157f"],

Cell["FindInfraCommonPoint", "Item",ExpressionUUID->"358ef36a-89bc-4927-bb3b-12a74459a130"],

Cell["Examples on large graphs", "Section",ExpressionUUID->"a3e7a766-e6ca-420f-9be7-392d2d3ad407"],

Cell["\<\
The pencil of directions at the center of three combinatorial balls, computed \
on the radius-2 neighborhood (the direction-class count grows with the \
localization radius -- a scale-dependent reading, so the pencil is always \
relative to a chosen horizon).\
\>", "Text",ExpressionUUID->"c7ffdd1a-c68c-4232-9127-6c7b89af37c0"],

Cell["Define the three balls.", "CodeText",ExpressionUUID->"c063a7b3-8d24-4d3e-823e-84612c9221cf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`Infrageometry`\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"graphs", " ", "=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"g", " ", "|->", " ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"h", " ", "=", " ", 
          RowBox[{"Graph", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{"EdgeList", "[", "g", "]"}]}], "]"}]}], "}"}], ",", "\n", 
        "     ", 
        RowBox[{
         RowBox[{"SeedRandom", "[", "1", "]"}], ";", "\n", "     ", 
         RowBox[{"Graph", "[", 
          RowBox[{"h", ",", " ", 
           RowBox[{"VertexCoordinates", " ", "->", " ", 
            RowBox[{"GraphEmbedding", "[", 
             RowBox[{"h", ",", " ", "\"\<SpringElectricalEmbedding\>\""}], 
             "]"}]}], ",", "\n", "       ", 
           RowBox[{"EdgeStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.15", "]"}]}], "]"}]}], ",", "\n", 
           "       ", 
           RowBox[{"VertexStyle", " ", "->", " ", 
            RowBox[{"Directive", "[", 
             RowBox[{"StandardGray", ",", " ", 
              RowBox[{"Opacity", "[", "0.3", "]"}]}], "]"}]}]}], "]"}]}]}], 
       "]"}]}], ")"}], " ", "/@", " ", 
    RowBox[{"{", "\n", "   ", 
     RowBox[{
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "6"}], "}"}], ",", " ", "8"}], "]"}], "]"}], 
      ",", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"6", ",", " ", "3"}], "}"}], ",", " ", "8"}], "]"}], "]"}], 
      ",", "\n", "   ", 
      RowBox[{"InteriorGraph", "[", 
       RowBox[{"TessellationNeighborhoodGraph", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "7"}], "}"}], ",", " ", "4"}], "]"}], 
       "]"}]}], "}"}]}]}], ";"}]}], "Code",
 InitializationCell->
  True,ExpressionUUID->"966f1e3f-5942-4638-9271-f315f7848044"],

Cell["The pencil at the center of each ball.", "CodeText",ExpressionUUID->"680d5629-fde1-4c0a-9a1a-2d3f574a7f9f"],

Cell[BoxData[
 RowBox[{"Grid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"MapThread", "[", "\n", "   ", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", ",", " ", "seed"}], "}"}], " ", "|->", "\n", "     ", 
       RowBox[{"With", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"SeedRandom", "[", "seed", "]"}], ";", " ", 
             RowBox[{"First", " ", "@", " ", 
              RowBox[{"FindInfraPoint", "[", 
               RowBox[{"g", ",", " ", 
                RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
               "]"}]}]}], ")"}]}], "}"}], ",", "\n", "       ", 
         RowBox[{"{", 
          RowBox[{"pencil", " ", "=", " ", 
           RowBox[{"PencilDirections", "[", 
            RowBox[{
             RowBox[{"NeighborhoodGraph", "[", 
              RowBox[{"g", ",", " ", 
               RowBox[{"c", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", " ", "1"}], "]"}], "]"}], ",", " ", "2"}], 
              "]"}], ",", " ", 
             RowBox[{"c", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "]"}]}], "}"}], ",",
          "\n", "       ", 
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"InfraLine", "[", "pencil", "]"}], ",", " ", "c"}], 
            "}"}], ",", " ", 
           RowBox[{"ImageSize", " ", "->", " ", "300"}]}], "]"}]}], "]"}]}], ",",
       "\n", "   ", 
      RowBox[{"{", 
       RowBox[{"graphs", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], "]"}],
     "}"}], ",", " ", 
   RowBox[{"Spacings", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"2", ",", " ", "2"}], "}"}]}]}], "]"}]], "Input",ExpressionUUID->\
"39df4b3f-f736-4089-a670-346b649bedd5"],

Cell["Direction-class counts at the three centers.", "CodeText",ExpressionUUID->"a9c8469a-0cbf-457b-ba3d-eb34e9d1c48d"],

Cell[BoxData[
 RowBox[{"MapThread", "[", "\n", "  ", 
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", " ", "seed"}], "}"}], " ", "|->", "\n", "    ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"SeedRandom", "[", "seed", "]"}], ";", "\n", "     ", 
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"c0", " ", "=", " ", 
          RowBox[{
           RowBox[{"First", "[", 
            RowBox[{"FindInfraPoint", "[", 
             RowBox[{"g", ",", " ", 
              RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
             "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", " ", "1"}], "]"}], "]"}]}], "}"}], ",", "\n", 
        "      ", 
        RowBox[{"Length", " ", "@", " ", 
         RowBox[{"PencilDirections", "[", 
          RowBox[{
           RowBox[{"NeighborhoodGraph", "[", 
            RowBox[{"g", ",", " ", "c0", ",", " ", "2"}], "]"}], ",", " ", 
           "c0"}], "]"}]}]}], "]"}]}], ")"}]}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"graphs", ",", " ", 
     RowBox[{"{", 
      RowBox[{"2", ",", " ", "3", ",", " ", "5"}], "}"}]}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"651e3e0e-d992-4104-844d-b5c7e7d0f3dc"],

Cell["Tutorial", "Section",ExpressionUUID->"f75f3b6c-18c1-4a8c-af3e-239e17af3e75"],

Cell["See ProjectiveGeometryTutorial for runnable examples.", "Item",ExpressionUUID->"318fa787-7ac5-4910-8489-815dfc1d0f21"],

Cell["References", "Section",ExpressionUUID->"aa983f1a-3bf9-4665-8b39-c66e64e6243b"],

Cell["\<\
Whitehead, The Axioms of Projective Geometry, Cambridge University Press \
1906, https://archive.org/details/cu31924001520455\
\>", "Item",ExpressionUUID->"c5f01ad9-d3cd-479c-8d1d-39bf931f44ee"],

Cell["Veblen and Young, Projective Geometry, Ginn 1910", "Item",ExpressionUUID->"04d512b1-1803-4488-a852-4eee75978514"],

Cell["\<\
Hartshorne, Foundations of Projective Geometry, Benjamin 1967\
\>", "Item",ExpressionUUID->"d8679d32-10eb-4abd-bbb4-ea985eb9014a"],

Cell["\<\
Beutelspacher and Rosenbaum, Projective Geometry: from foundations to \
applications, CUP 1998\
\>", "Item",ExpressionUUID->"2e0b2e5d-a9da-41d1-a3c7-0205aecdcae0"]
},
