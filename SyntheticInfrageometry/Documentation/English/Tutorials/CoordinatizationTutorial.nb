Cell[BoxData[{
 RowBox[{
  RowBox[{"bbSorted", "=", " ", 
   RowBox[{"SortBy", "[", 
    RowBox[{
     RowBox[{"bb", "[", "True", "]"}], ",", 
     RowBox[{
      RowBox[{"Total", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", "##"}], "]"}], "&"}], "@@@", 
        RowBox[{"Subsets", "[", 
         RowBox[{"#", ",", 
          RowBox[{"{", "2", "}"}]}], "]"}]}], "]"}], "&"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
