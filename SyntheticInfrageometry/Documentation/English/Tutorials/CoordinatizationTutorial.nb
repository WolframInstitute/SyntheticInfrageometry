Cell[BoxData[{
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"RadarCoordinates", "[", 
    RowBox[{"g", ",", "b"}], "]"}]}], ";"}], "\n", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", "=", 
