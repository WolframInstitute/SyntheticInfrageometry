Cell["Visualize level sets of the orthogonal coordinates:", "CodeText",
 CellChangeTimes->{{3.9874335460996*^9, 
  3.987433565753894*^9}},ExpressionUUID->"4d71cbf4-8c3c-44ae-a1d8-\
20b4e0f30df6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"oc", "=", " ", 
   RowBox[{"OrthogonalCoordinates", "[", 
    RowBox[{"g", ",", "c", ",", 
     RowBox[{"f", "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"d", "=", 
     RowBox[{"Length", "[", 
      RowBox[{"f", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"Row", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"With", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"levelSets", "=", 
           RowBox[{"KeySort", "[", 
            RowBox[{"GroupBy", "[", 
             RowBox[{
              RowBox[{"Keys", "[", "oc", "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"oc", "[", "#", "]"}], "[", 
                RowBox[{"[", "i", "]"}], "]"}], "&"}]}], "]"}], "]"}]}], ",", 
          
          RowBox[{"baseHue", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"i", "-", "1"}], ")"}], "/", "d"}]}]}], "}"}], ",", 
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"n", "=", 
            RowBox[{"Length", "[", "levelSets", "]"}]}], "}"}], ",", 
          RowBox[{"HighlightGraph", "[", 
           RowBox[{"g", ",", 
            RowBox[{"Append", "[", 
             RowBox[{
              RowBox[{"MapIndexed", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"With", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"t", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"#2", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "-", "1"}], ")"}], "/", 
                    RowBox[{"Max", "[", 
                    RowBox[{
                    RowBox[{"n", "-", "1"}], ",", "1"}], "]"}]}]}], "}"}], ",", 
                   RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"Subgraph", "[", 
                    RowBox[{"g", ",", 
                    RowBox[{"#1", "[", 
                    RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
                    RowBox[{"Directive", "[", 
                    RowBox[{"Thick", ",", 
                    RowBox[{"Hue", "[", 
                    RowBox[{"baseHue", ",", 
                    RowBox[{"1", "-", 
                    RowBox[{"0.7", " ", "t"}]}], ",", 
                    RowBox[{"0.2", "+", 
                    RowBox[{"0.75", " ", "t"}]}]}], "]"}]}], "]"}]}], "]"}]}],
                   "]"}], "&"}], ",", 
                RowBox[{"Normal", "[", "levelSets", "]"}]}], "]"}], ",", 
              RowBox[{"Style", "[", 
               RowBox[{
                RowBox[{"Labeled", "[", 
                 RowBox[{"c", ",", "i"}], "]"}], ",", 
                RowBox[{"Directive", "[", 
                 RowBox[{"Black", ",", 
                  RowBox[{"PointSize", "[", "Large", "]"}]}], "]"}]}], 
               "]"}]}], "]"}], ",", 
            RowBox[{"VertexLabels", "->", 
             RowBox[{"KeyValueMap", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#1", "->", 
                 RowBox[{"Placed", "[", 
                  RowBox[{
                   RowBox[{"#2", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "Above"}], "]"}]}], 
                "&"}], ",", "oc"}], "]"}]}], ",", 
            RowBox[{"ImageSize", "->", "Medium"}]}], "]"}]}], "]"}]}], "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "d"}], "}"}]}], "]"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9874332484592037`*^9, 3.987433248459858*^9}, {
