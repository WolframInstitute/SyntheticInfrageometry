  RowBox[{
   RowBox[{"InfraSceneHighlight", "[", 
    RowBox[{
     RowBox[{"Graph", "[", 
      RowBox[{"g", ",", 
       RowBox[{"VertexLabels", "->", " ", 
        RowBox[{"KeyValueMap", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"#1", "->", 
            RowBox[{"Row", "[", 
             RowBox[{"{", 
              RowBox[{"\"\<(\>\"", ",", 
               RowBox[{"#2", "[", 
