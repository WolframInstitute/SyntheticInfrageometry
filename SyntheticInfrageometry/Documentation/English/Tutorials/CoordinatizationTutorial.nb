Cell[CellGroupData[{

Cell["Orthogonal Coordinates", "Section",
 CellChangeTimes->{{3.987273797689374*^9, 
  3.9872738134085903`*^9}},ExpressionUUID->"dd384ceb-3b80-4f56-afb5-\
882e25aa1631"],

Cell[TextData[{
 StyleBox["Orthogonal coordinates",
  FontWeight->"Bold"],
 " of a vertex are the list of its shortest\:2011path projections onto a \
chosen set of lines, each line being parametrized by distance from a common \
center; these coordinates are most meaningful when the lines form an ",
 StyleBox["orthogonal frame",
  FontWeight->"Bold"],
 ", meaning each line has zero shortest\:2011path projection onto the others. \
There is a default tie-breaker that prefers 0 if it lies in the tied \
multi-coordinate, and otherwise returns the rounded median."
}], "Text",
 CellChangeTimes->{{3.9872527583790817`*^9, 3.987252822518712*^9}, 
   3.9874232616076317`*^9, {3.987424725670363*^9, 3.987424914392023*^9}, {
   3.9874249455027533`*^9, 3.987424993175477*^9}, {3.9874329123435173`*^9, 
   3.987432944111308*^9}, 
   3.987433031292482*^9},ExpressionUUID->"26e6dadc-8a63-4cb8-8284-\
5ffdf1ad251b"],

Cell["\<\
Find all orthogonal frames centered at a vertex with axes of given length:\
\>", "CodeText",
 CellChangeTimes->{{3.9874325727187853`*^9, 
  3.987432606160122*^9}},ExpressionUUID->"1659c54e-b10c-4b96-bb8d-\
caacf4a79ad2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", " ", 
   RowBox[{"MeshConnectivityGraph", "[", " ", 
    RowBox[{"DiscretizeRegion", "[", 
     RowBox[{
      RowBox[{"Rectangle", "[", "]"}], ",", " ", 
      RowBox[{"MaxCellMeasure", "->", ".01"}]}], "]"}], " ", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"FindInfraPoint", "[", 
    RowBox[{"g", ",", 
     RowBox[{"\"\<From\>\"", "->", "\"\<Center\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"f", " ", "=", " ", 
   RowBox[{"FindInfraOrthogonalFrame", "[", " ", 
    RowBox[{"g", ",", " ", "c", ",", " ", "r", ",", "All"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"InfraSceneHighlight", "[", 
     RowBox[{"g", ",", 
      RowBox[{"Join", "[", " ", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Thread", "[", " ", 
         RowBox[{"#", "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"Length", "[", "#", "]"}], "==", "1"}], ",", 
              RowBox[{"{", "0.5", "}"}], ",", 
              RowBox[{"Subdivide", "[", 
               RowBox[{"0.1", ",", "0.9", ",", 
                RowBox[{
                 RowBox[{"Length", "[", "#", "]"}], "-", "1"}]}], "]"}]}], 
             "]"}]}], ")"}]}], " ", "]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "->", "Red"}], ",", 
          RowBox[{
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", "c", ",", "r"}], "]"}], "->", "Red"}]}], 
         "}"}]}], "\[IndentingNewLine]", "]"}], ",", 
      RowBox[{"ImageSize", "->", "Small"}]}], "]"}], "&"}], "/@", 
   RowBox[{"Take", "[", 
    RowBox[{"f", ",", "5"}], "]"}]}], " ", "]"}]}], "Input",
 CellChangeTimes->{{3.9873949402811832`*^9, 3.987394958432658*^9}, {
  3.987395004977194*^9, 3.987395022031867*^9}, {3.987419599391152*^9, 
