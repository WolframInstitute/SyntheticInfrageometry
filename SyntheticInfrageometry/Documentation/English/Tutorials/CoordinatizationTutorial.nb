Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"maxR", " ", "=", " ", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", "=", 
        RowBox[{"FindInfraOrthogonalFrame", "[", 
         RowBox[{"g", ",", "c", ",", "r", ",", "1"}], "]"}]}], "}"}], ",", 
      RowBox[{"InfraSceneHighlight", "[", 
       RowBox[{"g", ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"f", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "==", "1"}], ",", 
                RowBox[{"{", "0.5", "}"}], ",", 
                RowBox[{"Subdivide", "[", 
                 RowBox[{"0.1", ",", "0.9", ",", 
                  RowBox[{
                   RowBox[{"Length", "[", 
                    RowBox[{"f", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "-", "1"}]}], 
                 "]"}]}], "]"}]}], ")"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c", "->", "Red"}], ",", 
            RowBox[{
             RowBox[{"FindInfraShell", "[", 
              RowBox[{"g", ",", "c", ",", "r"}], "]"}], "->", "Red"}]}], 
           "}"}]}], "]"}], ",", 
        RowBox[{"ImageSize", "->", "Small"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", 
      RowBox[{"Range", "[", "maxR", "]"}]}], "}"}]}], "]"}], "]"}]}], "Input",\

