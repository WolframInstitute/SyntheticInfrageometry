Cell["Find orthogonal frames as the radius increases:", "CodeText",
 CellChangeTimes->{{3.9874339402506247`*^9, 
  3.987433979792554*^9}},ExpressionUUID->"a06e838f-fe0e-40af-a02f-\
893909bd1ed2"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"MeshConnectivityGraph", "[", 
    RowBox[{"DiscretizeRegion", "[", 
     RowBox[{
      RowBox[{"Rectangle", "[", "]"}], ",", 
      RowBox[{"MaxCellMeasure", "->", ".01"}]}], "]"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"FindInfraPoint", "[", 
    RowBox[{"g", ",", 
     RowBox[{"\"\<From\>\"", "->", "\"\<Center\>\""}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxR", " ", "=", " ", "4"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"f", "=", 
        RowBox[{"FindInfraOrthogonalFrame", "[", 
         RowBox[{"g", ",", "c", ",", "r", ",", "1"}], "]"}]}], "}"}], ",", 
      RowBox[{"InfraSceneHighlight", "[", 
       RowBox[{"g", ",", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{
            RowBox[{"f", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"ColorData", "[", "\"\<Rainbow\>\"", "]"}], "/@", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", 
                  RowBox[{"f", "[", 
                   RowBox[{"[", "1", "]"}], "]"}], "]"}], "==", "1"}], ",", 
                RowBox[{"{", "0.5", "}"}], ",", 
                RowBox[{"Subdivide", "[", 
                 RowBox[{"0.1", ",", "0.9", ",", 
                  RowBox[{
                   RowBox[{"Length", "[", 
                    RowBox[{"f", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "]"}], "-", "1"}]}], 
                 "]"}]}], "]"}]}], ")"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"c", "->", "Red"}], ",", 
            RowBox[{
             RowBox[{"FindInfraShell", "[", 
              RowBox[{"g", ",", "c", ",", "r"}], "]"}], "->", "Red"}]}], 
           "}"}]}], "]"}], ",", 
        RowBox[{"ImageSize", "->", "Small"}]}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"r", ",", 
      RowBox[{"Range", "[", "maxR", "]"}]}], "}"}]}], "]"}], "]"}]}], "Input",\

 CellChangeTimes->{{3.9874336617124157`*^9, 3.987433727028652*^9}, {
  3.98743388092478*^9, 3.987433884268092*^9}},
 CellLabel->"In[42]:=",ExpressionUUID->"56a44c20-1433-43bd-ba13-315e6ec24b16"],

