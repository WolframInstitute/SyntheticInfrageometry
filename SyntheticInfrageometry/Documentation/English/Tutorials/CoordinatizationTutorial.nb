   3.987174646420895*^9, 3.9871747290023108`*^9}, {3.9871752468663588`*^9, 
   3.987175318657804*^9}, {3.9871753730644407`*^9, 3.987175393094309*^9}, {
   3.987175442936575*^9, 3.987175487547402*^9}, 
   3.987175520588628*^9},ExpressionUUID->"a527f90b-5470-4627-8df8-\
4fccf23b4436"]
}, Closed]],

