Notebook[{
Cell["Euclidean Geometry Tutorial", "Title",ExpressionUUID->"5d487068-2861-4c60-ae0b-5f03e4185fda"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"ae0d18a5-6bf9-4a82-b0c6-15d0a95b2c1b"],

Cell["\<\
Euclidean geometry rebuilt inside a graph. There is no ambient plane and no \
coordinates: every notion is redefined from the shortest-path metric alone. \
Two things differ from the textbook plane. A construction returns a set of \
admissible answers, so uniqueness fails generically. And some objects are \
empty -- a perpendicular bisector at odd distance, a circle of a single \
radius on a lattice. Both are results, not defects.\
\>", "Text",ExpressionUUID->"87f5925e-796e-488f-9adb-ab567551901b"],

Cell["Setup", "Section",ExpressionUUID->"e70ec08b-eb9b-486c-b020-bf93f7b1093e"],

Cell["\<\
The constructions live in SyntheticInfrageometry; the substrate generator \
lives in the sibling Infrageometry paclet. \
\>", "Text",ExpressionUUID->"b1392ced-15f1-488f-8915-95f907cb3fa4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Needs", "[", "\"\<WolframInstitute`Infrageometry`\>\"", "]"}], 
  ";"}]}], "Input",ExpressionUUID->"f6802691-6e81-4b09-8e04-8c872149c0d7"],

Cell["The substrate", "Section",ExpressionUUID->"aaf20863-f531-4e40-84ef-a44fae270146"],

Cell[TextData[{
 "Plane geometry needs a piece of the ",
 StyleBox["plane",
  FontSlant->Italic],
 ", not a torus. TessellationNeighborhoodGraph cuts a finite patch from the \
infinite triangular tiling, grown in concentric rings to a fixed radius, with \
a genuine boundary. "
}], "Text",ExpressionUUID->"a7e489a6-e175-45c9-a673-2a9fd9d2694d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"g", "=", 
   RowBox[{"TessellationNeighborhoodGraph", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "6"}], "}"}], ",", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"center", "=", 
  RowBox[{"First", "[", 
   RowBox[{"GraphCenter", "[", "g", "]"}], "]"}]}]}], "Input",ExpressionUUID->\
"59adbb20-be07-4c30-baff-c7ab550d3f79"],

Cell["\<\
House rule: anchor every construction at the centre and stay within the \
radius, never touching the boundary, so boundary behaviour is never mistaken \
for geometry.\
\>", "Item",ExpressionUUID->"c40bbcdc-a756-4d5f-8d32-a32a6ca913fa"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{"InfraPoint", "[", "center", "]"}], "}"}]}], "]"}]], "Input",Expre\
ssionUUID->"dcec9188-3b99-47c4-93bd-db4c26d7f6ef"],

Cell["Points and the segment between them", "Section",ExpressionUUID->"48c5ca12-3113-4145-bab0-faf261c80a04"],

Cell[TextData[{
 "Two interior points at distance four through the centre. The segment is the \
set of ",
 StyleBox["all",
  FontSlant->Italic],
 " geodesics between them. "
}], "Text",ExpressionUUID->"8ff96985-1493-4473-a4c2-58a3e1253028"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"A", ",", "B"}], "}"}], "=", 
   RowBox[{"{", 
    RowBox[{"6", ",", "19"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"seg", "=", 
  RowBox[{"FindInfraSegment", "[", 
   RowBox[{"g", ",", "A", ",", "B"}], "]"}]}]}], "Input",ExpressionUUID->\
"cf0741c1-7382-4db8-af61-3b66d62298c8"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPoint", "[", "A", "]"}], ",", 
     RowBox[{"InfraPoint", "[", "B", "]"}], ",", "seg"}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"c9c127de-034c-40af-85a5-d214e46f4515"],

Cell["\<\
The segment is a bundle of geodesics, rendered with intensity following \
multiplicity.\
\>", "Item",ExpressionUUID->"1bda5b5a-2e2c-4334-8602-3f004eb470a4"],

Cell["\<\
Enumerating them shows the first postulate already fails: the geodesic is not \
unique.\
\>", "Item",ExpressionUUID->"36b6bd34-5356-4ef4-b2ce-d7399b3975cf"],

Cell[BoxData[
 RowBox[{"FindInfraSegment", "[", 
  RowBox[{"g", ",", "A", ",", "B", ",", "All"}], "]"}]], "Input",ExpressionUUI\
D->"471c223c-2a28-41e7-b50f-97a25460d511"],

Cell["Midpoint", "Section",ExpressionUUID->"66f0694b-8875-43b9-815c-816c7ea9d2bf"],

Cell[TextData[{
 "The midpoint is the vertex equidistant from both ends. Its return type is \
InfraMesoPoint, a ",
 StyleBox["weighted",
  FontSlant->Italic],
 " set of candidate vertices, since several geodesics can pass through \
different middles. "
}], "Text",ExpressionUUID->"b9ad0687-36a8-4f26-b283-501b93b7d042"],

Cell[BoxData[
 RowBox[{"mid", "=", 
  RowBox[{"FindInfraMidpoint", "[", 
   RowBox[{"g", ",", "A", ",", "B"}], "]"}]}]], "Input",ExpressionUUID->\
"7db4ba95-d330-4569-bf88-1d4f5054d17e"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{"seg", ",", "mid"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"4af28441-f504-49e0-962d-b898626d6a21"],

Cell["\<\
At even distance the midpoint sits at the centre with the highest weight; at \
odd distance it splits into the two nearest vertices.\
\>", "Item",ExpressionUUID->"52f52a19-5f2d-49d8-8e7e-bd587258bc3d"],

Cell["Perpendicular bisector", "Section",ExpressionUUID->"ec559a08-a801-4e75-b75a-8bee855ea8cd"],

Cell["\<\
The perpendicular bisector is the set of vertices equidistant from A and B, a \
codimension-one slab returned as an InfraPlane. \
\>", "Text",ExpressionUUID->"e86cd28b-cc19-48c0-b18b-ea330d697e17"],

Cell[BoxData[
 RowBox[{"bis", "=", 
  RowBox[{"FindInfraBisectingHyperplane", "[", 
   RowBox[{"g", ",", "A", ",", "B"}], "]"}]}]], "Input",ExpressionUUID->\
"543cf92c-5dbc-4643-a69f-ba99efdee0e7"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPoint", "[", "A", "]"}], ",", 
     RowBox[{"InfraPoint", "[", "B", "]"}], ",", 
     RowBox[{"bis", "->", "Green"}], ",", "mid"}], "}"}]}], "]"}]], "Input",Ex\
pressionUUID->"2386d50f-a2b6-4760-91d3-63456e948f14"],

Cell["\<\
The bisector passes through the midpoint and crosses the segment at a right \
angle.\
\>", "Item",ExpressionUUID->"516b6287-bc05-4097-bb4b-d220890c6880"],

Cell["\<\
At odd distance the exact bisector is empty: no vertex is halfway. That \
emptiness is the correct answer.\
\>", "Item",ExpressionUUID->"fbb2c96a-71b6-4ad5-b875-c6cdf7d2e2b1"],

Cell["Line", "Section",ExpressionUUID->"881d2e89-ebfb-41a3-b9cc-157c10754929"],

Cell["\<\
Extending the segment as far as it will go in both directions gives a maximal \
geodesic, an InfraLine. Fix one for the constructions that follow. \
\>", "Text",ExpressionUUID->"afab56a9-8e35-43ca-9623-9ae4fbc37a1e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"line", "=", 
   RowBox[{"FindInfraLine", "[", 
    RowBox[{"g", ",", "A", ",", "B"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Lseq", "=", 
   RowBox[{"line", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"L", "=", 
  RowBox[{"InfraLine", "[", 
   RowBox[{"{", "Lseq", "}"}], "]"}]}]}], "Input",ExpressionUUID->"47fd5af1-\
66d7-4111-8e72-c5d27c2172ac"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{"L", "->", "Blue"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"d60ce55d-73aa-4b13-bbf7-fc06927ba230"],

Cell[TextData[{
 "A line is maximal ",
 StyleBox["within the patch",
  FontSlant->Italic],
 ": it terminates at the patch edge. That truncation is the patch's \
finiteness, not geometry, which is why the finite constructions stay anchored \
at the interior centre."
}], "Item",ExpressionUUID->"5e3de489-a140-449f-816b-fa787fbcfe15"],

Cell["Perpendicular from a point", "Section",ExpressionUUID->"58543969-856c-472c-93e3-5d2f796e05e7"],

Cell["\<\
Euclid I.12: drop a perpendicular to a line from a point not on it. The foot \
is the base midpoint of the isosceles triangle the point makes with the line. \
\>", "Text",ExpressionUUID->"27ba92de-e81a-450a-8805-3fca6006b314"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"P", "=", "13"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"perp", "=", 
  RowBox[{"FindInfraPerpendicular", "[", 
   RowBox[{"g", ",", "L", ",", "P", ",", "1"}], "]"}]}]}], "Input",ExpressionU\
UID->"e7938a46-5381-48b2-a74d-c2e6a6948115"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"L", "->", "Blue"}], ",", 
     RowBox[{"InfraPoint", "[", "P", "]"}], ",", 
     RowBox[{"perp", "->", "Green"}]}], "}"}]}], "]"}]], "Input",ExpressionUUI\
D->"9c85ffb9-1416-498c-9abd-2d0a7619261e"],

Cell["Parallel through a point", "Section",ExpressionUUID->"d3bea9aa-21fb-443b-a25c-28bbfc160229"],

Cell["\<\
A parallel is a line at constant distance from the given one, passing through \
P. \
\>", "Text",ExpressionUUID->"4ca7850c-4a6c-4da3-9cde-21c840e90666"],

Cell[BoxData[
 RowBox[{"par", "=", 
  RowBox[{"FindInfraParallel", "[", 
   RowBox[{"g", ",", "L", ",", "P", ",", "1"}], "]"}]}]], "Input",ExpressionUU\
ID->"7224584e-618f-4a1f-a8ec-f1f0b833d0ac"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"L", "->", "Blue"}], ",", 
     RowBox[{"InfraPoint", "[", "P", "]"}], ",", 
     RowBox[{"par", "->", "Green"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID\
->"fe0a8926-160d-4023-a2ed-6087c850b764"],

Cell["Equilateral triangle", "Section",ExpressionUUID->"883ffe79-2ac1-400b-91c0-be8dcc2f3c43"],

Cell["\<\
Euclid I.1: complete two points to an equilateral triangle. The apexes are \
the vertices equidistant from A and B at distance d(A, B); take one. \
\>", "Text",ExpressionUUID->"ccaca440-43fc-4701-bf9e-cf2f08e84999"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"apex", "=", 
   RowBox[{"CompleteInfraEquilateralTriangle", "[", 
    RowBox[{"g", ",", "A", ",", "B"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"c", "=", 
  RowBox[{
   RowBox[{"First", "[", "apex", "]"}], "[", 
   RowBox[{"[", "1", "]"}], "]"}]}]}], "Input",ExpressionUUID->"f8ec92d4-354f-\
4415-b5c1-b4773e2077cf"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPoint", "[", "A", "]"}], ",", 
     RowBox[{"InfraPoint", "[", "B", "]"}], ",", 
     RowBox[{"InfraPoint", "[", "c", "]"}], ",", "\[IndentingNewLine]", "   ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", "A", ",", "B"}], "]"}], ",", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", "B", ",", "c"}], "]"}], ",", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", "c", ",", "A"}], "]"}]}], "}"}]}], "]"}]], "Input",Exp\
ressionUUID->"7984b66f-f8d6-4501-b6a3-99d08ebba5bb"],

Cell["Circle", "Section",ExpressionUUID->"77ad4d7e-9fe7-43eb-8c02-2331c72dc2d4"],

Cell["\<\
A circle is a simple cycle inside a metric shell. On the triangular lattice \
the distance-two circle around the centre closes up into a hexagon. \
\>", "Text",ExpressionUUID->"1d6ae3cc-b49b-43c9-ab0b-63108e42311e"],

Cell[BoxData[
 RowBox[{"circ", "=", 
  RowBox[{"FindInfraCircle", "[", 
   RowBox[{"g", ",", "center", ",", "2"}], "]"}]}]], "Input",ExpressionUUID->\
"e7cfd74b-b86e-4334-a100-d72256dcb4a5"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPoint", "[", "center", "]"}], ",", 
     RowBox[{"circ", "->", "Green"}]}], "}"}]}], "]"}]], "Input",ExpressionUUI\
D->"af306e2e-0980-4cc7-9210-b7f4650a79c7"],

Cell["Regular polygon", "Section",ExpressionUUID->"b563fe7f-bb66-4293-9034-fcb67a03266f"],

Cell["\<\
A regular polygon is a cyclic vertex sequence whose diagonals all have \
prescribed lengths. Fixing side two and both longer diagonals, localised at \
the centre, picks out one convex hexagon. \
\>", "Text",ExpressionUUID->"db845287-2687-4cb5-ab3d-ffeabab71be5"],

Cell[BoxData[
 RowBox[{"hex", "=", 
  RowBox[{"FindInfraRegularPolygon", "[", 
   RowBox[{"g", ",", 
    RowBox[{"{", 
     RowBox[{"2", ",", "4", ",", "4"}], "}"}], ",", "6", ",", "All", ",", 
    RowBox[{"\"\<From\>\"", "->", 
     RowBox[{"center", "->", "2"}]}]}], "]"}]}]], "Input",ExpressionUUID->\
"93711b4e-2f9a-4a4e-9a7f-b1ff4498bec4"],

Cell[BoxData[
 RowBox[{"InfraSceneHighlight", "[", 
  RowBox[{"g", ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraPoint", "[", "center", "]"}], ",", 
     RowBox[{"hex", "->", "Purple"}]}], "}"}]}], "]"}]], "Input",ExpressionUUI\
D->"4a1ad80e-e2b6-42ab-b5a1-d66e7b3e3c3f"],

Cell["Recognising the objects", "Section",ExpressionUUID->"080a8f68-0000-4297-a894-a642c5ee1423"],

Cell["\<\
Every construction has a predicate that recognises its output. The \
line-shaped and segment-shaped predicates accept the wrappers their \
constructors return. \
\>", "Text",ExpressionUUID->"9cde04da-69a5-44b4-a28a-9dd8f7f7e377"],

Cell[BoxData[
 RowBox[{"InfraLineQ", "[", 
  RowBox[{"g", ",", "L"}], "]"}]], "Input",ExpressionUUID->"6ed9e43c-035d-\
4f62-9056-98deaff0235e"],

Cell["\<\
The uniqueness predicate confirms what the enumerated segment showed: the \
geodesic between A and B is not unique. \
\>", "Text",ExpressionUUID->"83caf1c1-e98c-4b37-81a8-8787124dfb6e"],

Cell[BoxData[
 RowBox[{"UniqueInfraSegmentQ", "[", 
  RowBox[{"g", ",", "A", ",", "B"}], "]"}]], "Input",ExpressionUUID->\
"174d7933-1eb3-407a-ba4d-a0eb4f3f48cb"],

Cell["\<\
The two-line predicates InfraParallelQ and InfraPerpendicularQ take bare \
vertex sequences rather than wrappers.\
\>", "Item",ExpressionUUID->"294f4a89-1402-48b5-b35d-5b21d21db0f6"],

Cell[BoxData[
 RowBox[{"InfraParallelQ", "[", 
  RowBox[{"g", ",", "Lseq", ",", 
   RowBox[{"par", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}], "]"}]], "Input",ExpressionUUID->\
"a9717cd4-34aa-4068-b517-50ee4b25c25a"],

Cell["\<\
InfraPerpendicularQ and FindInfraPerpendicular use inequivalent methods by \
default (projection versus the Euclid I.12 foot), so a line built by one need \
not satisfy the other without matching their Method options.\
\>", "Item",ExpressionUUID->"d979a9c3-50b9-4609-9d9b-2f850b0de522"],

Cell["See also", "Section",ExpressionUUID->"3dbd985f-dd8a-401b-bcd1-0ee61274bb9c"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"8723b357-be9c-41d1-8af2-f64716095501"],

Cell["VisualizationGuide", "Item",ExpressionUUID->"3a5d0047-d43e-4ac7-98b6-6b1a59d04f2a"],

Cell["CoordinatizationTutorial", "Item",ExpressionUUID->"5e623116-843b-45bf-9b8b-3f7f099099d5"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (July 2, 2026)",
