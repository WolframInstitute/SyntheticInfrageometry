Cell[5775, 162, 96, 0, 70, "Section",ExpressionUUID->"ec559a08-a801-4e75-b75a-8bee855ea8cd"],
Cell[5874, 164, 207, 3, 70, "Text",ExpressionUUID->"e86cd28b-cc19-48c0-b18b-ea330d697e17"],
Cell[6084, 169, 197, 4, 70, "Input",ExpressionUUID->"543cf92c-5dbc-4643-a69f-ba99efdee0e7"],
Cell[6284, 175, 336, 8, 70, "Input",ExpressionUUID->"2386d50f-a2b6-4760-91d3-63456e948f14"],
Cell[6623, 185, 163, 3, 70, "Item",ExpressionUUID->"516b6287-bc05-4097-bb4b-d220890c6880"],
Cell[6789, 190, 185, 3, 70, "Item",ExpressionUUID->"fbb2c96a-71b6-4ad5-b875-c6cdf7d2e2b1"],
Cell[6977, 195, 78, 0, 70, "Section",ExpressionUUID->"881d2e89-ebfb-41a3-b9cc-157c10754929"],
Cell[7058, 197, 226, 3, 70, "Text",ExpressionUUID->"afab56a9-8e35-43ca-9623-9ae4fbc37a1e"],
Cell[7287, 202, 475, 14, 70, "Input",ExpressionUUID->"47fd5af1-66d7-4111-8e72-c5d27c2172ac"],
