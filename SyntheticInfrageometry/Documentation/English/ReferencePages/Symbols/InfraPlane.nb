Notebook[{
Cell["InfraPlane", "Title",ExpressionUUID->"95db468c-c23e-40c4-bf53-b17ebb7a861a"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"66f20c54-7bbb-4131-bc1a-a577ef268d06"],

Cell["\<\
InfraPlane[{set}] is the unary form (one bisecting hyperplane); \
InfraPlane[{set1, ..., setk}] is the multi-realisation form. Find* returns a \
List of unary wrappers; wrap with InfraPlane @ ... to collapse to multi via \
auto-flatten. Scene-language constructors InfraPlane[p1, p2] and \
InfraPlane[p1, p2, {lo, hi}] are used inside InfraScene.\
\>", "Text",ExpressionUUID->"9731b042-6ff2-490e-aaab-6bdb05fb8822"],

Cell["Setup", "Section",ExpressionUUID->"3c81e4aa-61ac-40fb-af07-067dbee5b419"],

