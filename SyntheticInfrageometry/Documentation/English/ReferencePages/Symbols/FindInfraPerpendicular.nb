Notebook[{
Cell["FindInfraPerpendicular", "Title",ExpressionUUID->"5fa6362e-30fd-4975-81f8-8f5819a83178"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"554b1a2d-ffe0-4135-ab7c-46b87216bab3"],

Cell["\<\
FindInfraPerpendicular[graph, line, point] returns a List of InfraLine \
realisations through point perpendicular to line. \
FindInfraPerpendicular[graph, line, point, n] / UpTo[n] / All controls \
multiplicity. Options: Method (\"Metric\" (default; foot-of-perp via Euclid \
I.12), \"Projection\", \"Coordinate\", \"Arclength\", \"Alexandrov\", or any \
of these with sub-options inside the Method spec, e.g. {\"Alexandrov\", \
\"Curvature\" -> k, \"Tolerance\" -> t}, {\"Coordinate\", \"ZeroTest\" -> \
\"Mean\" | \"Median\" | \"Contains\" | {name, \"Tolerance\" -> t} | f}, \
{\"Projection\", \"Equality\" -> \"Subset\" | \"Set\" | \"Multiset\" | \
\"Diffuse\" | \"Overlap\"} -- forwarded verbatim to InfraPerpendicularQ); \
\"Radius\" -> All (default) | r_Integer localises construction and test to \
NeighborhoodGraph[g, point, r].\
\>", "Text",ExpressionUUID->"75ca752a-1983-44ff-a5e5-de1b0bae16ca"],

Cell["Setup", "Section",ExpressionUUID->"989a2b65-cbec-4f5d-9a5a-95ddd17b7fe1"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"1965c0ad-5592-43d9-a448-2a4926390f09"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"f5a642de-f1a4-4257-bc44-d6a854a5de0e"],

Cell["Related Guides", "Section",ExpressionUUID->"00a6a429-ec29-4702-83aa-f8bbf82ddb28"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"a3a50ba2-e9d7-42e2-9d56-a2e042e0daa6"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"b3733f4c-0e4e-4a17-8617-72d8b4efad2b"]
},
