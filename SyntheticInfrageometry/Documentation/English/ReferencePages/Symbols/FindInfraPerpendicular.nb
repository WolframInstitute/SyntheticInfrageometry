Notebook[{

Cell[CellGroupData[{
Cell["FindInfraPerpendicular", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0c3a6b3f-f2ad-4042-836e-bae19fd426b2"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPerpendicular"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraPerpendicular", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["line", "TI"], ",", " ", 
    StyleBox["point", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed778169-6979-4405-bf02-e522870bef65"],
 "\[LineSeparator]",
 "gives lines through ",
 StyleBox["point", "TI"],
 " perpendicular to ",
 StyleBox["line", "TI"],
 ", as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8b6e5ae9-3ebd-496d-8beb-36f04e065c58"],
 " realisations.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "57b87c98-427f-4fdd-9e75-113c5c0642c3"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "75ac4ab1-bdbe-4d5c-8c76-f2aa4b53e853"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "00db99f3-2af9-48df-80cb-e05d61f7fa10"],
 " all of them."
}], "Usage",ExpressionUUID->"b902fa3e-ffcd-4131-8bc8-fbc31a03fe78"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Metric\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95e21352-9f06-4817-bba2-5aaedbc6806d"],
 ": this is Euclid I.12. Take an isosceles base on the line, find its \
midpoint \[LongDash] the foot \[LongDash] and return the maximal lines \
through the foot and the point."
}], "Notes",ExpressionUUID->"e276a288-c299-45bb-a20a-01162f0db144"],

Cell["Two consequences follow from that construction.", "Notes",ExpressionUUID->"1c8452bd-1955-450c-b09a-0178456d770d"],

Cell[TextData[{
 "It returns nothing when ",
 StyleBox["point", "TI"],
 " lies ",
 StyleBox["on",
  FontWeight->"Bold"],
 " ",
 StyleBox["line", "TI"],
 ". The construction needs a foot distinct from the point, and there is none. \
Erecting a perpendicular at a point of the line is Euclid I.11, a different \
proposition."
}], "Notes",ExpressionUUID->"9a539910-70b2-40c6-b7e4-4793e5448b8c"],

Cell[TextData[{
 "The count is very large. On an 81-vertex square patch, a point off a line \
admits 6381 perpendiculars. This is the same combinatorial explosion as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3116d7f8-957a-4517-88c5-66089670a8ce"],
 ", and it has the same cause: a maximal geodesic on a lattice has many \
admissible continuations."
}], "Notes",ExpressionUUID->"4bb8f541-94a9-4e7d-b839-60b85bd0cb39"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Radius\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "97acac8c-6206-40a1-b343-9eb8932a0259"],
 " is the lever that makes it usable. ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0477a428-1686-4c4e-a9ba-e0b1bc30f9bb"],
 " localises both the candidate enumeration and the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the point. On that same patch the count falls to 110 at \
radius 3 and 26 at radius 2. Perpendicularity is a local notion, so \
localising it is not a compromise."
}], "Notes",ExpressionUUID->"a01303ef-1863-4776-aed1-2e9ae613a373"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3901d21f-a34d-4286-9d35-c3bbb838cca1"],
 " also takes the ",
 Cell[BoxData["Q"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b259d239-2cf0-432e-9c26-cf36168e38d7"],
 "-side families \[LongDash] ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc69af8b-3e1a-41d1-b1e7-75cf766df746"],
 ", ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60daf867-18a4-4a40-a65d-9dd3e4f370b9"],
 ", ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac77d570-2bbe-4c52-be32-41ea7f937a68"],
 ", ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4424f5c6-f24e-4e1f-be30-a7a358db69a3"],
 " \[LongDash] which enumerate maximal geodesics through the point and filter \
them with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb9dc2b8-d3c8-40aa-83c7-b3d1d37ee295"],
 ". Sub-options belong inside the method spec and are passed through."
}], "Notes",ExpressionUUID->"b04814e7-c582-4a67-88a8-cfe5383631b3"],

Cell[TextData[{
 "The result need not satisfy ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPerpendicularQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPerpendicularQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3108c7be-a0c4-4e30-bbff-974f9ff71822"],
 " under its default settings. The default ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed5fe1dd-623a-484a-adba-009b7dd7fc91"],
 " construction is Euclid's, while the predicate tests a projection \
condition, and on a lattice the two do not coincide. See that page for which \
equality setting reconciles them."
}], "Notes",ExpressionUUID->"51ea9de9-a027-4a7a-862d-fd1e68e0f29d"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"0a64b51f-0635-498f-a014-185c754a0730"],

