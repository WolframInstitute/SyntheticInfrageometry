Notebook[{

Cell[CellGroupData[{
Cell["InfraRayQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"1077ea96-f156-4921-a261-641a38c03b21"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["ray", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a02b9e6-2580-4eb6-89dc-6a12f9bf539c"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["ray", "TI"],
 " is a ray in ",
 StyleBox["g", "TI"],
 ": a geodesic from its own first vertex that cannot be prolonged past its \
last.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"e903059d-72bb-4dd5-9671-b59c1f439e67"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRayQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["rays", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8c4d286-14e3-4988-a7b7-1357101268bf"],
 "\[LineSeparator]",
 "tests every ray of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1ab0e06d-e07a-4f54-9fe3-64ab4f2377cb"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"645d0c9a-b3cd-4ec0-9138-339993e67f87"],

Cell["\<\
Two conditions, and the asymmetry between them is the whole definition:\
\>", "Notes",ExpressionUUID->"669ed43f-3a27-4a81-b9bb-032b1557c27d"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a5801b76-7a77-43af-b3d4-49197222aa5c"], Cell["Condition", "TableText",
     FontWeight->Bold,ExpressionUUID->"c58e9927-0a00-4a2f-8b46-5533c0569662"],
     Cell["Why", "TableText",
     FontWeight->Bold,ExpressionUUID->"23980fa0-0449-492f-b672-d6a8132fa94e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "29033048-9dbc-4f25-8972-42bee9a4d2ce"], Cell[
    "the sequence is a geodesic", "TableText",ExpressionUUID->
     "d85fa691-e463-409c-b651-8e084073930e"], Cell[TextData[{
     "a ray is straight, so ",
     Cell[BoxData[
      TemplateBox[{
        Cell[
         TextData["InfraSegmentQ"]], 
        "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegmentQ", 
        "WolframInstitute/SyntheticInfrageometry Package Symbol"},
       "PackageLink",
       BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
      "40ae2f35-d6fc-4c87-8ad4-714944f4b098"],
     " must hold"
    }], "TableText",ExpressionUUID->"1be0c71b-033c-4452-ab4b-2f98236440ba"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0151779d-efaf-43a1-ba15-3e0678641beb"], Cell["\<\
no neighbour of the last vertex sits one step farther from the first\
\>", "TableText",ExpressionUUID->"36a85343-0fbf-478a-a2fd-67a85011d4ac"], 
    Cell["the far end is inextensible", "TableText",ExpressionUUID->
     "0c13c6f0-f489-4b8e-82e1-30240ed2cd38"]}
  }]], "2ColumnTableMod",ExpressionUUID->"3824a2d4-733b-46bd-bc97-\
2fe9164dd6fd"],

Cell[TextData[{
 "Inextensibility is required ",
 StyleBox["only at the far end",
  FontWeight->"Bold"],
 ". The origin is an endpoint by fiat \[LongDash] that is exactly what \
distinguishes a ray from a line (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLineQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f407979a-fd65-4af1-9587-6e25b5086ba8"],
 " asks for inextensibility at both ends), and it means a ray may start \
anywhere, not only at a peripheral vertex."
}], "Notes",ExpressionUUID->"5c4459c2-09f6-4fc9-a6d9-29333c3be875"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c007cc9c-b238-4ba5-9bf9-54fac01f05a6"],
 ": a single vertex has no direction."
}], "Notes",ExpressionUUID->"476e5cd7-7411-4374-8573-a13dbd2e7fef"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "41ce0ce5-8cd5-4650-9252-14b5847db934"],
 ", which grows rays on a DAG whose sinks are exactly the inextensible ends, \
so every ray that finder returns satisfies it \[LongDash] under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "63c07ed8-5c39-415b-8def-efec9ed66673"],
 ", by construction."
}], "Notes",ExpressionUUID->"fdd03020-920a-4f30-88f3-0717ace4a29f"]
}, Open  ]],

