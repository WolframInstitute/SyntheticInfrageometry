Cell["\<\
Dropping the far vertex breaks inextensibility, so the truncation is no \
longer a ray.\
\>", "ExampleText",ExpressionUUID->"8fcc71f0-a248-4421-85c0-b0bbcf24cd74"],

Cell[CellGroupData[{

