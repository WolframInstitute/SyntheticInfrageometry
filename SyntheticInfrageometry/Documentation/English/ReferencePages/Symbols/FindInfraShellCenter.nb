Notebook[{
Cell["FindInfraShellCenter", "Title",ExpressionUUID->"8047bf38-d984-4874-bc87-2f0eda6a4ca9"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"3f763c43-a505-4ee0-8a75-7bcb6478816e"],

Cell["\<\
FindInfraShellCenter[graph, shell] returns {center, radii} of a metric shell \
as a weighted InfraPoint and a sorted radius list; shell is a vertex list or \
an InfraShell. Method (\"MaximalChordsBisectors\" (default): bisect the \
shell's longest chords and union the midpoints, mass = bisection \
multiplicity, radius = union of integer arms; \"EquidistantPoints\": every \
vertex equidistant from the whole shell, unweighted, radius = common \
distance). \"MaximalChordsBisectors\" sub-options (inside the Method spec): \
\"Maximality\" (\"PerVertex\" (default) | \"Diameter\"), \"Distance\" \
(\"Extrinsic\" (default) | \"Intrinsic\", antipode-selection distance; \
\"Intrinsic\" is empty on a genuine sphere), \"Parity\" (All (default) | \
\"Even\" | \"Odd\").\
\>", "Text",ExpressionUUID->"d0f07515-653b-46d2-94e6-39216586c8f0"],

Cell["Setup", "Section",ExpressionUUID->"2139bd4d-97e9-4fdc-9a9e-1c32f108fbf5"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"c4cf1fb5-e48f-4f68-9b6b-7fc2c1108ec4"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"58fcdc35-3557-40d4-877c-2623c9380869"],

Cell["Related Guides", "Section",ExpressionUUID->"7f6c9793-bca9-4748-844c-96def56bc16b"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"68cd2398-af7c-4508-a914-476f2e83bacc"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"a22cd141-dafb-44c6-800f-2ab2436bb638"]
},
