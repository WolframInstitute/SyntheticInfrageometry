Notebook[{
Cell["FindInfraShellCenter", "Title",ExpressionUUID->"f7a31c62-03ea-4c25-9b19-1caf22c90fee"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"759f1483-f540-490c-8cf3-1b4935026fe1"],

Cell["\<\
FindInfraShellCenter[graph, shell] returns {center, radii} of a metric shell \
as a weighted InfraPoint and a sorted radius list; shell is a vertex list or \
an InfraShell. Method (\"MaximalChordsBisectors\" (default): bisect the \
shell's longest chords and union the midpoints, mass = bisection \
multiplicity, radius = union of integer arms; \"EquidistantPoints\": every \
vertex equidistant from the whole shell, unweighted, radius = common \
distance). \"MaximalChordsBisectors\" sub-options (inside the Method spec): \
\"Maximality\" (\"PerVertex\" (default) | \"Diameter\"), \"Distance\" \
(\"Extrinsic\" (default) | \"Intrinsic\", antipode-selection distance; \
\"Intrinsic\" is empty on a genuine sphere), \"Parity\" (All (default) | \
\"Even\" | \"Odd\").\
\>", "Text",ExpressionUUID->"3936b6ae-b0b7-4244-b092-26129b6e3ee7"],

Cell["Setup", "Section",ExpressionUUID->"52a5101b-d3bb-43dc-b2e7-5a094e416687"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"216c403c-4f4d-497b-95eb-e8cf3a800dc6"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"d158f3c4-eb99-4fd3-b780-90911423afac"],

Cell["Related Guides", "Section",ExpressionUUID->"b195c1fb-af5c-459e-9331-8f98e3734aec"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"6aba5209-c9a1-4d88-87c1-05fe2a6e440f"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"ecc5c100-2492-47fd-8a0d-05e257e07873"]
},
