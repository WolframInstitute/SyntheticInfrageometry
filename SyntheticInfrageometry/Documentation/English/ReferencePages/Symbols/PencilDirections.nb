Cell["\<\
The pencil at the middle of a path has two rays, one to each leaf.\
\>", "ExampleText",ExpressionUUID->"51552f9b-dc16-4bca-b72c-44cc6ac935ec"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilDirections", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"8aaa41c4-7474-4e40-9d86-073b8fddda43"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"4", ",", "3", ",", "2", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", "5", ",", "6", ",", "7"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6c2bd59e-e018-44d8-9c9a-d08e6185bd41"]
}, Open  ]],

Cell["On the 6-cycle both rays from 1 end at the antipode.", "ExampleText",ExpressionUUID->"66d2ac40-90d9-4bc4-9046-43504affb418"],

