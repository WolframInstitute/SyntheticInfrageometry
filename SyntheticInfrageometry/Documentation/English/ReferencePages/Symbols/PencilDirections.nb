Cell[TextData[{
 "Every element of the pencil starts at ",
 StyleBox["O", "TI"],
 " and is a ray."
}], "ExampleText",ExpressionUUID->"37613e83-62dc-4cb5-927b-cd7f1b6c82cd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"PencilDirections", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "5"}], " ", "&&", 
       " ", 
       RowBox[{"InfraRayQ", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"1562cdea-8e93-432b-80c4-3345730a1519"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"43184587-d749-44c5-a72b-518652b477c8"]
}, Open  ]],

