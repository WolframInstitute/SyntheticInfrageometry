Notebook[{

Cell[CellGroupData[{
Cell["PencilDirections", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"285041e0-e4c0-4f9f-b7f3-a0f0a3c05999"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilDirections"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilDirections", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b9f4c5d-a608-431f-a493-4fd674910422"],
 "\[LineSeparator]",
 "gives the pencil at ",
 StyleBox["O", "TI"],
 ": every ray from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as a list of vertex sequences.",
 "\n"
}], "Usage",ExpressionUUID->"337c03b0-c28f-4263-99d5-f46595615131"],

Cell[TextData[{
 "The pencil at a vertex ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " \[LongDash] the graph's analogue of the unit tangent sphere, one element \
per direction. A ray leaves ",
 StyleBox["O", "TI"],
 " through exactly one neighbour, so the pencil is the union of ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "69816470-9ab3-4acd-9248-07f221064cf3"],
 " over the neighbours ",
 StyleBox["w", "TI"],
 " of ",
 StyleBox["O", "TI"],
 ", and that is how it is computed: one ray pool per neighbour, enumerated."
}], "Notes",ExpressionUUID->"3a5044e7-f828-4507-9e73-c1b339e8b997"],

Cell[TextData[{
 "Every element starts at ",
 StyleBox["O", "TI"],
 " and satisfies ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86a35187-9b60-4bfc-a2a4-acbeb2557461"],
 ". Opposite rays are distinct elements; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/SameDirectionQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dd586951-8f0e-40eb-9173-39f7dd077fab"],
 " is the predicate that identifies them."
}], "Notes",ExpressionUUID->"b96468de-2731-4c9a-a395-e54c7976249f"],

Cell[TextData[{
 "There is no pencil object. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilCardinality", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7920a2ba-fa7b-4786-84fe-85cf46c9d226"],
 " gives the size of the pencil without enumerating it."
}], "Notes",ExpressionUUID->"5c6244f6-b333-4ce7-858c-7ed3ce9e0266"]
}, Open  ]],

