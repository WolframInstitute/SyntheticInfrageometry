Cell[TextData[{
 "Every element of the pencil starts at ",
 StyleBox["O", "TI"],
 " and is a ray."
}], "ExampleText",ExpressionUUID->"1252d531-2ea6-49f2-af50-571c3574984c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"PencilDirections", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"First", "[", "#", "]"}], " ", "===", " ", "5"}], " ", "&&", 
       " ", 
       RowBox[{"InfraRayQ", "[", 
        RowBox[{"g", ",", " ", "#"}], "]"}]}], " ", "&"}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cffa4735-cbd3-43e3-ad82-845248836628"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b3082d47-6da8-4d07-b317-964fd35c70b5"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
