   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a68c08a6-a350-4ffb-828e-28c9de5dd4b4"],
 " counts the same set without enumerating it."
}], "ExampleText",ExpressionUUID->"71dde8e3-8dfb-493a-aace-ac7dbce7655e"],

