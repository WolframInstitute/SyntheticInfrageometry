Notebook[{
Cell["FindInfraCycle", "Title",ExpressionUUID->"d4ba5ad4-e077-4173-9760-7109bbc015e9"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"e5f9942c-f982-4ed1-988b-9240bccc2bae"],

Cell["\<\
FindInfraCycle[graph, n] returns n shortest simple cycles in graph as unary \
InfraCircle[{cycle}] wrappers (open vertex sequences, sorted by length \
ascending); UpTo[n] returns up to n; All returns all. FindInfraCycle[graph, \
{k}, n] restricts to cycles of exactly length k; FindInfraCycle[graph, {kMin, \
kMax}, n] to cycles in the length range. Returns $Failed when fewer than n \
cycles exist. Results feed directly into NullHomotopicQ and FindInfraHomotopy.\
\>", "Text",ExpressionUUID->"a286650d-067a-49a0-96eb-5b078038e6c3"],

Cell["Setup", "Section",ExpressionUUID->"a9045f47-1966-4b95-9466-74e493e8af16"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"779c8a50-10d1-4ea1-8a86-d36a7355fa64"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"0a178918-ddcf-4f3b-b083-355f5ba9d032"],

