Cell["\<\
Beyond the corner edge 1 \[RightArrow] 2 of a 3 \[Times] 3 grid: every vertex \
not in the first column, with edges away from the corner.\
\>", "ExampleText",ExpressionUUID->"cf5ec636-bd0a-4cdc-b5dc-39f7443dfa30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"GeodesicExtensionGraph", "[", 
  RowBox[{
   RowBox[{"GridGraph", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a26010ab-76fa-49f0-876b-3c87444f69be"],

Cell[BoxData[
 GraphicsBox[
  NamespaceBox["NetworkGraphics",
   DynamicModuleBox[{Typeset`graph = HoldComplete[
     Graph[{2, 3, 5, 6, 8, 
      9}, {{{1, 2}, {1, 3}, {2, 4}, {3, 4}, {3, 5}, {4, 6}, {5, 6}}, Null}, {
      VertexCoordinates -> {{1., 2.}, {1., 3.}, {2., 2.}, {2., 3.}, {3., 
        2.}, {3., 3.}}}]]}, 
    TagBox[
     GraphicsGroupBox[
      GraphicsComplexBox[{{1., 2.}, {1., 3.}, {2., 2.}, {2., 3.}, {3., 2.}, {
       3., 3.}}, {
        {Hue[0.6, 0.7, 0.7], Opacity[0.7], CapForm["Round"], Arrowheads[
         Medium], ArrowBox[{1, 2}, 0.02261146496815286], 
         ArrowBox[{1, 3}, 0.02261146496815286], 
         ArrowBox[{2, 4}, 0.02261146496815286], 
         ArrowBox[{3, 4}, 0.02261146496815286], 
         ArrowBox[{3, 5}, 0.02261146496815286], 
         ArrowBox[{4, 6}, 0.02261146496815286], 
         ArrowBox[{5, 6}, 0.02261146496815286]}, 
        {Hue[0.6, 0.5, 1.], EdgeForm[{GrayLevel[0], Opacity[0.7]}], 
         DiskBox[1, 0.02261146496815286], DiskBox[2, 0.02261146496815286], 
         DiskBox[3, 0.02261146496815286], DiskBox[4, 0.02261146496815286], 
         DiskBox[5, 0.02261146496815286], DiskBox[6, 0.02261146496815286]}}]],
     
     MouseAppearanceTag["NetworkGraphics"]],
    AllowKernelInitialization->False]],
  DefaultBaseStyle->"NetworkGraphics",
  FormatType->TraditionalForm,
  FrameTicks->None]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e652ae51-c7a9-4258-9fb2-655a7c57bbb6"]
}, Open  ]],

Cell["\<\
Its vertex set is the set of vertices reached by a geodesic from 1 through 2.\
\
\>", "ExampleText",ExpressionUUID->"366cef3e-f4a5-43a6-9d36-2781875a5b08"],

