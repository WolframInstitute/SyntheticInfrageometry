Notebook[{

Cell[CellGroupData[{
Cell["GeodesicExtensionGraph", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"7502eaf7-8aca-448c-b268-34a85416af79"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb070e14-b02c-4cc2-aa4e-d78b802aefc9"],
 "\[LineSeparator]",
 "gives the DAG of all geodesic extensions of the segment ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " beyond ",
 StyleBox["p2", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"26ffa447-8b6d-480c-9354-216f55dd97fa"],

Cell[TextData[{
 "The vertex set is {",
 StyleBox["e", "TI"],
 " : ",
 StyleBox["d(p1, e) = d(p1, p2) + d(p2, e)", "TI"],
 "} \[LongDash] the vertices that some geodesic from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 " reaches beyond ",
 StyleBox["p2", "TI"],
 " \[LongDash] and the edges are the edges of ",
 StyleBox["g", "TI"],
 " along increasing distance from ",
 StyleBox["p1", "TI"],
 ". The source is ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"aa82da54-ca24-440a-9018-1ab4e40ba70d"],

Cell[TextData[{
 "The set is closed under such a step: if ",
 StyleBox["u", "TI"],
 " is in it and ",
 StyleBox["v", "TI"],
 " is a neighbour of ",
 StyleBox["u", "TI"],
 " one step farther from ",
 StyleBox["p1", "TI"],
 ", then ",
 StyleBox["v", "TI"],
 " is in it too. So the directed paths from ",
 StyleBox["p2", "TI"],
 " are exactly the geodesics from ",
 StyleBox["p2", "TI"],
 " that stay geodesic behind any ",
 StyleBox["p1", "TI"],
 " \[RightArrow] ",
 StyleBox["p2", "TI"],
 " geodesic, and the ",
 StyleBox["sinks",
  FontWeight->"Bold"],
 " are the vertices past which no such geodesic can be prolonged \[LongDash] \
the ends of the rays from ",
 StyleBox["p1", "TI"],
 " through ",
 StyleBox["p2", "TI"],
 "."
}], "Notes",ExpressionUUID->"ab8db6c8-96dc-4ade-acd1-255478133581"],

Cell[TextData[{
 "This is the shared engine of the distance-matrix family. The ray pool of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "de69bda3-6147-4efd-acf8-dfe1667c4417"],
 " is the geodesic bundle from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " glued at ",
 StyleBox["p2", "TI"],
 " to this DAG. The two sides of a line through ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " are ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f6078450-a7a1-4146-8854-caaaaec072f7"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82d0d977-758b-47fb-9778-6821491d8271"],
 ", and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3106ce73-c90a-4469-bcd8-91443e0463df"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "30be5be4-b684-411a-b3e4-47d4968958d3"],
 " pick their ends from these two, subject to joint geodesicity."
}], "Notes",ExpressionUUID->"53702c27-644b-46f4-bfef-9dd5ca954850"],

Cell[TextData[{
 "With ",
 StyleBox["p1", "TI"],
 " = ",
 StyleBox["p2", "TI"],
 " the condition is empty and the result is the whole spray, ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicSprayGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/GeodesicSprayGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18cbe80f-8a22-4dc8-afae-5f674cc17e60"],
 "."
}], "Notes",ExpressionUUID->"594ee848-6bb4-42aa-87cb-adeb7fffb90b"],

Cell[TextData[{
 "Anchors may be wrappers \[LongDash] ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSet"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSet", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "52dc71cf-4673-4a51-b75d-0c4b56fee8b3"],
 ", ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "774bed51-a80c-4045-8a7c-0e7a6413e1a0"],
 ", a bundle \[LongDash] and spread to one DAG per pair of anchor vertices, \
returned as a list."
}], "Notes",ExpressionUUID->"1ce10dd4-4d45-4469-b4c3-72c0919326ce"],

Cell[TextData[{
 "The graph keeps the embedding coordinates of ",
 StyleBox["g", "TI"],
 ", so it draws in place."
}], "Notes",ExpressionUUID->"f8cfd06f-7485-4176-8d16-5430e301278c"]
}, Open  ]],

