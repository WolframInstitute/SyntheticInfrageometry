Cell["\<\
With the anchor as its own direction the extension graph is the spray.\
\>", "ExampleText",ExpressionUUID->"316dfc05-cadc-424b-9f65-b2e08e5445fc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicExtensionGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicSprayGraph", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"387b0043-f91b-48d8-9603-7db8bb2105bd"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0eb8fc6d-1cf6-416d-8a8f-7547ad36ba80"]
}, Open  ]],

Cell[TextData[{
 "The vertex set is closed under a farther step: every neighbour of a vertex \
in the graph that lies one step farther from ",
 StyleBox["p1", "TI"],
 " is in the graph."
}], "ExampleText",ExpressionUUID->"9d9c6eaf-f54d-4daa-955c-cc03adcef988"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "h", "]"}], ",", "\n", "    ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{"AllTrue", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", 
            " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "1", ",", " ", "v"}], "]"}], " ", "+", 
             " ", "1"}]}], " ", "&"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "h", "]"}], ",", " ", "#"}], "]"}], " ",
          "&"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"b7eb936f-614e-4f41-816b-cde33e95920c"],

