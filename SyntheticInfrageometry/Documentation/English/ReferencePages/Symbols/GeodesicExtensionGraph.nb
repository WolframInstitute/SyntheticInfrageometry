      RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4e2abb8d-7bf9-405a-a85e-3d162e8bb4d1"],

