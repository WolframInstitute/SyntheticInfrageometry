Cell["\<\
With the anchor as its own direction the extension graph is the spray.\
\>", "ExampleText",ExpressionUUID->"848415b8-b2db-49f7-85dc-03f13662b39f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicExtensionGraph", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"5", ",", " ", "5"}], "}"}]}], "]"}]}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"EdgeList", " ", "@", " ", 
      RowBox[{"GeodesicSprayGraph", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d59042ee-5cfa-4c3e-bc2d-9b9ad9747aec"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e083e68a-7aac-4c30-bcab-c88b0f4cfe69"]
}, Open  ]],

Cell[TextData[{
 "The vertex set is closed under a farther step: every neighbour of a vertex \
in the graph that lies one step farther from ",
 StyleBox["p1", "TI"],
 " is in the graph."
}], "ExampleText",ExpressionUUID->"6f61182f-89bb-4ad0-b551-c0c672b23a00"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "6"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"VertexList", "[", "h", "]"}], ",", "\n", "    ", 
     RowBox[{"v", " ", "|->", " ", 
      RowBox[{"AllTrue", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"AdjacencyList", "[", 
           RowBox[{"g", ",", " ", "v"}], "]"}], ",", " ", 
          RowBox[{
           RowBox[{
            RowBox[{"GraphDistance", "[", 
             RowBox[{"g", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", 
            " ", 
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "1", ",", " ", "v"}], "]"}], " ", "+", 
             " ", "1"}]}], " ", "&"}]}], "]"}], ",", "\n", "      ", 
        RowBox[{
         RowBox[{"MemberQ", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "h", "]"}], ",", " ", "#"}], "]"}], " ",
          "&"}]}], "]"}]}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5ef8bd2d-cc7b-436b-a496-b3193bf75b35"],

