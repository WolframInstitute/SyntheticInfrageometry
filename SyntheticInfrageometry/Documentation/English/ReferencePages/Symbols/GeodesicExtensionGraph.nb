Cell["The two sides of a line through the edge 1\[Dash]2 of the 6-cycle.", \
"ExampleText",ExpressionUUID->"2e39ee23-6951-4230-ab05-93644288112f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "1"}], "}"}]}], "]"}]}]}], ",", "\n", " ", 
   RowBox[{"Sort", " ", "@", " ", 
    RowBox[{"VertexList", " ", "@", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"d104782b-c2d1-4997-9026-aa243d49dbe4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"1", ",", "5", ",", "6"}], "}"}], ",", 
