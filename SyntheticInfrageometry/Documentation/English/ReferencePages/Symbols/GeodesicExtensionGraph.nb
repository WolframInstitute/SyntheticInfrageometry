      RowBox[{
       RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "2"}], "}"}]}], "]"}]}]}]}], "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"182cbfb5-80ce-4713-8d55-c4c151f9abe8"],

