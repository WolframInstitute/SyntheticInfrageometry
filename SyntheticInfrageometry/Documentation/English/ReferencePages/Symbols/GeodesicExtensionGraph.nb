 RowBox[{"{", 
  RowBox[{"2", ",", "3", ",", "5", ",", "6", ",", "8", ",", "9"}], 
  "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"e5b50509-93cf-483a-b57a-d14dceec8d3a"]
}, Open  ]],

Cell["\<\
Beyond the diagonal from the corner 1 through the centre 5, only the far \
quadrant remains, and the single sink is the opposite corner.\
\>", "ExampleText",ExpressionUUID->"b358f902-dddc-48f3-90bc-7b32f22f01d3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"h", " ", "=", " ", 
     RowBox[{"GeodesicExtensionGraph", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Sort", " ", "@", " ", 
      RowBox[{"VertexList", "[", "h", "]"}]}], ",", " ", 
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "h", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"VertexOutDegree", "[", 
          RowBox[{"h", ",", " ", "#"}], "]"}], " ", "==", " ", "0"}], " ", 
        "&"}]}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"16a90e2f-7875-48e2-9063-55698ed5b858"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "8", ",", "9"}], "}"}], ",", 
   RowBox[{"{", "9", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"64c8aeb2-8dee-497d-ac96-9f206594a0ce"]
}, Open  ]]
}, Open  ]],

