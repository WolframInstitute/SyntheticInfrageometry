       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"73923019-0274-47d9-9485-3f508cbab920"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", "9"}], ",", 
   RowBox[{"\<\"Square\"\>", "\[Rule]", "10"}], ",", 
   RowBox[{"\<\"Hexagonal\"\>", "\[Rule]", "10"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"16690207-8793-420b-afe9-68ae6b39f34f"]
}, Open  ]],

Cell["\<\
Every vertex of the perpendicular bisector is, by definition, equidistant \
from the two points it bisects.\
\>", "ExampleText",ExpressionUUID->"ee661d76-e001-40b5-b9a7-8be17215e9a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"AllTrue", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraBisectingHyperplane", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{"EquidistanceQ", "[", 
       RowBox[{
       "g", ",", " ", "a", ",", " ", "#", ",", " ", "b", ",", " ", "#"}], 
       "]"}], " ", "&"}]}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"ffa0a69b-6dcc-4011-9c18-783c9a438960"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"11ba3b51-6177-4e18-8f5d-b17154cf9370"]
}, Open  ]]
}, Open  ]],

