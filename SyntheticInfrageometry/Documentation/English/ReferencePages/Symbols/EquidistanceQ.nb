Cell["\<\
Equidistance is symmetric in each pair and reflexive, so a segment is \
congruent to itself read either way.\
\>", "ExampleText",ExpressionUUID->"58ec8981-693b-4ec8-9755-46791ebf6d73"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"EquidistanceQ", "[", 
      RowBox[{
      "g", ",", " ", "a", ",", " ", "b", ",", " ", "a", ",", " ", "b"}], 
      "]"}], ",", " ", 
     RowBox[{"EquidistanceQ", "[", 
      RowBox[{
      "g", ",", " ", "a", ",", " ", "b", ",", " ", "b", ",", " ", "a"}], 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"72de168a-6d0a-4a0d-ba88-c5379c5c8864"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"936292d5-1d46-4128-ba80-7f8ce88f0e36"]
}, Open  ]],

Cell["\<\
The congruence classes are the distance classes, so their number is the \
diameter rather than a continuum \[LongDash] on each substrate every pair at \
a given distance is congruent to every other.\
\>", "ExampleText",ExpressionUUID->"b0bd1285-3383-4951-a459-f19e24af2423"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"Union", " ", "@", " ", 
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "c"}], "]"}]}]}]}], "]"}]}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
