Cell[CellGroupData[{
Cell["EquidistanceQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4660b38d-3f8f-43f4-b1b3-2b7cbe8d6dff"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["EquidistanceQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/EquidistanceQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab8e26e9-b50b-4f1b-a450-e235ea9093d3"],
 "\[LineSeparator]",
 "tests Tarski's equidistance ",
 Cell[BoxData[
  RowBox[{
   StyleBox["a", "TI"], 
   StyleBox["b", "TI"], "\[Congruent]", 
   StyleBox["c", "TI"], 
   StyleBox["d", "TI"]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ffbfd134-ab14-4497-bf19-9e35dcc7894b"],
 ": whether ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["c", "TI"], ",", 
    StyleBox["d", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1b7d7df4-052f-4c66-ab08-fe8ed4a38d55"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"6f682acf-cd4a-4ab5-9e9a-06ab75cc57b7"],

Cell[TextData[{
 "Equidistance is the second primitive of Tarski's axiomatization, alongside \
betweenness (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["BetweennessQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/BetweennessQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4b0e0563-7019-4401-bdc8-ffcb46ec7c9e"],
 "). It is a ",
 StyleBox["four-place",
  FontWeight->"Bold"],
 " relation on vertices \[LongDash] it compares two segments rather than \
describing one \[LongDash] and it is what does the work of congruence: Tarski \
has no separate congruence primitive, no motions, and no ruler."
}], "Notes",ExpressionUUID->"c99eea17-0c6f-4f1a-a8d6-578f841cbaf1"],

Cell[TextData[{
 "On a graph it reduces to equality of graph distances, so it is cheap. What \
is not cheap, and not automatic, is that the axioms governing it hold: ",
 Cell[BoxData["TarskiCongruenceReflexivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0c25d0f-b358-42db-91f9-a19319903f6c"],
 ", ",
 Cell[BoxData["TarskiCongruenceTransitivityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9faf0c78-058f-4772-98f3-e7e314252068"],
 " and ",
 Cell[BoxData["TarskiCongruenceIdentityQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3e4ebe3-ef17-448a-851c-d55fed636ee6"],
 " test the three that concern equidistance alone, and ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "74241e47-da47-46e4-9a95-4990de731fa3"],
 " runs the whole dashboard."
}], "Notes",ExpressionUUID->"b81d1ec4-35b8-4083-9af6-d5a8659634af"],

Cell[TextData[{
 "Because the graph metric takes only integer values, the equidistance \
classes are coarse: every pair at distance ",
 StyleBox["k", "TI"],
 " is congruent to every other. ",
 Cell[BoxData["TarskiEquidistanceClasses"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "15aa9109-3f2d-475a-86a2-e92f36e0f86a"],
 " returns that partition. This is the sharpest way in which a graph is not a \
Euclidean plane \[LongDash] there are only ",
 Cell[BoxData[
  RowBox[{
   StyleBox["diam",
    FontSlant->"Plain"], 
   StyleBox["(",
    SpanMaxSize->1], 
   StyleBox["g", "TI"], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2f32fbd-d763-44a9-a6a2-2d3bf229abf1"],
 " congruence classes of segments, so congruence carries far less information \
than it does classically."
}], "Notes",ExpressionUUID->"66a3aa69-5a43-4855-a52d-e02ff9c14119"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"be0afc1f-a1d8-4024-801d-c4f6224c5df3"],

