Notebook[{

Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"4046b082-3f82-49b5-8ff1-705f9e97c557"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["path1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["pathk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d44bfe05-7d36-46b5-9e86-2112fc0d7b2d"],
 "\[LineSeparator]",
 "is a segment given by a set of geodesics.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"33009683-33d7-4d69-840b-a1acf4a831d5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dag", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "244f038e-a8f8-46d0-b11e-75643fd983dc"],
 "\[LineSeparator]",
 "is the same segment given by its geodesic DAG.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c68cf002-8acf-4080-8378-73edf026d20a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["dagk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad173998-fc80-4969-a4ff-afc5bb700655"],
 "\[LineSeparator]",
 "is the pool form: one geodesic DAG per pair of ends, as returned by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e41390a-2bae-4c47-9f02-bdd1f72ef994"],
 " and by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dbd1451c-0b3d-4cb7-b019-aeeceed80b7f"],
 " over several anchors."
}], "Usage",ExpressionUUID->"3c5cfb1d-db0b-4bde-b801-3b4590771f62"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " is the set of all geodesics from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 "."
}], "Notes",ExpressionUUID->"1ff3ec06-c15d-426f-b0a1-aa4113057156"],

Cell["\<\
It carries no weights. The geodesics are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"858519c2-bca6-49bd-ae36-1fa511a5b7d1"],

Cell["There are three forms of the same object.", "Notes",ExpressionUUID->"aa791bc0-1390-47ed-9193-deabf01664e0"],

Cell[TextData[{
 "The ",
 StyleBox["enumerated",
  FontWeight->"Bold"],
 " form is a list of paths, what a bounded count produces."
}], "Notes",ExpressionUUID->"5e85f02a-1c6c-44c6-9da9-3a6ef3b830c9"],

Cell[TextData[{
 "The ",
 StyleBox["DAG",
  FontWeight->"Bold"],
 " form is a graph: the geodesic interval. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6755fdd-7e3d-47c1-84d6-ffb33dfada88"],
 " produces it for one pair of endpoints."
}], "Notes",ExpressionUUID->"82d0bdc4-1eaf-458b-8969-a9efc954fea8"],

Cell[TextData[{
 "The ",
 StyleBox["pool",
  FontWeight->"Bold"],
 " form is a list of DAGs, one per pair of ends \[LongDash] the return of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "007a2501-eb20-4bc8-a9d8-2b99a9027c58"],
 "[",
 StyleBox["g", "TI"],
 ", ",
 StyleBox["seed", "TI"],
 ", ",
 StyleBox["kspec", "TI"],
 ", All] and of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "40390ade-b5dd-42a6-b148-86a3648dbaf7"],
 " spread over wrapper anchors. A lone atom collapses to the DAG form."
}], "Notes",ExpressionUUID->"6d4988e3-8e76-45c9-a59b-5954f0fc421e"],

Cell["\<\
The DAG is preferred because the number of geodesics grows fast while the DAG \
stays small. On a square grid, two vertices at distance 5 have 10 geodesics \
and a 12-vertex DAG.\
\>", "Notes",ExpressionUUID->"12481ef3-42c9-439b-8b72-fdae5c485726"],

Cell[TextData[{
 "A measure appears when you project. ",
 Cell[BoxData[
  RowBox[{"seg", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "293fda9f-39e5-4766-b3d9-95a31365eeb9"],
 " is the ",
 StyleBox["i", "TI"],
 "-th position across all realisations, returned as a measured ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d9610947-fde2-4daa-b518-3c602638f332"],
 ". Its weight at a vertex is the number of geodesics passing through that \
vertex at that position. Position 1 is the start, so it carries the full \
multiplicity. This is how ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0452eaf8-485a-40ea-a270-9a1da6a2c4b4"],
 " gets its weights."
}], "Notes",ExpressionUUID->"6d60babd-71d9-4b79-908d-8532470ab244"],

Cell["DAG accessors:", "Notes",ExpressionUUID->"9c51985c-9e2b-4609-baa5-25869d724770"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "be718a25-be26-4556-8345-2b9e831c19ec"], Cell["Accessor", "TableText",
     FontWeight->Bold,ExpressionUUID->"3db25205-263d-4b47-95df-d909c41ff4dc"],
     Cell["Gives", "TableText",
     FontWeight->Bold,ExpressionUUID->"5ff1a2cd-0cb7-452e-a41b-19fe569e4d0c"]},
