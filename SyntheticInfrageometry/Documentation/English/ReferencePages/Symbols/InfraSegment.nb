Cell["\<\
The pool form: one DAG per pair of ends. Extending an edge of the grid by one \
step on each side gives seven ends pairs, each carrying one geodesic here.\
\>", "ExampleText",ExpressionUUID->"b390f62a-ce52-4289-9e85-5d459d71100d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pool", " ", "=", " ", 
     RowBox[{"ExtendInfraSegment", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"pool", "[", "\"\<Graph\>\"", "]"}]}], ",", " ", 
     RowBox[{"pool", "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<Start\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<End\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"9bd075bd-05fb-461d-b877-643554fbd50d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "7", ",", 
   RowBox[{"InfraSet", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "5", ",", "10"}], "}"}], "]"}], ",", 
   RowBox[{"InfraSet", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", "8", ",", "11"}], "}"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"84e87475-4790-4f59-a675-562d5827a742"]
}, Open  ]]
