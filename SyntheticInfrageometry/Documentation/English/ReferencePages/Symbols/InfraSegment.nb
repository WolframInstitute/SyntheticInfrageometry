Notebook[{

Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e7d0f826-eba4-4ea2-bdda-73b3dcba4503"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["path1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["pathk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4b9de9d4-a9f4-4a8f-9b5b-77d277c0c2b2"],
 "\[LineSeparator]",
 "is a segment given by a set of geodesics.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"743d8265-99c3-40c0-bbe5-b94cd1da3a43"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dag", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd9a8143-2cdb-4f68-bcc9-86e2435701fe"],
 "\[LineSeparator]",
 "is the same segment given by its geodesic DAG.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"bc273f59-5734-4c8e-b2f4-66b7efca8619"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["dagk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1ca3f6b-0bcb-4e05-9630-6dc33a3c578b"],
 "\[LineSeparator]",
 "is the pool form: one geodesic DAG per pair of ends, as returned by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d84da698-7008-4e37-8813-bac79876cb3a"],
 " and by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7fd42593-7b74-4a03-b173-31a1ded0c2be"],
 " over several anchors."
}], "Usage",ExpressionUUID->"bea923a6-cecb-41a8-b1e3-5e288a6e94d0"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " is the set of all geodesics from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 "."
}], "Notes",ExpressionUUID->"df573233-a9cb-43ba-86d6-b2dfbfa623c8"],

Cell["\<\
It carries no weights. The geodesics are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"ad3bc57b-7379-4fe4-b90e-5219774c4c82"],

Cell["There are three forms of the same object.", "Notes",ExpressionUUID->"88812ed7-ad80-41a5-9504-c127451ec87a"],

Cell[TextData[{
 "The ",
 StyleBox["enumerated",
  FontWeight->"Bold"],
 " form is a list of paths, what a bounded count produces."
}], "Notes",ExpressionUUID->"dfb11c1a-220a-4f86-9887-434e8c4ea8de"],

Cell[TextData[{
 "The ",
 StyleBox["DAG",
  FontWeight->"Bold"],
 " form is a graph: the geodesic interval. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8ca72154-0d5a-4858-aa9e-b81eab4bb021"],
 " produces it for one pair of endpoints."
}], "Notes",ExpressionUUID->"274d3eff-70f2-413a-91d7-f6049e008091"],

Cell[TextData[{
 "The ",
 StyleBox["pool",
  FontWeight->"Bold"],
 " form is a list of DAGs, one per pair of ends \[LongDash] the return of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["ExtendInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a14126fc-7e4e-4b66-a9ce-baf2771550aa"],
 "[",
 StyleBox["g", "TI"],
 ", ",
 StyleBox["seed", "TI"],
 ", ",
 StyleBox["kspec", "TI"],
 ", All] and of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "af1cfae8-a39c-49d9-b4c8-da082016f2ce"],
 " spread over wrapper anchors. A lone atom collapses to the DAG form."
}], "Notes",ExpressionUUID->"5964cfbb-c0bb-4f20-a283-f3f49d795293"],

Cell["\<\
The DAG is preferred because the number of geodesics grows fast while the DAG \
stays small. On a square grid, two vertices at distance 5 have 10 geodesics \
and a 12-vertex DAG.\
\>", "Notes",ExpressionUUID->"cd95ee7e-5db4-452d-98c8-e389ffee5947"],

Cell[TextData[{
 "A measure appears when you project. ",
 Cell[BoxData[
  RowBox[{"seg", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "148e6fd0-0e1e-4e83-aa4c-00172d01050d"],
 " is the ",
 StyleBox["i", "TI"],
 "-th position across all realisations, returned as a measured ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "45a72a42-cdf7-4302-b9ef-3e1149ec379c"],
 ". Its weight at a vertex is the number of geodesics passing through that \
vertex at that position. Position 1 is the start, so it carries the full \
multiplicity. This is how ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bb35d0bf-48ac-4ded-b1b6-9482615b23a6"],
 " gets its weights."
}], "Notes",ExpressionUUID->"d85cfc0b-4301-4960-a205-b70a87b04b38"],

Cell["DAG accessors:", "Notes",ExpressionUUID->"44f0c5fa-8c06-4746-bc1d-f5679a30baa2"],

