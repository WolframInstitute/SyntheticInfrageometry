  FontSize->0.9 Inherited,ExpressionUUID->
  "580cabae-53f1-4100-9ef9-70e39d6198ff"],
 " names a segment to be solved for."
}], "Notes",ExpressionUUID->"f7674d00-0dca-4a3a-9881-989b2c3e9fb3"]
