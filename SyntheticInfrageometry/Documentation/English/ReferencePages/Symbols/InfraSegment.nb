Notebook[{

Cell[CellGroupData[{
Cell["InfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"dda39f4c-7cb4-4c47-bcc7-f88f5a124683"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["path1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["pathk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "653a2bea-3f74-4e96-b6be-d858e1c795c7"],
 "\[LineSeparator]",
 "is a segment given by a set of geodesics.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"988cd301-7108-4c3e-9215-d375f74c2c15"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dag", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e371077-ca9d-4424-89d1-73b72a613dea"],
 "\[LineSeparator]",
 "is the same segment given by its geodesic DAG."
}], "Usage",ExpressionUUID->"d52d2f6a-510c-4f99-9a37-c454237521d2"],

Cell[TextData[{
 "Definition: an infra-segment between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " is the set of all geodesics from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 "."
}], "Notes",ExpressionUUID->"d3a23f08-377e-4ecd-a31b-cbe857514083"],

Cell["\<\
It carries no weights. The geodesics are equally admissible, so nothing \
distinguishes them.\
\>", "Notes",ExpressionUUID->"4602a763-0a99-45b7-a716-7a26896106e6"],

Cell["There are two forms of the same object.", "Notes",ExpressionUUID->"35e36ff4-2c44-49ab-a27c-e3b5c5bbf3f2"],

Cell[TextData[{
 "The ",
 StyleBox["enumerated",
  FontWeight->"Bold"],
 " form is a list of paths. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "59d98a50-3a24-40fe-92c7-004a46634252"],
 " produces it."
}], "Notes",ExpressionUUID->"98697880-4e86-4890-b1d1-4aec0f7186df"],

Cell[TextData[{
 "The ",
 StyleBox["DAG",
  FontWeight->"Bold"],
 " form is a graph: the geodesic interval. It is the default return of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ad48b3f3-d11a-4dd3-945a-2081ed889095"],
 "."
}], "Notes",ExpressionUUID->"9243ed9a-6463-4808-9717-703bc8122bdc"],

Cell["\<\
The DAG is preferred because the number of geodesics grows fast while the DAG \
stays small. On a square grid, two vertices at distance 5 have 10 geodesics \
and a 12-vertex DAG.\
\>", "Notes",ExpressionUUID->"e199a136-8a30-4d0b-803d-21eea94ae5f9"],

Cell[TextData[{
 "A measure appears when you project. ",
 Cell[BoxData[
  RowBox[{"seg", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a605b092-3130-41fd-8f01-5e3fd7570613"],
 " is the ",
 StyleBox["i", "TI"],
 "-th position across all realisations, returned as a measured ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "42117646-43bb-4c3d-bbce-d1ef1eee1436"],
 ". Its weight at a vertex is the number of geodesics passing through that \
vertex at that position. Position 1 is the start, so it carries the full \
multiplicity. This is how ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "277d0d85-2d26-4ee7-98c2-4e1ce154342a"],
 " gets its weights."
}], "Notes",ExpressionUUID->"75f524b7-5315-4ca4-b8f9-0fff6b779899"],

Cell["DAG accessors:", "Notes",ExpressionUUID->"edf90f4f-7f10-4d9c-820c-02965b73a8b8"],

