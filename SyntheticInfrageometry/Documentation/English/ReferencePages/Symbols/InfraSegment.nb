  }]], "2ColumnTableMod",ExpressionUUID->"88a75449-5036-4351-947d-\
63fb25e83bff"],

Cell[TextData[{
 "On the pool the accessors are sized by the atoms, never by the family: ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "568981b6-b9dd-45d4-b6d3-b14a8983312a"],
 " is one number per DAG, ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Start\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e2840d3a-9a07-4288-9600-23d907316056"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<End\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9980fe62-13f8-41d0-9fc5-d776a80ce6e7"],
 " are the ",
 Cell[BoxData["InfraSet"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "358e2580-b1b5-45a6-a5b0-ed665be5bc67"],
 " of sources and of sinks, ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8d5ff5b-5e8b-4c8a-9c94-e53d7ede0a7d"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d76fa791-bd32-4489-bdba-c4dca9c1b082"],
 " sum the per-atom counts, ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"\"\<Realizations\>\"", ",", " ", "n"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a14973c-9067-4142-ae42-504b3ef7aebf"],
 " enumerates lazily atom by atom, and ",
 Cell[BoxData[
  RowBox[{"seg", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2467bb01-ddd0-4928-b85a-42d9b1fd6c1d"],
 " is the ",
 StyleBox["i", "TI"],
 "-th layer of every atom weighted by occupation. A 20 \[Times] 20 grid edge \
has about 9 \[Times] 10\:2079 lines through it in two atoms, so nothing here \
enumerates by default."
}], "Notes",ExpressionUUID->"e474f157-3ab4-4d19-9117-fc13010d27aa"],

Cell["\<\
Endpoints are deduplicated. Every geodesic of a family shares them. A walk \
keeps endpoint multiplicity instead, because walks can end anywhere.\
\>", "Notes",ExpressionUUID->"9cfadde1-a1ee-48f9-918b-32d33215d0a7"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6f3faef1-520d-4590-b555-d8b6819f0d00"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62a2fd01-62fd-4162-9ed1-29a4fd1b69bd"],
 " names a segment to be solved for."
}], "Notes",ExpressionUUID->"d240d7fb-85ed-43c1-a9e2-ebd6d320adbc"]
}, Open  ]],

