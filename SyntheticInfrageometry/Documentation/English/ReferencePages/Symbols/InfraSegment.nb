Cell["The DAG is small where the enumeration is large.", "ExampleText",ExpressionUUID->"e044f6d1-8c41-412b-b4be-f6d5a2f7fff6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<DAG vertices\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"seg", "[", "\"\<Vertices\>\"", "]"}]}]}], ",", " ", 
     RowBox[{"\"\<length\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Length\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<multiplicity\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Multiplicity\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<start\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Start\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<end\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<End\>\"", "]"}]}]}], "|>"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"5abcad86-9007-46b3-98d7-782dbb3eeb1a"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"DAG vertices\"\>", "\[Rule]", "12"}], ",", 
   RowBox[{"\<\"length\"\>", "\[Rule]", "5"}], ",", 
   RowBox[{"\<\"multiplicity\"\>", "\[Rule]", "10"}], ",", 
   RowBox[{"\<\"start\"\>", "\[Rule]", 
    RowBox[{"InfraPoint", "[", 
     RowBox[{"{", "1", "}"}], "]"}]}], ",", 
   RowBox[{"\<\"end\"\>", "\[Rule]", 
    RowBox[{"InfraPoint", "[", 
     RowBox[{"{", "31", "}"}], "]"}]}]}], "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2c8fbe8b-a1a3-41b6-b757-ba2a7bdde57f"]
}, Open  ]],

Cell["\<\
Indexing by position gives a measured point. Position 1 is the start and \
carries every geodesic.\
\>", "ExampleText",ExpressionUUID->"f4ff8021-30fc-42b2-a3d8-177355734cf9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"seg", "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", " ", 
     RowBox[{"seg", "[", 
      RowBox[{"[", "3", "]"}], "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"3ef74e06-bd72-4769-bf82-5b436c89eca1"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"InfraPoint", "[", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{"1", "\[Rule]", "10"}], "\[RightAssociation]"}], "]"}], ",", 
   RowBox[{"InfraPoint", "[", 
    RowBox[{"\[LeftAssociation]", 
     RowBox[{
      RowBox[{"9", "\[Rule]", "3"}], ",", 
      RowBox[{"3", "\[Rule]", "6"}], ",", 
      RowBox[{"7", "\[Rule]", "1"}]}], "\[RightAssociation]"}], "]"}]}], 
  "}"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"c15f06a2-51ce-4bdb-9385-2af992bdf563"]
}, Open  ]]
}, Open  ]],

