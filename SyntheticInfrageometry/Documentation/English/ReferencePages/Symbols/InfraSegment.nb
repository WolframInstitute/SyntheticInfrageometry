  }]], "2ColumnTableMod",ExpressionUUID->"ae360693-0376-4193-bdb4-\
5fc1f77ca621"],

Cell[TextData[{
 "On the pool the accessors are sized by the atoms, never by the family: ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1c181bb-e513-4684-a450-97b8237e032d"],
 " is one number per DAG, ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Start\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d12aabf-c98b-4270-af35-94cca4c39e42"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<End\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c83fd303-590a-4775-a944-92fd1a77c4a3"],
 " are the ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSet"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSet", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "38415aab-1443-43cf-aea6-c6086a662c28"],
 " of sources and of sinks, ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f43e6ce7-3e86-4760-8f65-874d7ba20494"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c1841bd-6536-4e55-8222-1d2a313d5e29"],
 " sum the per-atom counts, ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"\"\<Realizations\>\"", ",", " ", "n"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8e84e46-0e30-487b-9c6a-c7ceaec0aae8"],
 " enumerates lazily atom by atom, and ",
 Cell[BoxData[
  RowBox[{"seg", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ad4cedd-570b-49a0-bdda-ae033ab3991f"],
 " is the ",
 StyleBox["i", "TI"],
 "-th layer of every atom weighted by occupation. A 20 \[Times] 20 grid edge \
has about 9 \[Times] 10\:2079 lines through it in two atoms, so nothing here \
enumerates by default."
}], "Notes",ExpressionUUID->"8dfa4401-5fa1-49a7-b310-5f35f3569cad"],

Cell[TextData[{
 "Endpoints are deduplicated. Every geodesic of a family shares them. ",
 Cell[BoxData["InfraPath"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5645bc0-f744-4186-a7d0-57607e12daf7"],
 " keeps endpoint multiplicity instead, because walks can end anywhere."
}], "Notes",ExpressionUUID->"dce1c08b-9ba1-4c0d-8b99-fe64aa115c83"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4ee34b8a-b4fb-44fa-a27c-c9110136d854"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   RowBox[{"p", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d9b71cc-3b06-413d-8a3e-48459e090fe1"],
 " names a segment to be solved for."
}], "Notes",ExpressionUUID->"244a509d-2cb8-414e-8106-88fa9799a6fd"]
}, Open  ]],

