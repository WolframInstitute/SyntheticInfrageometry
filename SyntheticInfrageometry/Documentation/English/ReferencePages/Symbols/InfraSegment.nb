      FontSize->0.9 Inherited,ExpressionUUID->
      "74b3a337-8394-452c-a086-deb5087ed998"],
     ", ",
     Cell[BoxData[
      RowBox[{"[", "\"\<End\>\"", "]"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d6fd4733-f53a-4026-b383-d77560c4f23a"]
    }], "TableText",ExpressionUUID->"534b1321-0fca-4f46-a393-25cb34e49858"], 
    Cell["the endpoints", "TableText",ExpressionUUID->
