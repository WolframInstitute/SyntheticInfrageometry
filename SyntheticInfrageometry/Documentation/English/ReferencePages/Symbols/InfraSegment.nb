Cell["\<\
The vertices of the DAG are the metric interval between the endpoints.\
\>", "ExampleText",ExpressionUUID->"b19888d0-182e-4730-bd2a-ccd4efaf425c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{
      RowBox[{"FindInfraSegment", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}], 
      "[", "\"\<Vertices\>\"", "]"}]}], " ", "===", " ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{"MetricInterval", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8e485370-b4e3-45cf-b985-0cccf2814118"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"39e549e7-a39a-4fdc-9237-c27b9d5db875"]
}, Open  ]],

Cell["\<\
The length of the DAG is the graph distance, and every realisation has it.\
\>", "ExampleText",ExpressionUUID->"fceb3c7b-25f3-4f91-a0fd-d558f085d022"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"seg", "[", "\"\<Length\>\"", "]"}], " ", "===", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], ",", " ", 
     RowBox[{
      RowBox[{"Union", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "#", "]"}], " ", "-", " ", "1"}], " ", "&"}],
         " ", "/@", " ", 
        RowBox[{"seg", "[", "\"\<Realizations\>\"", "]"}]}], "]"}], " ", "===",
       " ", 
      RowBox[{"{", 
       RowBox[{"seg", "[", "\"\<Length\>\"", "]"}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"4f23efb8-159e-47dc-b9bb-6b5a40ac90af"],

