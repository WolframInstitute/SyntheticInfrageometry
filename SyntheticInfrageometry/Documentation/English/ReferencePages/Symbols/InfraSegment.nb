Notebook[{
Cell["InfraSegment", "Title",ExpressionUUID->"80b31240-c3e0-4029-b5a0-8d1a2946692e"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"b4c49a9a-6053-4fb0-8169-0e805029c88b"],

Cell["\<\
InfraSegment[{path}] is the unary form (one geodesic path); \
InfraSegment[{path1, ..., pathk}] is the multi-realisation form. Single-index \
seg[[i]] returns the weighted InfraPoint of the i-th position across \
realisations (mass = multiplicity; i may be negative); First[seg] and \
multi-index seg[[1,1]] keep the realisation-list / first-path meaning. Find* \
finders return a List of unary InfraSegment[{path}] wrappers; wrap that list \
with InfraSegment @ ... to collapse to multi via auto-flatten. Scene-language \
constructor InfraSegment[p, q] is used inside InfraScene. The multi form is \
consumed by InfraSceneHighlight (sequential-edge semantics).\
\>", "Text",ExpressionUUID->"386db461-8a53-407f-9592-8d4efd3164f0"],

Cell["Setup", "Section",ExpressionUUID->"c47c5846-9ce6-49fc-8c1d-aa366a6047ef"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"a43f5144-9517-46b9-9c36-3ce5a036e956"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"4415ae76-e9d0-42d0-bf55-4adf00a666d8"],

Cell["Related Guides", "Section",ExpressionUUID->"596d0231-cca3-4b53-9cf7-5c0c008f40b2"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"144e5013-8690-43e7-9ae2-9a4a18302c33"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"4e28b0bb-35da-4d00-b455-259e708d987b"]
},
