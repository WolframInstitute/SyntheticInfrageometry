     "8eb3a01a-5121-4517-a7b7-6d8c6f64d5d4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "afe27902-b130-4cc1-9cac-aae7ec1c720c"], Cell[TextData[Cell[BoxData[
     RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "e61512b8-1e2a-49bd-84ae-8264fd9eb959"]], "TableText",ExpressionUUID->
     "0e334370-93ec-4381-9a87-6581ab322540"], Cell[
    "the edge count", "TableText",ExpressionUUID->
     "faece41f-4472-4dc9-9cb4-f6304c98f2ea"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "10e0f8cc-33a1-4f3d-96dd-ca5c4ebcc566"], Cell[TextData[Cell[BoxData[
     RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
