     "d5fddaa0-86be-4a9a-bd3a-0c3ee8cf4dd0"]], "TableText",ExpressionUUID->
     "251550eb-90d3-46de-98b9-cd535d7fb313"], Cell[
    "how many geodesics it represents", "TableText",ExpressionUUID->
     "0061981b-fa37-4259-b2cd-f88b11227f5d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "587fe7ff-4892-4d66-9971-bc7a0ebd1ccb"], Cell[TextData[Cell[BoxData[
     RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
