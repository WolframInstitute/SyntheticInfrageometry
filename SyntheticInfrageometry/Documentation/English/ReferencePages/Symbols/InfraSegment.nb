Cell["The DAG is small where the enumeration is large.", "ExampleText",ExpressionUUID->"43ba42ae-f3ef-4639-b245-3ea8c427f92a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<DAG vertices\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"seg", "[", "\"\<Vertices\>\"", "]"}]}]}], ",", " ", 
     RowBox[{"\"\<length\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Length\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<multiplicity\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Multiplicity\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<start\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Start\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<end\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<End\>\"", "]"}]}]}], "|>"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"f724271f-e613-486d-bbad-11f77cc3ff38"],

