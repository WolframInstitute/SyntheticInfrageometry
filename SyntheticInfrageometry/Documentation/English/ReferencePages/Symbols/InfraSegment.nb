Cell[TextData[{
 "Endpoints are deduplicated. Every geodesic of a family shares them. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPath"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPath", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d575a1e4-c53f-4914-b98d-a23524f16d89"],
 " keeps endpoint multiplicity instead, because walks can end anywhere."
}], "Notes",ExpressionUUID->"f51ec259-c4f9-4915-89e0-03c09f2b9bcd"],

