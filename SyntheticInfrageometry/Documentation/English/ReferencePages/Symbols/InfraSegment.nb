Cell["\<\
The pool form: one DAG per pair of ends. Extending an edge of the grid by one \
step on each side gives seven ends pairs, each carrying one geodesic here.\
\>", "ExampleText",ExpressionUUID->"2723e590-9119-49ec-868f-33c1b703076f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pool", " ", "=", " ", 
     RowBox[{"ExtendInfraSegment", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"pool", "[", "\"\<Graph\>\"", "]"}]}], ",", " ", 
     RowBox[{"pool", "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<Start\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<End\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"3f3c216e-2b7d-4810-adfb-b228533c879e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"7", ",", "7", ",", 
   RowBox[{"InfraSet", "[", 
    RowBox[{"{", 
     RowBox[{"2", ",", "5", ",", "10"}], "}"}], "]"}], ",", 
   RowBox[{"InfraSet", "[", 
    RowBox[{"{", 
     RowBox[{"3", ",", "8", ",", "11"}], "}"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"3e7919d9-8bbe-4adb-bd41-60d1da9fec0c"]
}, Open  ]]
}, Open  ]],

