Cell["The DAG is small where the enumeration is large.", "ExampleText",ExpressionUUID->"8477726e-d49d-4ffd-97b3-4755832c1789"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<DAG vertices\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"seg", "[", "\"\<Vertices\>\"", "]"}]}]}], ",", " ", 
     RowBox[{"\"\<length\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Length\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<multiplicity\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Multiplicity\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<start\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<Start\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<end\>\"", " ", "->", " ", 
      RowBox[{"seg", "[", "\"\<End\>\"", "]"}]}]}], "|>"}]}], "]"}]], "Input",\

 CellLabel->"In[2]:= ",ExpressionUUID->"12fd1465-9996-4c51-a6dd-61d3c8938c8f"],

