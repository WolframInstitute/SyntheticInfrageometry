Notebook[{
Cell["InfraSegment", "Title",ExpressionUUID->"63468210-5db7-429b-ba4c-5d0888cd7416"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"7852b075-4d69-45a2-9c41-eed38e64cecd"],

Cell["\<\
InfraSegment[{path}] is the unary form (one geodesic path); \
InfraSegment[{path1, ..., pathk}] is the multi-realisation form. Single-index \
seg[[i]] returns the weighted InfraPoint of the i-th position across \
realisations (mass = multiplicity; i may be negative); First[seg] and \
multi-index seg[[1,1]] keep the realisation-list / first-path meaning. Find* \
finders return a List of unary InfraSegment[{path}] wrappers; wrap that list \
with InfraSegment @ ... to collapse to multi via auto-flatten. Scene-language \
constructor InfraSegment[p, q] is used inside InfraScene. The multi form is \
consumed by InfraSceneHighlight (sequential-edge semantics).\
\>", "Text",ExpressionUUID->"19e04725-ea16-4761-8998-fcb95079e349"],

Cell["Setup", "Section",ExpressionUUID->"3e5d3bb3-bf33-4121-a1b4-36cbae963f39"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"9abaa9e2-62ee-4ed5-98a4-87b388b4f973"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"7ccd43f2-75cd-4e82-a1c1-3f3083ca47db"],

Cell["Related Guides", "Section",ExpressionUUID->"63bfe9fa-0d0f-4f19-af5c-119990faac03"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"e16f2bf3-4681-4326-84ed-ab44d499048e"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"ef6924ee-624e-41bd-a1c0-404fa90b5af8"]
},
