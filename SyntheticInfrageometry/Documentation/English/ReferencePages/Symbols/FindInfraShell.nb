Cell["FindInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9199875c-31f1-44c8-8fe0-1942614f9361"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30f20e7c-28b3-44a0-a3ad-66984108dca1"],
 "\[LineSeparator]",
 "gives the metric shell ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["r", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8492146b-d805-4977-8197-a77e9b9eca35"],
 " around ",
 StyleBox["c", "TI"],
 " as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraShell", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fc9064ca-126c-49bf-aa71-0cb37dd79f68"],
 " wrapper. ",
 StyleBox["r", "TI"],
 " may be a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad0cdecc-22ba-4fb2-be0b-9500905a63b5"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"104f87be-fd14-4be9-995d-7d03ad25f0be"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6dd59a75-aac0-4923-8303-8d31a54f280c"],
 "\[LineSeparator]",
 "gives exactly ",
