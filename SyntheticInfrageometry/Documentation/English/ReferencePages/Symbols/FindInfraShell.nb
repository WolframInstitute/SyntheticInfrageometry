Cell["\<\
Shell cardinality against radius. On both lattices the growth is exactly \
linear \[LongDash] 4r on the square grid, 3r on the hexagonal \[LongDash] \
which is the intrinsic statement that these substrates are two-dimensional.\
\>", "ExampleText",ExpressionUUID->"cb190e41-a69d-4c4e-b1fb-edac634ac8f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], 
           "[", "\"\<Volume\>\"", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8a889ebd-229c-4a58-a4f1-f05ea7ad0106"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
