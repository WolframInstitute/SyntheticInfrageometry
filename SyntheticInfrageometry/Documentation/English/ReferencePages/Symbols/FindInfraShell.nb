Cell["\<\
The ball is the union of the shells up to its radius, so the volumes are the \
partial sums of the areas.\
\>", "ExampleText",ExpressionUUID->"129916af-11c9-4381-b85a-491d05f4f8a1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Hexagonal\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"areas", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], 
         "[", "\"\<Volume\>\"", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"volumes", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"First", " ", "@", " ", 
        RowBox[{
         RowBox[{"FindInfraBall", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], 
         "[", "\"\<Volume\>\"", "]"}]}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Accumulate", "[", "areas", "]"}], " ", "===", " ", "volumes"}]}],
   "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e7ee9fa6-5c89-4071-9a7c-dc83e6fcff54"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1afd20d3-7915-4d49-8770-01829ff6ca0d"]
}, Open  ]]
}, Open  ]],

