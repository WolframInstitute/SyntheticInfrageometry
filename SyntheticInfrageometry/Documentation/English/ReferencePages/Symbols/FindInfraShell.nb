Notebook[{
Cell["FindInfraShell", "Title",ExpressionUUID->"948a8060-0b9e-44c6-9ec6-fbed92e1aea2"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"2c4a094b-f7dd-47bb-90d1-cd2990e5d50a"],

Cell["\<\
FindInfraShell[graph, c, r] returns {InfraShell[{levelSet}]} for the metric \
shell { v : d(c, v) == r }; r may be {rmin, rmax} for a tolerance band. \
FindInfraShell[graph, c, r, n] returns a List of n unary InfraShell[{set}] \
wrappers or $Failed; UpTo[n] returns up to n; All returns all. Options: \
Properties (list of \"Separating\" / \"Connected\"; AND-conjoined filter on \
candidate subsets; empty default returns the level set itself), Method \
(\"Exhaustive\" (default; BFS over the peel-DAG, accepts nested {\"Exhaustive\
\", \"Pruning\" -> spec}) | \"Greedy\" (DFS, one realisation); ignored when \
Properties is empty).\
\>", "Text",ExpressionUUID->"0cf1af9b-057b-4624-8af9-f33a25f3cb7e"],

Cell["Setup", "Section",ExpressionUUID->"945507c7-34a6-49b6-9b00-416c708653fb"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"02b1ec53-4ba5-4dbc-b4d6-38130affe41d"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"139ebe01-6353-4f6e-a6c5-ef772f84ad72"],

Cell["Related Guides", "Section",ExpressionUUID->"b9d56225-ae40-41f3-ba51-6dc7da29e7da"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"23914358-3a0e-413d-b75e-894aa0d0216f"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"78c3643e-0e24-4253-866c-f031404b7799"]
},
