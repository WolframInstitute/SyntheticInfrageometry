Cell["\<\
Shell cardinality against radius. On both lattices the growth is exactly \
linear \[LongDash] 4r on the square grid, 3r on the hexagonal \[LongDash] \
which is the intrinsic statement that these substrates are two-dimensional.\
\>", "ExampleText",ExpressionUUID->"adf1e779-fee1-4dfb-9426-79b280879b99"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"First", " ", "@", " ", 
          RowBox[{
           RowBox[{"FindInfraShell", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "r"}], "]"}], 
           "[", "\"\<Volume\>\"", "]"}]}], ",", " ", 
         RowBox[{"{", 
          RowBox[{"r", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"60eadea7-df20-4fca-b9d5-f56072f1284d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"1", ",", "7", ",", "12", ",", "18", ",", "26", ",", "32"}], 
