Notebook[{
Cell["FindInfraShell", "Title",ExpressionUUID->"76dd0ee4-0d03-471f-ba7b-218fbe592b5d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"27d55bd0-1cbc-4ca0-96b0-3d8b84a01975"],

Cell["\<\
FindInfraShell[graph, c, r] returns {InfraShell[{levelSet}]} for the metric \
shell { v : d(c, v) == r }; r may be {rmin, rmax} for a tolerance band. \
FindInfraShell[graph, c, r, n] returns a List of n unary InfraShell[{set}] \
wrappers or $Failed; UpTo[n] returns up to n; All returns all. Options: \
Properties (list of \"Separating\" / \"Connected\"; AND-conjoined filter on \
candidate subsets; empty default returns the level set itself), Method \
(\"Exhaustive\" (default; BFS over the peel-DAG, accepts nested {\"Exhaustive\
\", \"Pruning\" -> spec}) | \"Greedy\" (DFS, one realisation); ignored when \
Properties is empty).\
\>", "Text",ExpressionUUID->"00212eef-9703-431d-a0f0-a07e6fc8c557"],

Cell["Setup", "Section",ExpressionUUID->"e2f001bb-84f1-4fa4-b3af-3ee68e59d762"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"32c0f2d0-4ba4-442a-bf70-435a51a1339a"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"e5c33de0-15ad-4d34-8bec-8676b3457a0f"],

Cell["Related Guides", "Section",ExpressionUUID->"630ba146-ce7d-40d0-b9a0-cdb4c18480b1"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"629bec4a-9496-43dd-bd89-84910ce59293"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"f0c7b1ad-edb8-4bfc-9076-0be3257851a3"]
},
