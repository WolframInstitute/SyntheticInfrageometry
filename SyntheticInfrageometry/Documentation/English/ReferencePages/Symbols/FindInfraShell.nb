Notebook[{

Cell[CellGroupData[{
Cell["FindInfraShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"302e6fe8-bd59-4abe-a7c9-3059261f16a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f85891f-cc8e-4901-82f8-93bc405274a6"],
 "\[LineSeparator]",
 "gives the metric shell ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cdbee625-0193-4824-927f-ba02f028f1e2"],
 " around ",
 StyleBox["c", "TI"],
 " as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraShell", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c98cc12a-5871-4f81-bda2-0d2b81a6fdbd"],
 " wrapper. ",
 StyleBox["r", "TI"],
 " may be a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "67668e12-2c4a-4987-918a-dc2d8c6f26ed"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ee36f798-8384-4788-b0f1-9251b42c86cf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4f455b0-244f-46c3-85a6-b29b5a59cc92"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " realisations or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84f4bb03-a131-4b67-bedd-c3acbabafb1b"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32664cf2-5be5-4b8e-a9b7-406e7b76c986"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "530d157f-4d3b-42d0-8b5f-5dd891d2702d"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e64dbb32-f040-4ee1-943e-44201da4f65f"],
 " the level set is the one realisation."
}], "Usage",ExpressionUUID->"4bfcd619-1591-4acd-9d30-c948327a2c4f"],

Cell[TextData[{
 "The shell of radius ",
 StyleBox["r", "TI"],
 " about ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db202dd2-6229-4aef-8986-4267e73a71f1"],
 " \[LongDash] the sphere of the graph metric, as a vertex ",
 StyleBox["set",
  FontWeight->"Bold"],
 "."
}], "Notes",ExpressionUUID->"68731361-3d07-4686-b4bf-8968cf58fbd9"],

Cell[TextData[{
 "It is the discrete analogue of a sphere, not of a circle: it is \
codimension-1 as a set, but on a lattice its vertices are pairwise \
non-adjacent, so it carries no cycle. The cyclic object is ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e3ef6039-22ee-4fd2-87c8-a4d58ed19638"],
 ", which needs a thickened band for exactly that reason."
}], "Notes",ExpressionUUID->"3b9d2126-a3df-4465-918e-7a3073a1bdc0"],

Cell[TextData[{
 "The shell is the substrate of the volume-growth invariants. Its cardinality \
as a function of ",
 StyleBox["r", "TI"],
 " is the surface-area profile, and on a flat lattice it grows ",
 StyleBox["linearly",
  FontWeight->"Bold"],
 ", which is the statement that the dimension is 2. The slope is a property \
of the tiling: 4 per step on the square grid, 3 on the hexagonal."
}], "Notes",ExpressionUUID->"0b08be03-f5c5-4fa5-979c-44edcf2a7022"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3e139fd5-f7a7-4c7d-8cfb-de8a993b4085"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95978b3b-2a1e-4b37-9de8-0f2a3a58181e"],
 " (default; the whole level set as one realisation), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d862aefc-be00-40ea-af4a-b4f9c768e658"],
 " (inclusion-minimal subsets separating the centre from beyond), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c5602e84-09bb-4e5b-985d-6796333014f9"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30126842-20d7-43eb-bf91-1487aa3f7093"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe266a0a-3fd0-42f7-abce-c662aa34deed"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a87c5366-7705-4a21-ac8d-30bc840ac802"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "adab7263-7f5c-4213-96e1-e5849632cda6"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "293f750e-43da-4992-a380-5e133f3d6ce6"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9833790a-156b-41fd-b060-4df90d707a45"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3f3f408d-4c6e-4d86-b8ea-da7985b660eb"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8391284-e3a7-44f8-81d2-f7ddc10beaf1"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "defb1b5c-0597-4bde-98c2-3bb94bd85077"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "06cb98b5-ccf1-411c-921d-56f43a4e3eeb"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06a3e21-eca7-45f8-80d5-5111280e5934"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33ab2031-18ab-4ae6-87b3-4ac9de471544"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a78a9d27-401a-4a24-80c9-61e10d4a38dc"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da7cdb58-3adb-4eed-93a1-080b7277c868"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors. The ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Volume\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5bbf02d1-09d4-4e65-a0a3-af2590fa1762"],
 " accessor gives the per-realisation vertex count as a list."
}], "Notes",ExpressionUUID->"c9a564b0-806f-4917-a1bd-ee5055574d83"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"11709af4-b10a-4ae0-9365-5ddc7af6551a"],

