Cell["\<\
Every geodesic between two vertices at distance 6, on the discretized plane, \
the square grid and the hexagonal tiling. The count is the sharpest \
difference between the substrates: the irregular mesh has four, the square \
grid fifteen, the hexagonal tiling three.\
\>", "ExampleText",ExpressionUUID->"97871655-5678-409f-9020-e7b018c2d507"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
         "name", ",", " ", "\"\<Large\>\"", ",", " ", "\"\<Gray\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"segs", " ", "=", " ", 
        RowBox[{"FindInfraSegment", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"segs", " ", "->", " ", "$InfraSegmentColor"}], ",", " ", 
            
            RowBox[{
             RowBox[{"InfraSet", "[", 
              RowBox[{"{", 
               RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
             "$InfraPointColor"}]}], "}"}], ",", "\n", "         ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{"name", " ", "<>", " ", "\"\<: \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"segs", "[", "\"\<Multiplicity\>\"", "]"}], "]"}], " ", "<>",
           " ", "\"\< geodesics\>\""}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3fb2f66e-5483-4b4e-b9c0-cedbe8112d6c"],

