Notebook[{
Cell["FindInfraSegment", "Title",ExpressionUUID->"521bfacf-0809-4a98-9597-ecb88465190f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d8d50202-93aa-4e43-b306-91a7260fd67b"],

Cell["\<\
FindInfraSegment[graph, p1, p2] returns {InfraSegment[{path}]} for one \
geodesic between p1 and p2 (shortest path; geodesic-ness implicit). \
FindInfraSegment[graph, p1, p2, n] / UpTo[n] / All returns up to n unary \
InfraSegment[{path}] wrappers. Endpoints accept InfraPoint[{...}] for \
multi-anchor spread. Options: Properties (AND-conjoined filters on the \
geodesic bundle; supported: {\"EdgeMin\", f}, {\"EdgeMax\", f} with \
user-supplied edge function f[a, b], and {\"LongestPath\", \"Window\" -> k, \
\"Aggregation\" -> \"Lex\" | \"Sum\"}; \"ShortestPath\" is implicit and not a \
valid Property), Method (\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\
\" -> spec}, \"Greedy\").\
\>", "Text",ExpressionUUID->"8ea83866-24d5-46a0-bdc2-2aff1c28b992"],

Cell["Setup", "Section",ExpressionUUID->"7af7395f-ea05-4b43-8dda-6d6ffa5200ea"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"79fe3ab5-95d9-441d-a17e-47adae31c601"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"e8d0287b-bcd0-4baa-85fa-bb11405f61ca"],

Cell["Related Guides", "Section",ExpressionUUID->"5439d9eb-bda8-4aa4-a6ba-ae9575ec3c98"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"c37757d1-0ee4-4c5e-8491-78ef54185def"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"7d73d718-aea9-4e4a-be69-8f6506f9eab9"]
},
