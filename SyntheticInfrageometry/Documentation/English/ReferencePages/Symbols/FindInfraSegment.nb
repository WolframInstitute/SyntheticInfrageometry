Cell["\<\
The intensity in that picture is the multiplicity: an edge lying on many \
geodesics is drawn more strongly than one lying on few, so the bundle shows \
where the segment is concentrated.\
\>", "ExampleText",ExpressionUUID->"325acdf9-f086-45b4-b38e-523eabaf298d"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30177cdc-02cb-4023-85db-eda15b3faf0b"],
 " is the interval DAG, not a list of paths; the count-less call is one \
path."
}], "ExampleText",ExpressionUUID->"9ad67dc4-3df4-4e8f-9760-f7186b007cfd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Head", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
        "]"}]}]}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{
       RowBox[{"FindInfraSegment", "[", 
        RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], 
       "[", "\"\<Realizations\>\"", "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"8ec32d48-dcd6-4c73-8de9-0e51436c5762"],

