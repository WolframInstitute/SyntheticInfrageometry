Notebook[{

Cell[CellGroupData[{
Cell["FindInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"3ab2e9b1-4ab7-4c51-ab2e-bfbe663df724"],
 Cell[BoxData[
  RowBox[{"FindInfraSegment", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a290ac0-f36d-47c6-a966-81b6184df1a3"],
 "\[LineSeparator]",
 "gives one geodesic \[LongDash] a shortest path \[LongDash] from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as an ",
 Cell[BoxData["InfraSegment"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7fe76612-427f-448d-a88f-9596a9cb7c5d"],
 " wrapper.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b96b075d-a593-4424-a940-21f1652464f7"],
 Cell[BoxData[
  RowBox[{"FindInfraSegment", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2dc3d453-184d-4c6b-a546-74cb8041f726"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " geodesics or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8706766-3efc-478c-b879-cec2271efaf3"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e365d7bf-cbf2-4b0b-9bc6-cf2300f22eba"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7f0820aa-f36c-4279-9417-73d7dc394be1"],
 " gives the whole class as the geodesic interval DAG ",
 Cell[BoxData[
  RowBox[{"InfraSegment", "[", 
   StyleBox["dag", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0cef9718-d21e-4f69-81eb-68fe5db486bd"],
 "."
}], "Usage",ExpressionUUID->"1717063b-f67c-4488-a3e1-fa15a3204328"],

Cell[TextData[{
 "A segment from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " is a geodesic: a path whose length realizes ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b1450603-1ce0-42ce-84e7-398005101f3e"],
 "."
}], "Notes",ExpressionUUID->"c2d44d81-1b83-4d41-8997-4fe3b81750a9"],

Cell[TextData[{
 "In the Euclidean plane the segment between two points is unique. On a graph \
it is a ",
 StyleBox["set",
  FontWeight->"Bold"],
 " of paths, and uniqueness fails generically \[LongDash] a square grid has \
many geodesics between two vertices, because any interleaving of the \
horizontal and vertical steps is one."
}], "Notes",ExpressionUUID->"3bbe1e79-db3f-4706-896c-369a121b598d"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4e4c5ec-2b99-4b8d-a9cd-10671a70871a"],
 " returns the geodesic interval DAG rather than an enumeration, because the \
number of geodesics grows combinatorially: it is the compact object that \
represents all of them at once, and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "18176c75-6b65-452d-95b8-efad42b117a2"],
 ", ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2c26887e-257b-42ff-8459-2415609887fc"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5a6f9f30-fa41-4b44-bc0d-22fb7ea373ce"],
 " are read off it without enumerating a path. A bounded count enumerates \
that many geodesics, and the count-less call is one, deterministic."
}], "Notes",ExpressionUUID->"f502168c-2f26-4dfe-b2bd-5e37efb826a3"],

Cell[TextData[{
 Cell[BoxData["UniqueInfraSegmentQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af5327ca-1e91-460a-82e8-3015644d5008"],
 " tests whether the segment is unique, which is the graph-intrinsic shadow \
of Euclid's first postulate holding sharply."
}], "Notes",ExpressionUUID->"7f97c527-651e-4474-96e1-e3a2a150d0d7"],

Cell[TextData[{
 "There is no ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e163a47e-5c43-4a9c-9014-966fa9fa1e04"],
 " option: the symbol is the whole geodesic class, and a rule narrowing it is \
a local law at an infra-scale, which is a ",
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2df8b80d-4e1c-4225-b1ae-ec1bd0362c06"],
 " call. Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d845225-c7a8-430e-a88d-aeaa4794d913"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fbe2e1c-083a-4bd7-93fe-509217a01fee"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "024cfc09-be7f-4a96-bc7e-de385e2b3ff3"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0f03b4e-89e7-468c-8db0-3d37c28e045b"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "88c52a7c-f5ec-47a2-acc7-5f55073bb4dc"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fab66b4b-c653-450e-9e07-86dda1c9cdc5"],
 ". ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71991bc8-f4f1-4c67-ba70-c96a8b6f55ea"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6aba33d4-77a7-42e5-bca1-d14a9374645d"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b3c47266-81ba-4e72-9f5a-35f6acd3b410"],
 ", the DAG; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7a457dc-0d29-467d-8f0b-f04227c7f16f"],
 ", the DAG descended in candidate order \[LongDash] and the class is the \
same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7884e903-2e49-4430-bffa-ea11abdb963c"],
 " descends in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c546dba7-b0e7-417b-9c58-326bb0cceb76"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1d2e217-8d89-4ba0-86b7-98aba780483b"],
 " is accepted and inert, the DAG having no frontier to cap."
}], "Notes",ExpressionUUID->"ff1a1f00-36f6-45b5-92f4-008ae5b67021"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"ab23dc69-25fd-45b7-b09d-02913282ddb3"],

