Notebook[{
Cell["FindInfraSegment", "Title",ExpressionUUID->"3784222b-5f4f-4e5a-9d08-6c5db9596924"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"e7fab050-ddae-47f9-a48d-79e1d8dcb6f0"],

Cell["\<\
FindInfraSegment[graph, p1, p2] returns {InfraSegment[{path}]} for one \
geodesic between p1 and p2 (shortest path; geodesic-ness implicit). \
FindInfraSegment[graph, p1, p2, n] / UpTo[n] / All returns up to n unary \
InfraSegment[{path}] wrappers. Endpoints accept InfraPoint[{...}] for \
multi-anchor spread. Options: Properties (AND-conjoined filters on the \
geodesic bundle; supported: {\"EdgeMin\", f}, {\"EdgeMax\", f} with \
user-supplied edge function f[a, b], and {\"LongestPath\", \"Window\" -> k, \
\"Aggregation\" -> \"Lex\" | \"Sum\"}; \"ShortestPath\" is implicit and not a \
valid Property), Method (\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\
\" -> spec}, \"Greedy\").\
\>", "Text",ExpressionUUID->"3ffcca88-a9d7-48f6-a9d1-6b7a323a31b4"],

Cell["Setup", "Section",ExpressionUUID->"0db7211c-a348-4d4c-ac42-de4c57b0a812"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"3a218e90-7579-40e8-b804-c5d15827a28d"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"dc1e09f7-7c7a-4fc7-b150-dbd437875620"],

Cell["Related Guides", "Section",ExpressionUUID->"052c92f3-5e03-4afa-bb4a-0262e2375724"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"c6d3dc95-d812-4547-acc6-3da9e2cd5eca"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"ca8b0c93-bade-44fd-a5b1-65c6f9464c14"]
},
