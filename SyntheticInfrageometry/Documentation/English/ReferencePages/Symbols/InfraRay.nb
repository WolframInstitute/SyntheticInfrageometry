Notebook[{
Cell["InfraRay", "Title",ExpressionUUID->"6fad6631-4b20-4bc6-9353-3a3ea15d1f6f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c9cb4b03-cce7-42e8-ad4e-6506f48d5669"],

Cell["\<\
InfraRay[{ray}] is the unary form (one pointed half-line from a base vertex \
O); InfraRay[{ray1, ..., rayk}] is the multi-realisation form. Each ray is a \
vertex sequence {O, ..., w} with w an inextensible endpoint. Find* returns a \
List of unary wrappers; wrap with InfraRay @ ... to collapse to multi via \
auto-flatten. Consumed by InfraSceneHighlight (sequential-edge semantics).\
\>", "Text",ExpressionUUID->"a125e9eb-083d-469d-ba19-f84513e76a13"],

Cell["Setup", "Section",ExpressionUUID->"f3964cb9-fde5-43e4-b15d-1706cdc51c0a"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"9afb2a3c-6aa9-4d18-ae06-bfde27784339"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"9c34cf8d-6a94-44dc-9317-44cc845a5f0e"],

Cell["Related Guides", "Section",ExpressionUUID->"148fed47-a6c1-4bb9-9c64-758a90fa5459"],

