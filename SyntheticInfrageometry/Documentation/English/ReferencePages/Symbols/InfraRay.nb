Notebook[{
Cell["InfraRay", "Title",ExpressionUUID->"d42b72f8-7a4e-442c-934e-bf61c3f31bc4"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"1329334e-cfcb-47a0-abc2-c4d43bc9b867"],

Cell["\<\
InfraRay[{ray}] is the unary form (one pointed half-line from a base vertex \
O); InfraRay[{ray1, ..., rayk}] is the multi-realisation form. Each ray is a \
vertex sequence {O, ..., w} with w an inextensible endpoint. Find* returns a \
List of unary wrappers; wrap with InfraRay @ ... to collapse to multi via \
auto-flatten. Consumed by InfraSceneHighlight (sequential-edge semantics).\
\>", "Text",ExpressionUUID->"93f8101c-6c51-4e1f-8311-4094e9db80b5"],

Cell["Setup", "Section",ExpressionUUID->"4cd9799b-c1c7-4dbd-9f1a-3b7f33b104ea"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"98177d01-5ceb-49a9-a7a2-2d3dc0086c6f"],

