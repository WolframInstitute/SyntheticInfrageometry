Cell["InfraRay", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"86b66f42-5739-4fd8-9d9f-7191df07574e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["ray1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["rayk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c6d3214d-e598-4a1e-85ed-7fef03cbcf9f"],
 "\[LineSeparator]",
 "is a bundle of rays, each a geodesic from a base vertex to an endpoint it \
cannot be prolonged past, given as a vertex sequence.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"169ec026-1771-4679-af5f-4a21be0c7e56"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["dagk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac3bda85-6f2c-49dc-8a53-3fd224dd696f"],
 "\[LineSeparator]",
 "is the pool form: one DAG with the base vertex as source per anchor pair, \
whose source-to-sink paths are the rays."
}], "Usage",ExpressionUUID->"864b13b9-4ce7-4ec6-a4c4-7439c13ca575"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a9cd0204-8a45-4567-8d3b-b1e35647df0a"],
 " returns the enumerated form for a bounded count and the pool form for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "50f04521-3ef2-4f71-819e-2b5d5b1b96bb"],
 ". Every ray begins at the base vertex ",
 StyleBox["O", "TI"],
 "; rays to different sinks differ in length, so ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a54a09a4-8e58-406b-be78-919526a24ef8"],
 " on the pool lists one length per ray, read off the sink layers and the \
path counts rather than by enumeration."
}], "Notes",ExpressionUUID->"366b13ce-738d-4d65-9ed8-e06e08c92096"],

