Notebook[{
Cell["FindInfraPoint", "Title",ExpressionUUID->"125a63d1-7352-483f-b39d-f77c0db62ef1"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d2cf8156-9bfa-4073-85d7-64b904987773"],

Cell["\<\
FindInfraPoint[graph] returns one vertex as {InfraPoint[{v}]}. \
FindInfraPoint[graph, n] returns a List of n unary InfraPoint[{v}] wrappers \
or $Failed; UpTo[n] returns up to n; All returns every vertex. Options: \
\"From\", \"Distance\" (d for exactly distance d; {dMin, dMax} for a range, \
Infinity allowed in dMax), \"MaxCliques\".\
\>", "Text",ExpressionUUID->"0a9dcba1-1e85-4103-933e-f11c15decfb4"],

Cell["Setup", "Section",ExpressionUUID->"793302e6-5e2b-4841-bfaf-09a47b21a681"],

