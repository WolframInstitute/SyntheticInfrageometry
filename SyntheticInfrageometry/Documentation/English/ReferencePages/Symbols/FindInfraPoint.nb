Notebook[{
Cell["FindInfraPoint", "Title",ExpressionUUID->"3e620229-f3bb-42b6-a3fe-13397ce85d65"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"5701630f-9381-4722-a4e4-669185393308"],

Cell["\<\
FindInfraPoint[graph] returns one vertex as {InfraPoint[{v}]}. \
FindInfraPoint[graph, n] returns a List of n unary InfraPoint[{v}] wrappers \
or $Failed; UpTo[n] returns up to n; All returns every vertex. Options: \
\"From\" (\"Random\" (default), \"Center\", \"Periphery\", {\"Center\", cap} \
to iterate c -> NeighborhoodGraph[c, GraphCenter[c]] up to cap steps \
(Infinity = uncapped) until it stabilizes or its neighbourhood disconnects, \
anchor -> spec, vertex, list), \"Distance\" (d for exactly distance d; {dMin, \
dMax} for a range, Infinity allowed in dMax; \"Max\" for mutually as far \
apart as possible; \"Spread\" same maximal gap but tie-broken to the most \
equidistant set), \"MaxCliques\".\
\>", "Text",ExpressionUUID->"53927984-3ddb-449c-bc29-cf8d69b96211"],

Cell["Setup", "Section",ExpressionUUID->"f3f7206f-0029-4299-847e-34c3218f401b"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"61bcae42-49e4-4c22-95f1-fb8d8b387043"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"c8635eaf-134a-436b-9740-065a2ecb0bb1"],

