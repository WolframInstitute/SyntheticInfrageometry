Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"868dd74e-e7a4-49bd-b47a-71901990043f"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3487048b-6d4a-441f-bf52-54e4ab89a041"],
 "\[LineSeparator]",
 "gives one point of ",
 StyleBox["g", "TI"],
 ", as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "85dd6dd1-d305-4f68-a3a2-adbb5d44c75c"],
 " atom.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d72bc052-3c2a-47dc-9b7b-fb88047754c1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9de1b7d4-8cf9-4ea8-9759-1ca1d26f3259"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " points, as a list of ",
 StyleBox["n", "TI"],
 " atoms. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "940d3d21-6db9-4462-8715-99c8c6b1c870"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a40bec5a-9595-4430-9e1b-84babf701f57"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "050a3502-f933-4c89-b341-b7a02c37d00e"],
 " gives every vertex of the pool."
}], "Usage",ExpressionUUID->"c7a670d8-64d8-4a1f-b149-d39762afba95"],

Cell[TextData[{
 "Definition: a point of ",
 StyleBox["g", "TI"],
 " drawn from the ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b72a426b-e736-45d2-b802-883812357f47"],
 " candidate pool."
}], "Notes",ExpressionUUID->"7e9e9100-6394-48e1-b200-f413e6b415e2"],

Cell[TextData[{
 "The count always means ",
 StyleBox["how many points you get",
  FontWeight->"Bold"],
 "; the ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6d7a0c8-9bc4-4961-b96e-ba43206b9fff"],
 " option constrains ",
 StyleBox["which",
  FontWeight->"Bold"],
 " ones. With a distance condition the returned list is therefore one \
mutually-constrained tuple \[LongDash] three points pairwise at maximum \
distance is a joint condition, and a plain list of atoms states it without \
ambiguity."
}], "Notes",ExpressionUUID->"89cd873c-b07c-4abe-86f9-4d408fd09935"],

Cell[TextData[{
 "The whole pool as a ",
 StyleBox["region", "TI"],
 " is a coercion, not a return value:"
}], "Notes",ExpressionUUID->"a71cd0d5-c3b8-4c5d-9b64-3eb39e8d64c9"],

