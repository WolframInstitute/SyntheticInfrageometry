Cell[CellGroupData[{
Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"95dcf3d3-1a39-46f9-b8e3-92bc8c055525"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "edcd14c6-02ec-4a91-80ed-7b99627d323c"],
 "\[LineSeparator]",
 "gives the canonical point of ",
 StyleBox["g", "TI"],
 ": every vertex, as one ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bf4840b8-2d30-4adb-8cf9-f4fe53bdbda8"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"421b0414-9ff9-4fb7-95d9-83583a311434"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab4f2af5-ccee-441d-b4e3-21caf9dc35be"],
 "\[LineSeparator]",
 "gives ",
 StyleBox["n", "TI"],
 " mutually constrained points, as a list of ",
 StyleBox["n", "TI"],
 " wrappers. Exactly ",
 StyleBox["n", "TI"],
 " or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ba902f4-b5d4-4557-a646-fd17b32db81a"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02e1737b-f1e2-48db-b8c3-2b24554f78cc"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "21c5745e-6ae7-4dcc-bfcc-df08bbb7cc77"],
 " gives every vertex."
}], "Usage",ExpressionUUID->"143e372f-a096-4ca9-a8c0-dfb54ac031e3"],

Cell[TextData[{
 "Definition: with no condition imposed, a point of ",
 StyleBox["g", "TI"],
 " is the whole vertex set, held as one candidate family."
}], "Notes",ExpressionUUID->"c49f07ba-6e8d-4f28-9312-b0175dbcb6bf"],

Cell["\<\
That is the honest answer to \"give me a point\". It is a starting object, \
not a placeholder. Constraints then narrow it.\
\>", "Notes",ExpressionUUID->"179c57f3-566f-497a-89bb-33ffd01d5d99"],

Cell["The two forms return different shapes, on purpose.", "Notes",ExpressionUUID->"f2cfd821-ef03-47f6-a818-00c99d652aff"],

Cell[TextData[{
 "One point is ",
 StyleBox["one wrapper",
  FontWeight->"Bold"],
 " with many realisations."
}], "Notes",ExpressionUUID->"f47bb86a-13c8-4b30-a518-e42a0ffd5645"],

Cell[TextData[{
 StyleBox["n", "TI"],
 " points is a ",
 StyleBox["list of n wrappers",
  FontWeight->"Bold"],
 "."
}], "Notes",ExpressionUUID->"c2354cc2-1023-44a7-a4da-784dd26ee73d"],

Cell["\<\
The list is needed because the points constrain each other. Three points \
pairwise at maximum distance is a joint condition. One wrapper could not say \
which realisations go together.\
\>", "Notes",ExpressionUUID->"0439a43f-1ee0-4956-b62d-edfe8985e4cb"],

Cell["Options:", "Notes",ExpressionUUID->"87c9554b-b07e-4cf5-99bd-66b3dc8bb813"],

