Cell["\<\
One point is an atom; the calling triple gives a list of them.\
\>", "ExampleText",ExpressionUUID->"e4bd5338-f2d7-40d4-85d9-34be862268eb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"FindInfraPoint", "[", "g", "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All"}], "]"}]}], ",", " ", 
     RowBox[{"VertexCount", "[", "g", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"3f355dca-798c-4bd5-9c4b-012b4bc25f32"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"61", ",", "313", ",", "313"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e2da67a3-45a3-46ae-a918-5883d1443250"]
}, Open  ]],

Cell[TextData[{
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b151c78c-5a3e-426c-8237-941647c289f5"],
 " selects the metrically special vertices. Here the centre is one vertex and \
the periphery is many."
}], "ExampleText",ExpressionUUID->"6ffc43d0-556c-43c6-8fe5-3d0989368676"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<centre\>\"", " ", "->", " ", 
      RowBox[{"FindInfraPoint", "[", 
       RowBox[{"g", ",", " ", "All", ",", " ", 
        RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], "]"}]}],
      ",", "\n", "    ", 
     RowBox[{"\"\<periphery count\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"FindInfraPoint", "[", 
        RowBox[{"g", ",", " ", "All", ",", " ", 
         RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c10adae0-2877-4cc5-99f3-e436f5d90cc3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"centre\"\>", "\[Rule]", 
    RowBox[{"{", "1", "}"}]}], ",", 
   RowBox[{"\<\"periphery count\"\>", "\[Rule]", "48"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"27ba5e01-bb32-4cee-a07e-7507ce075d3e"]
}, Open  ]],

Cell["\<\
Centre and periphery drawn together. The periphery of a patch is its rim.\
\>", "ExampleText",ExpressionUUID->"f924b969-7a39-4083-94b1-d0815f32704f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", "\"\<Gray\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSceneHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSet", " ", "@", " ", 
         RowBox[{"FindInfraPoint", "[", 
          RowBox[{"g", ",", " ", "All", ",", " ", 
           RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Periphery\>\""}]}], 
          "]"}]}], " ", "->", " ", "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"InfraSet", " ", "@", " ", 
         RowBox[{"FindInfraPoint", "[", 
          RowBox[{"g", ",", " ", "All", ",", " ", 
           RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<Center\>\""}]}], 
          "]"}]}], " ", "->", " ", "$InfraPointColor"}]}], "}"}], ",", "\n", 
     "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "16"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
      "\n", "    ", 
     RowBox[{"ImageSize", " ", "->", " ", "340"}]}], "]"}]}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"bb1043a6-121e-4a86-b50e-528c655d4d12"],

