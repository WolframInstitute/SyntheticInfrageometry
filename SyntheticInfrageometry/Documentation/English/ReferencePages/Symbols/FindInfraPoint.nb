Cell["FindInfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2d28424a-eea1-48df-91ab-100f389a6446"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["graph", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5d939f6d-9d29-4b83-aeb9-c0e5d3f5f219"],
 "\[LineSeparator]",
 "returns THE canonical point: the whole candidate pool in superposition, \
InfraPoint[pool].",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fb8a98cd-5924-492c-83b1-51991ae7c8a6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b5eda655-1d25-4588-b7ed-a953f5b24e42"],
 "\[LineSeparator]",
 "returns a tuple of n mutually-constrained points as a List of unary \
wrappers, exactly n or $Failed; UpTo[n] returns up to n; All returns every \
vertex."
}], "Usage",ExpressionUUID->"ffbabf46-fad9-45af-8b35-350fbbfb9880"],

