Cell["\<\
A tuple of three mutually most-distant points comes back as three atoms.\
\>", "ExampleText",ExpressionUUID->"8cd5cc9f-1ff8-4de4-9d76-b82ca7d2eb7f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"FindInfraPoint", "[", 
      RowBox[{"g", ",", " ", "3", ",", " ", 
       RowBox[{"\"\<Distance\>\"", " ", "->", " ", "\"\<Max\>\""}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<count\>\"", " ", "->", " ", 
      RowBox[{"Length", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"\"\<vertices\>\"", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", "\"\<Vertex\>\"", "]"}], " ", "&"}], " ", "/@", 
        " ", "t"}], ")"}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[5]:= ",ExpressionUUID->"d7097958-0c95-46cd-85e3-40823eec1992"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"count\"\>", "\[Rule]", "3"}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"273", "[", "\<\"Vertex\"\>", "]"}], ",", 
      RowBox[{"299", "[", "\<\"Vertex\"\>", "]"}], ",", 
      RowBox[{"363", "[", "\<\"Vertex\"\>", "]"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[5]= ",ExpressionUUID->"902979d1-3065-4303-ab02-4da187a323c7"]
}, Open  ]]
}, Open  ]],

