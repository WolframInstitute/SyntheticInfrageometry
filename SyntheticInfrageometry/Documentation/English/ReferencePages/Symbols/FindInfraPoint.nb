Cell[TextData[{
 Cell[BoxData["\"\<Center\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8bdee525-1bbd-4058-8a6e-747fb6745dfd"],
 " and ",
 Cell[BoxData["\"\<Periphery\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72ee828d-e521-4f59-aa75-4a23aacea3ae"],
 " are meant in the graph-eccentricity sense. ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81b70972-10cb-446b-a4c3-a17a72dd1743"],
 " imposes a mutual-distance condition on a tuple."
}], "Notes",ExpressionUUID->"0ba7eb98-fbaf-4453-93c0-53fb42df22af"],

Cell[TextData[{
 "To keep a whole construction interior, not just its anchors, cut the \
substrate with ",
 Cell[BoxData[
  RowBox[{"CenterGraph", "[", 
   RowBox[{"g", ",", " ", "q"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5334b7f2-43f5-4378-91b5-71b81ce0778c"],
 " (from the Infrageometry paclet) and work on that graph: it is the ball of \
radius ",
 Cell[BoxData[
  RowBox[{"Floor", "[", 
   RowBox[{"q", " ", 
    RowBox[{"GraphRadius", "[", "g", "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab268cba-6bd5-4213-98fa-7e4df86d218d"],
 " about ",
 Cell[BoxData[
  RowBox[{"GraphCenter", "[", "g", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "26291ff5-6f5b-4e56-826b-b76fbb4caaa9"],
 ", carrying the same vertex labels and coordinates, so the result draws on \
the original. Restricting ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1403b9d6-cb2e-4479-9d2b-ffd769437a8a"],
 " alone pins only the anchors; a construction with slack spends it outward."
}], "Notes",ExpressionUUID->"7f5692a7-963a-4671-bc53-9e6de102344a"],

Cell[TextData[{
 "To narrow a bundle you already hold, use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SelectInfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/SelectInfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "66b98e5e-ae0e-438e-97c2-87fe1ede8b0f"],
 ". It takes the same ",
 Cell[BoxData["\"\<From\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "de7c9bb6-2986-4696-a973-7cb6b47fd795"],
 " and ",
 Cell[BoxData["\"\<Distance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "970b7a0e-648e-466f-82fe-243c981f05bc"],
 " vocabulary on a supplied vertex set."
}], "Notes",ExpressionUUID->"ea1f9e0f-ac08-4aeb-bd3d-23ad8062f926"],

Cell[TextData[{
 "The draw is random: seed with ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "33b44f69-9876-4872-a907-94a7b2c901ab"],
 " before the first call if you need a reproducible figure."
}], "Notes",ExpressionUUID->"942631f4-d6de-4870-a665-42343992ea2a"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"c27f3f1c-92de-46ce-8874-ae861d0f38d9"],

