Notebook[{
Cell["FindInfraLinearCombination", "Title",ExpressionUUID->"4d158794-706a-4cdd-a6bd-6b755847c8cf"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"14640125-8538-4035-927b-4e1793d4e765"],

Cell["\<\
FindInfraLinearCombination[graph, o, {{lambda1, u1}, {lambda2, u2}, ...}] \
returns a List of unary InfraPoint[{v}] wrappers for the multi-valued vertex \
realisation of sum_i lambda_i u_i with base point o, computed as \
scaled-then-pairwise-summed left-to-right. With n / UpTo[n] / All controls \
multiplicity. Options: \"ScaleMethod\" (Automatic (default), \"Metric\", \
\"Line\", \"Midpoint\"); \"SumMethod\" (\"Metric\" (default), \"Parallel\").\
\>", "Text",ExpressionUUID->"f5f2779d-49ff-490c-a727-13d136234383"],

Cell["Setup", "Section",ExpressionUUID->"4e049716-8e11-4f3c-b114-b107af9e56b5"],

