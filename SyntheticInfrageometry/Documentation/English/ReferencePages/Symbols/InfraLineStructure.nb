Notebook[{
Cell["InfraLineStructure", "Title",ExpressionUUID->"782c4393-b844-49f3-bf24-a4316cd80a48"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"b8adeec4-9924-497c-ad50-f607a248a6fd"],

Cell["\<\
InfraLineStructure[{line1, ..., linek}] is a consistent geodesic path system, \
stored as its maximal lines (the structure's realisations). Accessors: \
[\"Lines\"] / [\"Realizations\"] the maximal lines, [\"First\"] / [[i]] one \
line, [\"Length\"] per-line edge counts; [\"Paths\"] the unfolded association \
<|{u,v} -> P(u,v)|>, [\"Incidence\"] the transpose <|v -> {line numbers}|>, [\
\"Coordinates\"] <|v -> {{line, offset}}|> (offset = edges from the line \
start), and [\"Path\", u, v] recovers P(u,v) oriented u -> v.\
\>", "Text",ExpressionUUID->"7a726b24-702d-4bdb-bfae-622c36e8382d"],

Cell["Setup", "Section",ExpressionUUID->"9f39cdaa-b7b1-49b2-a8a1-b250a64ccef9"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"600f4365-7830-49f2-b12e-2adcaff4a749"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"5dc40abf-d8fb-4eaf-bc18-38047c4c2744"],

Cell["Related Guides", "Section",ExpressionUUID->"413c387e-d130-43b3-ab5c-e3b4fc7a7155"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"af635c49-3060-48e4-85ae-92c61b075b1d"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"26166061-e86a-4bcc-bef9-3515e6ef9e4c"]
},
