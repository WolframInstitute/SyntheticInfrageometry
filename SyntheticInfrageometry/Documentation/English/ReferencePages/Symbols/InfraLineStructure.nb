Notebook[{
Cell["InfraLineStructure", "Title",ExpressionUUID->"5b1ae960-50f8-4f04-9568-ace77dc63b74"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"a80335ae-c7b2-4308-9394-079177f3bb0c"],

Cell["\<\
InfraLineStructure[{line1, ..., linek}] is a consistent geodesic path system, \
stored as its maximal lines (the structure's realisations). Accessors: \
[\"Lines\"] / [\"Realizations\"] the maximal lines, [\"First\"] / [[i]] one \
line, [\"Length\"] per-line edge counts; [\"Paths\"] the unfolded association \
<|{u,v} -> P(u,v)|>, [\"Incidence\"] the transpose <|v -> {line numbers}|>, [\
\"Coordinates\"] <|v -> {{line, offset}}|> (offset = edges from the line \
start), and [\"Path\", u, v] recovers P(u,v) oriented u -> v.\
\>", "Text",ExpressionUUID->"e319a0c9-15bd-40a0-99b3-8338b3bd89e5"],

Cell["Setup", "Section",ExpressionUUID->"6659c10b-cf2a-430a-91dc-8407aba686b4"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"3849c80f-9e7c-4fcb-b8b9-167cb04d3849"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"2b74c3c5-45f2-4a34-a75c-936029c451a7"],

Cell["Related Guides", "Section",ExpressionUUID->"a66b7cc0-dfed-40b4-ad8d-b98f3062d5f5"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"35d94cc5-0d36-415e-af05-a9f7dda5b722"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"e4fbdfa0-b14f-476a-92ca-ae65f065f0a0"]
},
