Notebook[{
Cell["ComparisonTriangle", "Title",ExpressionUUID->"5db53b5c-9aa1-44a1-aa24-bbc987533889"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"4a8746ca-300e-41d9-a7da-311d7e266f7f"],

Cell["\<\
ComparisonTriangle[a, b, c] returns the Wolfram Triangle in R^2 with side \
lengths {a, b, c} (a opposite p, b opposite q, c opposite r). \
ComparisonTriangle[a, b, c, \"Curvature\" -> k] for k != 0 returns \
InfraComparisonTriangle[<|\"Sides\" -> ..., \"Curvature\" -> k, \"Angles\" -> \
{alpha_p, alpha_q, alpha_r}|>] in M_k^2. ComparisonTriangle[graph, p, q, r, \
\"Curvature\" -> k] reads the side lengths from the graph.\
\>", "Text",ExpressionUUID->"8c7013e6-c27a-4dff-8f54-2d7f9094ac61"],

Cell["Setup", "Section",ExpressionUUID->"04d37e54-9c2f-4161-a3c0-40944cccad6c"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"56d6ee24-3e11-4552-ac25-37f3929055e6"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"0d06b655-0ea4-43f8-87b4-baf9fd6fe591"],

Cell["Related Guides", "Section",ExpressionUUID->"98e3f6e3-386b-40ab-bbba-fcce2a7df8f2"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"4cba8f8e-34e8-4c96-af06-b95bcd666ddc"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"2047ca83-358f-476e-b7a8-44fa643358ee"]
},
