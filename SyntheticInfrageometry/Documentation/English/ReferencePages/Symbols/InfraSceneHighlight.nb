Cell[TextData[{
 "The same bundle at three opacity settings. ",
 Cell[BoxData["None"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6bc7ff2-57cb-4731-9583-bb8b25ca9a06"],
 " draws every geodesic alike. A wider envelope exaggerates the contrast."
}], "ExampleText",ExpressionUUID->"1da69141-3051-42af-980e-2905a8e118df"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"ExampleGraphData", "[", 
           RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}], ",",
           " ", 
          RowBox[{"Sequence", " ", "@@", " ", 
           RowBox[{"AmbientGraphStyle", "[", "\"\<Gray\>\"", "]"}]}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"FindInfraSegment", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
             "]"}], " ", "->", " ", "$InfraSegmentColor"}], "}"}], ",", "\n", 
          "         ", 
          RowBox[{"\"\<OpacityRange\>\"", " ", "->", " ", "spec"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "240"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{"ToString", "[", "spec", "]"}], "]"}]}], "]"}]}], "]"}], ",",
     "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{"None", ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.4", ",", " ", "1."}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"0.05", ",", " ", "1."}], "}"}]}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"105713ad-9e7f-42f7-9f79-a1da23d3514f"],

