    StyleBox["g", "TI"], ",", " ", 
    StyleBox["obj", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "811e4e82-34c0-456b-b26f-21b1163377f5"],
 "\[LineSeparator]",
 "draws a single object."
}], "Usage",ExpressionUUID->"276e5564-8fd2-44c4-a673-55a99c4fedcb"],

Cell["\<\
This is the only rendering primitive in the paclet. Every viewer and every \
figure calls it.\
\>", "Notes",ExpressionUUID->"9b60c403-5468-4765-bde4-a86b29da7cfa"],

Cell["\<\
The principle is diffuse rendering. A construction is a family, not a choice. \
So the picture shows the whole family, and multiplicity sets the intensity. \
An edge on many geodesics is drawn strongly. An edge on few is drawn faintly. \
No single realisation is privileged.\
\>", "Notes",ExpressionUUID->"37c2b11d-d989-4f3c-8cb0-3f62012f2d8a"],

Cell[TextData[{
 "Objects are given as ",
 Cell[BoxData[
  RowBox[{"obj", " ", "->", " ", "style"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6660c4c-dcc5-4ed6-9f81-80cb86230498"],
 " entries. With no style, the colour comes from the wrapper head via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["$InfraPalette"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/$InfraPalette", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "159a8162-fdda-49a7-8e6f-1c6f0f74f2e6"],
 ": points red, segments orange, circles teal, and so on."
}], "Notes",ExpressionUUID->"8585eadf-4c1e-4c22-9aa7-abc0dc3f8b37"],

Cell["Options:", "Notes",ExpressionUUID->"5a80b38a-00c1-4a71-9acf-9b92fb1cb555"],

