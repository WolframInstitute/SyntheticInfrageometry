Notebook[{
Cell["GeodesicSprayGraph", "Title",ExpressionUUID->"e169dd28-8d84-4266-8220-9f6d4bb24ea0"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"054947b1-4c9e-46ce-9167-60b321e1c4f4"],

Cell["\<\
GeodesicSprayGraph[graph, c] returns the BFS DAG rooted at c: a directed \
graph with edge u -> v whenever d(c, v) = d(c, u) + 1 and u-v is an edge of \
graph. Sinks are peripheral vertices reachable from c; directed paths c -> \
sink are exactly the maximal geodesics from c. GeodesicSprayGraph[graph, \
InfraPoint[{c1, ..., ck}]] uses multi-source BFS. GeodesicSprayGraph[graph, \
pairs] returns the union of geodesics between the listed vertex pairs. \
Options: \"AxisLength\" (truncate the source-spray DAG at depth k; default \
All), \"PathThickness\" (per-pair Hausdorff threshold; 0 keeps one geodesic \
per pair, Infinity keeps all), \"Directed\".\
\>", "Text",ExpressionUUID->"dab4c072-f4af-4a3d-9e20-b963a71b7937"],

Cell["Setup", "Section",ExpressionUUID->"a73d7f1f-d1c8-4772-bc07-9c4bf74ef2c8"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"980778fd-3580-4c39-b327-9cfbe70ba061"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"06ba3c53-ece6-4f31-a0c8-49888de76421"],

Cell["Related Guides", "Section",ExpressionUUID->"8d8db50c-a16c-450e-81b2-a5cdaaf2397f"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"59a4b833-141a-4a27-ad33-43fc164ca7e6"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"fcbb4340-e622-496b-8667-db07ffcf2e9a"]
},
