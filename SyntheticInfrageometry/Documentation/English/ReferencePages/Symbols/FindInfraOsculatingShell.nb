Notebook[{
Cell["FindInfraOsculatingShell", "Title",ExpressionUUID->"1051809a-4775-4cbd-ae5d-d29c0ab7dc75"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"f2c9d2b0-b7b5-4326-b2e5-7c4d715a7b6d"],

Cell["\<\
FindInfraOsculatingShell[graph, path, i, k] returns InfraShell[{set}] for the \
smallest-radius osculating shell at the k-vertex window centered on \
path[[i]]: the level set { v : d(c, v) == r } around an osculating center c \
equidistant from every window-vertex with common distance r. \
FindInfraOsculatingShell[graph, path, i, k, n] returns up to n shells sorted \
by ascending radius (one shell per osculating center), with UpTo[n] / All for \
the full calling triple. path may be a vertex list or an InfraPath wrapper \
(multi-realisation paths are spread and unioned). Forwards Properties / \
Method options to FindInfraShell.\
\>", "Text",ExpressionUUID->"5d2ffcdf-a013-4776-abd0-becdfcefd340"],

Cell["Setup", "Section",ExpressionUUID->"43095471-de52-4ed7-8e7c-3c9262e2ba77"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"9fdc0f7c-275d-4c0f-94af-eaa82848d7d7"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"7ada7dd7-437d-468d-a1c3-622d168a8201"],

Cell["Related Guides", "Section",ExpressionUUID->"5a8e402a-b3c7-4ade-85ca-68092b2611a5"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"c68af0bd-c06c-405a-8689-25b3e3c4a44e"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"e4477227-6459-4bb8-8556-4f8765c6f4b9"]
