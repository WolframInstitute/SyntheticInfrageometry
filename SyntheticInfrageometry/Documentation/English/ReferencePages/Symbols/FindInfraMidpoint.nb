Notebook[{
Cell["FindInfraMidpoint", "Title",ExpressionUUID->"241b6412-b49b-4f8a-8579-04d7e07c7931"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"db56870d-5408-47a9-b03d-976ca770a1e0"],

Cell["\<\
FindInfraMidpoint[graph, InfraSegment[{walks}]] returns one InfraPoint: the \
vertices at the index/indices closest to each walk's centre (n+1)/2, unioned \
over the walks (a single vertex when d(p1, p2) is even, a two-vertex \
mesopoint when odd). FindInfraMidpoint[graph, walk] is the bare-walk \
shortcut. FindInfraMidpoint[graph, p1, p2] unions over every geodesic. \
Options: Method (\"Metric\" (default) | \"Embedding\" (single nearest vertex \
to the coord-space midpoint, with sub-options \"Coordinates\" and \"Pool\")), \
\"Tolerance\" (0 (default); widens the band beyond the closest index by that \
many graph-distance units).\
\>", "Text",ExpressionUUID->"06f08433-18de-4ed5-91fd-798f491df917"],

Cell["Setup", "Section",ExpressionUUID->"699b3c02-7aac-4b9b-846d-0f7bb43de50e"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"9d36b858-5b67-4995-9621-8dd57a55e125"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"24ce84ca-9e49-40c4-941e-8c57c63dc8f7"],

Cell["Related Guides", "Section",ExpressionUUID->"33bb5c38-75ac-4cae-b8a5-fdd2fe9710fc"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"65ab0c74-8f2d-4a38-9a1c-04f10fd9a57e"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"6d77fcd5-9570-446d-9d6e-c18e39cd4035"]
},
