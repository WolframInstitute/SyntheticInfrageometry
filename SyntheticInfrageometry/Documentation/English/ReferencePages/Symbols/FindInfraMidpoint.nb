Notebook[{

Cell[CellGroupData[{
Cell["FindInfraMidpoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2b4c3328-645a-4512-a413-b55b5cdbbc93"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraMidpoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f12e533-776c-4893-9d20-3b06ecee908a"],
 "\[LineSeparator]",
 "gives the midpoint vertices of ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " in the graph ",
 StyleBox["g", "TI"],
 ", unioned over every geodesic between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"d9cea251-0929-4972-ab26-9a6bd4861906"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraMidpoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"{", 
      StyleBox["walks", "TI"], "}"}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cff7a23-a60d-4478-9024-d3f87db4b799"],
 "\[LineSeparator]",
 "uses the supplied walks instead of all geodesics."
}], "Usage",ExpressionUUID->"af94c93d-54c9-4a99-8a31-3d05e273295a"],

Cell[TextData[{
 "A midpoint of ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " is a vertex ",
 StyleBox["m", "TI"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["m", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["m", "TI"], ",", 
      StyleBox["b", "TI"]}], ")"}], "\[LongEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      StyleBox["a", "TI"], ",", 
      StyleBox["b", "TI"]}], ")"}], "/", "2"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "af71c4ca-8063-4b3a-94f7-a1e1902e6a10"],
 "."
}], "Notes",ExpressionUUID->"528c5445-ff16-4d07-b378-e46ad7ed7a24"],

Cell[TextData[{
 "On a graph the midpoint is a ",
 StyleBox["set",
  FontWeight->"Bold"],
 ", not a point. Distinct geodesics from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " put their centre at different vertices, and every one of them is \
returned."
}], "Notes",ExpressionUUID->"1f5b9375-fcc9-4512-92fc-a3a507b070cc"],

Cell[TextData[{
 "At odd ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     StyleBox["a", "TI"], ",", 
     StyleBox["b", "TI"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b4dff3f6-1570-42b2-a7db-124cb92da154"],
 " no vertex lies at half the distance. The two central vertices of each \
geodesic are returned instead."
}], "Notes",ExpressionUUID->"9e0a4be7-aab2-4551-81ce-09f31265e09e"],

Cell[TextData[{
 "The result is the density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5164bcbd-7e14-465b-b34b-3c17dd0329c4"],
 " of candidates, ",
 StyleBox["m", "TI"],
 " counting the geodesics centred at ",
 StyleBox["v", "TI"],
 "; dividing by ",
 Cell[BoxData["Total"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9120d3d7-9cf7-485f-8ed0-b805ebd9b9cb"],
 " gives the fraction centred at each vertex."
}], "Notes",ExpressionUUID->"c91cf412-7f48-42e9-bc4b-7a4499c9cbc6"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "657acf05-673f-4215-9f95-3d2128cc11d9"],
 " takes ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ea46247-d545-4225-b183-e3376cb17026"],
 " (default), which reads the graph distance, or ",
 Cell[BoxData["\"\<Embedding\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "32f77cc7-71fe-451e-b32a-291ba1878e6d"],
 ", which ranks candidates by an embedding of the geodesic bundle."
}], "Notes",ExpressionUUID->"c55fc29d-1583-4983-87c0-e55bed909b0e"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"89a48f6a-7399-4846-afb6-a017fe77b44c"],

