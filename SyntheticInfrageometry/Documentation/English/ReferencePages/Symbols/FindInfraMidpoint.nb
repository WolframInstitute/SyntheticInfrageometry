Cell["\<\
On the square grid the geodesics between the two vertices are centred on \
three different vertices. The measure records what fraction of them chooses \
each.\
\>", "ExampleText",ExpressionUUID->"8cf1f4d6-ddb2-4100-bab7-ebf2ad3062ba"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Large\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"InfraMeasure", " ", "@", " ", 
     RowBox[{"FindInfraMidpoint", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"a3747a88-ae3a-461d-904d-2481c99199b3"],

Cell[BoxData[
 RowBox[{"InfraMeasure", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"8", "\[Rule]", "3"}], ",", 
    RowBox[{"10", "\[Rule]", "9"}], ",", 
    RowBox[{"21", "\[Rule]", "3"}]}], "}"}], "]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"d5be7e2b-ee84-4497-881a-bacd3226ec7c"]
}, Open  ]],

Cell["\<\
At odd distance no vertex sits halfway, and the central pair of each geodesic \
is returned instead.\
\>", "ExampleText",ExpressionUUID->"a3012f2b-248a-4c7d-bec5-1bded4b755d6"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
