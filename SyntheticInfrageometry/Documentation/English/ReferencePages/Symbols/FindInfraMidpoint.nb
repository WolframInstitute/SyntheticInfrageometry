Notebook[{

Cell[CellGroupData[{
Cell["FindInfraMidpoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"48bf1508-ab97-45ec-b653-b20cdd410fde"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraMidpoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e4d46f27-0967-4780-ba56-e49c657c24f6"],
 "\[LineSeparator]",
 "gives the midpoint vertices of ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " in the graph ",
 StyleBox["g", "TI"],
 ", unioned over every geodesic between them.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"6a03e48e-f84e-4ac3-8471-61ef544960f6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraMidpoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"InfraSegment", "[", 
     RowBox[{"{", 
      StyleBox["walks", "TI"], "}"}], "]"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6885ca00-c9d6-4599-a336-c9e388bfc1a6"],
 "\[LineSeparator]",
 "uses the supplied walks instead of all geodesics."
}], "Usage",ExpressionUUID->"1ee0e76c-66c6-4f9d-b27d-a82544c5fcd1"],

Cell[TextData[{
 "A midpoint of ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " is a vertex ",
 StyleBox["m", "TI"],
 " with ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["m", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["m", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "/", "2"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4218f18e-8897-4a70-9373-3fc017373ff1"],
 "."
}], "Notes",ExpressionUUID->"32847a64-c210-46ee-9cca-f137633b6e1b"],

Cell[TextData[{
 "On a graph the midpoint is a ",
 StyleBox["set",
  FontWeight->"Bold"],
 ", not a point. Distinct geodesics from ",
 StyleBox["a", "TI"],
 " to ",
 StyleBox["b", "TI"],
 " put their centre at different vertices, and every one of them is \
returned."
}], "Notes",ExpressionUUID->"1c237c91-a1c9-4fe4-942f-82285a56bef0"],

Cell[TextData[{
 "At odd ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["a", "TI"], ",", 
    StyleBox["b", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e455521e-002f-446b-be76-40f67822937f"],
 " no vertex lies at half the distance. The two central vertices of each \
geodesic are returned instead \[LongDash] a mesopoint."
}], "Notes",ExpressionUUID->"34d2a2f6-0abb-4f77-a48e-3c69d54c93d1"],

Cell[TextData[{
 "The result is an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "69012c3e-eed5-49bc-b999-4053c446a764"],
 " carrying the multiplicity of each candidate. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasure"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasure", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "230fcfdc-13c5-43fe-b7d6-1c800dafd624"],
 " gives the normalized measure: the fraction of geodesics centred at each \
vertex."
}], "Notes",ExpressionUUID->"6a84b5cc-0941-47d4-9d6d-e4adecebdc07"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93061eeb-1b2b-4119-ac41-923bf744d125"],
 " takes ",
 Cell[BoxData["\"\<Metric\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0eb3b486-3508-4fd4-b0b0-75d1a98b1840"],
 " (default), which reads the graph distance, or ",
 Cell[BoxData["\"\<Embedding\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f30cffb-66b1-40a4-bb4b-019ec5b18876"],
 ", which ranks candidates by an embedding of the geodesic bundle."
}], "Notes",ExpressionUUID->"85fe7116-5b49-47d5-9813-471c0645944c"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"2cac3b10-7300-4d27-83d2-45f2998d7f08"],

