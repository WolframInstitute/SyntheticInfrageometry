Cell["\<\
On the square grid the geodesics between the two vertices are centred on \
three different vertices. The measure records what fraction of them chooses \
each.\
\>", "ExampleText",ExpressionUUID->"cce760de-18ea-4ec9-8a23-4e04df9d0b0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Large\>\""}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Normal", " ", "@", " ", 
    RowBox[{"InfraMeasure", " ", "@", " ", 
     RowBox[{"FindInfraMidpoint", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}]}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"6fc38591-9050-4cb9-8c79-d353b5952a11"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"8", "\[Rule]", 
    FractionBox["1", "5"]}], ",", 
   RowBox[{"10", "\[Rule]", 
    FractionBox["3", "5"]}], ",", 
   RowBox[{"21", "\[Rule]", 
    FractionBox["1", "5"]}]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"de7c10a0-cd10-47e8-83d3-2c899776c854"]
}, Open  ]],

Cell["\<\
At odd distance no vertex sits halfway, and the central pair of each geodesic \
is returned instead.\
\>", "ExampleText",ExpressionUUID->"f2db5379-67a1-4a3c-a265-6b43f137c8be"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
