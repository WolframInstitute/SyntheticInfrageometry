Cell["\<\
The midpoint of two vertices at distance 6, on the discretized plane, the \
square grid and the hexagonal tiling. The count differs with the substrate: \
one midpoint on the irregular mesh, three on the square grid, two on the \
hexagonal tiling.\
\>", "ExampleText",ExpressionUUID->"cc982e39-5639-4d50-ba91-36fa9dbeed01"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"ExampleGraphData", "[", 
           RowBox[{"name", ",", " ", "\"\<Large\>\""}], "]"}], ",", " ", 
          RowBox[{"Sequence", " ", "@@", " ", 
           RowBox[{"AmbientGraphStyle", "[", "\"\<Gray\>\"", "]"}]}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"FindInfraMidpoint", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", 
      "\n", "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraSegment", "[", 
              RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
              "]"}], " ", "->", " ", "$InfraSegmentColor"}], ",", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"InfraPoint", "[", 
              RowBox[{"{", 
               RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
             "$InfraPointColor"}], ",", "\n", "          ", 
            RowBox[{
             RowBox[{"InfraPoint", "[", 
              RowBox[{"m", "[", "\"\<Realizations\>\"", "]"}], "]"}], " ", "->",
              " ", "$InfraCircleColor"}]}], "}"}], ",", "\n", "         ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "17"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{"name", " ", "<>", " ", "\"\<: \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", " ", "@", " ", 
            RowBox[{"m", "[", "\"\<Realizations\>\"", "]"}]}], "]"}], " ", "<>",
           " ", "\"\< midpoints\>\""}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0dfbbbc1-dbb8-49b7-b268-ea5d3025973c"],

