Cell["\<\
The midpoint of two vertices at distance 6, on the discretized plane, the \
square grid and the hexagonal tiling. The count differs with the substrate: \
one midpoint on the irregular mesh, three on the square grid, two on the \
hexagonal tiling.\
\>", "ExampleText",ExpressionUUID->"9fd92c13-f4a5-44ba-a4dd-825d0f93ff7e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
         "name", ",", " ", "\"\<Large\>\"", ",", " ", "\"\<Gray\>\"", ",", 
          " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"m", " ", "=", " ", 
        RowBox[{"FindInfraMidpoint", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", 
      "\n", "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraSegment", "[", 
              RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
              "]"}], " ", "->", " ", "$InfraSegmentColor"}], ",", "\n", 
            "          ", 
            RowBox[{
             RowBox[{"InfraSet", "[", 
              RowBox[{"{", 
               RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
             "$InfraPointColor"}], ",", "\n", "          ", 
            RowBox[{
             RowBox[{"InfraPoint", "[", 
              RowBox[{"m", "[", "\"\<Realizations\>\"", "]"}], "]"}], " ", "->",
              " ", "$InfraCircleColor"}]}], "}"}], ",", "\n", "         ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "17"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{"name", " ", "<>", " ", "\"\<: \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Length", " ", "@", " ", 
            RowBox[{"m", "[", "\"\<Realizations\>\"", "]"}]}], "]"}], " ", "<>",
           " ", "\"\< midpoints\>\""}], "]"}]}], "]"}]}], "]"}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"74995486-497f-45ac-a736-c6ec6cd1d9b3"],

