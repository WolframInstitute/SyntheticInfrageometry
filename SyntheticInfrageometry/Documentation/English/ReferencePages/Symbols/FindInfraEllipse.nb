Notebook[{
Cell["FindInfraEllipse", "Title",ExpressionUUID->"128cd6b5-206c-4220-8e5a-9a760b086a4a"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"be7eaec8-dd66-4691-9f8b-19efbfdf1c6b"],

Cell["\<\
FindInfraEllipse[graph, {p1, p2}, c] returns {InfraEllipse[{cycle}]} for the \
shortest separating cycle in the level-surface subgraph { v : cMin <= d(p1,v) \
+ d(p2,v) <= cMax }, as an open vertex sequence (c may be scalar or {cMin, \
cMax}; sparse level sets usually require a range). FindInfraEllipse[graph, \
{p1, p2}, c, n] returns a List of n unary InfraEllipse[{cycle}] wrappers or \
$Failed (cycles sorted by length ascending); UpTo[n] returns up to n; All \
returns all. Options: Properties (default {\"Separating\"}; cycle disconnects \
{sum < cMin} from {sum > cMax}; {} permits any cycle in the level surface), \
Method (\"Peel\" (default; BFS peel-DAG on the level-set vertices, robust on \
sparse level sets) | \"Exhaustive\" (FindCycle + filter + length sort, \
accepts nested {\"Exhaustive\", \"Pruning\" -> spec}) | \"Greedy\" (first \
admissible cycle by length, one realisation)).\
\>", "Text",ExpressionUUID->"19ccb122-a3fd-47f7-85d1-f82ce03b2c32"],

Cell["Setup", "Section",ExpressionUUID->"b27f1c81-b2ba-4c41-a721-574be2adaa30"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"45cd6369-105e-41a2-862a-a0fa9132d2a3"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"3838f07e-e571-4e94-8464-ddec8523547a"],

Cell["Related Guides", "Section",ExpressionUUID->"5d29b42d-9e5f-4d05-ace7-943e0f79b463"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"520dc211-347b-4d8c-89b0-b778b72655b7"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"94de61b0-b4cc-438f-a748-2b26afcc6f4b"]
},
