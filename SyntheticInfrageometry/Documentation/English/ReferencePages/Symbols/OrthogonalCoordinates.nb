Notebook[{
Cell["OrthogonalCoordinates", "Title",ExpressionUUID->"c646da64-3fb7-4ab7-bb31-66a431f5ba5d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"1b8e71af-9b46-4d0a-94c6-b7f9b87d56e1"],

Cell["\<\
OrthogonalCoordinates[graph, c, {a1, a2, ...}, v] returns the Z-valued \
displacement of v on each axis ai through the centre c; \
OrthogonalCoordinates[graph, c, {a1, a2, ...}] returns the Association for \
all vertices. Centre c is a vertex or InfraPoint; each axis ai is an \
InfraSegment, InfraLine, or vertex sequence. Option \"SelectCoordinate\" \
(projection-tie reducer applied to the shifted tied list ix_v - k: \"Centered\
\" (default; 0 if 0 in shifted, else Round[Median]), Min, Max, Mean, Median, \
All, or any user function).\
\>", "Text",ExpressionUUID->"b4053393-4935-4f81-9183-7e14b14230d6"],

Cell["Setup", "Section",ExpressionUUID->"276d8dad-a37f-409a-a9fd-3c1d9e6bc6c3"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"ac07e72d-90ba-47fa-b68b-87151b623afc"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"47b9b247-7bc5-4bd8-ab2c-bf92741463ef"],

Cell["Related Guides", "Section",ExpressionUUID->"8b528347-8412-4e46-b6e6-540a2968f3f9"],

