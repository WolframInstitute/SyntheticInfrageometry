Notebook[{
Cell["FindLineHull", "Title",ExpressionUUID->"e729af0d-1b02-4807-859b-d1c00c253c62"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"0f63f0e9-2d6e-43b3-92f5-fde51f69f05a"],

Cell["\<\
FindLineHull[graph, S] returns the smallest superset of S closed under the \
line operator (the maximal geodesics through each pair), as a sorted vertex \
list. Option \"LineStructure\" (None (default), or an InfraLineStructure / \
list of lines) closes under that fixed line family instead of all maximal \
geodesics.\
\>", "Text",ExpressionUUID->"6896a574-b8ee-4d66-b444-fd34f6a19c42"],

Cell["Setup", "Section",ExpressionUUID->"c38010e2-e8a8-4998-a7cf-bf8939533914"],

