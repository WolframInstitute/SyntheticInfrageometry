Notebook[{
Cell["FindLineHull", "Title",ExpressionUUID->"047026c0-8be5-4d6a-9cf6-b06a284af591"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"31a8f139-3742-4705-8435-a1d26ab9971b"],

Cell["\<\
FindLineHull[graph, S] returns the smallest superset of S closed under the \
line operator (the maximal geodesics through each pair), as an InfraSet. S is \
any Infra* object, a list of them, or a bare vertex list. Option \
\"LineStructure\" (None (default), or an InfraLineStructure / list of lines) \
closes under that fixed line family instead of all maximal geodesics.\
\>", "Text",ExpressionUUID->"437dc503-70fe-4c81-a151-ff83a745297d"],

Cell["Setup", "Section",ExpressionUUID->"2a3dd98c-3e4f-4ee2-8952-8e56445cddd8"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"3fda7ed0-d3e9-4354-a51d-abeb45935895"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"6c86c4db-0502-4938-a608-5a445b486322"],

Cell["Related Guides", "Section",ExpressionUUID->"cdc5939f-69bc-4d93-a151-7d96cadeed17"],

Cell["MetricAlgebraGuide", "Item",ExpressionUUID->"aeebe6fd-e499-45fb-bf50-4520c27fbde7"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"8ff00f78-20d5-4206-af09-2e391fad3ca7"]
