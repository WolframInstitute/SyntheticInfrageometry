Notebook[{
Cell["FindInfraEquidistantSet", "Title",ExpressionUUID->"375a7ea7-4c73-4398-8cd3-cd23f3cd0e70"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"9c4580bd-49da-4d4c-837e-c50f73b2a04d"],

Cell["\<\
FindInfraEquidistantSet[graph, {p1, ..., pn}] returns the equidistant set {v \
: d(p1, v) == ... == d(pn, v)} as an InfraSet, the intersection of the n-1 \
consecutive perpendicular bisectors. FindInfraEquidistantSet[graph, {p1, ..., \
pn}, {lo, hi}] thickens each consecutive bisector to the slab lo <= d(p_i, v) \
- d(p_{i+1}, v) <= hi.\
\>", "Text",ExpressionUUID->"866efc20-d868-44a3-b60d-4bba189eeaf1"],

Cell["Setup", "Section",ExpressionUUID->"72a98a0b-f9a9-4cfa-8b46-0d0ce62e5897"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"fe41f5f3-c60d-4d09-87fa-cd8556314592"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"e8113be8-b75a-481a-bec1-f1b34cfc2ecc"],

Cell["Related Guides", "Section",ExpressionUUID->"dfeef162-ecf8-4408-a009-d2b8790054a2"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"bee64f0c-87b3-44eb-a86c-14aec5062f2c"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"c5b6a0cd-9b41-4847-960d-72eb7a78ee4c"]
},
