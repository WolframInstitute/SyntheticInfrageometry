Notebook[{
Cell["FindInfraCommonLine", "Title",ExpressionUUID->"6ebe0af2-9597-40b2-9cad-eb78c9304dd1"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"38ba292d-65bb-4156-bf3d-389847f55197"],

Cell["\<\
FindInfraCommonLine[graph, vertices] returns a List of unary \
InfraLine[{line}] wrappers for the canonical lines containing every listed \
vertex, or $Failed. With n / UpTo[n] / All controls multiplicity. Entries may \
be bare vertices or InfraPoint / InfraSegment / InfraLine / InfraRay wrappers.\
\>", "Text",ExpressionUUID->"59e2ec48-93d6-4d0a-9d68-4f1484fe7184"],

