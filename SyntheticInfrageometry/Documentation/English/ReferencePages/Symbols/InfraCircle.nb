Notebook[{

Cell[CellGroupData[{
Cell["InfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"74687cb3-c078-4be3-82a3-fccf3a8cc789"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    StyleBox["cycle", "TI"], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bba39ff7-5efe-4a53-9d65-40777aedeb1b"],
 "\[LineSeparator]",
 "is a circle given by one cycle.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5d1072cb-35b2-45e0-8a17-2b7d6f3dcfb4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["cycle1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["cyclek", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0a595331-6c26-407d-ae6b-646fbdd77092"],
 "\[LineSeparator]",
 "is a circle given by several."
}], "Usage",ExpressionUUID->"34217400-87c8-44a1-ad47-f444b458501e"],

Cell["\<\
Definition: an infra-circle is a simple cycle lying in a level surface of the \
metric.\
\>", "Notes",ExpressionUUID->"08bfc77f-3198-41c7-84ff-4aac69140803"],

Cell[TextData[{
 "A realisation is an ",
 StyleBox["open",
  FontWeight->"Bold"],
 " vertex sequence. The edge from the last vertex back to the first is \
implicit."
}], "Notes",ExpressionUUID->"46739f41-ebc9-492b-b99b-99681cd05035"],

Cell[TextData[{
 "So a circle of ",
 StyleBox["k", "TI"],
 " vertices has ",
 StyleBox["k", "TI"],
 " edges. ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a9c92816-f8dd-4a5c-99c8-330c3f259306"],
 " gives the edge count per realisation, as a list, and it equals the vertex \
count. For a path wrapper such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "dc1ab4ef-1842-4444-9659-ba67b843d5f8"],
 " the edge count is one less than the vertex count. That is the difference \
between a cycle wrapper and a path wrapper."
}], "Notes",ExpressionUUID->"0bc97cd2-569a-4275-a1ee-c4597f46f8d3"],

Cell[TextData[{
 "A cycle is always connected. This is why ",
 Cell[BoxData["\"\<Connected\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b30acad-c358-4f1d-ae27-4bf8e0e592ed"],
 " is not an admissible property on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5d681fa2-dda6-439c-88b8-3ac2bebe2e29"],
 "."
}], "Notes",ExpressionUUID->"45184b3f-e4bc-47da-8d35-3a80271c0438"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraShell", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c2787f73-e956-4b57-bd8a-28614c63bbf1"],
 " is the set-shaped companion. The shell is the level surface itself. The \
circle is a cycle inside it. On a lattice the shell has no cycle at all, so \
the circle is empty until the radius is widened to a band."
}], "Notes",ExpressionUUID->"b1374fe1-79f5-4f71-9053-e60c582af721"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneHighlight"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSceneHighlight", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "f6a9f8a7-baaf-4cb0-b903-eb39490a26d8"],
 " draws the multi form with sequential edges and closes it automatically. \
Passing an already-closed sequence is harmless: the closure is not doubled."
}], "Notes",ExpressionUUID->"6ee163cf-1f22-44f8-b88c-bfbb1c9746a2"],

Cell[TextData[{
 "For homotopy the wrapper coerces to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraString"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraString", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "ef01c467-b747-4d8e-921a-223704bc211d"],
 ", a closed walk taken modulo rotation, since a circle has no base point."
}], "Notes",ExpressionUUID->"ce719540-7685-4b2c-996b-d106de3aa79c"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d2aeb519-2df3-4ea2-b957-a9badb236cc7"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"center", ",", " ", "radius"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "880e0385-9a8f-499b-9ef5-8bd868ece758"],
 " names a circle to be solved for."
}], "Notes",ExpressionUUID->"03d07d09-1614-4d24-915e-b2b14d25b636"]
}, Open  ]],

