Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SubsetQ", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"First", " ", "@", " ", 
