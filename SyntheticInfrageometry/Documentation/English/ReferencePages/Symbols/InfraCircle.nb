Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SubsetQ", "[", 
    RowBox[{
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraShell", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}], ",", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraCircle", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}]}], "]"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b58e6016-e807-464b-ab47-759be8abb134"],

