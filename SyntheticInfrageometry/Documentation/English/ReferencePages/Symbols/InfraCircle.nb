Notebook[{

Cell[CellGroupData[{
Cell["InfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"319663e2-5281-4e0d-9bda-f4adf67cf67d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    StyleBox["cycle", "TI"], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6ce7e08-6fcc-4497-8e42-1da3ce5fffd6"],
 "\[LineSeparator]",
 "is a circle given by one cycle.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"18d44847-d011-4d7c-a8cb-61b7769daf42"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["cycle1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["cyclek", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c65c393e-0a24-4cc6-8f6a-ad2b01cfcd97"],
 "\[LineSeparator]",
 "is a circle given by several."
}], "Usage",ExpressionUUID->"95ff34d6-8b62-4cf2-b344-74e17b4becf5"],

Cell["\<\
Definition: an infra-circle is a simple cycle lying in a level surface of the \
metric.\
\>", "Notes",ExpressionUUID->"72fa14b2-e976-49a3-baeb-589da8467cd1"],

Cell[TextData[{
 "A realisation is an ",
 StyleBox["open",
  FontWeight->"Bold"],
 " vertex sequence. The edge from the last vertex back to the first is \
implicit."
}], "Notes",ExpressionUUID->"d97f371d-a806-4484-a1dc-b801e4513ca2"],

Cell[TextData[{
 "So a circle of ",
 StyleBox["k", "TI"],
 " vertices has ",
 StyleBox["k", "TI"],
 " edges. ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "10c55e07-7182-4ca9-b8ed-a5042dac66b6"],
 " gives the edge count per realisation, as a list, and it equals the vertex \
count. For a path wrapper such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "668f4681-84d8-4ba5-ab23-f60ae8df1098"],
 " the edge count is one less than the vertex count. That is the difference \
between a cycle wrapper and a path wrapper."
}], "Notes",ExpressionUUID->"25da4892-d0b6-4c6c-93cc-c4bc027ce9d6"],

Cell[TextData[{
 "A cycle is always connected. This is why ",
 Cell[BoxData["\"\<Connected\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e432f22b-5018-41f7-b9fe-ff090b23abd9"],
 " is not an admissible property on ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2a9c253d-87d4-46d9-9834-4550a4a4ca79"],
 "."
}], "Notes",ExpressionUUID->"eaeb2dc2-5d5b-4fdd-a412-4e121d17e032"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraShell"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraShell", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "a2d8806b-4fff-4cd8-83f2-9830c52cdd2d"],
 " is the set-shaped companion. The shell is the level surface itself. The \
circle is a cycle inside it. On a lattice the shell has no cycle at all, so \
the circle is empty until the radius is widened to a band."
}], "Notes",ExpressionUUID->"fcfc3faf-a636-4010-b870-5fc6e7e2793d"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneHighlight"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSceneHighlight", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "23854c1b-82cf-43e2-95bd-39df448662fe"],
 " draws the multi form with sequential edges and closes it automatically. \
Passing an already-closed sequence is harmless: the closure is not doubled."
}], "Notes",ExpressionUUID->"6737afdf-577f-40c9-ad8c-1ebfcd8fc219"],

Cell["\<\
For homotopy a circle is read as a free loop \[LongDash] a closed walk taken \
modulo rotation \[LongDash] since it has no base point.\
\>", "Notes",ExpressionUUID->"5764d05a-23cd-4c2a-b862-6afa946a5aee"],

Cell[TextData[{
 "Inside an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScene"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScene", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "20e97f69-b11a-4d9c-a011-ee72c9efc546"],
 ", ",
 Cell[BoxData[
  RowBox[{"InfraCircle", "[", 
   RowBox[{"center", ",", " ", "radius"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ff9900e-d63b-4743-9798-f4e7c4bc7f4a"],
 " names a circle to be solved for."
}], "Notes",ExpressionUUID->"864c7b34-eb85-43d6-b674-d3bb08efccfb"]
}, Open  ]],

