Cell[TextData[{
 "The circle of a square grid at band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fc5365d8-0fbc-4bd3-a526-9adffe1b32ed"],
 ". Its length equals its vertex count, because the closure is implicit."
}], "ExampleText",ExpressionUUID->"2fdc757d-f75a-4617-9f2d-e67718c587b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
       " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"circ", " ", "=", " ", 
     RowBox[{"FindInfraCircle", "[", 
      RowBox[{"g", ",", " ", "c", ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<realisations\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", "circ"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<length (edges)\>\"", " ", "->", " ", 
      RowBox[{"circ", "[", "\"\<Length\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<vertices in first\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", "circ"}]}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"73542105-9367-40d7-b627-cbd0f5ef963b"],

