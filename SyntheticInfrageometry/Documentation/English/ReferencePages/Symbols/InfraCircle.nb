Notebook[{
Cell["InfraCircle", "Title",ExpressionUUID->"9bc3f40b-ab70-4d94-80de-c506d175b239"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"15d7a116-f16d-4490-a577-b9c171f2381f"],

Cell["\<\
InfraCircle[{cycle}] is the unary form; InfraCircle[{cycle1, ..., cyclek}] is \
the multi-realisation form. Find* returns a List of unary wrappers; wrap with \
InfraCircle @ ... to collapse to multi via auto-flatten. Scene-language \
constructor InfraCircle[center, radius] is used inside InfraScene. The multi \
form is consumed by InfraSceneHighlight (sequential edges with auto-closure).\
\
\>", "Text",ExpressionUUID->"b993ad49-f97e-49c8-adf9-3abe67e79273"],

Cell["Setup", "Section",ExpressionUUID->"18fb4c13-e427-4743-bee1-08f8c74896bd"],

