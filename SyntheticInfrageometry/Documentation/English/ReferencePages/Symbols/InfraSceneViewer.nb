Notebook[{
Cell["InfraSceneViewer", "Title",ExpressionUUID->"32ffb898-5936-4b01-ac7b-11828425be13"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c1f5238e-bffd-471d-a142-a6aa9ffa045f"],

Cell["\<\
InfraSceneViewer[scene, graph] is an interactive visualisation of an \
InfraScene on a graph; an optional third Association of pre-fixed bindings is \
supported. Controls: step arrows, \"Branch\"/\"Diffuse\" mode setter, and (in \
Branch mode) branch arrows.\
\>", "Text",ExpressionUUID->"8018f0ad-caa0-4d1f-b16d-1fce06d4fd20"],

