Cell[TextData[{
 "Build a scene and open the viewer on it. The result is a ",
 Cell[BoxData["Manipulate"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "81ceb0aa-fa49-45b9-94f0-11cfb9e4b22b"],
 "."
}], "ExampleText",ExpressionUUID->"8ac632d6-7c5f-475b-b69b-da8a4c05e66a"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"a", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"b", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"cA", ",", " ", "cB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"Head", " ", "@", " ", 
    RowBox[{"InfraSceneViewer", "[", 
     RowBox[{"scene", ",", " ", "g"}], "]"}]}]}], "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d1f9aa52-a31c-4e8d-9c04-9e986a9586d4"],

Cell[BoxData["DynamicModule"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"61805973-4314-4104-87f7-e7af8ac7a77d"]
}, Open  ]],

Cell["\<\
The first three steps as stills: the two points, then the circle about the \
first. This is what the viewer shows as you step, drawn without the interface.\
\>", "ExampleText",ExpressionUUID->"f4e0461d-44c1-425c-8551-665af2c6ba8f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{"a", ",", " ", "b", ",", " ", "cA"}], "]"}], ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"ExampleGraphData", "[", 
        RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Medium\>\""}], "]"}], ",", 
       " ", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"AmbientGraphStyle", "[", "\"\<Gray\>\"", "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Row", "[", 
    RowBox[{"{", "\n", "    ", 
     RowBox[{
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"InfraPoint", "[", 
             RowBox[{"{", 
              RowBox[{"p1", ",", " ", "p2"}], "}"}], "]"}], " ", "->", " ", 
            "$InfraPointColor"}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "18"}], ",", "\n",
           "        ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Text", "[", "\"\<points a and b\>\"", "]"}]}], "]"}], ",", 
      "\n", "    ", 
      RowBox[{"Labeled", "[", "\n", "      ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "        ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraCircle", "[", 
              RowBox[{"g", ",", " ", "p1", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}], " ", "->", " ", 
             "$InfraCircleColor"}], ",", "\n", "         ", 
            RowBox[{
             RowBox[{"InfraPoint", "[", 
              RowBox[{"{", 
               RowBox[{"p1", ",", " ", "p2"}], "}"}], "]"}], " ", "->", " ", 
             "$InfraPointColor"}]}], "}"}], ",", "\n", "        ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "18"}], ",", "\n",
           "        ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", " ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "      ", 
        RowBox[{"Text", "[", "\"\<circle around a\>\"", "]"}]}], "]"}]}], 
