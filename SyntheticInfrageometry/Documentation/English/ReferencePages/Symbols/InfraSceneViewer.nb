Cell[TextData[{
 "Definition: the viewer solves the scene one step at a time and draws the \
objects bound so far, through ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSceneHighlight"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSceneHighlight", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4959968f-05b8-4d5a-8bf5-75a7b0b97e1c"],
 "."
}], "Notes",ExpressionUUID->"2627070d-e497-49d6-ab57-1a319ce4b3cb"],

Cell["\<\
It exists because a construction is a sequence, not a picture. Reading Euclid \
I.10 as a single figure hides the order; stepping it shows which object each \
later one depends on.\
\>", "Notes",ExpressionUUID->"83e547df-fea5-485a-b04f-8063b6b96446"],

Cell["Controls, in two rows.", "Notes",ExpressionUUID->"f46f76af-6cbc-4b1d-9915-3805087a94c5"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "020f87b5-f555-443e-af1b-d78ebe9e3ff9"], Cell["Control", "TableText",
     FontWeight->Bold,ExpressionUUID->"d527e1ec-1b5e-43cd-b734-033e40b708e5"],
     Cell["Does", "TableText",
     FontWeight->Bold,ExpressionUUID->"6ac9ff8a-f2eb-41d6-84b4-a4ece6173eb7"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
