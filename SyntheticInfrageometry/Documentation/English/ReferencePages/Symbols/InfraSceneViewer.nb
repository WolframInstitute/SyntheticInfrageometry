    "step arrows, label menu", "TableText",ExpressionUUID->
     "3f85d7bc-888a-4e0c-b01d-5cce2ef138db"], Cell[
    "move between construction steps", "TableText",ExpressionUUID->
     "1b24d879-80a9-43c7-85f8-520d7f069d74"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "adc4eec0-5e14-4c0c-98d4-4ba502653701"], Cell[
    "eye", "TableText",ExpressionUUID->
     "4039f82e-8c25-4133-b515-945ec5f6db4c"], Cell[
    "hide or show the current step's object", "TableText",ExpressionUUID->
     "8160fd69-a574-4d48-ad17-c0a3e268fd76"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5a6413cd-fa24-4bec-8947-a05cdf600824"], Cell[
    "Branch / Diffuse", "TableText",ExpressionUUID->
     "04f8700c-b833-49c9-9141-2fd6ea2baa70"], Cell[
    "show one realisation, or all of them overlaid", "TableText",
     ExpressionUUID->"a5848ad5-fa57-4c41-9420-8210df133611"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "d22bed95-1852-4285-9d41-2b344cd1650d"], Cell[
