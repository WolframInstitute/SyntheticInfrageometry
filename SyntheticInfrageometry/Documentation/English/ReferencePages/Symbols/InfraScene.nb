Cell["\<\
The same construction on a square grid finds nothing, because there the two \
circles do not meet.\
\>", "ExampleText",ExpressionUUID->"56854fdb-3cae-49c6-ade0-0841698f8942"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"Intersection", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Union", " ", "@@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "p1", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}], ",", "\n", 
      "    ", 
      RowBox[{"Union", " ", "@@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "p2", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"bfd74d9b-c980-48c7-b11e-82bc3a878d25"],

