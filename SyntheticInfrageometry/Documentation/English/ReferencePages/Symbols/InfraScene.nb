                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
