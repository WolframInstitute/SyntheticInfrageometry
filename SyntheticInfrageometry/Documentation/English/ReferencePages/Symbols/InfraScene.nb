Cell["\<\
The opening of Euclid I.10: two points, a circle about each, and the vertices \
where the circles meet. On the discretized plane this succeeds.\
\>", "ExampleText",ExpressionUUID->"bfba185c-01bd-433e-b2e9-6aa6b40aabb4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"a", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cB", " ", "==", " ", 
             RowBox[{"InfraCircle", "[", 
              RowBox[{"b", ",", " ", 
               RowBox[{"{", 
                RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}], "}"}], ",", 
           " ", "\"\<circle around b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"u", " ", "==", " ", 
             RowBox[{"InfraIntersection", "[", 
              RowBox[{"cA", ",", " ", "cB"}], "]"}]}], "}"}], ",", 
           " ", "\"\<they meet\>\""}], "]"}]}], "}"}]}], "]"}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<objects\>\"", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Objects\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<labels\>\"", " ", "->", " ", 
      RowBox[{"scene", "[", "\"\<Labels\>\"", "]"}]}]}], "|>"}]}], 
  "]"}]}], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c6b6520d-8f9d-44ac-9cda-539de93d809d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"objects\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "cA", ",", "cB", ",", "u"}], "}"}]}], ",", 
   RowBox[{"\<\"labels\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"\<\"point a\"\>", ",", "\<\"point b\"\>", 
      ",", "\<\"circle around a\"\>", ",", "\<\"circle around b\"\>", 
      ",", "\<\"they meet\"\>"}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"cc70c13b-44b7-432c-b85c-7b2dc8673dfe"]
}, Open  ]],

Cell["\<\
Solving it. The third argument is the step to solve up to, and the last step \
binds every object.\
\>", "ExampleText",ExpressionUUID->"534b455c-859b-4b91-b69f-11bbba6be236"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"scene", " ", "=", " ", 
     RowBox[{"InfraScene", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"a", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p1", "]"}]}], "}"}], ",", 
           " ", "\"\<point a\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"b", " ", "==", " ", 
             RowBox[{"InfraPoint", "[", "p2", "]"}]}], "}"}], ",", 
           " ", "\"\<point b\>\""}], "]"}], ",", "\n", "      ", 
         RowBox[{"InfraGeometricStep", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"cA", " ", "==", " ", 
