Cell["\<\
The same construction on a square grid finds nothing, because there the two \
circles do not meet.\
\>", "ExampleText",ExpressionUUID->"a5161add-5075-4e1b-92c5-83685e75fde7"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", 
   RowBox[{
   "a", ",", " ", "b", ",", " ", "cA", ",", " ", "cB", ",", " ", "u"}], "]"}],
   ";"}], "\n", 
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p2", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"g", ",", " ", "p1", ",", " ", "#"}], "]"}], " ", "==", " ",
          "8"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"Length", " ", "@", " ", 
    RowBox[{"Intersection", "[", "\n", "    ", 
     RowBox[{
      RowBox[{"Union", " ", "@@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "p1", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}], ",", "\n", 
      "    ", 
      RowBox[{"Union", " ", "@@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "p2", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}]}]}]}], "]"}]}]}], 
  "]"}]}], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8957af6a-023f-41dd-b988-696aa237c3e3"],

Cell[BoxData["0"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"e7bca60e-4e45-44ca-9b32-f7c1b9f4ceda"]
