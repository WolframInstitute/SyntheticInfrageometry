Notebook[{
Cell["HomotopicQ", "Title",ExpressionUUID->"c74002b4-cdc0-471a-a4f0-6e551bb92c44"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"08bf2632-adf5-446f-9690-c37a80479f76"],

Cell["\<\
HomotopicQ[graph, a, b] tests whether a and b are in the same homotopy class. \
a and b must share a wrapper head (InfraPath / InfraLoop / InfraString; \
InfraCircle coerces to InfraString). Spreads over multi-realisation inputs as \
a Cartesian-AllTrue conjunction. Inherits FindInfraHomotopy options.\
\>", "Text",ExpressionUUID->"9de7396a-71ba-48f9-a9e8-d63755b74714"],

Cell["Setup", "Section",ExpressionUUID->"6939fdab-accb-4e23-9815-38b367a6b1be"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"72a315d8-bdb8-4b59-87ad-a68497cec199"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"fcc4a20a-1af4-4cca-8f31-b8298c441a75"],

