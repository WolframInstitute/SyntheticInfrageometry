Notebook[{
Cell["FindInfraHomotopyRepresentativeHomotopy", "Title",ExpressionUUID->"888104f8-7395-47bd-92ca-bacfa66399a4"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"51c4c428-690d-467e-8e0c-d26d6a2bd7c7"],

Cell["\<\
FindInfraHomotopyRepresentativeHomotopy[graph, obj] returns \
{InfraHomotopy[{chain}]} for one reduction chain {obj, ..., m} of elementary \
moves ending at a representative m. \
FindInfraHomotopyRepresentativeHomotopy[graph, obj, n] / UpTo[n] / All \
controls multiplicity. Same options as FindInfraHomotopyRepresentative.\
\>", "Text",ExpressionUUID->"3283387c-eded-43a7-9789-f84005beb497"],

