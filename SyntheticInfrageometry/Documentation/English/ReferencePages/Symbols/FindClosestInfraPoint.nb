Notebook[{
Cell["FindClosestInfraPoint", "Title",ExpressionUUID->"df1597d4-2cad-433e-9600-f159da48a3b5"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d220de9a-3c5f-4173-8538-cb79173cf6c1"],

Cell["\<\
FindClosestInfraPoint[graph, line, point] returns a List of unary \
InfraPoint[{v}] wrappers for the vertices on line at minimum graph distance \
from point (metric argmin). FindClosestInfraPoint[graph, line, point, n] / \
UpTo[n] / All controls multiplicity. line accepts a bare vertex sequence or \
InfraSegment / InfraLine / InfraPath / InfraRay wrapper; point accepts a bare \
vertex or InfraPoint[{...}]; multi-realisation wrappers spread Cartesian. \
Distinct from FindInfraPerpendicular, which runs the synthetic Euclid I.12 \
foot construction.\
\>", "Text",ExpressionUUID->"780a2c42-ea21-47a5-b99f-f898b94b4631"],

Cell["Setup", "Section",ExpressionUUID->"ddce02d2-2758-4888-83ca-5d6e39077390"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"b2564512-0b73-44d6-b85d-39e84c1ad5a0"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"9677dc8e-7622-41ce-8d33-574ddd8642f0"],

Cell["Related Guides", "Section",ExpressionUUID->"90f27455-6ea8-4888-8a2a-7010f167e04c"],

