Notebook[{
Cell["FindClosestInfraPoint", "Title",ExpressionUUID->"08d294b8-c8d4-4022-970f-02b6aebcda15"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"f12cd884-e075-4481-bd16-d4a522b4ff36"],

Cell["\<\
FindClosestInfraPoint[graph, line, point] returns a List of unary \
InfraPoint[{v}] wrappers for the vertices on line at minimum graph distance \
from point (metric argmin). FindClosestInfraPoint[graph, line, point, n] / \
UpTo[n] / All controls multiplicity. line accepts a bare vertex sequence or \
InfraSegment / InfraLine / InfraPath / InfraRay wrapper; point accepts a bare \
vertex or InfraPoint[{...}]; multi-realisation wrappers spread Cartesian. \
Distinct from FindInfraPerpendicular, which runs the synthetic Euclid I.12 \
foot construction.\
\>", "Text",ExpressionUUID->"b94c722f-3915-48cf-a780-08bb639ead2e"],

Cell["Setup", "Section",ExpressionUUID->"a19d3f8f-f7c8-4662-9b5a-ec0c4c67f4f7"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"7d825aa4-f00a-4847-b236-4af235568e4f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"e3d58b93-b023-4fe7-8dc0-c2b02714a0b3"],

Cell["Related Guides", "Section",ExpressionUUID->"baa985e0-1415-4785-9b80-78b81ef486f2"],

