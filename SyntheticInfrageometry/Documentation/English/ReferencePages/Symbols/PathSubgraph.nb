Cell["PathSubgraph", "Title",ExpressionUUID->"cc537dcb-73fa-46fe-bc8b-fab4734bc0ca"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"a8bff95d-f4bb-44be-a57b-c9dec145e1e8"],

Cell["\<\
PathSubgraph[graph, u, v] returns the union of all shortest u-v paths. \
PathSubgraph[graph, u, v, k] (or UpTo[k]) caps path length; \
PathSubgraph[graph, u, v, All] returns the full simple-path subgraph. Option: \
\"Directed\".\
\>", "Text",ExpressionUUID->"2fb1a589-818f-47f0-8308-54fc2dd7a68f"],

