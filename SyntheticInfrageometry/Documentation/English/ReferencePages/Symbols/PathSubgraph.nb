Cell["PathSubgraph", "Title",ExpressionUUID->"ecb85d7f-27dc-45be-a8cd-2a40940cd14d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"a0088ca1-e1de-4c89-801c-e6979d982983"],

Cell["\<\
PathSubgraph[graph, u, v] returns the union of all shortest u-v paths. \
PathSubgraph[graph, u, v, k] (or UpTo[k]) caps path length; \
PathSubgraph[graph, u, v, All] returns the full simple-path subgraph. Option: \
\"Directed\".\
\>", "Text",ExpressionUUID->"6e7453e7-0d20-49d9-af78-486e9377d5f6"],

