Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"8", ",", "1"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "12"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"12", ",", "54"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"14", ",", "108"}], "}"}], ",", 
