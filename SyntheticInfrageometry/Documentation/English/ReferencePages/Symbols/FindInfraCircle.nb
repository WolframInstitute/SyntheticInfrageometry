Cell["\<\
The circle around the centre of each lattice, at the band each one needs.\
\>", "ExampleText",ExpressionUUID->"2279a36a-d7d6-4627-b4e2-cf80c134b682"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"ExampleGraphData", "[", 
           RowBox[{
            RowBox[{"First", "[", "spec", "]"}], ",", " ", "\"\<Medium\>\""}],
            "]"}], ",", " ", 
          RowBox[{"Sequence", " ", "@@", " ", 
           RowBox[{"AmbientGraphStyle", "[", "\"\<Gray\>\"", "]"}]}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
