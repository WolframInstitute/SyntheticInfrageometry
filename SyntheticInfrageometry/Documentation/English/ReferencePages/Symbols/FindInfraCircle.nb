Cell["\<\
The circle around the centre of each lattice, at the band each one needs; on \
both it is unique.\
\>", "ExampleText",ExpressionUUID->"931a165a-4812-4981-ac42-771c5aa52213"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"InfraSubstrate", "[", 
         RowBox[{
          RowBox[{"First", "[", "spec", "]"}], ",", " ", "\"\<Medium\>\"", ",",
           " ", "\"\<Gray\>\"", ",", " ", 
          RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"c", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraCircle", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", 
               RowBox[{"Last", "[", "spec", "]"}]}], "]"}], " ", "->", " ", 
             "$InfraCircleColor"}], ",", "\n", "          ", 
            RowBox[{
             RowBox[{"InfraPoint", "[", "c", "]"}], " ", "->", " ", 
             "$InfraPointColor"}]}], "}"}], ",", "\n", "         ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
               RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}],
           ",", "\n", "         ", 
          RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
        "       ", 
        RowBox[{"Text", "[", 
         RowBox[{
          RowBox[{"First", "[", "spec", "]"}], " ", "<>", 
          " ", "\"\<, band \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", 
           RowBox[{"Last", "[", "spec", "]"}], "]"}]}], "]"}]}], "]"}]}], 
     "]"}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"spec", ",", " ", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "5"}], "}"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", 
          RowBox[{"{", 
           RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8a0958c3-d06c-4702-a803-7311bb6b7b38"],

