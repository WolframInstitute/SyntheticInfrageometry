Cell["\<\
At a single radius the circle exists on the irregular mesh and is empty on \
both lattices \[LongDash] the shell has no two adjacent vertices to make a \
cycle from.\
\>", "ExampleText",ExpressionUUID->"1184e1b4-87da-43e4-a1e7-be9b587d44b1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "4", ",", " ", "All"}], "]"}], 
        "[", "\"\<Multiplicity\>\"", "]"}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"4301d59b-3ab6-4ff2-afb3-132b95ba1a9f"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"4daa842f-ff5c-4af9-9af1-2cb1c2d30473"]
}, Open  ]],

Cell[TextData[{
 "Thickening the radius to a band produces a genuine circle, and the \
thickness needed follows the girth: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6946a87-8c8c-4f6d-aa2c-6ba4808f251f"],
 " suffices on the square grid, while the hexagonal tiling needs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "6"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d8fe026-efe4-4355-89e6-85d2c178a1f0"],
 "."
}], "ExampleText",ExpressionUUID->"e03a7fb0-ebe5-479a-a7a1-06ffbee23d36"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"band", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          
          RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", 
           ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"FindInfraCircle", "[", 
         RowBox[{"g", ",", " ", "c", ",", " ", "band", ",", " ", "All"}], 
         "]"}], "[", "\"\<Multiplicity\>\"", "]"}]}], "]"}]}], ",", "\n", 
    "   ", 
    RowBox[{"{", 
     RowBox[{"band", ",", " ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"0f9d8e89-7950-416c-badc-0fd291562dcb"],

