Notebook[{
Cell["FindInfraCircle", "Title",ExpressionUUID->"d5c15e97-7ecc-4e9b-8aa6-5410d534a175"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"4bbbd120-0d29-4b95-bbc8-0afa275368aa"],

Cell["\<\
FindInfraCircle[graph, c, r] returns {InfraCircle[{cycle}]} for the canonical \
infra-circle around c at radius r (shortest separating cycle in the level \
surface), as an open vertex sequence. r is a scalar or {rmin, rmax} slab. \
FindInfraCircle[graph, c, r, n] returns a List of n unary \
InfraCircle[{cycle}] wrappers or $Failed; UpTo[n] returns up to n; All \
returns all. Option Properties (default {\"Separating\", \"Shortest\"}, \
order-insensitive set): \"Separating\" requires the cycle to disconnect c \
from {v: d(c,v) > rmax}; \"Shortest\" restricts to cycles tied at the minimum \
admissible length; empty {} permits any simple cycle in the level surface.\
\>", "Text",ExpressionUUID->"1892b700-a57d-43ac-bc80-96728dfca85c"],

Cell["Setup", "Section",ExpressionUUID->"79c19bc0-1794-4200-a582-96b3639b2e38"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"83b32a74-63b8-41b8-9394-37f8cb9a1995"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"d544cd0d-137b-40fd-941c-2fad2145f882"],

Cell["Related Guides", "Section",ExpressionUUID->"1d95df68-8e21-4d67-b993-0574b564fe2a"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"635e1768-91d8-4285-abdf-7cd94825f728"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"37a18d99-e090-4340-933e-4ac64f3f6da1"]
},
