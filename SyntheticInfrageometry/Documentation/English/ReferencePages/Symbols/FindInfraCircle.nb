Cell[CellGroupData[{

Cell["Method", "ExampleSubsection",ExpressionUUID->"6d0cced1-5f07-4a72-b712-b17e16556503"],

Cell[TextData[{
 "The class is the same under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "734052c3-c6f6-41d3-aa5d-c7a57dd06076"],
 "; only the order in which circles come off the pool differs."
}], "ExampleText",ExpressionUUID->"104bc31e-04b6-46e8-a759-a8dfd4c77f0d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{
         RowBox[{"FindInfraCircle", "[", 
          RowBox[{"g", ",", " ", "41", ",", " ", 
           RowBox[{"{", 
            RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "All", ",", " ", 
           RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}], 
         "[", "\"\<Realizations\>\"", "]"}]}], " ", "&"}], " ", "/@", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
        " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"670474cf-ca3e-45cc-b570-06c1ea31b65f"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"51abd06a-1811-4c58-ba6e-e3fa30275968"]
}, Open  ]],

Cell[TextData[{
 "The count-less call is deterministic; ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "42d2e97e-43da-499f-978d-016aa1fea758"],
 " takes the pool in random order, so the seed goes in front."
}], "ExampleText",ExpressionUUID->"4be9819b-d56b-4665-a26a-0f8df73550d4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", " ", "=", " ", 
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
    
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"FindInfraCircle", "[", 
