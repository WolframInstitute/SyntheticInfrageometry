Cell[TextData[{
 "Without ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "62c39ad1-f8da-43e6-b837-d94a243020b6"],
 " every separating cycle in the band is returned, by length: 256 of them in \
the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"1", ",", " ", "3"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71baed09-800a-49c5-992e-b22043229374"],
 " around the centre of a 7\[Times]7 grid, from one of length 8 to 81 of \
length 16."
}], "ExampleText",ExpressionUUID->"d12237a9-065a-419f-af65-bfe0ee09bfde"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Tally", "[", 
  RowBox[{"Length", " ", "/@", " ", 
   RowBox[{
    RowBox[{"FindInfraCircle", "[", 
     RowBox[{
      RowBox[{"GridGraph", "[", 
       RowBox[{"{", 
        RowBox[{"7", ",", " ", "7"}], "}"}], "]"}], ",", " ", "25", ",", " ", 
      
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "All", ",", " ", 
