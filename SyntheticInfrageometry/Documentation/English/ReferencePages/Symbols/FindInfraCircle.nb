      RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b59a4c70-8588-41ca-8175-a80e8c343bbf"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", "\"\<Shortest\>\"", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b436654a-fe74-495c-b347-0f176fa3b299"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", "}"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b4d1b9bb-cfda-4a1f-8d23-e5607c89e138"]
    }], "TableText",ExpressionUUID->"95b5d70f-f459-46de-9246-dd7d3baf2148"], 
    Cell["which cycles of the level surface count, conjoined.", "TableText",
     ExpressionUUID->"80267f9a-7883-4b44-82c4-e37a697efaf9"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "80820ac7-024d-4a32-bf39-99e0a04dfb9d"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d5e99fe4-3a92-486a-9ed0-1352444b03b0"]], "TableText",ExpressionUUID->
     "ac1f51fc-9619-4f7d-8ff0-5ef41d9810f6"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "96306e07-5489-4cd7-a5ff-721e37156dac"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "29dd0868-a99a-4d42-b909-7fd41989baeb"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "160fe1af-f94a-4610-97a2-f89c432b6d9c"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "39c7c5bc-e034-4901-95c1-5d0d8987c3b4"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ba8822b8-dfd5-40a5-99f3-d83c61775e3a"]
    }], "TableText",ExpressionUUID->"d135de68-ea21-4ad2-90ed-751c39d082f2"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "406feeb4-8a8b-44e2-9834-d1a776a30a8d"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ef1fba04-eb3d-4172-850c-d0f4192ff16e"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "06b8d81c-8fda-4638-8147-21f05b6a9f67"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7da34ea8-26fe-44d2-86a4-b3a65c2943be"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2afdbf6d-73c6-458f-810c-6a7b63d158bb"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f12f5799-ef90-49d6-8d88-80ab5d655160"],
     " take the atoms and their branches in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d893889e-501d-4a71-84dc-23dd909b89ea"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ca1a1e27-c422-4f05-9230-7cc38ce225f8"],
     ". `\"Pruning\" -> n"
    }], "TableText",ExpressionUUID->"00b0b8b4-7c87-40d4-9194-97e95599bcba"]}
  }]], "3ColumnTableMod",ExpressionUUID->"399308d6-a26c-4c81-9e89-\
086616b022c9"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"50cc1dfd-4111-40d9-9e5c-d09a7226aa16"],

