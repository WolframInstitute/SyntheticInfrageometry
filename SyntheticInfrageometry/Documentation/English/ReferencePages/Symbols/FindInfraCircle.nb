Cell["\<\
At a single radius the circle exists on the irregular mesh and is empty on \
both lattices \[LongDash] the shell has no two adjacent vertices to make a \
cycle from.\
\>", "ExampleText",ExpressionUUID->"b89d4542-357c-47fb-a1c8-b23f5f4bd766"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraCircle", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "4"}], "]"}]}]}]}], "]"}]}], ",",
     "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"d61cc0c5-2b37-4b9d-83b0-00d9ffa67cfb"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", "1"}], ",", 
   RowBox[{"\<\"Square\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Hexagonal\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"da88f8a6-4531-476d-9f49-c53b2612995d"]
}, Open  ]],

Cell[TextData[{
 "Thickening the radius to a band produces a genuine circle, and the \
thickness needed follows the girth: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "518b0f9b-841a-406b-9a4e-22ce2f788d55"],
 " suffices on the square grid, while the hexagonal tiling needs ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "6"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1de7d4f2-8b6c-42fe-bdd1-93727fee79e5"],
 "."
}], "ExampleText",ExpressionUUID->"432d0d9f-0ff0-4812-bb7a-12acbb197d8a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"band", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"\"\<Hexagonal\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], 
        "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraCircle", "[", 
          RowBox[{"g", ",", " ", "c", ",", " ", "band"}], "]"}]}]}]}], 
      "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"band", ",", " ", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "6"}], "}"}]}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"9d5446e8-aea0-4a97-af50-64462f84d139"],

