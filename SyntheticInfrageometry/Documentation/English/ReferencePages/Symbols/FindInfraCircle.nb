Notebook[{

Cell[CellGroupData[{
Cell["FindInfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"876a4bf4-cbfb-4466-a3b0-35854e90838e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "56cb9650-f7a1-4edc-b9d0-3f8a63290213"],
 "\[LineSeparator]",
 "gives one infra-circle around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ": a shortest cycle in the level surface at radius ",
 StyleBox["r", "TI"],
 " that separates ",
 StyleBox["c", "TI"],
 " from what lies beyond, as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraCircle"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d0c7da51-e16f-433d-89c4-f5d4f9e5464d"],
 " wrapper. ",
 StyleBox["r", "TI"],
 " is a scalar or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "997a05a9-6219-4f31-a569-6c1bc66e8ef9"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"f30a87ea-547d-4d16-bc41-46c99e8e662e"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b56ba7ce-b400-4082-97b6-30df01cd3c29"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " circles or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "77cf889b-2431-467b-9115-961abec6282f"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8878c25b-0463-40da-9b4b-c95b0f4643a9"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b34d1354-aab6-46cb-9ed6-1eb909c2f0fb"],
 " gives the whole class, as the circle pool where one exists."
}], "Usage",ExpressionUUID->"93b984f9-4eb7-4009-898a-ef30cde9c743"],

Cell[TextData[{
 "The level surface at radius ",
 StyleBox["r", "TI"],
 " around ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["r", "TI"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0337bde-b3ff-4da6-885d-ebd2234eb67e"],
 ", or ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     SubscriptBox[
      StyleBox["r", "TI"], "min"], "\[LessEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       StyleBox["c", "TI"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
     SubscriptBox[
      StyleBox["r", "TI"], "max"]}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "525989ec-94f9-426a-9f41-0758b32229d7"],
 " for a band. A circle is a simple cycle inside that level surface which \
separates ",
 StyleBox["c", "TI"],
 " from everything beyond it; the canonical ones are the shortest, and the \
count-less call returns one of them."
}], "Notes",ExpressionUUID->"c3367f01-963e-4fe6-b5ec-cac48976408f"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell contains no two adjacent vertices, so \
it spans no cycle at all and the result is empty. This is not a defect of the \
definition \[LongDash] it is what a sphere of one-vertex thickness is on a \
lattice."
}], "Notes",ExpressionUUID->"dc9c016c-c055-4da4-937e-6bb4227d48c6"],

Cell[TextData[{
 "Thickening the radius to a band fixes it, and ",
 StyleBox["the band thickness that suffices tracks the girth of the tiling",
  FontWeight->"Bold"],
 ". On the square grid, girth 4, a two-thick band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ae65c5b-6cbf-436e-80a0-5856b75ab377"],
 " already carries a cycle. On the hexagonal tiling, girth 6, it does not: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40a8116b-0ebf-4d14-aa7d-0270b4fb7c77"],
 " is still empty and the band has to reach ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "54faa417-976a-4ee3-ada1-d52db27895a6"],
 ". On an irregular mesh a single shell usually works, since its vertices are \
adjacent by accident of the triangulation."
}], "Notes",ExpressionUUID->"676b1548-f822-4b61-9436-032223b490c2"],

Cell[TextData[{
 "The class is carried two ways. Under the default ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cae1c6ea-e009-4fac-ae57-5198cca74bf1"],
 ", a single anchor and an integer band, the circles are the source-to-sink \
paths of a ",
 StyleBox["pool",
  FontWeight->"Bold"],
 " of geodesic DAGs \[LongDash] the level surface cut open along a radial \
seam: ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f988013-5b6f-4947-bf7d-34dae7463a11"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec0305a7-8d1a-48bb-8335-92304b4d7052"],
 ", whose ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cb0317b5-34c0-475b-891f-a5d6fccd9e3b"],
 " counts the circles without enumerating one, and a bounded count streams \
circles off the atoms. Below, the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2074643-d4f3-41ed-baa4-7d8f6341f3c1"],
 " on the irregular mesh holds 75 circles in one pool. Off that class \
\[LongDash] other ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2b614c5b-4d4d-40c9-af84-750b34c8df61"],
 ", several anchors, or a band the seam cannot cut open, reported by ",
 Cell[BoxData[
  RowBox[{"::", "uncertified"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf20341c-743a-46b6-ac0a-1c2fcdddc641"],
 " \[LongDash] the family is enumerated by a cycle sweep over the level \
surface, length by length, stopping at the first non-empty length when ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e7489ae-126a-46d8-8751-1e8a6deeed39"],
 " is present."
}], "Notes",ExpressionUUID->"c04b9328-cb9d-4e2b-821b-047b2a5075ca"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4864d23f-0380-4d34-8804-3e54f769ee49"],
 " defaults to ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Shortest\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36950adb-b7d6-4747-91af-78da1913042a"],
 ", the canonical infra-circle. Dropping ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2a8ddff7-730a-4694-9456-ae3871e1bcef"],
 " gives all separating cycles in order of length; dropping ",
 Cell[BoxData["\"\<Separating\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "044a5255-b0f3-462f-a111-4b9951f9c0c2"],
 " allows any simple cycle in the level surface. ",
 Cell[BoxData["\"\<Connected\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dfe5a5a-b2e5-4ac0-8611-d5b2d72d2b64"],
 " is not a valid property \[LongDash] a cycle is connected."
}], "Notes",ExpressionUUID->"e21305cc-af48-4721-b09a-80eedc001111"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "528fc8f9-ff51-4c0b-b0e9-19ca6365feb5"], Cell["Option", "TableText",
