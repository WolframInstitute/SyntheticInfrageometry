Notebook[{

Cell[CellGroupData[{
Cell["FindInfraCircle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"fbb6fbcf-7646-44a2-adc3-51205df955e4"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb0a67cd-8ff0-4313-9108-5c1b59b7b97b"],
 "\[LineSeparator]",
 "gives the canonical infra-circle around ",
 StyleBox["c", "TI"],
 " at radius ",
 StyleBox["r", "TI"],
 ": the shortest separating cycle in the level surface, together with its \
ties. ",
 StyleBox["r", "TI"],
 " is a scalar or a band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"rmin", ",", " ", "rmax"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ede6d4b5-fc86-4bb3-81ac-87d2cc9aa857"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ca4c54ba-7699-4264-b85a-2ae8b79d36e5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraCircle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraCircle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["r", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3879023-fbd7-48ee-bc04-b8557e98ad25"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " realisations or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79151d96-3125-4eda-92ae-74a44eda7c10"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2973f1ad-91a2-4f09-8342-7ca95cf42825"],
 " up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20220a8f-f1fb-488b-be9c-5a49314c37c9"],
 " all of them."
}], "Usage",ExpressionUUID->"cddaaebf-c141-4af6-aa6e-f6c674eea66d"],

Cell[TextData[{
 "The level surface at radius ",
 StyleBox["r", "TI"],
 " around ",
 StyleBox["c", "TI"],
 " is ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["r", "TI"], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6858903d-448c-4ccd-8314-e16abc944422"],
 ", or ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["min",
      FontSlant->"Plain"]], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     StyleBox["c", "TI"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "\[LessEqual]", 
    SubscriptBox[
     StyleBox["r", "TI"], 
     StyleBox["max",
      FontSlant->"Plain"]], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7799971b-9bc7-4d23-8fa4-26df831559c2"],
 " for a band. A circle is a simple cycle inside that level surface which \
separates ",
 StyleBox["c", "TI"],
 " from everything beyond it; the canonical one is shortest, and its ties are \
returned with it."
}], "Notes",ExpressionUUID->"f827dafb-10e1-4cb3-9547-3da9ac63f7f2"],

Cell[TextData[{
 StyleBox["A circle need not exist.",
  FontWeight->"Bold"],
 " On a lattice a single distance shell contains no two adjacent vertices, so \
it spans no cycle at all and the result is empty. This is not a defect of the \
definition \[LongDash] it is what a sphere of one-vertex thickness is on a \
lattice."
}], "Notes",ExpressionUUID->"31306448-ac31-48f2-87e6-3edb7676dff4"],

Cell[TextData[{
 "Thickening the radius to a band fixes it, and ",
 StyleBox["the band thickness that suffices tracks the girth of the tiling",
  FontWeight->"Bold"],
 ". On the square grid, girth 4, a two-thick band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a30b418f-5a02-470a-bb43-ee49acd8a33c"],
 " already carries a cycle. On the hexagonal tiling, girth 6, it does not: ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "1"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e7f52360-a908-48d5-9e4d-7aaef84c704e"],
 " is still empty and the band has to reach ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"r", ",", " ", 
    RowBox[{"r", "+", "2"}]}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "122b0798-2fab-43af-b2c2-4cf517b8de8a"],
 ". On an irregular mesh a single shell usually works, since its vertices are \
adjacent by accident of the triangulation."
}], "Notes",ExpressionUUID->"c4524781-8260-478b-983c-16ee1bd2c442"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c4971aa7-12d7-4759-b54b-0bba623179c8"],
 " defaults to ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Shortest\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fcbd6ac-59ae-441f-8c06-fbb132259305"],
 ", the canonical infra-circle. Dropping ",
 Cell[BoxData["\"\<Shortest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2db28fba-64ff-4b8b-b2f2-524cec1e006e"],
 " gives all separating cycles ordered by length; dropping ",
 Cell[BoxData["\"\<Separating\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9881c7b6-c9bc-4f28-b119-f88718ca00cc"],
 " allows any simple cycle in the level surface. ",
 Cell[BoxData["\"\<Connected\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd027c96-58a2-4cd5-99e1-b82ed45fedd7"],
 " is not a valid property \[LongDash] a cycle is connected."
}], "Notes",ExpressionUUID->"20c07be1-0877-4e0e-9865-9ce98a8c5bbb"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"18774661-6edd-44cb-a333-fa63ca2d8805"],

