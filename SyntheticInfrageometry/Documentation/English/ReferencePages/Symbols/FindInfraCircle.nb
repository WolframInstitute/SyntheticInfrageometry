Cell[TextData[{
 "On the irregular mesh the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"4", ",", " ", "5"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7f59c6f-19a9-4cba-bb50-ccc2838d90df"],
 " holds 75 circles. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb9c4f4a-02b5-4e78-a55c-1e9b27e496b6"],
 " returns them as one pool without enumerating them; the count-less call is \
one of them, 28 edges long."
}], "ExampleText",ExpressionUUID->"5e60620d-c4d3-4126-a849-ec39d4012a90"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareMeshGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}], ",", " ", "All"}], "]"}], 
      "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "5"}], "}"}]}], "]"}], "[", "\"\<Length\>\"", 
      "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"b3100a1f-94d4-44c1-a184-0679be091da7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"75", ",", 
   RowBox[{"{", "28", "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0d77363c-09d1-4a34-a293-4a33f7797029"]
}, Open  ]],

Cell[TextData[{
 "A bounded count streams circles off the pool; a strict count that cannot be \
met is ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6717a5a3-6f11-4c88-8ee1-484cb7cc6831"],
 ". Sixteen circles lie in the band ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"2", ",", " ", "4"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ad00d380-56de-4a48-b643-589b356daf81"],
 " around the centre of a 9\[Times]9 grid."
}], "ExampleText",ExpressionUUID->"c5bfd063-59ee-4058-99f4-f9963840a5e4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"9", ",", " ", "9"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"FindInfraCircle", "[", 
       RowBox[{"g", ",", " ", "41", ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "All"}], "]"}], 
      "[", "\"\<Multiplicity\>\"", "]"}], ",", "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{
       RowBox[{"FindInfraCircle", "[", 
        RowBox[{"g", ",", " ", "41", ",", " ", 
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "3"}], "]"}], 
       "[", "\"\<Realizations\>\"", "]"}]}], ",", "\n", "   ", 
     RowBox[{"FindInfraCircle", "[", 
      RowBox[{"g", ",", " ", "41", ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "20"}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c27b4d46-f8b4-4bed-b7c8-cb9de85163dd"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"16", ",", "3", ",", "$Failed"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"4fe0baf0-3d9c-4406-a5b0-b9e60af89131"]
