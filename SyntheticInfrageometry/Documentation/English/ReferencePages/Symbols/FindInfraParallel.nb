  FontSize->0.9 Inherited,ExpressionUUID->
  "1cbf085e-7dfd-4659-acc6-b86865731b38"],
 "."
}], "Notes",ExpressionUUID->"fd2feac7-ef36-47ea-b241-ef759a6150c2"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"81912ddf-3fd2-4885-9dc5-c9cc23a3822f"],

