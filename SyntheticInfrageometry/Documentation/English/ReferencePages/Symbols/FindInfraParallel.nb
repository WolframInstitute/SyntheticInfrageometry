Cell["\<\
Playfair's axiom on the grid: through a vertex of the third row there is \
exactly one parallel to the first row, and it is the row.\
\>", "ExampleText",ExpressionUUID->"574eba84-deb2-42c9-b596-37aee5cc31f1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FindInfraParallel", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"5", ",", " ", "5"}], "}"}], "]"}], ",", " ", 
    RowBox[{"Range", "[", "5", "]"}], ",", " ", "13", ",", " ", "All"}], 
   "]"}], "[", "\"\<Realizations\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"a02a1900-ca80-4a33-b38f-c7fdb8466b3c"],

