Cell["Through a point off a line, on three substrates.", "ExampleText",ExpressionUUID->"4a2e1a03-af1e-4268-aa7b-55eeff8e1aa0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Small\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"far", " ", "=", " ", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{"GraphDistance", "[", 
              RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
             " ", "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"line", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"First", " ", "@", " ", 
           RowBox[{"FindInfraLine", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "far", ",", " ", "1"}], 
            "]"}]}]}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"p", " ", "=", " ", 
         RowBox[{"SelectFirst", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "2"}], " ", "&&", " ", 
             RowBox[{"!", " ", 
              RowBox[{"MemberQ", "[", 
               RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraParallel", "[", 
          RowBox[{"g", ",", " ", "line", ",", " ", "p", ",", " ", "All"}], 
          "]"}]}]}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9050639a-cda9-4bed-9230-32a51ef46ab3"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Square\"\>", "\[Rule]", "0"}], ",", 
   RowBox[{"\<\"Hexagonal\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a35ff179-e720-4f5b-bf3b-2987405c0fb8"]
}, Open  ]],

Cell["\<\
The count does not change when the boundary is removed. On a flat torus, \
which has no rim at all, it is the same.\
\>", "ExampleText",ExpressionUUID->"297ac782-d22f-4058-9ede-fe2af38fe0d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"t", " ", "=", " ", 
     RowBox[{"IndexGraph", " ", "@", " ", 
      RowBox[{"TessellationGraph", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"12", ",", " ", "12"}], "}"}]}], "]"}]}]}], "}"}], ",", "\n",
    "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GraphDistance", "[", 
          RowBox[{"t", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", " ", 
         "4"}], " ", "&"}]}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraLine", "[", 
        RowBox[{"t", ",", " ", "1", ",", " ", "far", ",", " ", "1"}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"p", " ", "=", " ", 
     RowBox[{"SelectFirst", "[", 
      RowBox[{
       RowBox[{"VertexList", "[", "t", "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"GraphDistance", "[", 
           RowBox[{"t", ",", " ", "1", ",", " ", "#"}], "]"}], " ", "==", " ",
           "2"}], " ", "&&", " ", 
         RowBox[{"!", " ", 
          RowBox[{"MemberQ", "[", 
           RowBox[{"line", ",", " ", "#"}], "]"}]}]}], " ", "&"}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<torus vertices\>\"", " ", "->", " ", 
      RowBox[{"VertexCount", "[", "t", "]"}]}], ",", " ", 
     RowBox[{"\"\<parallels\>\"", " ", "->", " ", 
      RowBox[{"Length", " ", "@", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"FindInfraParallel", "[", 
         RowBox[{"t", ",", " ", "line", ",", " ", "p", ",", " ", "All"}], 
         "]"}]}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aa3bb1f1-b595-4a9d-815a-401ee6811197"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"torus vertices\"\>", "\[Rule]", "144"}], ",", 
   RowBox[{"\<\"parallels\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"664a0baf-6dc4-435b-95a4-4106572fb3e5"]
}, Open  ]]
}, Open  ]],

