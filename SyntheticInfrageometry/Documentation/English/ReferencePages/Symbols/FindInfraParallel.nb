Cell[TextData[{
 "Every parallel is a geodesic, and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraParallelQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraParallelQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9a057822-85ca-40ee-b1ae-fd779c5250b7"],
 " accepts it \[LongDash] as it accepts two concentric shells, which no \
geodesic could be."
}], "ExampleText",ExpressionUUID->"2876cf9a-2d60-400f-a7b6-7cb09518845a"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"row", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{
       RowBox[{"FindInfraParallel", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"Range", "[", "5", "]"}], ",", " ", "13"}], "]"}], 
       "[", "\"\<Realizations\>\"", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"InfraSegmentQ", "[", 
      RowBox[{"g", ",", " ", "row"}], "]"}], ",", " ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"Range", "[", "5", "]"}], ",", " ", "row"}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"InfraParallelQ", "[", 
      RowBox[{"g", ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "13", ",", " ", "1"}], "]"}]}]}], ",", " ", 
       RowBox[{"First", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraShell", "[", 
          RowBox[{"g", ",", " ", "13", ",", " ", "2"}], "]"}]}]}]}], "]"}]}], 
    "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9406411e-dccf-48af-89be-ad2a67b421d9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"d79bc621-a367-4cd8-914b-b474e5110c79"]
}, Open  ]],

