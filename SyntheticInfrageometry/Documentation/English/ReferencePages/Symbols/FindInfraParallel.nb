     "0a2671f7-c6dd-4517-beb9-8c7a4e839fe0"], Cell["\<\
The Euclidean axiom, stated with betweenness and equidistance.\
\>", "TableText",ExpressionUUID->"29d9fc87-6a85-4868-86b8-4b0bcf391549"]}
  }]], "3ColumnTableMod",ExpressionUUID->"ba944359-1a1d-4ecf-89e2-\
