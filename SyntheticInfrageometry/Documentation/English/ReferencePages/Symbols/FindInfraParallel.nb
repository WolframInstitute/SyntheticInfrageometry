Cell["FindInfraParallel", "Title",ExpressionUUID->"325daa2f-8fe3-4e21-9953-5f965ec2dd9f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"4a9f7718-c617-4e26-aafa-707e3d5371f2"],

Cell["\<\
FindInfraParallel[graph, line, p] returns a List of unary InfraLine[{line}] \
wrappers for parallels through p (parallel = constant distance to line), or \
$Failed. FindInfraParallel[graph, line, p, n] / UpTo[n] / All controls \
multiplicity. Options: Properties ({} only at present), Method \
(\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\" -> spec}, \"Greedy\").\
\>", "Text",ExpressionUUID->"c9b40ad3-8f27-4567-b4d6-cce5ac427883"],

