    "Euclid", "TableText",ExpressionUUID->
     "9001ba17-d622-4fbd-a6eb-a14cb65c6951"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "c9ea6214-e1f1-4b81-9c49-47779ed9e59d"], Cell["\<\
The parallel postulate: two lines cut by a transversal making internal angles \
less than two right angles meet on that side.\
\>", "TableText",ExpressionUUID->"8998893d-163c-4480-a6a4-5fbc02812f23"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5419f6db-fb78-43be-8349-129bda26bca4"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "85bd2e42-83f8-4f95-950d-5d57c0f378bc"], Cell[
    "Proposition I.31", "TableText",ExpressionUUID->
     "e49c4710-dd5c-4111-8f7a-00625adb1553"], Cell["\<\
To draw a line through a given point parallel to a given line.\
\>", "TableText",ExpressionUUID->"59064eea-1836-495f-b33f-b3917beb78bd"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "32f22f69-b657-44e5-88cd-715a34d86f08"], Cell[
