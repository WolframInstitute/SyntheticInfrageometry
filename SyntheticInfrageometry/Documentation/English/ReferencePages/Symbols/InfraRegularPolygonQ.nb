Cell["InfraRegularPolygonQ", "Title",ExpressionUUID->"cf4f371f-5ab8-49ca-b9b7-ef7c8be94ae7"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"1862e334-4c9f-49a4-92f5-e63a8800abc8"],

Cell["\<\
InfraRegularPolygonQ[graph, cycle, As] tests whether the cycle is a regular \
n-gon w.r.t. the metric tuple As, with the same slot grammar as \
FindInfraRegularPolygon (Integer | {lo, hi} | Automatic per slot). Accepts \
open and closed input.\
\>", "Text",ExpressionUUID->"660991da-6b5f-4b88-b874-523159527c08"],

