Notebook[{

Cell[CellGroupData[{
Cell["InfraPerpendicularQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cbeb709e-5e97-4b89-9e7a-79db0e58fd55"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPerpendicularQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPerpendicularQ",
      "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["l1", "TI"], ",", " ", 
    StyleBox["l2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1debe218-d152-4d84-8147-049ab71fc4af"],
 "\[LineSeparator]",
 "tests whether the two lines are perpendicular.",
 "\n"
}], "Usage",ExpressionUUID->"10c3d27b-b689-4647-98a3-92d6de65ffd5"],

Cell[TextData[{
 "Definition, with the default ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Projection\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd1f4990-063b-4bc3-b0d6-cd74a80134cd"],
 ": at each common vertex, the foot of the perpendicular from one line onto \
the other must lie in the intersection of the two lines."
}], "Notes",ExpressionUUID->"16836131-7cf4-487e-b65c-c54aad75c6b7"],

Cell[TextData[{
 "The test is a conjunction over all common vertices. It is ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea9b423f-6b18-410a-a01a-afc59eace180"],
 " when the lines do not meet."
}], "Notes",ExpressionUUID->"6bf7bab4-f165-467e-9129-ca7cd47b9fa1"],

Cell[TextData[{
 "There is no single right definition of a right angle on a graph, so there \
are several methods and they are ",
 StyleBox["not",
  FontWeight->"Bold"],
 " equivalent."
}], "Notes",ExpressionUUID->"b160f5ca-a663-49ef-96f4-0162419ce146"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "aaddc0a0-0277-4bb2-90c5-08bffdd643c7"], Cell["Method", "TableText",
     FontWeight->Bold,ExpressionUUID->"f86973b5-a01c-4cb7-ab77-e8573423713a"],
     Cell["Tests", "TableText",
     FontWeight->Bold,ExpressionUUID->"56bf8cf9-7a58-4943-aaf8-94b3cce271a4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b319c77e-c180-4568-b376-4c406d873d30"], Cell[TextData[{
     Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d8860a1e-88c1-4424-81bc-ce7f00929b63"],
     " (default)"
    }], "TableText",ExpressionUUID->"cafa3d30-3353-4e05-856f-3430bab85443"], 
    Cell["the foot of the perpendicular lies in the intersection", 
     "TableText",ExpressionUUID->"2d801c05-99a3-4e38-b3b8-eacabc304161"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "8abef34f-c7f3-4369-bbac-b29138635667"], Cell[TextData[Cell[
    BoxData["\"\<Coordinate\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "9d215896-cf07-4f8c-94de-098f6eedf51d"]], "TableText",ExpressionUUID->
     "a90412cf-f569-4f17-9f3f-8aff94183818"], Cell["\<\
signed projection coordinates of the feet are centred on the meeting point\
\>", "TableText",ExpressionUUID->"5c3893ba-601a-4826-9e15-7ec2b0a5c46e"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "07d207d8-7d7a-491c-92c3-ecf96eacc2b1"], Cell[TextData[Cell[
    BoxData["\"\<Arclength\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b5efed75-a42e-46d1-9377-5ddb45e4b234"]], "TableText",ExpressionUUID->
     "e18bd664-e73c-4534-8bbc-2c6c998f573c"], Cell["\<\
the four corner wedge angles at the meeting point are equal within a tolerance\
\>", "TableText",ExpressionUUID->"5185fb36-e1ce-415b-b97f-9cad7ae113c1"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1cedc282-4a5b-42fb-b821-1cd81a249c13"], Cell[TextData[Cell[
    BoxData["\"\<Alexandrov\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "b225817d-d2f1-4613-8680-53e117b94272"]], "TableText",ExpressionUUID->
     "dc9a0d6e-0462-4f91-8d12-7388d155746d"], Cell[TextData[{
     "the same, with comparison angles in the model plane of curvature ",
     StyleBox["k", "TI"]
    }], "TableText",ExpressionUUID->"352c37d0-62d1-4a6c-874e-e95572421490"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4fa8eb67-36ac-479a-958f-\
e2db5c2f4c59"],

Cell[TextData[{
 "Sub-options live inside the method spec, because their natural units differ \
per family. ",
 Cell[BoxData["\"\<Projection\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "367740c2-c109-43bb-a4b1-e62267c284fe"],
 " takes ",
 Cell[BoxData["\"\<Equality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8737225-e638-4022-9d88-a455d381af70"],
 ", forwarded to ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEqualQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraEqualQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4dcb0a9c-2dd3-4d51-b0bb-804c24900178"],
 ": ",
 Cell[BoxData["\"\<Subset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "556b7638-0966-40f8-82ce-b84ecdbe8b11"],
 " is the default, and ",
 Cell[BoxData["\"\<Set\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec63734d-7b6d-4044-98a7-dfaa1dd351f7"],
 ", ",
 Cell[BoxData["\"\<Multiset\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "82ce9e2d-ea89-4fb2-a2aa-7a7a8562d9d6"],
 ", ",
 Cell[BoxData["\"\<Diffuse\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "84b5c932-9ad8-4d4f-a681-69ccfd211b12"],
 " and ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ddcb167-e453-4f0b-a390-27b04c37f76b"],
 " are also accepted. ",
 Cell[BoxData["\"\<Coordinate\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8130a60c-3a5b-4281-bdee-27d486dd2544"],
 " takes ",
 Cell[BoxData["\"\<ZeroTest\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2d1996a3-f59c-4c39-97b7-96bee2567ecb"],
 ". ",
 Cell[BoxData["\"\<Arclength\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2617a71a-fea1-44df-a7fb-3c52281a0fae"],
 " and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fcc21cc9-b9cc-46a3-be78-0d23618d88e8"],
 " take ",
 Cell[BoxData["\"\<Tolerance\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "070367c1-1a24-4797-bd45-010b236de8d5"],
 " in radians, and ",
 Cell[BoxData["\"\<Alexandrov\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0fc376f8-9700-4c0e-8fc8-9dbb10e95d8d"],
 " takes ",
 Cell[BoxData["\"\<Curvature\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0dc0eeb3-f3b7-4610-a677-e0e93dd654e3"],
 ". Use ",
 Cell[BoxData[
  RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "0"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e8b112ad-8c50-4457-b4e9-0aa91098676b"],
 " for the synthetic right-angle test."
}], "Notes",ExpressionUUID->"2956015d-0554-414d-96bc-357d66277871"],

Cell[TextData[{
 "The top-level option ",
 Cell[BoxData[
  RowBox[{"\"\<Radius\>\"", " ", "->", " ", "r"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9869e2be-3c59-48e2-9322-0dda72b03f8c"],
 " localises the test to the ",
 StyleBox["r", "TI"],
 "-neighbourhood of the meeting point."
}], "Notes",ExpressionUUID->"d105415b-cdf5-4e0f-a75f-a38a298f80e6"],

Cell[TextData[{
 StyleBox["The default is strict.",
  FontWeight->"Bold"],
 " A line produced by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraPerpendicular"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraPerpendicular", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "d4d41634-3600-4f2a-83ca-a8a7d3690375"],
 " with its default Euclid I.12 construction is generally rejected by this \
predicate under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Subset\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc79085a-f94a-4afd-8206-6006b878468a"],
 ", and accepted under ",
 Cell[BoxData[
  RowBox[{"\"\<Equality\>\"", " ", "->", " ", "\"\<Overlap\>\""}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b26feb28-2aa8-4ffe-9baa-f4ec144461f9"],
 ". The construction and the test are asking different questions: one lays \
off an isosceles base and takes its midpoint, the other demands that \
projections land exactly in the intersection. On a lattice those come apart. \
If you want the two to agree, pass ",
 Cell[BoxData["\"\<Overlap\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e6fb40a-2412-4e69-b2ad-8080f5c8c538"],
 "."
}], "Notes",ExpressionUUID->"67f0b811-2e41-4966-92cd-f04f95c13a1e"],

Cell["\<\
Two lines on a lattice can also meet in more than one vertex, which has no \
analogue in the plane, and the conjunction then has to hold at each of them.\
\>", "Notes",ExpressionUUID->"571c172b-1db8-4e3b-99e7-06062bc6fa08"]
}, Open  ]],

