Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"l2$", "::", "shdw"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Symbol", " "}], 
  TagBox["\<\"l2$\"\>",
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"appears", " ", "in", " ", "multiple", " ", "contexts", " "}]}], 
