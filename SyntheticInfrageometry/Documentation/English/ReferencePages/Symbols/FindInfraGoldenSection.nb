Notebook[{
Cell["FindInfraGoldenSection", "Title",ExpressionUUID->"7c1fa1e3-d85d-4ac6-8645-a197035b0392"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"4dd38a59-6cd9-4a61-911d-72f2dce6743f"],

Cell["\<\
FindInfraGoldenSection[graph, InfraSegment[{walks}]] returns one InfraPoint: \
the vertex at the index closest to each walk's golden index 1 + \
(n-1)/GoldenRatio (AS == AB/phi), unioned over the walks; the golden index is \
irrational, so it is a single point per walk. FindInfraGoldenSection[graph, \
walk] is the bare-walk shortcut. FindInfraGoldenSection[graph, p1, p2] unions \
over every geodesic. Options: Method (\"Metric\" (default) | \"Embedding\" \
(single nearest vertex to the coord-space point A + (1/GoldenRatio)(B - A), \
with sub-options \"Coordinates\" and \"Pool\")), \"Tolerance\" (0 (default); \
widens the band beyond the closest index by that many graph-distance units).\
\>", "Text",ExpressionUUID->"8444b370-8504-4c2d-a03f-66ca11e2deb3"],

Cell["Setup", "Section",ExpressionUUID->"501ceea1-7407-4d8e-8bbc-a30660e75891"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"18c3cf26-cbd6-42aa-98cd-dac20b082348"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"6e340ddd-fb66-46b7-86f1-effd4525aad2"],

Cell["Related Guides", "Section",ExpressionUUID->"4ec3d878-dd5d-41e2-9515-120a28c78208"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"0945740a-0ec3-4c57-9b41-de7ec52aaa55"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"d03993eb-ebd6-4f63-b77f-bf3a77aa474b"]
},
