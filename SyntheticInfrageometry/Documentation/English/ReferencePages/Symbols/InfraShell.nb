Notebook[{
Cell["InfraShell", "Title",ExpressionUUID->"dc751900-3967-40dd-a1bd-74afb1022ae5"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"0b49f6f9-e841-42be-b6f2-67bafa31ac94"],

Cell["\<\
InfraShell[{set}] is the unary form (one metric shell vertex set); \
InfraShell[{set1, ..., setk}] is the multi-realisation form. Find* returns a \
List of unary wrappers; wrap with InfraShell @ ... to collapse to multi via \
auto-flatten. Scene-language constructor InfraShell[center, radius] is used \
inside InfraScene. The multi form is consumed by InfraSceneHighlight \
(induced-subgraph semantics).\
\>", "Text",ExpressionUUID->"0cbf3ee1-a519-49e1-b3f6-52c65491a338"],

Cell["Setup", "Section",ExpressionUUID->"71091bb8-fd7d-4007-aa22-a7d5cd6c4041"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"0647d0b5-1236-4ba1-8510-d062e8483e77"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"266dfa0e-4082-43ba-ba3f-e1657223e499"],

