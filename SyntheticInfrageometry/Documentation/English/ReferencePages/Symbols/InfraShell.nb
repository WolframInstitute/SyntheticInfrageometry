Notebook[{
Cell["InfraShell", "Title",ExpressionUUID->"5dd0c2d3-6685-4a69-a788-d8b572f529b4"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"f5d22dc6-9826-4645-ae70-ea0fedc97358"],

Cell["\<\
InfraShell[{set}] is the unary form (one metric shell vertex set); \
InfraShell[{set1, ..., setk}] is the multi-realisation form. Find* returns a \
List of unary wrappers; wrap with InfraShell @ ... to collapse to multi via \
auto-flatten. Scene-language constructor InfraShell[center, radius] is used \
inside InfraScene. The multi form is consumed by InfraSceneHighlight \
(induced-subgraph semantics).\
\>", "Text",ExpressionUUID->"8039d1b3-428d-47b4-b683-8172d01ada91"],

Cell["Setup", "Section",ExpressionUUID->"539a490e-574e-44ef-afca-c70bb36becaa"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"c88ffe90-3a23-4b6a-89b7-18352769a98b"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"9cfeac98-a2c6-4d56-b7ba-2ef387e8b19a"],

