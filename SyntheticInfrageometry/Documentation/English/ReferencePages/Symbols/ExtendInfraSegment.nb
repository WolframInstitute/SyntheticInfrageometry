Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"pool", " ", "=", " ", 
     RowBox[{"ExtendInfraSegment", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "2", ",", " ", "All"}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pool", "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<Start\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<End\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9c37fe36-3b90-4c79-9092-a330a2579a37"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", 
   RowBox[{"InfraSet", "[", 
    RowBox[{"{", 
     RowBox[{"1", ",", "9", ",", "14"}], "}"}], "]"}], ",", 
   RowBox[{"InfraSet", "[", 
    RowBox[{"{", 
     RowBox[{"4", ",", "12", ",", "15"}], "}"}], "]"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0fea9da2-eff8-4ce8-974e-d77984d269dd"]
}, Open  ]],

Cell["\<\
A whole geodesic bundle extends as one object: six geodesics from the corner, \
twelve lines through all of them.\
\>", "ExampleText",ExpressionUUID->"2a0be3e8-ec77-4654-8af4-d8265fb5707c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", "11", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"seg", "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "Infinity", ",", " ", "All"}], 
       "]"}], "[", "\"\<Multiplicity\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"dfeab3d4-a41c-4015-b15e-62aaaa564247"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"2bd9ae2d-176b-4ff1-9666-6df927cbd625"]
}, Open  ]],

Cell["\<\
On the 6-cycle a budget of 1 buys one extension of the edge 1\[Dash]2, a \
budget of 2 the three lines through it.\
\>", "ExampleText",ExpressionUUID->"3463d5d3-f68e-42a3-b11a-cb14cb4927c0"],

