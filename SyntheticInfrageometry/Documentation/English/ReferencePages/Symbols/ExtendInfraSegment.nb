Cell["\<\
One step per side beyond an interior edge of the grid: seven extensions.\
\>", "ExampleText",ExpressionUUID->"aac8b511-a691-49dc-b439-8c7fb876d329"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtendInfraSegment", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
   "]"}], "[", "\"\<Realizations\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"adfda16e-fbb7-42ad-ae49-bb1a6b471cc2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "6", ",", "7", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "7", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "7", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "6", ",", "7", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "6", ",", "7", ",", "8"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"848d2376-da5a-4ba9-a777-cba7239be966"]
}, Open  ]],

Cell["\<\
A budget of 0 is the seed itself; no budget at all gives the lines through it.\
\>", "ExampleText",ExpressionUUID->"a54169de-efb8-40f8-87a5-89ae5c9041e5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "0", ",", " ", 
        "All"}], "]"}], "[", "\"\<Realizations\>\"", "]"}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}], "[", "\"\<Multiplicity\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"7bb312c9-cd8a-42c0-9308-74110988c025"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"6", ",", "7"}], "}"}], "}"}], ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"1d56c5d3-85e2-4bff-b485-c6bc18e240ad"]
}, Open  ]],

Cell["\<\
The count-less call is one extension, the same one every time.\
\>", "ExampleText",ExpressionUUID->"c25249a1-dd5e-4ff4-87ee-b2b464aaac9a"],

