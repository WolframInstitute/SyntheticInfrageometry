Cell["\<\
One step per side beyond an interior edge of the grid: seven extensions.\
\>", "ExampleText",ExpressionUUID->"87ec5933-e2f3-4028-b1d3-ec2ea0f43da4"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"ExtendInfraSegment", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
   "]"}], "[", "\"\<Realizations\>\"", "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"6f2a5832-0619-44a0-aa86-aa9cad95da3d"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"2", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"2", ",", "6", ",", "7", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "7", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "7", ",", "8"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"5", ",", "6", ",", "7", ",", "11"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "6", ",", "7", ",", "3"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"10", ",", "6", ",", "7", ",", "8"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6455ba2b-c58c-4dd7-85ef-db825df27405"]
}, Open  ]],

Cell["\<\
A budget of 0 is the seed itself; no budget at all gives the lines through it.\
\>", "ExampleText",ExpressionUUID->"0444ee41-8c28-46cd-819a-4909200379da"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "0", ",", " ", 
        "All"}], "]"}], "[", "\"\<Realizations\>\"", "]"}], ",", "\n", "   ", 
     
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}], "[", "\"\<Multiplicity\>\"", "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5b2fcd13-adc2-46b0-8607-d79c301e96af"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"6", ",", "7"}], "}"}], "}"}], ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"dbc74bbb-3841-4014-9c34-4e441eb082bf"]
}, Open  ]],

