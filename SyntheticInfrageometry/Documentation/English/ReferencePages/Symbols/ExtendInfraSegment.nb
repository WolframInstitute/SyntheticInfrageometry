     "exactly ",
     StyleBox["k", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"7091d188-7a04-486c-af06-d1dd337a5a45"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f43c05b1-18f5-4af8-8930-856b01abe5f9"], Cell[TextData[{
     "{",
     StyleBox["lo", "TI"],
     ", ",
     StyleBox["hi", "TI"],
     "}"
    }], "TableText",ExpressionUUID->"daf232e0-7d84-422b-a2fc-4049cb4b7bb3"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"a683e732-245e-45ab-a644-2d3413368c0b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "08f9e7ef-6e96-434f-9924-a84420f4e3ea"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "6f111015-01ee-4493-a59b-07a2b68668fa"],
     " (default)"
    }], "TableText",ExpressionUUID->"3b9cc807-beea-4c4d-93ee-d1a0ddc5b7e9"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"cfa23949-3e02-490f-868b-d912e6fa8472"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1a0d6617-55fd-4bc5-bdbe-e4a658abf903"], Cell[
    "0", "TableText",ExpressionUUID->"12b19ea7-2165-4652-b0a6-75fc192d8446"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "e1ad783c-0e28-47e8-a6cd-92bdd182b130"]}
  }]], "2ColumnTableMod",ExpressionUUID->"89765842-5cef-4f79-9d44-\
01a7a3b1c1f9"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fbb5a899-6739-4519-96e8-fd026f890bcd"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee7ae178-7390-4700-93ca-49fdf149ef62"],
 ", one geodesic DAG per admissible pair of ends; a single admissible pair \
collapses to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dag", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7d968cd1-535d-4fe5-b8ce-46e8627c1ea4"],
 ". ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e590ca42-b227-4f98-b011-de3631284e74"],
 ", ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8fcf52c-185f-45fd-9737-87adbbf7f4ee"],
 ", ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Start\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc49e29b-0a03-4059-b85d-232da88e80bf"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<End\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "890b7861-6cbf-479a-b399-4218c266d594"],
 " are read off the DAGs without enumeration and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "aa86fe0a-e71f-4eea-90d5-e7cb8d6dd632"],
 " is one number per DAG. A bounded count streams extensions off the \
admissible pairs."
}], "Notes",ExpressionUUID->"e369c17b-b313-430a-bc53-d4a006d03e58"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0449a415-e726-4cd7-9956-766b17732de3"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b056a569-bb0f-4bdd-9f14-b883d27b369d"],
 " \[LongDash] the same pool."
}], "Notes",ExpressionUUID->"d71a2b87-0c7b-438c-aa5a-840cb0cccd21"],

Cell[TextData[{
 "The longest extensions are a selection on the result, ",
 Cell[BoxData[
  RowBox[{"SelectInfraWalk", "[", 
   RowBox[{"g", ",", " ", "pool", ",", " ", "All", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<MaxLength\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d395df7f-2712-4235-9d4c-dbc2c02de719"],
 "."
}], "Notes",ExpressionUUID->"1e7ae627-a625-48c1-9b3c-0351ab25229c"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b4e511b8-2ad8-4096-b27a-bc19beb89622"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"3b476444-d837-47cd-9589-3e8615303cbc"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"988e4e83-2706-47d2-a98c-aaf418d166db"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"eb9d3ce9-5e6a-45cc-94ee-597e9652994c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "1cb8011f-65af-468c-bf7b-94372f0ed6fb"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "c1d6564b-d290-4f74-8f7a-0b01b92cd4b1"]], "TableText",ExpressionUUID->
     "661d0dfb-c936-4c0e-9edc-d686d1b757ec"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "612f7b24-7f09-4672-900f-b01f75bd2bf5"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7e88dac5-c440-4b16-829d-e8e731633faa"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c72fe4ae-bbe7-4c4d-be7e-e8decc351456"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "876de5af-bf1c-4240-a92f-422db4af8a1f"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e63a5183-6906-461c-a79b-2bf36c9db180"]
    }], "TableText",ExpressionUUID->"00abd974-b57b-4181-884a-6adba70bae09"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2b9f6b24-dd3d-45de-8f67-41cb6e154a07"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "328ef7e7-6d2c-4a8a-86d0-7dbbb0e8a204"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "41012d46-7a74-43d6-a69e-edca0e316d88"],
     ", the pool; a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a8b4a93e-2424-48fe-ad40-d036ac375218"],
     ", which takes the admissible pairs and the branches of each DAG in \
candidate order, so the count-less call is deterministic. ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2ac97a12-cbbb-4902-804c-7a0283490aa4"],
     " takes them in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7148fdc7-2d0e-49b5-8583-dedb8d2bad6e"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "8f37e201-715e-498b-b77f-18c11df1e908"],
     " is accepted and inert, the pool having no frontier to cap."
    }], "TableText",ExpressionUUID->"24a057fa-96ae-4046-9816-10d80f6bc60b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "58c44715-3761-4a93-83f1-56ac97b4fdfe"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "70f9dad8-c5d7-4649-92fc-967265bb4b5e"]], "TableText",ExpressionUUID->
     "2fd15252-9498-431a-af52-0a1b3046f874"], Cell[TextData[{
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "9854b289-300b-4ab8-92fd-7db52282106c"],
     " (default), ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "22834d99-c31f-4f2e-a523-f3bdd096dcee"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4db9c37c-af48-472f-b7df-d4868ad5ac96"]
    }], "TableText",ExpressionUUID->"1aa5f09e-225d-4911-9b48-e27eec28be4f"], 
    Cell[TextData[{
     "which ends may move: ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "637e02a9-3e2f-4700-b1cd-4fb0e8696d22"],
     " keeps ",
     StyleBox["p1", "TI"],
     " and extends past ",
     StyleBox["p2", "TI"],
     " only, ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "3fb7e307-2caa-4247-95d1-05d82312871c"],
     " the reverse."
    }], "TableText",ExpressionUUID->"49227943-1f71-4235-8a3f-ce2eaf96066f"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "9511ac8c-901e-4841-aae6-fa4d46c8d737"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "0fff0147-67ad-4af1-9519-012d071942db"]], "TableText",ExpressionUUID->
     "c285de61-cac6-4378-8ec0-a8162898e125"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "046e22c5-0a96-4789-93fb-40edade6aeaf"]], "TableText",ExpressionUUID->
     "f315c25f-2677-435d-956c-2c3e04ae324a"], Cell[TextData[{
     "only the empty list; a rule on the extension is a local law and lives \
on ",
     Cell[BoxData["ExtendInfraGeodesic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1e38187c-146b-4898-9cb2-40a962853971"],
     "."
