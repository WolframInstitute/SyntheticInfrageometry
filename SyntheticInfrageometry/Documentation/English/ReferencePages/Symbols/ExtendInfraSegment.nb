Notebook[{

Cell[CellGroupData[{
Cell["ExtendInfraSegment", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"bc93cf1b-c218-4efb-af57-3886e0abc49c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "833ff519-a36b-4598-9b78-b14263bef855"],
 "\[LineSeparator]",
 "gives one geodesic containing ",
 StyleBox["seg", "TI"],
 ", extended past its ends by at most ",
 StyleBox["kspec", "TI"],
 " edges on each side and inextensible within that budget, as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4654b8f2-72cc-4488-86a3-7803a6be1ee7"],
 " wrapper.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"67362aa8-7f03-41a8-afe3-85b7e9c26111"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["kspec", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8c79b5c-81cd-45d2-80a6-cd1ce9de0db5"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " extensions or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e5deb07-e664-442b-8cc3-df0248fc5681"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "09bc122b-1fd7-42b6-99c0-cdab817ad6c6"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "143c9007-d5ed-43f4-8794-969177f03853"],
 " gives the whole class as a pool.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"1d186e6f-980a-4453-b576-9028bcd6d5d1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["d", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f7cf94d6-d3f0-4692-9360-3093adab1746"],
 "\[LineSeparator]",
 "gives the vertices ",
 StyleBox["x", "TI"],
 " with ",
 StyleBox["b", "TI"],
 " between ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["x", "TI"],
 " and ",
 StyleBox["d(b, x) = d(c, d)", "TI"],
 " \[LongDash] Tarski's segment construction, axiom A4 \[LongDash] as a list \
of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "04df0cd5-595e-4524-a0f6-fac000509437"],
 " atoms."
}], "Usage",ExpressionUUID->"4c5ff050-e20c-4c3e-9b52-86282ba99451"],

Cell[TextData[{
 "The seed ",
 StyleBox["seg", "TI"],
 " is a vertex sequence, an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "88366ee7-3d7f-484b-9512-7fa18df5d183"],
 " geodesic DAG, or any wrapper spreading to walks. A geodesic DAG extends ",
 StyleBox["as one object",
  FontWeight->"Bold"],
 ": the whole bundle from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 " gets the same ends."
}], "Notes",ExpressionUUID->"70b93643-2b6f-46c5-a7bb-c433f9c9ee0e"],

Cell[TextData[{
 "Everything is read off the distance matrix. With the seed running from ",
 StyleBox["p1", "TI"],
 " to ",
 StyleBox["p2", "TI"],
 ", a pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") is ",
 StyleBox["admissible",
  FontWeight->"Bold"],
 " when ",
 StyleBox["d(s, e) = d(s, p1) + d(p1, p2) + d(p2, e)", "TI"],
 " \[LongDash] the concatenation is a geodesic whichever geodesics are used, \
so the condition reads only the ends \[LongDash] when the larger of ",
 StyleBox["d(p1, s)", "TI"],
 " and ",
 StyleBox["d(p2, e)", "TI"],
 " passes ",
 StyleBox["kspec", "TI"],
 ", and when each free side is either at the budget or inextensible. The \
candidate ends are the vertices of the two extension graphs ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p2", "TI"], ",", " ", 
      StyleBox["p1", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df24695b-3ab3-4c74-9f7c-7606d3b12cef"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "494b00ab-a6be-451b-a01f-d1eccc1239ed"],
 ", cut at the budget."
}], "Notes",ExpressionUUID->"1d347758-17ad-4e5f-82b1-7e0eeeea0eb3"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "66711974-e8b3-4dbc-8cb6-33a00b3ad370"], Cell[TextData[StyleBox[
    "kspec", "TI"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"03935fd4-e2a2-4d5b-bc8a-e75f15a356c1"],
     Cell["Extension per side", "TableText",
     FontWeight->Bold,ExpressionUUID->"2af6b07f-0045-4778-857b-0697efa289e0"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
