      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "1", ",", " ", "All"}], 
     "]"}], "[", "\"\<Realizations\>\"", "]"}], ",", "\n", " ", 
