    RowBox[{"pool", " ", "=", " ", 
     RowBox[{"ExtendInfraSegment", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "2", ",", " ", "All"}],
       "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"pool", "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<Start\>\"", "]"}], ",", " ", 
     RowBox[{"pool", "[", "\"\<End\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"281bf532-c490-4c18-b46b-52ac241a73de"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"12", ",", 
   RowBox[{"InfraSet", "[", 
