     "}"
    }], "TableText",ExpressionUUID->"c2298dff-cae1-414e-82dd-cde3284fe0af"], 
    Cell[TextData[{
     "between ",
     StyleBox["lo", "TI"],
     " and ",
     StyleBox["hi", "TI"],
     " edges"
    }], "TableText",ExpressionUUID->"f84ceac9-2308-4452-9420-045b25fab53c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0b50a92d-48eb-4ad5-bbae-4c854d15a61d"], Cell[TextData[{
     Cell[BoxData["Infinity"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "495406f8-b160-4726-9f51-595b76abbadd"],
     " (default)"
    }], "TableText",ExpressionUUID->"70661526-2ba2-4aa1-ab59-bb3393d27eb3"], 
    Cell["unbounded \[LongDash] the lines through the seed", "TableText",
     ExpressionUUID->"94e47fe2-0d69-43ba-b8d8-09fba15dd4ae"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "0bc528df-d4b9-4a34-8de3-0f9a42ed5a65"], Cell[
    "0", "TableText",ExpressionUUID->"aa413251-5732-4619-b2cf-dd84ce978e53"], 
    Cell["none \[LongDash] the seed itself", "TableText",ExpressionUUID->
     "f379544b-0495-454a-b3ce-107496643212"]}
  }]], "2ColumnTableMod",ExpressionUUID->"37e18f36-c8aa-4dac-b1b9-\
eef31b7b58d7"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c2d7115f-92c1-410e-a12b-958deb8493c3"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f12a6e2-7eae-4998-a2de-007fe5aabbc3"],
 ", one geodesic DAG per admissible pair of ends; a single admissible pair \
collapses to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["dag", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "80caf0c6-2812-4130-ac8f-76b28300f840"],
 ". ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4879d4eb-3dbf-4afd-80bd-78da85128b26"],
 ", ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3fd0bd75-9990-427e-a304-e25aebc3da04"],
 ", ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Start\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9bdc794-fb9b-47e5-85f4-542162b289c7"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<End\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2bdfd502-7f74-436e-922a-bdcb92bc2e74"],
 " are read off the DAGs without enumeration and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f2aba516-9e54-483b-8cdf-d41a0d4f6c1a"],
 " is one number per DAG. A bounded count streams extensions off the \
admissible pairs."
}], "Notes",ExpressionUUID->"aca22abb-4748-4054-bc07-5b19482ec39f"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c8045990-d496-4269-80da-f31368459c85"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0e55c09-e5c5-4a26-b3b8-23f792114be5"],
 " \[LongDash] the same pool."
}], "Notes",ExpressionUUID->"05e6beba-8173-4160-87fd-4cdb9d490984"],

Cell[TextData[{
 "The longest extensions are a selection on the result, ",
 Cell[BoxData[
  RowBox[{"SelectInfraWalk", "[", 
   RowBox[{"g", ",", " ", "pool", ",", " ", "All", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<MaxLength\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ee3e5d7-c12f-4e4a-81d7-cc270cfd2ca4"],
 "."
}], "Notes",ExpressionUUID->"b33d22ed-96ea-4452-b743-db133357d87b"],

