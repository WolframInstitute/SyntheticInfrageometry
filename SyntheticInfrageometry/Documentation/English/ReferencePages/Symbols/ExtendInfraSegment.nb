Cell["With no budget the extension pool is the line pool.", "ExampleText",ExpressionUUID->"ad745685-57c8-43dd-8d87-e6abd02a9b0e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"6", ",", " ", "7"}], "}"}], ",", " ", "Infinity", ",", " ", 
        "All"}], "]"}], "[", "\"\<Realizations\>\"", "]"}]}], " ", "===", 
    "\n", "    ", 
    RowBox[{"Sort", " ", "@", " ", 
     RowBox[{
      RowBox[{"FindInfraLine", "[", 
       RowBox[{"g", ",", " ", "6", ",", " ", "7", ",", " ", "All"}], "]"}], 
      "[", "\"\<Realizations\>\"", "]"}]}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"9fe57f58-8a8c-47e6-bcdf-e1f5ae433324"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"a0ea6c10-ab34-4fad-8205-905b20d64a22"]
}, Open  ]],

Cell["\<\
Exactly one step per side gives the same seven as at most one, since every \
one-step extension is inextensible within the budget.\
\>", "ExampleText",ExpressionUUID->"541dbd8e-8cac-4ef2-93a9-a383145d237b"],

