}, Open  ]],

Cell["\<\
A whole geodesic bundle extends as one object: six geodesics from the corner, \
twelve lines through all of them.\
\>", "ExampleText",ExpressionUUID->"04f19890-3af9-4757-8e2c-e493199607f5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"seg", " ", "=", " ", 
     RowBox[{"FindInfraSegment", "[", 
      RowBox[{"g", ",", " ", "1", ",", " ", "11", ",", " ", "All"}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"seg", "[", "\"\<Multiplicity\>\"", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"ExtendInfraSegment", "[", 
       RowBox[{"g", ",", " ", "seg", ",", " ", "Infinity", ",", " ", "All"}], 
       "]"}], "[", "\"\<Multiplicity\>\"", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"bbd04a75-dda1-48ea-9ef8-bc2259825221"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "12"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"da839207-a4c8-4528-b8c1-9f611db23c3e"]
}, Open  ]],

Cell["\<\
On the 6-cycle a budget of 1 buys one extension of the edge 1\[Dash]2, a \
budget of 2 the three lines through it.\
\>", "ExampleText",ExpressionUUID->"eda03245-3cf8-49f4-92f6-a3116582a58a"],

