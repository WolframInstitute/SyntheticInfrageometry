      RowBox[{"{", 
       RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "2", ",", " ", "All"}], 
     "]"}], "[", "\"\<Realizations\>\"", "]"}]}], "}"}]], "Input",
