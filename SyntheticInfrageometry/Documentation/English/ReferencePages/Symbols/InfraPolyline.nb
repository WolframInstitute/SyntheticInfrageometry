Notebook[{

Cell[CellGroupData[{
Cell["InfraPolyline", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"6bf1b101-cf84-485b-a29a-2868debe9f15"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPolyline"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPolyline", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    StyleBox["poly", "TI"], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e1d4db9-4a59-4cec-ad44-e60993a62e82"],
 "\[LineSeparator]",
 "is the unary form: poly = {seg1, \[Ellipsis], segk} is a list of unary \
InfraSegment[{path_i}] with consecutive legs sharing their endpoint \
(Last[path_i] == First[path_{i+1}]).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"7afda59a-709c-494a-a303-ffbad3ac87da"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPolyline"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPolyline", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["poly1", "TI"], ",", " ", "...", ",", " ", 
     StyleBox["polym", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "99b61d03-68b8-4b08-a1ca-686c194462a6"],
 "\[LineSeparator]",
 "is the multi-realisation form."
}], "Usage",ExpressionUUID->"ee5b794e-cb90-4469-8847-c0f621ff0364"],

Cell["\<\
Consumed by InfraSceneHighlight (each realisation flattens to one \
concatenated vertex sequence; sequential-edge semantics).\
\>", "Notes",ExpressionUUID->"8d19bbee-587c-4616-92e3-ed3bb1975dd8"]
}, Open  ]],

