Cell["InfraPolygonQ", "Title",ExpressionUUID->"7702f203-0dcc-4e86-a1d3-739a37cbf870"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"fef8c3ee-e3f5-4fb6-9d23-e1a153531225"],

Cell["\<\
InfraPolygonQ[graph, poly] tests whether poly is a closed chain of geodesic \
InfraSegment sides (every leg a geodesic, consecutive legs sharing endpoints \
cyclically). Accepts an InfraPolygon wrapper or a bare leg list {seg1, ..., \
segn}.\
\>", "Text",ExpressionUUID->"fa8b7c5e-a0da-42d9-b4df-23aa565be483"],

