Notebook[{
Cell["FindInfraPolylineSubdivision", "Title",ExpressionUUID->"4fed9d3d-a1c0-4d1c-8545-fabe912be9b1"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"1436b2af-79ec-40e0-bcad-791a9878d34d"],

Cell["\<\
FindInfraPolylineSubdivision[graph, path] returns {InfraPolyline[{{seg1, ..., \
segk}}]} where the legs are the fewest geodesic InfraSegments whose knots are \
path-vertices and each leg is a shortest path since the previous knot. \
Option: \"MaxLength\" (Infinity (default) | numeric L) caps every leg's \
graph-length at L.\
\>", "Text",ExpressionUUID->"7a6a0487-69e5-4763-9df0-22c38e928947"],

Cell["Setup", "Section",ExpressionUUID->"9adcf9f1-0dd3-4e35-9e00-0b142b2d46be"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"4b08e60e-21c8-4d41-8f43-6106c741ad20"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"7fcbc40d-df2f-4d2c-9a16-01dbeb5c2d03"],

