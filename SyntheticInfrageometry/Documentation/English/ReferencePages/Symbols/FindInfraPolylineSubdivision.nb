Notebook[{
Cell["FindInfraPolylineSubdivision", "Title",ExpressionUUID->"441ca13f-aebc-4656-9c6e-edb86b777c33"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"8dd3dd1f-24cb-46c2-882b-b8037a178345"],

Cell["\<\
FindInfraPolylineSubdivision[graph, path] returns {InfraPolyline[{{seg1, ..., \
segk}}]} where the legs are the fewest geodesic InfraSegments whose knots are \
path-vertices and each leg is a shortest path since the previous knot. \
Option: \"MaxLength\" (Infinity (default) | numeric L) caps every leg's \
graph-length at L.\
\>", "Text",ExpressionUUID->"6e112a7f-6f2b-4a8c-8996-d22cde3cc684"],

Cell["Setup", "Section",ExpressionUUID->"e32c8be7-00a2-4507-87eb-9d6827fc9f79"],

