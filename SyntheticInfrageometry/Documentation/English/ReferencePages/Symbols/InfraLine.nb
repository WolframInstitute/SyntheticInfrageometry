Cell[CellGroupData[{
Cell["InfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"c9923dbc-8fb9-4d45-8995-3b569387003d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["line1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["linek", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01bb0e53-9f5b-4fee-a127-9ee5ef898c8a"],
 "\[LineSeparator]",
 "is a bundle of lines, each an inextensible geodesic given as a vertex \
sequence.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"53507bbb-aa47-48f7-b13f-6e4b9f5a4ce3"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["dagk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a43b7ee7-415d-4ba9-aa93-7a3a098dcfa4"],
 "\[LineSeparator]",
 "is the pool form: one geodesic DAG per pair of ends, whose source-to-sink \
paths are the lines with those ends."
}], "Usage",ExpressionUUID->"bdce32ad-4460-4f8d-9d6d-e5645f8df1e7"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "84ff55e6-6edb-47d0-a420-648e28f5fcef"],
 " returns the enumerated form for a bounded count and the pool form for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd222d1a-01e2-4c45-8fa8-97ce8cdad12a"],
 ". The two describe the same object; the pool stays small where the \
enumeration is astronomical \[LongDash] 5 242 880 lines through two vertices \
of a 313-vertex square-tiling patch fit in 104 DAGs."
}], "Notes",ExpressionUUID->"2ee0c47d-9e4f-45c9-9a3c-2d71b25ce5f3"],

Cell["Accessors on either form:", "Notes",ExpressionUUID->"4dfeb826-b4e7-4ac0-bda6-ab1709c8aaec"],

