Cell[TextData[{
 Cell[BoxData[
  RowBox[{"line", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b823c044-48a7-4d36-bac8-b80340130b5c"],
 " is the ",
 StyleBox["i", "TI"],
 "-th position across all lines as a measured ",
 Cell[BoxData["InfraEffectivePoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e771f94-b409-4129-b55a-b16ef007ee39"],
 ": its weight at a vertex is the number of lines passing through that vertex \
at that position. On the pool this is the ",
 StyleBox["i", "TI"],
 "-th layer of every DAG weighted by geodesic occupation, computed without \
enumeration; ",
 StyleBox["i", "TI"],
 " may be negative."
}], "Notes",ExpressionUUID->"88be5e73-a3ea-4ed2-876f-43c982178820"],

