Cell["\<\
The first position across the pool is a measured point: every line starts at \
one of the two ends 1 and 13, six at each.\
\>", "ExampleText",ExpressionUUID->"5fb0975d-8b14-4258-8488-f3270df3c706"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FindInfraLine", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "6", ",", " ", 
    "7", ",", " ", "All"}], "]"}], "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"72771c7d-e03d-4c98-b118-0c5b7066477a"],

Cell[BoxData[
 RowBox[{"InfraEffectivePoint", "[", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"1", "\[Rule]", "6"}], ",", 
    RowBox[{"13", "\[Rule]", "6"}]}], "\[RightAssociation]"}], 
  "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"31ab138d-4b60-47a3-9de9-03a263de8716"]
}, Open  ]],

Cell["\<\
The measure is the fraction of lines through each vertex; the anchors carry \
all of them.\
\>", "ExampleText",ExpressionUUID->"9d7f3a6d-3402-4d58-ad9c-c0393959930b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"measure", " ", "=", " ", 
     RowBox[{
      RowBox[{"FindInfraLine", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "6", ",", " ",
         "7", ",", " ", "All"}], "]"}], "[", "\"\<Measure\>\"", "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"measure", "[", "6", "]"}], ",", " ", 
     RowBox[{"measure", "[", "7", "]"}], ",", " ", 
     RowBox[{"measure", "[", "1", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"39666eec-6123-4319-a718-f1a797729c87"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", 
   FractionBox["1", "2"]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"9a97f373-6d29-4522-84d2-f7eb21f29ca2"]
}, Open  ]]
}, Open  ]],

