Cell[CellGroupData[{
Cell["InfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"f15d7bf6-1b8e-443b-b61d-f3dc3fa4b338"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["line1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["linek", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5623627a-bc0f-4d54-aa32-5b0b77282105"],
 "\[LineSeparator]",
 "is a bundle of lines, each an inextensible geodesic given as a vertex \
sequence.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"359227c2-fe54-428d-a839-a02a35b2b172"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["dagk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9e9945e3-781e-4c00-bd6b-59f71cd7b1d9"],
 "\[LineSeparator]",
 "is the pool form: one geodesic DAG per pair of ends, whose source-to-sink \
paths are the lines with those ends."
}], "Usage",ExpressionUUID->"cf6d9505-dbb8-4b22-83d8-add90cefac7f"],

Cell[TextData[{
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "6423d607-c3fd-4849-b988-ed5bcb291099"],
 " returns the enumerated form for a bounded count and the pool form for ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c86e2361-fcc3-4439-a7b7-eaa518bc2723"],
 ". The two describe the same object; the pool stays small where the \
enumeration is astronomical \[LongDash] 5 242 880 lines through two vertices \
of a 313-vertex square-tiling patch fit in 104 DAGs."
}], "Notes",ExpressionUUID->"f0a83412-54a1-40a3-9258-befb9a8609ee"],

Cell["Accessors on either form:", "Notes",ExpressionUUID->"94567940-c0d2-404a-a7bb-bbb82f6cf23f"],

