Cell["\<\
The first position across the pool is a measured point: every line starts at \
one of the two ends 1 and 13, six at each.\
\>", "ExampleText",ExpressionUUID->"a82cb8e5-ca2c-4482-9dd7-35963b513dd8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"FindInfraLine", "[", 
   RowBox[{
    RowBox[{"GridGraph", "[", 
     RowBox[{"{", 
      RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "6", ",", " ", 
    "7", ",", " ", "All"}], "]"}], "[", 
  RowBox[{"[", "1", "]"}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"10351e5e-7af5-4f96-b917-ac4cbd459404"],

Cell[BoxData[
 RowBox[{"InfraEffectivePoint", "[", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"1", "\[Rule]", "6"}], ",", 
    RowBox[{"13", "\[Rule]", "6"}]}], "\[RightAssociation]"}], 
  "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"31c1bfa1-aa3d-4688-93fe-84451c44ddf2"]
}, Open  ]],

Cell["\<\
The measure is the fraction of lines through each vertex; the anchors carry \
all of them.\
\>", "ExampleText",ExpressionUUID->"aee2f16f-eb3a-4370-8c00-149bfc181115"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"measure", " ", "=", " ", 
     RowBox[{
      RowBox[{"FindInfraLine", "[", 
       RowBox[{
        RowBox[{"GridGraph", "[", 
         RowBox[{"{", 
          RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "6", ",", " ",
         "7", ",", " ", "All"}], "]"}], "[", "\"\<Measure\>\"", "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"measure", "[", "6", "]"}], ",", " ", 
     RowBox[{"measure", "[", "7", "]"}], ",", " ", 
     RowBox[{"measure", "[", "1", "]"}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"5a5ce6f4-4fff-46f4-9881-a2c35007508f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1", ",", 
   FractionBox["1", "2"]}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"92761852-4c14-485a-bacb-0fc7faf11ba0"]
}, Open  ]]
}, Open  ]],

