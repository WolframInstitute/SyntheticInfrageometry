Cell[TextData[{
 Cell[BoxData[
  RowBox[{"line", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cf8c2053-4af8-4334-b547-997fd8ad0484"],
 " is the ",
 StyleBox["i", "TI"],
 "-th position across all lines as a measured ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraEffectivePoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraEffectivePoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "82253f2e-2e3c-446a-ac89-91bcc81cea5b"],
 ": its weight at a vertex is the number of lines passing through that vertex \
at that position. On the pool this is the ",
 StyleBox["i", "TI"],
 "-th layer of every DAG weighted by geodesic occupation, computed without \
enumeration; ",
 StyleBox["i", "TI"],
 " may be negative."
}], "Notes",ExpressionUUID->"ed881e37-a7ee-43c2-8ddc-34b4007e3ef5"],

