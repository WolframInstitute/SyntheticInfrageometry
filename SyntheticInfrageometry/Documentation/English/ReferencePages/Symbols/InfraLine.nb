Notebook[{
Cell["InfraLine", "Title",ExpressionUUID->"f3d9fc1e-a963-438d-9b7f-2d602f193a5d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"ce535f5d-6b46-4e09-adb9-97213d47da04"],

Cell["\<\
InfraLine[p, q] represents maximal geodesic extensions through p and q. \
InfraLine[path] extends a given path. Multi-realisations are returned as \
