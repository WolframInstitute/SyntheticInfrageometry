Notebook[{
Cell["FindInfraEllipticShell", "Title",ExpressionUUID->"89ee9129-19fa-4722-8f45-c8ae8d0c302e"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"e27b193f-b04b-46c0-a86d-6bf6f6dc4917"],

Cell["\<\
FindInfraEllipticShell[graph, {p1, p2}, c] returns \
{InfraEllipticShell[{levelSet}]} for the elliptic shell { v : d(p1,v) + \
d(p2,v) == c }; c may be {cMin, cMax} for a tolerance band. \
FindInfraEllipticShell[graph, {p1, p2}, c, n] returns a List of n unary \
InfraEllipticShell[{set}] wrappers or $Failed; UpTo[n] returns up to n; All \
returns all. Options: Properties (list of \"Separating\" / \"Connected\"; \
empty default returns the level set itself), Method (\"Exhaustive\" (default; \
BFS over the peel-DAG, accepts nested {\"Exhaustive\", \"Pruning\" -> spec}) \
| \"Greedy\" (DFS, one realisation); ignored when Properties is empty).\
\>", "Text",ExpressionUUID->"085b0daa-68a4-43f7-bb38-f3c3199140dc"],

Cell["Setup", "Section",ExpressionUUID->"b3246d40-b785-41ba-91ba-dfdee69de8de"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"b753cf0f-32c0-4c09-8364-fd31c2e1461d"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"cc81c8f8-adf9-465a-ace3-81b6c48da334"],

Cell["Related Guides", "Section",ExpressionUUID->"a1ca2be7-bca2-47d4-abac-7edd05b18738"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"8e675524-f189-482c-baa8-5e3b94a08aeb"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"1cdbe317-c628-4a6b-a2b8-37b4fea57843"]
},
