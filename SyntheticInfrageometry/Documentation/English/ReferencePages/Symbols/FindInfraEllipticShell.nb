Notebook[{

Cell[CellGroupData[{
Cell["FindInfraEllipticShell", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5723cc5c-38d4-4c03-8e16-e3de39d6a436"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraEllipticShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraEllipticShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6ebe46ac-993d-44b7-9988-7dd1f1b11e04"],
 "\[LineSeparator]",
 "returns {InfraEllipticShell[{levelSet}]} for the elliptic shell { v : \
d(p1,v) + d(p2,v) == c } (c may be {cMin, cMax}).",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"fc93d82d-8a2e-48c7-80c2-c1de0aedbf25"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraEllipticShell"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraEllipticShell", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p1", "TI"], ",", " ", 
      StyleBox["p2", "TI"]}], "}"}], ",", " ", 
    StyleBox["c", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c37ca909-e591-4370-b80a-2fbb3f1073d1"],
 "\[LineSeparator]",
 "returns exactly n or $Failed; UpTo[n] returns up to n; All returns all. \
Under the default Properties -> {} the level set is the one realisation; \
under {\"Separating\"} the count-less call is one minimal separating subset."
}], "Usage",ExpressionUUID->"49a06425-df7f-4b4f-934f-a93be0933ed4"],

Cell["Options:", "Notes",ExpressionUUID->"611fad9e-5d4b-447a-9c32-a10baad1cbea"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "a895a3d0-b990-4e8e-b4b1-847b84518619"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"2b3664a4-c511-4efd-834f-7254e5c82f29"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"e1483399-2169-4b66-b340-929ac8ca2c62"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5c644def-d84e-43be-9285-bb3179d61eff"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "a9b1b5c5-8be2-43ad-9fde-34cf23e5a4ad"]], "TableText",ExpressionUUID->
     "f413151f-1980-41ad-b2d2-88e308b4c09b"], Cell[
    "\"Separating\", \"Connected\"", "TableText",ExpressionUUID->
     "9513181e-c023-4a54-83d4-a8562da59f95"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7b38e841-006d-404f-a206-573294c9074f"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "96852046-9863-426f-9a1f-3b4acd5960c7"]], "TableText",ExpressionUUID->
     "ccdae695-30ee-400e-b9a2-60c0cbb74baf"], Cell["\<\
Automatic (default), \"Exhaustive\", {\"Exhaustive\", \"Pruning\" -> spec}, \
\"Greedy\", \"RandomGreedy\" \[LongDash] Automatic resolves by the count, All \
to \"Exhaustive\" and a bounded or absent count to \"Greedy\"; the class is \
the same under every value, \"RandomGreedy\" peels in random order under an \
ambient SeedRandom, and \"Pruning\" caps the removable vertices tried per \
layer\
\>", "TableText",ExpressionUUID->"405f3316-376c-4574-8832-c0bdeceb26e8"]}
  }]], "2ColumnTableMod",ExpressionUUID->"871ad15b-259a-4650-a933-\
0c7c948fa1c3"]
}, Open  ]],

