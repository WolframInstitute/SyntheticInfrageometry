   {Cell["      ", "ModInfo",ExpressionUUID->
     "18dfe973-1180-4507-88f7-da686107ca27"], Cell[
    "Birkhoff", "TableText",ExpressionUUID->
     "b2a0943d-48fb-497f-ab55-3e6488c6e118"], Cell[
    "Ruler postulate", "TableText",ExpressionUUID->
     "ea9cd81d-beb8-4f40-88ce-6aa94fa6e9f5"], Cell[TextData[{
     Cell[BoxData[
      StyleBox["w", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "238bf3cb-9fea-44f7-8e25-f4056bcaa324"],
     " is between ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1899754c-ab6f-4f59-8723-5ee08a8e0d79"],
     " and ",
     Cell[BoxData[
      StyleBox["v", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "d89eaafc-0f72-4d09-8683-6a3c03c510ca"],
     " iff its ruler coordinate lies between theirs."
    }], "TableText",ExpressionUUID->"9a2b7035-a4fc-4b36-9d17-cd6d574020d3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"92d959df-fd01-47d7-8e70-\
ac64bb3ccbef"]
}, Open  ]],

