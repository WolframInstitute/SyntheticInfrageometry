Cell["\<\
Betweenness holds for every midpoint of two vertices, on each substrate.\
\>", "ExampleText",ExpressionUUID->"b1bfea26-c860-439d-8f7c-924892d17718"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"AllTrue", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FindInfraMidpoint", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}], 
          "[", "\"\<Realizations\>\"", "]"}], ",", " ", 
         RowBox[{
          RowBox[{"BetweennessQ", "[", 
           RowBox[{"g", ",", " ", "a", ",", " ", "#", ",", " ", "b"}], "]"}], 
          " ", "&"}]}], "]"}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"779c7df1-6dff-445d-a814-905f3932cadb"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Square\"\>", "\[Rule]", "True"}], ",", 
   RowBox[{"\<\"Hexagonal\"\>", "\[Rule]", "True"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6293d27e-6371-4be7-bb63-f98f6507d2e0"]
}, Open  ]],

Cell["\<\
The set of vertices satisfying betweenness is the metric interval, and on a \
lattice it is broad rather than thin.\
\>", "ExampleText",ExpressionUUID->"8454f6bc-9b1f-4d1c-b1f5-a78e9ef10b47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
          RowBox[{
           RowBox[{"BetweennessQ", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#", ",", " ", "b"}], "]"}],
            " ", "&"}]}], "]"}]}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"940fe265-82c9-4c7d-bb4a-6a9a928b9fd5"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", "9"}], ",", 
   RowBox[{"\<\"Square\"\>", "\[Rule]", "12"}], ",", 
   RowBox[{"\<\"Hexagonal\"\>", "\[Rule]", "10"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"454ad020-8ba9-4cc5-a297-47afc5b21f6d"]
}, Open  ]],

Cell["\<\
That interval, drawn on the square grid: every vertex between the two \
endpoints, not merely those on one geodesic.\
\>", "ExampleText",ExpressionUUID->"24a922b8-ee61-466e-90bc-ee81aafa8e28"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
       RowBox[{"ExampleGraphData", "[", 
        RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}], ",", 
       " ", 
       RowBox[{"Sequence", " ", "@@", " ", 
        RowBox[{"AmbientGraphStyle", "[", "\"\<Gray\>\"", "]"}]}]}], "]"}]}], 
    "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"InfraSceneHighlight", "[", 
    RowBox[{"g", ",", "\n", "    ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"InfraSet", "[", 
         RowBox[{"Select", "[", 
          RowBox[{
           RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
           RowBox[{
            RowBox[{"BetweennessQ", "[", 
             RowBox[{"g", ",", " ", "a", ",", " ", "#", ",", " ", "b"}], 
             "]"}], " ", "&"}]}], "]"}], "]"}], " ", "->", " ", 
        "$InfraShellColor"}], ",", "\n", "     ", 
       RowBox[{
        RowBox[{"InfraPoint", "[", 
         RowBox[{"{", 
          RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
        "$InfraPointColor"}]}], "}"}], ",", "\n", "    ", 
     RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n", 
     "    ", 
     RowBox[{"VertexShapeFunction", " ", "->", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
          RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], ")"}]}], ",",
