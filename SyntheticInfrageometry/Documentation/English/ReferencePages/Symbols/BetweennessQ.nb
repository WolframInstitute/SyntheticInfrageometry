Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e2529291-d399-4c10-8be7-55ea322a25bf"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["BetweennessQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/BetweennessQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "da1fd4a9-5d58-4e88-962a-fdbbb4decd0c"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ccab85f0-9009-49ac-a0a6-a67c8de20666"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"59e79767-9abf-4eee-8c25-d9a62f08da22"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "033e5869-0b2a-4eea-b7f5-bc9f5c7ead36"],
 " holds exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fe098a32-8d13-49a9-aea5-0bdd25794b8f"],
 "."
}], "Notes",ExpressionUUID->"16a5fbeb-3e76-4306-960f-b8d3fe7db717"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["EquidistanceQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/EquidistanceQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "68624cb4-9f65-4186-81b6-2af605bf02c7"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9db071c7-50b2-40ce-8d58-657d9ae7e729"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"b2a931cf-4256-46f7-b246-79570b3305c8"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58bd14d3-f74e-4dae-8f6f-9f664891a97f"],
 ", not last."
}], "Notes",ExpressionUUID->"fd7263c4-3ec1-4072-9ffe-5cf6376ee100"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"595fc683-7ad3-4731-831c-0a57002bc47f"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"1ee80abf-c20f-4842-9ad7-f2625ac1456d"],

