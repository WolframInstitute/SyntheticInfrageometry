      "b9938207-1231-4061-bd72-c411e55f2c20"],
     " is between ",
     Cell[BoxData[
      StyleBox["u", "TI"]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e76f9686-87c6-4302-b148-d034b56c42d3"],
     " and ",
