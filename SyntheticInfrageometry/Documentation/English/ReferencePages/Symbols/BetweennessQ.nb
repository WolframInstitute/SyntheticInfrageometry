Cell[CellGroupData[{
Cell["BetweennessQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"e159e15f-cfe5-467f-ac70-c09d9bd8dcb4"],
 Cell[BoxData[
  RowBox[{"BetweennessQ", "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c160d7c-2d8d-4903-b150-bbd2b6b6d2ee"],
 "\[LineSeparator]",
 "tests Tarski's betweenness ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ede48933-a51a-43b6-a91e-5bd1e4c8999c"],
 ": whether ",
 StyleBox["w", "TI"],
 " lies on a geodesic from ",
 StyleBox["u", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"164da097-c98e-49d2-a298-a544a1a4a446"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "711e48ed-a4ec-4507-b791-97fc125dd8bc"],
 " holds exactly when ",
 Cell[BoxData[
  RowBox[{
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "+", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1], "=", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "668335d7-1167-4fa9-9b2f-204eb4ddb6e4"],
 "."
}], "Notes",ExpressionUUID->"934ce03f-7c94-45a9-8991-5a24dabc98f5"],

Cell[TextData[{
 "Betweenness is one of the two primitives of Tarski's axiomatization \
\[LongDash] the other is equidistance, tested by ",
 Cell[BoxData["EquidistanceQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58aa4b98-8f45-4b86-9749-55e057f27328"],
 " \[LongDash] so this predicate is where the classical axiom system meets \
the graph. ",
 Cell[BoxData["TarskiAxiomQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b6eda4f9-e145-4a2c-8420-732765348fc9"],
 " and the eleven individual axiom predicates are all built from these two."
}], "Notes",ExpressionUUID->"1a52d01a-ff74-4ecb-85ed-12f7cbeb29fa"],

Cell[TextData[{
 "Note the argument order: the ",
 StyleBox["middle",
  FontWeight->"Bold"],
 " point is second, matching Tarski's ",
 Cell[BoxData[
  RowBox[{
   StyleBox["B", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
   RowBox[{
    StyleBox["u", "TI"], ",", 
    StyleBox["w", "TI"], ",", 
    StyleBox["v", "TI"]}], 
   StyleBox[")",
    SpanMaxSize->1]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4103d322-734c-4ce1-878e-4242ac1e5b86"],
 ", not last."
}], "Notes",ExpressionUUID->"3102b9ad-365a-4a6d-b545-32adeb705209"],

Cell[TextData[{
 "Unlike the plane, a graph has no order-completeness. Betweenness holds for \
a whole ",
 StyleBox["set", "TI"],
 " of middle vertices, which is exactly the metric interval, and that set can \
be large: on a square grid the vertices between two points fill a whole \
diamond, not a line."
}], "Notes",ExpressionUUID->"a2befc35-704c-4d53-847c-f8e53afb9495"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"1c95b578-be15-495b-844f-7da2318bdde7"],

