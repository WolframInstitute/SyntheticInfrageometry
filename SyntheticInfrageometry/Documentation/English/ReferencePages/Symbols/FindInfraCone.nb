Notebook[{
Cell["FindInfraCone", "Title",ExpressionUUID->"17cdca02-5243-45c9-91d0-22723395d20b"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"8911bbc0-387a-4971-98af-cf657cb5f64d"],

Cell["\<\
FindInfraCone[graph, axis, slope] returns InfraObject[set] for the cone of \
given slope with apex at axis[[1]]: radii are slope * Range[0, Length[axis] - \
1]. Option \"Apex\" (First (default) | Last) flips the apex end; inherits \
remaining options from FindInfraRevolution.\
\>", "Text",ExpressionUUID->"68e78cf4-5caf-42d1-8122-74e697a6235a"],

Cell["Setup", "Section",ExpressionUUID->"ef420984-c1c0-48c7-8389-ced39eb35366"],

