Notebook[{
Cell["FindInfraCone", "Title",ExpressionUUID->"51193b5f-7ff2-4f78-bce8-2de14df8cb9e"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"b311be53-6311-40a6-abc2-34397b77fdb2"],

Cell["\<\
FindInfraCone[graph, axis, slope] returns InfraObject[set] for the cone of \
given slope with apex at axis[[1]]: radii are slope * Range[0, Length[axis] - \
1]. Option \"Apex\" (First (default) | Last) flips the apex end; inherits \
remaining options from FindInfraRevolution.\
\>", "Text",ExpressionUUID->"653e321b-a47d-408f-bc00-e5ff868016b3"],

Cell["Setup", "Section",ExpressionUUID->"08303295-56aa-4c7d-89db-b2fe0566c02f"],

