    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "245d3fc4-b9e4-4ee7-863c-b49aac70c33b"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "2"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eee6ef9b-8df5-4a09-a0bc-83edf059869b"],
 " as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPlane", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "b77617c4-64f3-43ca-830a-2a6dcdf6c6b0"],
 " wrapper. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "41b07317-b0f2-4bda-8694-b421f1153b47"],
 " widens it to the slab ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], 
   StyleBox["o", "TI"], "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
