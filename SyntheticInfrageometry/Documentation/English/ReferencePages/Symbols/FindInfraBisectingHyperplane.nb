Cell["\<\
The bisector exists at even distance and is empty at odd \[LongDash] a parity \
obstruction, not a failure of the construction.\
\>", "ExampleText",ExpressionUUID->"5377958f-bdd8-49f1-ae71-7fb652cde3e7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"even", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "6"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"odd", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<distance 6\>\"", " ", "->", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{
        RowBox[{"FindInfraBisectingHyperplane", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "even"}], "]"}], 
        "[", "\"\<Volume\>\"", "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<distance 5\>\"", " ", "->", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{
        RowBox[{"FindInfraBisectingHyperplane", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "odd"}], "]"}], 
        "[", "\"\<Volume\>\"", "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"34ad6096-c315-4200-810a-d2df7309768c"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"distance 6\"\>", "\[Rule]", "15"}], ",", 
   RowBox[{"\<\"distance 5\"\>", "\[Rule]", "0"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"0faa4ba7-cbc3-4be4-90ef-13ade5f3c562"]
}, Open  ]],

Cell["\<\
The bisector of two vertices at distance 6, drawn with its endpoints. It runs \
clear across the patch, separating one from the other.\
\>", "ExampleText",ExpressionUUID->"bd36d1be-a36e-4044-bc1b-23b3e930c132"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"Graph", "[", 
      RowBox[{
