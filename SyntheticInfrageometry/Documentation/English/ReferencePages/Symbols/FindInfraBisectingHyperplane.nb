Cell[CellGroupData[{
Cell["FindInfraBisectingHyperplane", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b0b36398-44ee-4dc4-95d2-b282e302fb58"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraBisectingHyperplane", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "346b3276-4201-413c-951a-21feb851a23d"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["v", "TI"], ":", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "1"], ",", 
       StyleBox["v", "TI"]}], ")"}], "\[LongEqual]", 
     StyleBox["d", "TI"], 
     RowBox[{"(", 
      RowBox[{
       SubscriptBox[
        StyleBox["p", "TI"], "2"], ",", 
       StyleBox["v", "TI"]}], ")"}]}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "66d3c957-bd31-44b6-8d02-4dd29108754e"],
 " as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPlane", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0a49e284-9a6a-4691-bf58-d4d967a81cc1"],
 " wrapper. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e3c44275-76ff-461d-ad0c-7f34aca09625"],
 " widens it to the slab ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["l", "TI"], 
    StyleBox["o", "TI"], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", 
    StyleBox["h", "TI"], 
    StyleBox["i", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7b19f80e-02b4-4a45-b924-d332b4336464"],
 ".",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5e867a02-da4e-49cb-b4ed-afe4ae1ca48a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraBisectingHyperplane"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
FindInfraBisectingHyperplane", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["p1", "TI"], ",", " ", 
    StyleBox["p2", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ef7e4763-9ba4-4209-b2e9-bf20ad191232"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " realisations or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0433462-6d17-498c-a6ff-009b91e4224f"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1230bb04-aec8-424d-8ca2-c853a97155cf"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9416d26e-ece9-490a-8e8c-02e3b79767cd"],
 " gives all of them. Under the default ",
 Cell[BoxData[
  RowBox[{"Properties", " ", "->", " ", 
   RowBox[{"{", "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "703dbd0f-0e13-4e48-a120-24fdcbbe4e9c"],
 " the slab is the one realisation."
}], "Usage",ExpressionUUID->"fddc8dec-34a6-41af-bfd2-f8b1238eb6d2"],

Cell[TextData[{
 "The bisector of ",
 StyleBox["p1", "TI"],
 " and ",
 StyleBox["p2", "TI"],
 " is the set of vertices equidistant from both. It is the codimension-1 \
object of the metric: in the plane a line, here a vertex set."
}], "Notes",ExpressionUUID->"e923ecd1-6779-40e6-8bb1-152cbb77ed9b"],

Cell[TextData[{
 StyleBox["It is empty at odd distance.",
  FontWeight->"Bold"],
 " If ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["d", "TI"], "(", 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     SubscriptBox[
      StyleBox["p", "TI"], "2"]}], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7113b5be-3a03-4259-8790-ae9e33aa1d97"],
 " is odd then no vertex can be equidistant from both, since the two \
distances would have to be equal halves of an odd number. Below, two vertices \
at distance 6 on a square grid have a 21-vertex bisector, while at distance 5 \
the bisector is empty. This is the same parity obstruction that makes ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "2bcfd5ce-9306-4aed-ab52-f061a34e692b"],
 " return a two-vertex effective point at odd distance, seen one dimension up."
}], "Notes",ExpressionUUID->"9e74a365-a9aa-4560-9bb5-232de4e1171b"],

Cell[TextData[{
 "The ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fadb9987-9f8a-4923-9f81-f8f963e62337"],
 " slab is the repair: widening to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "1"}], "\[LessEqual]", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "1"], ",", 
      StyleBox["v", "TI"]}], ")"}], "-", 
    StyleBox["d", "TI"], 
    RowBox[{"(", 
     RowBox[{
      SubscriptBox[
       StyleBox["p", "TI"], "2"], ",", 
      StyleBox["v", "TI"]}], ")"}], "\[LessEqual]", "1"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a8f35087-3402-4709-a750-64beb53a8fe0"],
 " catches the vertices that straddle the bisector and is non-empty at either \
parity."
}], "Notes",ExpressionUUID->"8b58949f-acdc-4dd3-a273-f081b2e2ae78"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "890627d4-38fa-4054-9d6c-4fa5b84e3994"],
 " takes ",
 Cell[BoxData[
  RowBox[{"{", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5f908f21-07a2-464c-b445-4399cc6ade27"],
 " (default; the slab itself as one realisation), ",
 Cell[BoxData[
  RowBox[{"{", "\"\<Separating\>\"", "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "013ec75d-0345-4538-8c91-7e410f66d5c8"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d7027a80-c76b-4e17-8a28-e4ab41032d4b"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30b05aa2-4b53-4b45-8635-d044815ec637"],
 " takes ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a15ac9fc-37bd-4686-9e55-5b216e798010"],
 " (default), ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bb3f58d-039d-4790-8692-81938d5cd2fc"],
 ", ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
    RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "635b0f88-e0f6-43e5-8f7f-3391432694de"],
 ", ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "942676bf-cbfb-4312-9587-53a7d934829d"],
 " or ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "40331d2d-cd19-4d7b-9e36-b79a2568d64c"],
 ", and is read only when ",
 Cell[BoxData["Properties"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "166d997c-2301-4a06-b9a5-6bb524f922e8"],
 " names a class to search: ",
 Cell[BoxData["Automatic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c78805b3-38b6-4c49-981e-c7ffb6384f80"],
 " resolves by the count \[LongDash] ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9d9f02da-aab5-440c-b3fe-4c84de9321ec"],
 " to ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cefb73ee-3d58-491b-9a8a-09c041293628"],
 "; a bounded or absent count to ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e9696915-27e2-43c2-bd25-833efe670c37"],
 ", the lazy peel, so the count-less call is one minimal subset, \
deterministic \[LongDash] and the class is the same under every value. ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8911f8d2-374d-4b1c-8f9c-85ad296e2c9c"],
 " peels in random order, seeded by an ambient ",
 Cell[BoxData["SeedRandom"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3ae808f8-1602-49a2-ab95-e0e6f529381e"],
 "; ",
 Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f9661a23-ba85-4896-868b-84aced1e717c"],
 " caps the removable vertices tried per layer, and the result is then \
minimal among the survivors. The ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Volume\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8f7ccc79-cab6-404d-bdb3-15d9d733a1b7"],
 " accessor gives the per-realisation vertex count."
}], "Notes",ExpressionUUID->"5207bacf-7353-4fc6-83a3-1ebbedbb78fa"],

