  FontSize->0.9 Inherited,ExpressionUUID->
  "e7ccaa34-38e9-4542-91b2-e768084f15ac"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d8ae294c-4a05-4dc3-8235-f55994f4fe2e"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27f19e8a-a81f-4c3a-81fe-ce2876cdcbdd"],
 " takes ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "254da4c2-7e0f-4814-ae94-33f85db4eaff"],
 " (default) or ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5a2547e-6ad5-4f3b-91a4-58cc7364e800"],
 ". The ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Volume\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b885e836-5795-4bbc-b99f-97704f20b715"],
 " accessor gives the per-realisation vertex count."
}], "Notes",ExpressionUUID->"0e4f73f3-e404-4037-8277-8f903f16cf0f"],

