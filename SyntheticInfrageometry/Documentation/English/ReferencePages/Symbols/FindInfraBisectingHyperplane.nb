  "c9c1c19a-4924-479c-9eb8-085f55e0764d"],
 " (inclusion-minimal subsets that disconnect ",
 StyleBox["p1", "TI"],
 " from ",
 StyleBox["p2", "TI"],
 "), or ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"\"\<Separating\>\"", ",", " ", "\"\<Connected\>\""}], "}"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e1104962-29e2-4909-97f6-dd25878be85c"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0490234-de48-49f8-85fe-08ab6b7fedca"],
 " takes ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1e0c562c-10a0-4c01-b225-1383785b09b8"],
 " (default) or ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f8eefa8e-20b2-42a9-abd7-a6bd1692c59e"],
 ". The ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Volume\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "17927047-8909-49b2-9e76-78fb20092b8e"],
 " accessor gives the per-realisation vertex count."
}], "Notes",ExpressionUUID->"c10ea594-7d1c-4cfa-8904-89012a8e2df2"],

