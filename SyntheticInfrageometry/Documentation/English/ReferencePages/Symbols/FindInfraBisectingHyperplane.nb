  FontSize->0.9 Inherited,ExpressionUUID->
  "3e22a4b5-df42-4cf1-8914-cccdcf150e0c"],
 "\[LineSeparator]",
 "gives the perpendicular bisector ",
 Cell[BoxData[
  RowBox[{
   RowBox[{"{", 
    StyleBox["v", "TI"]}], ":", 
   RowBox[{
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "1"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "=", 
    StyleBox["d", "TI"], 
    StyleBox["(",
     SpanMaxSize->1], 
    RowBox[{
     SubscriptBox[
      StyleBox["p", "TI"], "2"], ",", 
     StyleBox["v", "TI"]}], 
    StyleBox[")",
     SpanMaxSize->1], "}"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "406af448-a58c-4de2-a205-cefabf67ad4b"],
 " as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraPlane"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPlane", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "38732f6a-1368-4182-9926-c0ea7e6a7cfd"],
 " wrapper. A positional ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"lo", ",", " ", "hi"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2e52acb5-c13d-44d9-810f-7cf3dca9e29f"],
 " widens it to the slab ",
 Cell[BoxData[
  RowBox[{
   StyleBox["l", "TI"], 
   StyleBox["o", "TI"], "\[LessEqual]", 
   StyleBox["d", "TI"], 
   StyleBox["(",
    SpanMaxSize->1], 
