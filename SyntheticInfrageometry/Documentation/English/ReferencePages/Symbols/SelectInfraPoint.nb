Notebook[{
Cell["SelectInfraPoint", "Title",ExpressionUUID->"15805283-1c27-4740-8a4e-66ae600350d9"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"6a554116-f89a-4866-b5c4-4fa4e557eaa5"],

Cell["\<\
SelectInfraPoint[graph, vertices] returns one vertex drawn from the bundle \
treated as a finite metric space under graph distance. \
SelectInfraPoint[graph, vertices, n] returns exactly n unary InfraPoint[{v}] \
wrappers or $Failed; UpTo[n] returns up to n; All returns the whole filtered \
pool. Options mirror FindInfraPoint: \"From\" (All (default), \"Center\", \
\"Periphery\", anchor -> spec, InfraPoint[{...}] -> spec, vertex, list), \
\"Distance\" (None (default), \"Max\", d, {dMin, dMax}), \"MaxCliques\". \
Accepts InfraPoint[{...}]; preserves the wrapper. Operator form \
SelectInfraPoint[graph, n, opts][vertices].\
\>", "Text",ExpressionUUID->"cf8f5c60-fb1d-428f-94aa-b3377c3f3f69"],

Cell["Setup", "Section",ExpressionUUID->"103cbb10-482f-4d31-be5a-028cecb116f4"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"6c2a837e-0580-4925-8971-4dda14eac25a"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"7a83947f-e9a7-4cf8-b5a5-83b93993aa96"],

Cell["Related Guides", "Section",ExpressionUUID->"199d6d95-1081-4d51-9c72-3dc87a446cad"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"9ba6f981-7967-44dc-9e44-901add3b43c2"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"748969c6-c8ef-454b-a3b0-b97d1d50122f"]
},
