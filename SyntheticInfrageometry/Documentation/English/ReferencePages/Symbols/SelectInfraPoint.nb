Notebook[{
Cell["SelectInfraPoint", "Title",ExpressionUUID->"5ab4af05-0d13-4cd7-805e-72698d12aa2d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"e1543a28-17c6-4728-b86b-21dabdc9188a"],

Cell["\<\
SelectInfraPoint[graph, vertices] returns one vertex drawn from the bundle \
treated as a finite metric space under graph distance. \
SelectInfraPoint[graph, vertices, n] returns exactly n unary InfraPoint[{v}] \
wrappers or $Failed; UpTo[n] returns up to n; All returns the whole filtered \
pool. Options mirror FindInfraPoint: \"From\" (All (default), \"Center\", \
\"Periphery\", anchor -> spec, InfraPoint[{...}] -> spec, vertex, list), \
\"Distance\" (None (default), \"Max\", \"Spread\", d, {dMin, dMax}), \
\"MaxCliques\". Accepts InfraPoint[{...}] or any set-like Infra* wrapper \
(InfraBall, InfraShell, InfraSet, ...) as the bundle. Operator form \
SelectInfraPoint[graph, n, opts][vertices].\
\>", "Text",ExpressionUUID->"274f1629-e6dd-4f7b-8942-cfb63c52fa0c"],

Cell["Setup", "Section",ExpressionUUID->"fbae7d00-bbe9-4d8a-9d11-0f9b345d226c"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"e87eccb9-f1eb-46f3-9c69-a4cc5e6e7f40"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"bdbcdf49-c17e-4eab-92c0-b32b96ed4a67"],

Cell["Related Guides", "Section",ExpressionUUID->"b8c010ba-d396-4349-8538-e21404fadb9e"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"7e303fae-0b87-407c-bc2e-0b3e6d134261"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"056fa6f8-d6cd-4c2b-bfc5-1b0e712e120f"]
},
