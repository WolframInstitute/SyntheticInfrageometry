Notebook[{
Cell["ExtendInfraPath", "Title",ExpressionUUID->"f0f7f5b2-8d6d-41d1-bead-2b554d379297"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"aff4eb54-21b1-498b-82ea-fb8f55ba68c4"],

Cell["\<\
ExtendInfraPath[graph, path] extends a walk by a per-step geometric rule \
until inextensible and returns a List of unary InfraPath[{walk}] wrappers. \
ExtendInfraPath[graph, path, n] / UpTo[n] / All controls multiplicity; the \
multi-realisation InfraPath wrapper spreads. Options: Properties (same \
per-step constraints as FindInfraPath; default {} allows non-simple \
extensions), Method (\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\" \
-> spec}), \"Length\" (Automatic (default; extend until inextensible) or \
integer step budget), \"Direction\" (\"BothSides\" (default; per-step \
symmetric -- each step adds at most one vertex on each side, a side freezes \
when stuck while the other keeps growing), \"Forward\", \"Backward\").\
\>", "Text",ExpressionUUID->"01a16d39-56bc-4973-9eea-78900f3a5ed9"],

Cell["Setup", "Section",ExpressionUUID->"bf817a16-a5c7-47df-a3fd-c06a9d2536fb"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"5978d4c3-29d7-450d-8326-fa9722dff66b"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"3fa033ef-232b-4090-a681-f71aec95f082"],

Cell["Related Guides", "Section",ExpressionUUID->"bb7f733d-31fc-4078-8e4c-8dc64be8d88e"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"d2a35826-d582-4bb7-97b9-b46166e4a8a8"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"a4ecf78f-87b6-4b8c-bb5c-c978a771ff6e"]
},
