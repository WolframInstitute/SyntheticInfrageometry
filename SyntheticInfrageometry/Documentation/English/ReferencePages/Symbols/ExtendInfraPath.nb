Notebook[{
Cell["ExtendInfraPath", "Title",ExpressionUUID->"de45f942-a828-46e7-b633-357776e37ef4"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d68e2e9b-df38-458a-9a07-9d314f3e8e2c"],

Cell["\<\
ExtendInfraPath[graph, path] extends a walk by a per-step geometric rule \
until inextensible and returns a List of unary InfraPath[{walk}] wrappers. \
ExtendInfraPath[graph, path, n] / UpTo[n] / All controls multiplicity; the \
multi-realisation InfraPath wrapper spreads. Options: Properties (same \
per-step constraints as FindInfraPath; default {} allows non-simple \
extensions), Method (\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\" \
-> spec}), \"Length\" (Automatic (default; extend until inextensible) or \
integer step budget), \"Direction\" (\"BothSides\" (default; per-step \
symmetric -- each step adds at most one vertex on each side, a side freezes \
when stuck while the other keeps growing), \"Forward\", \"Backward\").\
\>", "Text",ExpressionUUID->"fe213a1f-42a7-4228-be18-6be4ad3b9726"],

Cell["Setup", "Section",ExpressionUUID->"98b7e1d7-38b3-42d3-ba5b-90d74beb4a0c"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"e631b0bf-b667-41ca-b624-40bbade2d3b1"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"daf409c5-73e9-450e-91ee-5907dbe76523"],

Cell["Related Guides", "Section",ExpressionUUID->"88947a77-4337-44eb-b37b-83c49ae401c8"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"f6f9ef20-ddb2-4eda-a82e-d373e226e633"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"74b03499-2d69-44f4-9e1e-478a26cccf35"]
},
