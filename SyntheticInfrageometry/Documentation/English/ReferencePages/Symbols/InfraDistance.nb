Notebook[{
Cell["InfraDistance", "Title",ExpressionUUID->"365d547a-5196-4698-8f1d-5d6b464ff993"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d7a575bf-2e7d-43a0-9b67-8b33ec065737"],

Cell["\<\
InfraDistance[g, p, q] is the graph distance between p and q in g, where each \
is a bare vertex or any Infra* wrapper (InfraPoint, InfraSegment, InfraPath, \
InfraLoop, InfraString, InfraLine, InfraRay, InfraCircle, InfraEllipse, \
InfraPolyline, InfraShell, InfraEllipticShell, InfraPlane, InfraBall, \
InfraObject, InfraSet); the result is aggregated over the cross-product of \
underlying vertex sets via the \"Aggregation\" option (Min default, also Max \
/ Mean / any List -> Number). InfraDistance[p, q] without a graph is also \
recognised inside InfraScene assertions.\
\>", "Text",ExpressionUUID->"9ed90b6c-fdb2-41fb-9937-ed3e61742283"],

Cell["Setup", "Section",ExpressionUUID->"850cc464-86d1-47b8-802e-13488d0b2c80"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"da4e049a-6eb0-48d0-b9fb-89f2c6ab1404"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"920063d7-57c6-4bd8-968a-601901054667"],

Cell["Related Guides", "Section",ExpressionUUID->"91f6d263-c16b-4c92-9709-ea6633a47df1"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"a0b2d56a-f917-487c-95b1-972f708794b8"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"4dd87bba-85ef-43c5-8c52-3b3da104dae2"]
},
