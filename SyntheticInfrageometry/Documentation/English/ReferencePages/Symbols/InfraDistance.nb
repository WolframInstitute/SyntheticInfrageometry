Notebook[{
Cell["InfraDistance", "Title",ExpressionUUID->"8f658f92-ff2e-4db3-882c-75fb85c64e1e"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c45ed113-821b-44ff-ab3e-067c3bdfda56"],

Cell["\<\
InfraDistance[g, p, q] is the graph distance between p and q in g, where each \
is a bare vertex or any Infra* wrapper (InfraPoint, InfraSegment, InfraPath, \
InfraLoop, InfraString, InfraLine, InfraRay, InfraCircle, InfraEllipse, \
InfraPolyline, InfraShell, InfraEllipticShell, InfraPlane, InfraBall, \
InfraObject, InfraSet); the result is aggregated over the cross-product of \
underlying vertex sets via the \"Aggregation\" option (Min default, also Max \
/ Mean / any List -> Number). InfraDistance[p, q] without a graph is also \
recognised inside InfraScene assertions.\
\>", "Text",ExpressionUUID->"537b795c-67f6-4964-a1d8-c4ad1e953e94"],

Cell["Setup", "Section",ExpressionUUID->"3868bfc0-995b-438a-b58c-48ddea00ff71"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"c883e009-cc3d-4a1b-9de6-612a47996a1c"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"d0b48c25-ff1a-47b4-af57-c126ca34c0f0"],

Cell["Related Guides", "Section",ExpressionUUID->"31bf8a0e-af69-407a-b300-e34df7be9160"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"434fa6fd-630e-4b0f-b556-555d9bb57588"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"85cd1fb9-9ff2-4726-8116-3ee4422e7f63"]
},
