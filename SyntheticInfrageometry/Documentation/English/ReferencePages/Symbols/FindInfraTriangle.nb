Notebook[{
Cell["FindInfraTriangle", "Title",ExpressionUUID->"2f5be2c4-dd2d-4acb-8f46-d9ac34be9f73"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c625e4ce-4ac9-4b73-bc19-3c27841ee733"],

Cell["\<\
FindInfraTriangle[graph, {a, b, c}] returns {InfraTriangle[{poly}]} for the \
triangle through corners a, b, c (the n = 3 case of FindInfraPolygon); each \
side a geodesic. FindInfraTriangle[graph, verts, count] / UpTo[count] / All \
controls multiplicity over the Cartesian product of per-side geodesics; \
default count = 1. Options Properties / Method forward to the side geodesics \
(see FindInfraSegment).\
\>", "Text",ExpressionUUID->"fea4760d-a0fc-4755-8520-253415c8786e"],

Cell["Setup", "Section",ExpressionUUID->"2c60ff06-47f9-403e-aea7-34b1942e0e94"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"eac81618-cedf-4fd8-93cf-0a58481cfb28"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"0d01b267-6255-4e04-9239-d352b28a7ca8"],

