Notebook[{
Cell["FindInfraTriangle", "Title",ExpressionUUID->"23106ff2-42b2-46b7-a238-562b722cba83"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"494d888f-a155-46d4-9d05-b7b9efd2c017"],

Cell["\<\
FindInfraTriangle[graph, {a, b, c}] returns {InfraTriangle[{poly}]} for the \
triangle through corners a, b, c (the n = 3 case of FindInfraPolygon); each \
side a geodesic. FindInfraTriangle[graph, verts, count] / UpTo[count] / All \
controls multiplicity over the Cartesian product of per-side geodesics; \
default count = 1. Options Properties / Method forward to the side geodesics \
(see FindInfraSegment).\
\>", "Text",ExpressionUUID->"f29da0eb-25b4-4912-8d85-9ac2e6323d97"],

Cell["Setup", "Section",ExpressionUUID->"3fc10602-119b-499f-aa4f-d2091c4e3cfa"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"ae572149-3d06-4f7b-9127-b93095c8a313"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"567f7427-4716-413b-a9d7-f194f0fabd87"],

