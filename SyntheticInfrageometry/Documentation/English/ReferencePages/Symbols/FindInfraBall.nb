Notebook[{
Cell["FindInfraBall", "Title",ExpressionUUID->"8cd03805-36bd-472b-85a7-24795ebeb61f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"0d33e00e-4f5c-4c32-92d8-6c9ce02090b8"],

Cell["\<\
FindInfraBall[graph, c, r] returns InfraBall[{B_r(c)}] for the closed metric \
ball B_r(c) = { v : d(c, v) <= r }. A multi-anchor center (InfraPoint wrapper \
or a list of unary InfraPoint wrappers) spreads into one realisation per \
center.\
\>", "Text",ExpressionUUID->"b152af29-d0c4-42ce-9362-7c0c49761b38"],

