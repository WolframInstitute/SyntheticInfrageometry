Notebook[{
Cell["InfraIntersection", "Title",ExpressionUUID->"656b49c2-263c-4f78-a195-8af42a77e92e"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c3e40796-17f7-479b-8519-126f36acb417"],

Cell["\<\
InfraIntersection[obj1, obj2, ...] returns the vertex-set intersection of the \
given Infra* objects as an InfraSet (each object's contribution is the union \
of vertices across its realisations). Also used symbolically in InfraScene \
hypotheses, where it stays inert until bindings resolve.\
\>", "Text",ExpressionUUID->"ad61e0fe-51d5-4cd2-9810-89fad4d37336"],

