Notebook[{
Cell["InfraIntersection", "Title",ExpressionUUID->"1d59259b-3055-4c44-b9dc-2ddfe163936c"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"5dd021b8-fcff-464b-a3b9-fdd4bc50e2d1"],

Cell["\<\
InfraIntersection[obj1, obj2, ...] returns the vertex-set intersection of the \
given Infra* objects (each object's contribution is the union of vertices \
across its realisations). Also used symbolically in InfraScene hypotheses, \
where it stays inert until bindings resolve.\
\>", "Text",ExpressionUUID->"88d4e478-23a1-4f01-acbb-6cc9b0851972"],

