Notebook[{
Cell["SelectInfraCycle", "Title",ExpressionUUID->"c672b0ae-f307-48a6-a332-a8874710518b"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"b44d15ef-1822-477d-9fdf-77d9474e7e57"],

Cell["\<\
SelectInfraCycle[graph, cycles] returns one cycle drawn from the bundle in \
path-space. SelectInfraCycle[graph, cycles, n] returns exactly n or $Failed; \
UpTo[n] returns up to n; All returns the whole pool. Options mirror \
SelectInfraPath; the \"From\" values \"MinLength\" / \"MaxLength\" select \
shortest / longest circumference. Path-space metric distances factor cyclic \
rotation so they are rotation-invariant. Accepts InfraCircle[cycles_List]; \
preserves the wrapper. Operator form SelectInfraCycle[graph, n, opts][cycles].\
\>", "Text",ExpressionUUID->"478267d2-b1d4-456b-9f6f-4dde46845722"],

Cell["Setup", "Section",ExpressionUUID->"2cf01093-5890-41a7-97eb-17a88e494586"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"d9e5543f-553f-4857-86b8-bc9eeadc3cde"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"4c306bc4-b567-464f-8fbb-5219d65aa743"],

Cell["Related Guides", "Section",ExpressionUUID->"d0601f46-e99c-43bc-bf73-40c373ba1991"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"7ce193f2-dd6e-4d77-9cb5-a753bfd0733b"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"4ea773b6-a4b3-44ba-8352-a6f02638525d"]
},
