Notebook[{
Cell["FindInfraPath", "Title",ExpressionUUID->"dc0b55df-54fd-4755-8cd1-2d425b64f564"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"7117c005-5f04-4d78-b7fc-ee7b43b621f1"],

Cell["\<\
FindInfraPath[graph, p1, p2] returns {InfraPath[{walk}]} for one walk between \
p1 and p2 (default Properties -> {} allows non-simple walks). \
FindInfraPath[graph, p1, p2, kspec] restricts walk length: kspec is k (length \
<= k), {k} (length == k), {kmin, kmax} (range), or Infinity (any length, \
default). FindInfraPath[graph, p1, p2, kspec, n] / UpTo[n] / All controls \
multiplicity. Endpoints accept InfraPoint[{...}] for multi-anchor spread. \
Options: Properties (AND-conjoined list of per-step constraints; supported: \
\"Simple\", {\"ShortestPath\", \"Window\" -> k}, {\"LongestPath\", \"Window\" \
-> k, \"Aggregation\" -> \"Lex\" | \"Sum\"}, {\"EdgeMin\", f}, {\"EdgeMax\", \
f}), Method (\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\" -> spec}).\
\>", "Text",ExpressionUUID->"a7477bee-db54-4d09-a627-3ba350d79877"],

Cell["Setup", "Section",ExpressionUUID->"8237bc88-af3b-4bf1-a4af-040bd2be74fb"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"b3eda2e1-7a89-40ac-a02d-33a6088100db"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"10d317fe-e5f6-43c0-8435-1dfa4ca23a50"],

Cell["Related Guides", "Section",ExpressionUUID->"b38fdbf9-3e6e-4ff6-b3f3-cdfdcb838bed"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"3d6a825d-f6f2-44ed-80cc-e73b013d8601"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"1eb1019f-0d31-41f8-91a3-8b0d55c057e7"]
},
