Notebook[{
Cell["FindInfraPath", "Title",ExpressionUUID->"465f5a0a-fd0e-44c1-801c-1ef17d4ac3f1"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"7fb11016-cd99-4438-adac-8f217664f5eb"],

Cell["\<\
FindInfraPath[graph, p1, p2] returns {InfraPath[{walk}]} for one walk between \
p1 and p2 (default Properties -> {} allows non-simple walks). \
FindInfraPath[graph, p1, p2, kspec] restricts walk length: kspec is k (length \
<= k), {k} (length == k), {kmin, kmax} (range), or Infinity (any length, \
default). FindInfraPath[graph, p1, p2, kspec, n] / UpTo[n] / All controls \
multiplicity. Endpoints accept InfraPoint[{...}] for multi-anchor spread. \
Options: Properties (AND-conjoined list of per-step constraints; supported: \
\"Simple\", {\"ShortestPath\", \"Window\" -> k}, {\"LongestPath\", \"Window\" \
-> k, \"Aggregation\" -> \"Lex\" | \"Sum\"}, {\"EdgeMin\", f}, {\"EdgeMax\", \
f}), Method (\"Exhaustive\" (default), {\"Exhaustive\", \"Pruning\" -> spec}).\
\>", "Text",ExpressionUUID->"6b515a1f-9bc9-43df-bc54-271525da8242"],

Cell["Setup", "Section",ExpressionUUID->"87334ab0-a0ee-46eb-aa5e-fcc49e459d6e"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"13d6fb65-bd3b-4954-b5cc-690b17db0672"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"ceb07b8e-c65c-4072-aafb-99c91a3a8384"],

Cell["Related Guides", "Section",ExpressionUUID->"593b90bd-ea5b-44b8-bf79-d2861b053851"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"4804896b-3b7c-4c94-86a4-f2a99f993faf"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"e3ad57e8-6d69-4724-9b5c-44c3b9a49599"]
},
