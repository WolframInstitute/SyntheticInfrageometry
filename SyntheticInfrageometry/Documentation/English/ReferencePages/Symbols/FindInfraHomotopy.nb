Notebook[{
Cell["FindInfraHomotopy", "Title",ExpressionUUID->"079d4cfc-9f88-420e-b68c-10e61862ed19"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"ad989654-c405-4b16-aaef-89fb7430dc92"],

Cell["\<\
FindInfraHomotopy[graph, a, b] returns {InfraHomotopy[{chain}]} exhibiting a \
chain of elementary moves from a to b. Endpoints a and b must share a wrapper \
head (InfraPath / InfraLoop / InfraString; InfraCircle coerces to \
InfraString). FindInfraHomotopy[graph, a, b, n] / UpTo[n] / All controls \
multiplicity. Options: Method (\"Exhaustive\" (default; walk-space BFS), \
{\"Exhaustive\", \"Pruning\" -> spec}, \"Greedy\" (DFS picking the move \
minimising symmetric Hausdorff distance to target)), \"FreeHomotopy\" (False \
(default); True allows endpoint slides on InfraPath and base-point rotation \
on InfraLoop), \"NullHomotopicCycles\" (default {1, 2, 3}), \"MaxLength\" \
(Automatic), \"MaxMoves\" (Infinity).\
\>", "Text",ExpressionUUID->"f2ba5037-9118-4183-8e27-69a2d823248b"],

Cell["Setup", "Section",ExpressionUUID->"2f8ca90c-a080-49a5-831d-25c1ce442a8c"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"c677091e-81c0-422b-aa2f-05da20e1d7e4"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"6ce45dce-2131-44b5-b6e8-d668a90655fd"],

