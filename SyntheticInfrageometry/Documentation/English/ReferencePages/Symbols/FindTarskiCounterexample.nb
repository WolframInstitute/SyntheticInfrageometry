Cell["FindTarskiCounterexample", "Title",ExpressionUUID->"cdfe4b18-40dd-44e4-9890-0495abc9b9c8"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"485122e6-0c34-4fa9-a09d-e533190e1688"],

Cell["\<\
FindTarskiCounterexample[graph, predQ] returns one vertex tuple witnessing \
the failure of the Tarski axiom predicate predQ, or $Failed. With n / UpTo[n] \
/ All caps witness count. Returns $Failed for always-True axioms and \
TarskiContinuityQ.\
\>", "Text",ExpressionUUID->"b2c9fa62-b5a5-4b54-bc86-e9d144152883"],

