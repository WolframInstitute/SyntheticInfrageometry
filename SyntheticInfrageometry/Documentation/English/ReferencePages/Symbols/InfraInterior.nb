Notebook[{
Cell["InfraInterior", "Title",ExpressionUUID->"6a0e406f-e740-48a4-8a1b-df83c5c1a9f3"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"36387290-5f66-44e5-8dcf-12b6bbe19879"],

Cell["\<\
InfraInterior[g, s] is the interior of the vertex set s (a bare vertex list \
or any Infra* object) in g, returned as an InfraSet. Option Method \
(\"Combinatorial\" (default), s minus its inner boundary via GraphInterior; {\
\"Alexandrov\", \"Radius\" -> r}, the topological interior in the \
closed-r-ball topology, default r = 1).\
\>", "Text",ExpressionUUID->"4fdcf939-3760-43ae-8caf-ee4396a645e2"],

Cell["Setup", "Section",ExpressionUUID->"509db5e5-48db-40dd-988d-6c25623707f4"],

