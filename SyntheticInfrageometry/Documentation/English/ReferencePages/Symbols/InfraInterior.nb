Notebook[{
Cell["InfraInterior", "Title",ExpressionUUID->"480580d9-74d0-4030-a0b4-c1f6e2463f46"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"15a998a0-a039-4a3b-b51f-e046e7c6da56"],

Cell["\<\
InfraInterior[g, s] is the interior of the vertex set s (a bare vertex list \
or any Infra* object) in g, returned as an InfraSet. Option Method \
(\"Combinatorial\" (default), s minus its inner boundary via GraphInterior; {\
\"Alexandrov\", \"Radius\" -> r}, the topological interior in the \
closed-r-ball topology, default r = 1).\
\>", "Text",ExpressionUUID->"d4b36831-50c9-41de-b0d0-2b413ec7fb4b"],

Cell["Setup", "Section",ExpressionUUID->"f810f392-6803-41ce-b3bc-e89cb403d64b"],

