Notebook[{
Cell["InfraBall", "Title",ExpressionUUID->"759f0eb3-d5b6-464b-8c50-89b0fb0ef663"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"9260dc32-07ee-4ae2-90d6-92c34999ae15"],

Cell["\<\
InfraBall[{ball}] is the unary form (one closed metric ball vertex set); \
InfraBall[{ball1, ..., ballk}] is the multi-realisation form. Scene-language \
constructor InfraBall[center, radius] is used inside InfraScene. The multi \
form is consumed by InfraSceneHighlight (induced-subgraph semantics).\
\>", "Text",ExpressionUUID->"a406e28e-65f5-4fdc-a079-900c1e0b94fc"],

