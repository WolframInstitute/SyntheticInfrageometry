Notebook[{
Cell["ResistanceCoordinates", "Title",ExpressionUUID->"f7285c0f-8e28-4126-a530-bcf539805868"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"bc19a276-d485-4c98-8a3b-e215b567d090"],

Cell["\<\
ResistanceCoordinates[graph] returns the Association v -> Phi(v) of \
resistance-matching spectral coordinates Phi(v) = (phi_i(v) / \
Sqrt[lambda_i])_{i: lambda_i > 0}, satisfying ||Phi(u) - Phi(v)||^2 == \
EffectiveResistance(u, v). ResistanceCoordinates[graph, v] returns one \
coordinate vector; an InfraPoint query returns the per-realisation list. \
Options: \"Rescaling\" (\"ResistanceMatching\" (default), \"None\", \
\"Diffusion\" -> t), \"Dimension\" (Automatic, Integer, UpTo[k], All), \
\"Origin\" (None or vertex / InfraPoint).\
\>", "Text",ExpressionUUID->"1cf04d13-4ebf-4fb6-a739-d9f2e4b744f7"],

Cell["Setup", "Section",ExpressionUUID->"3ec56bb3-a85b-4191-9c0b-ac7f2c41d582"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"82a00dcc-3504-4a26-a4a0-340fa0258b53"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"ab485af6-0e52-4da1-86a0-224fc74dfbcd"],

Cell["Related Guides", "Section",ExpressionUUID->"7835f24c-1231-435f-9b63-bd8d34ed8cdc"],

Cell["CoordinatizationGuide", "Item",ExpressionUUID->"0d50b116-4bab-4a07-8cee-0ed20a54ec59"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"1b19dcd5-b6b2-4a8a-92c3-94de8e3418bb"]
},
