Notebook[{
Cell["FindInfraRevolution", "Title",ExpressionUUID->"77cadcbc-0487-49b0-bcb4-49807e6795c4"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"f1e53a88-e73e-40c0-aadc-e4d458719e5b"],

Cell["\<\
FindInfraRevolution[graph, axis, profile] returns InfraObject[set] for the \
rotational vertex set around axis with the given radius profile. The axis is \
internally extended by +1 position on each side via ExtendInfraSegment[..., \
\"Length\" -> 1] so the orthogonality test sees a one-step extension at each \
endpoint. The profile may be NumericQ (constant), a List of length |axis|, an \
Association vertex -> radius, or any callable applied to index 1..|axis|. \
Options: \"Form\" (\"Solid\" (default) | \"Surface\"); Method (\"Voronoi\" \
(default) -- closest extended position must be in the original axis range; \
\"PerpendicularBisector\" -- u included at position i iff d(u, v_{i-1}) == \
d(u, v_{i+1})).\
\>", "Text",ExpressionUUID->"788a84b8-e29a-49bd-a909-db24dc9e5fbf"],

Cell["Setup", "Section",ExpressionUUID->"60a9e98d-af58-48b8-b335-59a83d6745a2"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"b50b2c64-a85c-473a-a4d6-76c53f06171a"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"5a53c2ea-575a-448a-87a0-4313ccca0844"],

Cell["Related Guides", "Section",ExpressionUUID->"faa75a53-4b8d-4e5f-b7e5-a1d71aea4798"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"7bc4b6de-45f8-4848-acaf-976da97dafaa"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"dcf1a9ac-f46a-4946-a437-620960acc416"]
},
