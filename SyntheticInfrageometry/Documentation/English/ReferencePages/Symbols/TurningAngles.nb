Notebook[{
Cell["TurningAngles", "Title",ExpressionUUID->"f24b795c-8695-45ee-bee2-4bc2bd4d531c"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"6882a520-a73d-41be-9cbb-ec9830e884ba"],

Cell["\<\
TurningAngles[graph, path] returns the list of discrete exterior angles Pi - \
InfraAngle[graph, {v_{i-1}, v_i, v_{i+1}}] at each interior vertex of the \
polygonal curve path = {v_1, ..., v_k}; closed cycles (First[path] == \
Last[path]) include the wrap-around triple. TurningAngles[graph, polyline] \
returns the list of turning angles at the knot vertices of an InfraPolyline \
(one list per realisation); geodesic-interior vertices contribute no turning \
by construction.\
\>", "Text",ExpressionUUID->"0a1104f8-1f6b-4381-a16c-bef03fd85b17"],

Cell["Setup", "Section",ExpressionUUID->"49730d35-d0c8-46bf-99b8-f63e7192a969"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"3ffefc82-db2d-4897-baa6-e5d9bcee9d81"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"da97f091-54d7-4320-9f31-dd40b3bddd74"],

Cell["Related Guides", "Section",ExpressionUUID->"0ccb59ff-0f9f-46b8-8491-77751b8676ba"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"65b71e75-538d-43fa-bf81-ba6602f0bc61"],

