Notebook[{
Cell["TurningAngles", "Title",ExpressionUUID->"a34bc23a-d2bb-45f4-8a58-f7a072763707"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"83c27883-3650-47bd-bbbc-162e7052fec4"],

Cell["\<\
TurningAngles[graph, path] returns the list of discrete exterior angles Pi - \
InfraAngle[graph, {v_{i-1}, v_i, v_{i+1}}] at each interior vertex of the \
polygonal curve path = {v_1, ..., v_k}; closed cycles (First[path] == \
Last[path]) include the wrap-around triple. TurningAngles[graph, polyline] \
returns the list of turning angles at the knot vertices of an InfraPolyline \
(one list per realisation); geodesic-interior vertices contribute no turning \
by construction.\
\>", "Text",ExpressionUUID->"a090ed23-aabd-4266-b593-010f79531a6e"],

Cell["Setup", "Section",ExpressionUUID->"c9303d71-4995-4a24-bc10-e49b02da3104"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"2a741f61-be00-4451-959b-4431a74fc4a6"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"714537bb-8a4f-432a-893f-d06a79d2d859"],

Cell["Related Guides", "Section",ExpressionUUID->"78c52077-6f03-4f80-8a28-32187bf5b769"],

