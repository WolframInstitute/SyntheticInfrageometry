Notebook[{
Cell["FindInfraSpanningAxes", "Title",ExpressionUUID->"41b9d8be-5cb5-4827-919d-d160027190e5"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"1f40b0ef-41e7-45e3-a5ba-6babc83a3796"],

Cell["\<\
FindInfraSpanningAxes[graph, n] returns n mutually well-separated longest \
geodesics across graph (greedy, no fixed center) or $Failed; UpTo[n] returns \
up to n; All returns every axis above the separation threshold. Options: \
\"AxisDistance\" (\"MinEndpoint\" | \"Hausdorff\" | \"Separation\"), \
\"MinLength\", \"MinSeparation\", \"AxisThickness\", \"RandomPick\". For axes \
through a fixed center vertex use FindInfraOrthogonalFrame.\
\>", "Text",ExpressionUUID->"a5f88a96-2801-43c2-a4b0-0ac92e7e4305"],

Cell["Setup", "Section",ExpressionUUID->"f0c887a0-bea0-4059-9197-b7e58fd14fa1"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"45e13ab8-bb90-41b2-b47d-9d35bc531e87"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"74269944-fb5b-4fb4-98c1-91d872d26f04"],

Cell["Related Guides", "Section",ExpressionUUID->"b3c21b29-153f-46f3-8936-8f8eb1dfff71"],

Cell["CoordinatizationGuide", "Item",ExpressionUUID->"a75fe640-3126-4ca3-8377-0456853f39fe"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"00956233-af8e-4a15-b153-955331574b35"]
},
