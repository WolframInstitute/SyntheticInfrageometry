Notebook[{
Cell["FindInfraSpanningAxes", "Title",ExpressionUUID->"ae23d88e-166f-49c5-a608-5584ffa8d273"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"808704b4-888d-4ef7-9c06-c6630a30e0a3"],

Cell["\<\
FindInfraSpanningAxes[graph, n] returns n mutually well-separated longest \
geodesics across graph (greedy, no fixed center) or $Failed; UpTo[n] returns \
up to n; All returns every axis above the separation threshold. Options: \
\"AxisDistance\" (\"MinEndpoint\" | \"Hausdorff\" | \"Separation\"), \
\"MinLength\", \"MinSeparation\", \"AxisThickness\", \"RandomPick\". For axes \
through a fixed center vertex use FindInfraOrthogonalFrame.\
\>", "Text",ExpressionUUID->"0103c4fd-ba1e-400a-b6b1-71a68bac6d00"],

Cell["Setup", "Section",ExpressionUUID->"77d63085-9175-4856-bbf0-c18ca56eb97e"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"5d26bcce-1519-4373-8693-b70818c6c543"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"ba146225-6826-49b1-821f-ed78d46ab502"],

Cell["Related Guides", "Section",ExpressionUUID->"197e4bbf-ea13-4a24-9989-fb586b893cc4"],

Cell["CoordinatizationGuide", "Item",ExpressionUUID->"43bc4bf4-47f2-4707-9d75-a9eb59eb2672"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"75f2a0ea-d1f3-4174-a125-fc73cdcbc32b"]
},
