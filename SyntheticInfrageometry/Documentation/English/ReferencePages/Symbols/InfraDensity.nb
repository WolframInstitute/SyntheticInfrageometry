Cell[CellGroupData[{
Cell["InfraDensity", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"13ac22e8-2c96-4eef-80c2-90a873221c93"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraDensity"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraDensity", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["x", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c88903e0-f484-4955-b82c-4221b93d2aff"],
 "\[LineSeparator]",
 "gives the marginal of the shape ",
 Cell[BoxData["x"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "340fd9bf-3b29-4226-84c6-3459d31ea985"],
 " to the vertex set of ",
 Cell[BoxData["graph"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5200393d-9751-4e0a-8b62-7759e34f1f12"],
 ", as the Association <|v -> m|>, with respect to the counting measure.",
 "\n"
}], "Usage",ExpressionUUID->"4cc42d40-7bbb-4047-a805-17cd3972a5f3"],

Cell[TextData[{
 Cell[BoxData["InfraDensity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8b864451-69a1-49c7-bc56-b1dbedf72a5e"],
 " is the one public coercion in the API. ",
 Cell[BoxData["Keys"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ec829b2a-0ec6-4b57-8695-415ce9e47e6b"],
 " demotes a density back to its support; ",
 Cell[BoxData["Counts"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "eb5947a4-e6e7-4759-ac1f-39deca266c92"],
 " promotes a vertex list to a density."
}], "Notes",ExpressionUUID->"17cb4e5e-eb40-4560-86a0-9be48affd940"],

Cell["It reads every shape:", "Notes",ExpressionUUID->"7a609500-7b4e-46f3-8db2-1ab0d0a08869"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "006903d4-20b3-4ceb-a990-f9fed874ada8"], Cell[TextData[Cell[BoxData[
    "x"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "7c2452e5-6cc7-4abb-a981-01d3009fd8b6"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"b57c0ce0-c140-4209-a205-41b3f14b22d3"],
     Cell[TextData[Cell[BoxData[
     RowBox[{"InfraDensity", "[", 
      RowBox[{"graph", ",", " ", "x"}], "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "232f18e8-af51-4139-bc7b-1155e74ab665"]], "TableText",
     FontWeight->Bold,ExpressionUUID->"01b5d686-794e-44b4-9946-6663a8e9e712"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "19d9b42d-548c-481c-8332-abfdbc0aaf5e"], Cell[TextData[{
     "a vertex ",
     Cell[BoxData["v"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b38ca41e-986c-47fe-beba-c6456a21133a"]
    }], "TableText",ExpressionUUID->"19e0379b-41d5-40dc-ae7d-0cbb351adf15"], 
    Cell[TextData[Cell[BoxData[
     RowBox[{"<|", 
      RowBox[{"v", " ", "->", " ", "1"}], "|>"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "db7f5d4d-d565-4f83-a617-fe5ac34a3f02"]], "TableText",ExpressionUUID->
     "f4bfbbf9-28d2-4861-88d6-00003e12b2b4"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f9f5b338-1939-4d0e-9df3-781893fe9e53"], Cell[
    "a vertex list", "TableText",ExpressionUUID->
     "1e7ac547-302e-4bec-865d-757be631327f"], Cell[TextData[{
     "its ",
     Cell[BoxData["Counts"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "27f186b8-b420-4425-b53d-7fa1c2d8accc"]
    }], "TableText",ExpressionUUID->"cb79955d-6dd6-4562-aed7-233c9ad64342"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "4134fd47-a928-4ba3-a17f-653724d3cda4"], Cell[TextData[{
     "a density ",
     Cell[BoxData[
      RowBox[{"<|", 
       RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "640067dc-1806-479e-a9c8-beee9362cb25"]
    }], "TableText",ExpressionUUID->"634e2336-89d4-4eab-92e4-eeb03e4d5f7e"], 
    Cell["itself", "TableText",ExpressionUUID->
     "dfb9b7be-3526-4ba1-a717-8bead282567a"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "49c89b14-faa0-4c39-9cb0-0b082eac962d"], Cell[
    "a walk graph, or a bundle of them", "TableText",ExpressionUUID->
     "1aaba775-3d0b-4117-9baa-be112a08b434"], Cell[
    "the vertex occupation over the walks it carries", "TableText",
     ExpressionUUID->"d4ad1f36-6038-456c-acaa-918245095cfc"]}
  }]], "2ColumnTableMod",ExpressionUUID->"dc44bf50-d122-4cbe-856f-\
5ddae134fe65"],

Cell[TextData[{
 "The result is key-sorted, so two densities built by different routes \
compare with ",
 Cell[BoxData["SameQ"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a0722562-d88f-4dd9-89b1-4650059238b6"],
 "."
}], "Notes",ExpressionUUID->"6718c89c-1870-4f04-80cc-20fa0c4209b5"],

Cell[TextData[{
 Cell[BoxData["InfraDensity"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "db8bc4bd-d4fa-471d-926e-25064d5d30a8"],
 " is the raw marginal: it takes no ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "816926f1-4fbd-4d03-bdbf-c1fb0691a3a9"],
 " and no ",
 Cell[BoxData["\"\<On\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5329bc0c-b6e9-45ee-939f-cee28114e14c"],
 " option. The two normalisations are one division away -- ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Max", " ", "@", " ", 
    RowBox[{"Values", " ", "@", " ", "d"}]}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5dfbbe68-247f-4111-b92c-87e5c671013f"],
 " is the occupation in [0, 1], ",
 Cell[BoxData[
  RowBox[{"d", " ", "/", " ", 
   RowBox[{"Total", " ", "@", " ", "d"}]}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0b1d7f5b-450c-478b-affd-864f10fbd862"],
 " the distribution summing to 1. Edge weights are internal to the renderer."
}], "Notes",ExpressionUUID->"4b112155-cc44-4d07-a832-82dd82b679ee"]
}, Open  ]],

