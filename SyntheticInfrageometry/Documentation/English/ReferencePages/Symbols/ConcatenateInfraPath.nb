Notebook[{
Cell["ConcatenateInfraPath", "Title",ExpressionUUID->"b3e42cfc-e98e-45f3-b2a7-cdbc5c4a8d77"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"e8089fb9-943f-4cc9-b4af-639a36490c80"],

Cell["\<\
ConcatenateInfraPath[path1, path2] returns a List of unary InfraPath[{walk}] \
wrappers for every compatible pair (walk1 from path1, walk2 from path2) with \
Last[walk1] === First[walk2], concatenated as Join[walk1, Rest[walk2]]. \
ConcatenateInfraPath[path1, path2, n] / UpTo[n] / All controls multiplicity \
(default All). Both arguments accept multi-realisation InfraPath[{...}] \
wrappers or lists of unary wrappers.\
\>", "Text",ExpressionUUID->"a85198b9-2ee5-4088-835f-9e553db0300b"],

Cell["Setup", "Section",ExpressionUUID->"38a0569f-3274-46d8-9689-d25e38b3785b"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"6a708096-c59f-4043-9e4c-ef3fb6e8bcaa"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"dea6827a-0065-460f-83a9-3ec36ebf69fb"],

Cell["Related Guides", "Section",ExpressionUUID->"f13ead34-c5a7-47c7-a3c8-73be6a51e05b"],

