Notebook[{
Cell["FindInfraHomotopyRepresentative", "Title",ExpressionUUID->"1510aca9-15ce-4ded-8fa4-bce37709c9f5"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"1917a428-738b-4f8c-b677-032c12ab2a5a"],

Cell["\<\
FindInfraHomotopyRepresentative[graph, obj] returns {head[{w}]} for one \
length-shortest walk w in obj's homotopy class, where head matches the input \
wrapper (InfraPath / InfraLoop / InfraString; InfraCircle coerces to \
InfraString). FindInfraHomotopyRepresentative[graph, obj, n] / UpTo[n] / All \
controls multiplicity. Options: Method (\"Exhaustive\" (default; BFS), \
{\"Exhaustive\", \"Pruning\" -> spec}, \"Greedy\" (DFS contracting moves \
only)), \"FreeHomotopy\" (False (default); True allows endpoint slides on \
InfraPath and base-point rotation on InfraLoop), \"NullHomotopicCycles\" \
(default {1, 2, 3}), \"MaxLength\" (Automatic), \"MaxMoves\" (Infinity).\
\>", "Text",ExpressionUUID->"246d327f-ad45-41c9-b40d-c8b11966334a"],

Cell["Setup", "Section",ExpressionUUID->"158da343-dba8-4c70-86ca-a8dc56b4338c"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"12343513-6dd8-462d-89ab-eb826a6caddb"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"42aad447-6e8b-411e-b7a8-37a39cd034db"],

Cell["Related Guides", "Section",ExpressionUUID->"b2c3966f-42a8-44f0-b60e-aad5b3afc630"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"3d344edd-d84d-4228-b7d4-77c86cc705a5"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"b9e8b15d-fde0-450f-b3a7-a12c07f5597c"]
},
