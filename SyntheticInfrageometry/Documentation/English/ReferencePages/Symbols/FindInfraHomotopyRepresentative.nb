Notebook[{
Cell["FindInfraHomotopyRepresentative", "Title",ExpressionUUID->"27686708-7ddc-4f33-9ff3-feb1ac4e7714"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"225d4542-eb09-4cfc-899f-a21861d7fb6e"],

Cell["\<\
FindInfraHomotopyRepresentative[graph, obj] returns {head[{w}]} for one \
length-shortest walk w in obj's homotopy class, where head matches the input \
wrapper (InfraPath / InfraLoop / InfraString; InfraCircle coerces to \
InfraString). FindInfraHomotopyRepresentative[graph, obj, n] / UpTo[n] / All \
controls multiplicity. Options: Method (\"Exhaustive\" (default; BFS), \
{\"Exhaustive\", \"Pruning\" -> spec}, \"Greedy\" (DFS contracting moves \
only)), \"FreeHomotopy\" (False (default); True allows endpoint slides on \
InfraPath and base-point rotation on InfraLoop), \"NullHomotopicCycles\" \
(default {1, 2, 3}), \"MaxLength\" (Automatic), \"MaxMoves\" (Infinity).\
\>", "Text",ExpressionUUID->"8b39fe24-0081-4b64-81f1-4a32cd2822e3"],

Cell["Setup", "Section",ExpressionUUID->"29881ae1-d176-4d8f-9a79-8d922c76cc19"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"8aeb0d0d-4f1f-41ca-ae7a-12ba48ac868f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"48ce2ddb-b9ac-47ab-82c0-1469c0ed3a78"],

Cell["Related Guides", "Section",ExpressionUUID->"f70298bf-2f85-46c6-9860-eacac5ba1f86"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"b046bc26-9896-47bd-98d4-690fa133bdc1"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"aa248f58-181c-4ffe-9ae6-729d60957a40"]
},
