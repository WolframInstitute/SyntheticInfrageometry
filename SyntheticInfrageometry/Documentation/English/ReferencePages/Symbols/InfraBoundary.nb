Notebook[{
Cell["InfraBoundary", "Title",ExpressionUUID->"83ef5a55-024e-483a-9645-acf26fa793a1"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"87d95e67-a441-4b74-9047-012721076ae2"],

Cell["\<\
InfraBoundary[g, s] is the boundary of the vertex set s (a bare vertex list \
or any Infra* object) in g, returned as an InfraSet. Option Method \
(\"Combinatorial\" (default), the inner vertex boundary via GraphBoundary; \
{\"Alexandrov\", \"Radius\" -> r}, the two-sided cl(s)\\int(s) in the \
closed-r-ball topology, default r = 1).\
\>", "Text",ExpressionUUID->"9172f1b2-788c-4af5-921d-344d36c2c20d"],

Cell["Setup", "Section",ExpressionUUID->"60d5143e-034e-4593-a5bb-71f4547a5562"],

