Notebook[{
Cell["FindLineStructure", "Title",ExpressionUUID->"baf19af6-1ca0-4b81-ab66-d09a83ef71f8"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"ee31de7d-0635-43ad-a3a7-962414e77486"],

Cell["\<\
FindLineStructure[graph] returns an InfraLineStructure[{lines}]: a consistent \
(subpath-closed) geodesic path system -- one shortest path per pair, with \
every stretch of a chosen path again the chosen path -- stored as its maximal \
lines. Option Method (\"Lexicographic\" (default; exact 1 + 2^(-rank) \
weighting, edges ranked by sorted endpoints) | {\"Random\", seed} | \
\"Resistance\" | \"Weight\" -> w) supplies the edge ranking that breaks \
geodesic ties; every method yields a consistent system. See \
InfraLineStructure for accessors.\
\>", "Text",ExpressionUUID->"009173ec-8531-4a60-ac7f-4b1a9e98624d"],

Cell["Setup", "Section",ExpressionUUID->"59e54941-4e96-4cd4-8c3a-4efdf05557a6"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"917a44c9-a60c-4681-a8a9-9a70d97300e7"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"1dfbdadb-8ca1-4324-9ba8-702494c8d317"],

Cell["Related Guides", "Section",ExpressionUUID->"9db94301-c592-47b0-95e3-5dc027c7576f"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"89d712eb-3779-42b0-acee-8ceca2cbae86"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"9619ad9d-69aa-40a0-901f-64fccf221a98"]
},
