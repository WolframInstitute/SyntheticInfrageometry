Notebook[{
Cell["FindLineStructure", "Title",ExpressionUUID->"ec431820-b7c7-47dd-89fd-d940145546fa"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"2a55ca12-8e87-4705-953c-1472689ef4ea"],

Cell["\<\
FindLineStructure[graph] returns an InfraLineStructure[{lines}]: a consistent \
(subpath-closed) geodesic path system -- one shortest path per pair, with \
every stretch of a chosen path again the chosen path -- stored as its maximal \
lines. Option Method (\"Lexicographic\" (default; exact 1 + 2^(-rank) \
weighting, edges ranked by sorted endpoints) | {\"Random\", seed} | \
\"Resistance\" | \"Weight\" -> w) supplies the edge ranking that breaks \
geodesic ties; every method yields a consistent system. See \
InfraLineStructure for accessors.\
\>", "Text",ExpressionUUID->"d5bb1ebd-f87f-4d3a-bc73-d090bcb043f4"],

Cell["Setup", "Section",ExpressionUUID->"43fb6d89-d1dc-48f3-ad56-9668624a922e"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"087e9ceb-3b10-4309-94a7-ae7bdb55d0bb"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"888acefe-7192-4fa5-b65f-58dfab0c256a"],

Cell["Related Guides", "Section",ExpressionUUID->"baabacbc-2bab-48f8-bca6-6a1972f3b685"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"8578e924-3807-463b-a7a0-09be4ec779f8"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"7b03ed5c-0d39-4c08-a89c-1d065a85f07b"]
