Notebook[{
Cell["PunchHole", "Title",ExpressionUUID->"a72a5f1b-b0a4-408f-bc43-f03b25771a7f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"3e57a919-8c5e-49cb-8516-58b93d458008"],

Cell["\<\
PunchHole[g, r] removes the closed r-ball around a random vertex; \
PunchHole[g, c -> r] removes the closed r-ball around vertex c. For multiple \
holes, Fold[PunchHole, g, list].\
\>", "Text",ExpressionUUID->"047dd9a4-3ffa-4620-87a5-000f8074dd35"],

