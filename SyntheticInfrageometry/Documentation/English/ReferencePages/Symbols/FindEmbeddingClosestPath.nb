Notebook[{
Cell["FindEmbeddingClosestPath", "Title",ExpressionUUID->"28ca1d4c-aa24-453c-818a-b7c3348f74fe"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"9f7caec8-b3d6-4c0c-8c6d-fab7373aeeb2"],

Cell["\<\
FindEmbeddingClosestPath[graph, curve] snaps an arbitrary embedded curve to a \
graph walk and returns InfraPath[{walk}] tracing it: each sampled curve point \
is mapped to its nearest vertex under the graph embedding, consecutive \
repeats are dropped, and successive anchors are joined by geodesics. curve is \
a Line / BSplineCurve / BezierCurve or a list of plane points in the \
embedding's coordinates. Unlike EmbeddingClosest (which selects from a \
supplied bundle), this constructs the path, so it works for shapes with no \
enumerable bundle (spirals, figure-eights).\
\>", "Text",ExpressionUUID->"18086d23-c309-4cd1-bcc0-51c0f19b8505"],

Cell["Setup", "Section",ExpressionUUID->"c3745841-0b52-4050-a56a-97f214695fe7"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"714888e5-4a1a-4b87-a2c7-b21c9e252171"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"9a53eed0-522f-4325-9ce1-14eeca5cf93e"],

Cell["Related Guides", "Section",ExpressionUUID->"011658f0-ee37-4864-8f3a-ed1b9def31e3"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"bae942d7-b5a8-4765-bf0a-195997113bb3"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"cc223092-3321-4366-a73a-b18dcfb931a1"]
},
