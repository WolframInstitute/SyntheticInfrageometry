Notebook[{
Cell["FindEmbeddingClosestPath", "Title",ExpressionUUID->"15b2ac84-2230-4914-9fb4-b2244d6fa3b1"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"691f6869-809c-4568-9f5d-d075e42813d4"],

Cell["\<\
FindEmbeddingClosestPath[graph, curve] snaps an arbitrary embedded curve to a \
graph walk and returns InfraPath[{walk}] tracing it: each sampled curve point \
is mapped to its nearest vertex under the graph embedding, consecutive \
repeats are dropped, and successive anchors are joined by geodesics. curve is \
a Line / BSplineCurve / BezierCurve or a list of plane points in the \
embedding's coordinates. Unlike EmbeddingClosest (which selects from a \
supplied bundle), this constructs the path, so it works for shapes with no \
enumerable bundle (spirals, figure-eights).\
\>", "Text",ExpressionUUID->"3e21cce7-2cc1-492e-b37d-b3aa581b1c4b"],

Cell["Setup", "Section",ExpressionUUID->"1b178530-94e1-481c-bb2f-fdda9b0df89c"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"307067dd-9a33-4f32-8b91-45011e6d5a85"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"4b85feec-5086-4dd7-8e86-c82d5a3bec02"],

Cell["Related Guides", "Section",ExpressionUUID->"c08c363e-b5e8-4ae9-84fb-e9b543afe9df"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"7ea58745-31c3-4c56-bec7-161e0dd159d9"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"1d7f686a-a73f-4a03-9efc-0acfc361e502"]
},
