Notebook[{
Cell["InfraPath", "Title",ExpressionUUID->"1d46a268-0c7c-4b86-85ad-2b9624e1717d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"57c731b7-2fb9-484b-9ec4-2e49e713e9ae"],

Cell["\<\
InfraPath[{walk}] is the unary form (one walk, possibly non-simple); \
InfraPath[{walk1, ..., walkk}] is the multi-realisation form. Inside \
InfraScene, InfraPath[p1, p2, ..., pk] is the step-wise scene-DSL \
constructor: every length-(k-1) walk {v1, ..., vk} with vi in pi and each \
consecutive pair (vi, v_{i+1}) a graph edge (non-simple chains kept). \
FindInfraPath finders return a List of unary InfraPath[{walk}] wrappers; wrap \
that list with InfraPath @ ... to collapse to multi via auto-flatten. \
Rendered like InfraSegment (sequential-edge semantics).\
\>", "Text",ExpressionUUID->"ae7de14c-db0f-440e-8848-7c270583e31a"],

Cell["Setup", "Section",ExpressionUUID->"ad586566-6b5d-446d-92a8-40d327cd7ef9"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"8f8707e7-b198-4c59-bcf9-d7dfcd930e31"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"c15f9512-e87d-4283-a1a7-44f9083a217b"],

Cell["Related Guides", "Section",ExpressionUUID->"b5b4a247-a41c-4e91-ad1e-7c98c7b5f2fb"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"7d70854f-470b-4e53-896b-db962ea128d6"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"0d228a04-c80f-4d43-bbd3-779a36dcc954"]
},
