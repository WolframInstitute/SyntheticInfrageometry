Notebook[{

Cell[CellGroupData[{
Cell["CATInequalityQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b840aedf-ce1e-4c80-9de0-a3c5b02c8303"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["CATInequalityQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/CATInequalityQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q", "TI"], ",", " ", 
      StyleBox["r", "TI"]}], "}"}], ",", " ", 
    RowBox[{
     StyleBox["k", "TI"], " ", ":", " ", "0"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9ab11828-a87d-49ee-b286-8132bcb9b31e"],
 "\[LineSeparator]",
 "tests whether the geodesic triangle on {p, q, r} satisfies the CAT(k) \
thinness inequality.",
 "\n"
}], "Usage",ExpressionUUID->"60e5d992-3196-4866-b421-2071fc1947ce"],

Cell["Options:", "Notes",ExpressionUUID->"15278578-2ef2-4573-b0b7-6f85d8ffdc20"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2f2fa9b2-2d83-44e0-807e-a572f8b77e78"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"79e1bfaa-b838-40b6-93ff-6bef839596e9"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"3bc13cf7-542c-4649-858c-32e96322dd92"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "5e596719-c6dd-4d63-8a53-7b82adb3da35"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "bd4a6a11-06ec-43cd-b2c3-9336dac473db"]], "TableText",ExpressionUUID->
     "8a833a1f-f655-4fb1-98eb-f51c10a6719a"], Cell["\<\
\"ApexSide\" (default) -- d(apex, x) <= d_k_bar(apex', x') for every interior \
vertex x on the side opposite to each apex; \"TwoRays\" -- d(x, y) <= \
d_k_bar(x', y') for every cross-ray pair (x, y) on the two rays emanating \
from each apex\
\>", "TableText",ExpressionUUID->"88bd2702-b314-4f57-8fc8-95055491115d"]}
  }]], "2ColumnTableMod",ExpressionUUID->"4de72706-8877-43f1-bd6a-\
bdd54558458e"],

Cell["\<\
Returns Indeterminate when k > 0 and the triangle perimeter exceeds 2 Pi / \
Sqrt[k].\
\>", "Notes",ExpressionUUID->"450d2d07-33fc-4c3f-a4f1-8579c9fc647d"]
}, Open  ]],

