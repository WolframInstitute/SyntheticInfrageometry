Notebook[{
Cell["CATInequalityQ", "Title",ExpressionUUID->"0ff0973b-165a-4a22-a6f6-d8a4dd4bbf9a"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"f23e9691-5109-4bfe-bb71-db26afea46aa"],

Cell["\<\
CATInequalityQ[graph, {p, q, r}, k : 0] tests whether the geodesic triangle \
on {p, q, r} satisfies the CAT(k) thinness inequality. Option Method \
(\"ApexSide\" (default) -- d(apex, x) <= d_k_bar(apex', x') for every \
interior vertex x on the side opposite to each apex; \"TwoRays\" -- d(x, y) \
<= d_k_bar(x', y') for every cross-ray pair (x, y) on the two rays emanating \
from each apex). Returns Indeterminate when k > 0 and the triangle perimeter \
exceeds 2 Pi / Sqrt[k].\
\>", "Text",ExpressionUUID->"553ca6c1-7f24-4c11-ad5e-c11dfd400f1d"],

Cell["Setup", "Section",ExpressionUUID->"7e070e55-acbf-424d-9eb2-3c4848b35d46"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"907447a0-994c-4735-bf4c-e987b9504f88"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"594570f5-a6eb-4524-b1ea-26b2fd2b7110"],

Cell["Related Guides", "Section",ExpressionUUID->"1bb3e58a-0dc8-44e1-a66a-d691533cbcd0"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"be1b20b9-469f-4dd7-b878-6c1583e05c2d"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"7f799760-0c34-484a-bfe3-af4dbf792662"]
},
