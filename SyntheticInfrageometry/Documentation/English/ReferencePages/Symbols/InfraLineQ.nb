Notebook[{

Cell[CellGroupData[{
Cell["InfraLineQ", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b066e439-8f5c-48dc-a94b-852e8e812ca5"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLineQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["walk", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "be66500a-2587-46cf-a050-c8a7d5b35b6b"],
 "\[LineSeparator]",
 "tests whether ",
 StyleBox["walk", "TI"],
 " is a line in ",
 StyleBox["g", "TI"],
 ": a geodesic that no neighbour of either endpoint prolongs.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"99d80076-3824-4bbc-ad9e-2bc2ce20c911"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLineQ"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLineQ", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["lines", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e111610f-f3e6-428f-999a-620486c54535"],
 "\[LineSeparator]",
 "tests every line of an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "552fc1b1-9238-40cc-b357-653d2750d1bf"],
 " bundle or pool."
}], "Usage",ExpressionUUID->"676fe1ff-49c6-4109-8c3c-fed9ad9b0d1e"],

Cell[TextData[{
 "Two conditions: the sequence is a geodesic (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegmentQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegmentQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0511111a-b3b5-4ac2-a796-80e6a87e2884"],
 "), and stepping off either end to a neighbour gives a walk that is no \
longer a shortest path \[LongDash] no neighbour of the first vertex lies one \
step farther from the last, and no neighbour of the last lies one step \
farther from the first. Both tests are single distance lookups."
}], "Notes",ExpressionUUID->"1c705600-1101-4d75-b05b-1b0c785a31c6"],

Cell[TextData[{
 "Sequences shorter than two vertices are ",
 Cell[BoxData["False"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c4320a3-553e-4f0d-876d-d9eabfc3cf21"],
 "."
}], "Notes",ExpressionUUID->"3eb200e6-c523-499d-9895-4c2cd4028bec"],

Cell[TextData[{
 "The predicate is the companion of ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8e9f4bba-cf43-4c71-b566-e9f241153371"],
 ", and every line that finder returns satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60ae5e85-bd51-4a6f-a194-7df0b97f73be"],
 "."
}], "Notes",ExpressionUUID->"018fca07-609c-4328-84b6-a37b775e5542"]
}, Open  ]],

