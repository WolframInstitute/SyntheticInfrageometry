Cell["\<\
The square on the four corners of a 5\[Times]5 grid has one realisation; the \
diamond on the four side midpoints has 1296.\
\>", "ExampleText",ExpressionUUID->"21ed7461-3c43-4f27-825d-0b9c9eb4e2e9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"5", ",", " ", "5"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "5", ",", " ", "25", ",", " ", "21"}], "}"}],
          ",", " ", "All"}], "]"}], "[", "\"\<Realizations\>\"", "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{
       RowBox[{"FindInfraPolygon", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "15", ",", " ", "23", ",", " ", "11"}], 
          "}"}], ",", " ", "All"}], "]"}], "[", "\"\<Realizations\>\"", 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c48f5c93-4cb3-419e-a5a6-c629089fabfb"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"1", ",", "1296"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"6b1fe2c0-0403-450b-a2f8-53763255adb4"]
}, Open  ]],

Cell["\<\
Three of the diamonds, streamed off the class in random order.\
\>", "ExampleText",ExpressionUUID->"c24f1061-bdf1-4d2d-b832-54c8ed62d710"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"With", "[", "\n", "  ", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", " ", "=", " ", 
