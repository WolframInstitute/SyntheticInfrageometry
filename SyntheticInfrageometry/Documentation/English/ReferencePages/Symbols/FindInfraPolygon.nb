Notebook[{
Cell["FindInfraPolygon", "Title",ExpressionUUID->"91ea66f1-3d3e-4b57-b8a2-21e3b1ffd9f2"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d8b81f15-cd90-4576-953e-26beb9995249"],

Cell["\<\
FindInfraPolygon[graph, {p1, ..., pn}] returns {InfraPolygon[{poly}]} for the \
polygon through corners p1, ..., pn (n >= 3), each side a geodesic between \
consecutive corners and the last side returning to p1. \
FindInfraPolygon[graph, verts, count] returns exactly count or $Failed; \
UpTo[count] returns up to count; All returns all polygons (the Cartesian \
product of per-side geodesic realisations). Default count = 1 (first geodesic \
per side). Corners accept bare vertices or unary InfraPoint. Options \
Properties / Method forward to the side geodesics (see FindInfraSegment).\
\>", "Text",ExpressionUUID->"b02ffda7-9fbb-48e1-9a68-73c9c36e6b26"],

Cell["Setup", "Section",ExpressionUUID->"84886511-6c37-4148-a571-7a1665b44836"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"24d8f63c-ffd4-414b-bc32-eb402b81936a"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"60049816-9319-4f8f-8ce3-7b3c8f7b75e5"],

