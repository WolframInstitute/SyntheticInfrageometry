   {Cell["      ", "ModInfo",ExpressionUUID->
     "bd0bb8b2-ec17-4189-91c7-a0e58f662a3b"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "d7a1a5c2-27b1-4c5d-9b09-467144e6fb55"]], "TableText",ExpressionUUID->
     "1ea4f21c-cd8e-4d9f-8b2f-6aa0b9fc8ddb"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "86bc34c7-3533-4ff9-a5f9-0ea9ce37e4be"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "89831af5-a936-450d-b965-3674f3643017"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b5f820a5-ed1d-496d-92ce-22005a4ac2fb"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5fc69a0a-a9c9-46c2-a697-43572f07d396"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cb5b20cf-cfb2-4df7-8216-451be4dd5c3d"]
    }], "TableText",ExpressionUUID->"c91897c6-a91e-4ef4-815a-b7b9ca99880b"], 
    Cell[TextData[{
     "forwarded to the side geodesics. ",
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f6555343-0f9d-48e3-90a0-739cf7f1d388"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bcb4a66f-f1f8-4617-9490-e3883183fced"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "453b98ab-18a3-49a6-aecb-d121855deb36"],
     ", a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "592f94f4-6472-4f6d-ac15-6cda70c9eb55"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f5147e67-8ce4-4303-8fa5-cc97b91741e1"],
     " and ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e1b3516e-9cd3-42c6-a530-16dbb1dc20c4"],
     " take each side's geodesics in candidate order, ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "114408ee-6612-494c-8ad5-463762b85cef"],
     " in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "5c08d803-174e-4388-88f7-c8cf6427b484"],
     ". ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ce83b474-d6c6-43cb-8a37-d40b718024a9"],
     " is accepted and inert: the sides come off geodesic pools, which have \
no frontier to cap."
    }], "TableText",ExpressionUUID->"a41e0156-e3af-4fdb-b7a3-7cc4486991b3"]}
  }]], "3ColumnTableMod",ExpressionUUID->"8776fa3b-89d3-4029-a8bb-\
9b3cb848e793"],

Cell[TextData[{
 "Sides chosen by a local rule \[LongDash] straightest, curvature-minimising \
\[LongDash] are not a polygon option: build them with ",
 Cell[BoxData["FindInfraGeodesic"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2aa56c14-9ef3-4559-b804-795f6d519bc7"],
 " and assemble the ",
