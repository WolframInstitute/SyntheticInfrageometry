    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPolygon", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "93b6289b-b2d3-4908-a247-13edced3ebfa"],
 "."
}], "Notes",ExpressionUUID->"97a6746a-fe72-4728-9d0a-34f136821938"],

