Cell["Two rays leave the middle of a path.", "ExampleText",ExpressionUUID->"6cb30c12-4c6a-4bfe-ad8a-b985b9caf42d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"PathGraph", "[", 
    RowBox[{"Range", "[", "7", "]"}], "]"}], ",", " ", "4"}], "]"}]], "Input",\

 CellLabel->"In[1]:= ",ExpressionUUID->"847779ec-8445-40bf-bc4f-2345dc9f3f01"],

Cell[BoxData["2"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"73da0bc8-e025-4295-8a1a-6e214d510595"]
}, Open  ]],

Cell["\<\
Two leave a vertex of the 6-cycle \[LongDash] both end at the antipode \
\[LongDash] and eight leave the centre of a 3 \[Times] 3 grid.\
\>", "ExampleText",ExpressionUUID->"ba00261d-ea87-43cd-992b-740fa8561a1c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1"}], "]"}], ",", " ", 
   
   RowBox[{"PencilCardinality", "[", 
    RowBox[{
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], ",", " ", "5"}], "]"}]}], 
  "}"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"aefda7f7-2b60-4d5f-b3d1-1c9d18b64daa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"2", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"fbccb8f7-232a-46b0-8695-dfb99b0590f9"]
}, Open  ]],

Cell["\<\
On the 3-cube every geodesic from a vertex runs to the antipode, so the \
pencil has 3! = 6 rays.\
\>", "ExampleText",ExpressionUUID->"1e9df599-0dd6-48d2-a6c2-1073a356f6bd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"PencilCardinality", "[", 
  RowBox[{
   RowBox[{"HypercubeGraph", "[", "3", "]"}], ",", " ", "1"}], "]"}]], "Input",\

 CellLabel->"In[3]:= ",ExpressionUUID->"183f19f1-794d-4cd3-a39d-bb946eb49f5a"],

Cell[BoxData["6"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"407e287d-f221-49c5-a0e7-9b6883fc7483"]
}, Open  ]],

Cell["\<\
The pencil at the centre of each substrate, counted without enumerating a ray.\
\>", "ExampleText",ExpressionUUID->"1cca2c00-3b2b-4299-83c9-73d87800baf5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"PencilCardinality", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "]"}]}], "]"}]}], ",", 
    "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[4]:= ",ExpressionUUID->"e6d53b4a-63f0-43f7-9932-681823aca6bd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1587"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "16380"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "762"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[4]= ",ExpressionUUID->"63f27cad-7228-41da-bfbc-343368f76113"]
}, Open  ]]
}, Open  ]],

