Notebook[{

Cell[CellGroupData[{
Cell["PencilCardinality", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"97831d19-1d09-4c07-92a2-f514ec6b72dd"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["PencilCardinality"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilCardinality", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "811cc7da-7dca-4256-b6d8-66c438cf1028"],
 "\[LineSeparator]",
 "gives the number of rays from ",
 StyleBox["O", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ".",
 "\n"
}], "Usage",ExpressionUUID->"4567d100-4618-4175-aab2-149d6d657d21"],

Cell[TextData[{
 "The pencil at ",
 StyleBox["O", "TI"],
 " is the set of rays from ",
 StyleBox["O", "TI"],
 " (",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilDirections"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilDirections", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "35f892c8-0c88-45ec-98f9-a6fe440065b8"],
 "). A ray leaves ",
 StyleBox["O", "TI"],
 " through exactly one neighbour, so its size is the sum over the neighbours ",
 StyleBox["w", "TI"],
 " of the path count of the ray pool ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["w", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2683bc58-f4d5-4fc5-a739-a1d13d52d886"],
 " \[LongDash] read off each pool's ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "2ad80848-0fb1-479a-b4bb-71a3395d4415"],
 " by dynamic programming, never by enumerating rays."
}], "Notes",ExpressionUUID->"29d41c65-ee56-4b10-956f-51cafad940d0"],

Cell[TextData[{
 "The count is at least the degree of ",
 StyleBox["O", "TI"],
 ", with equality when every direction continues uniquely to a unique end. \
Its excess over the degree measures how much the graph branches ahead of ",
 StyleBox["O", "TI"],
 "; on a lattice it is large."
}], "Notes",ExpressionUUID->"07dce7dc-c47f-4eeb-8f63-a41254e9ddd1"]
}, Open  ]],

