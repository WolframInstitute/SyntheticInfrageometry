Cell["The count equals the length of the enumerated pencil.", "ExampleText",ExpressionUUID->"963209c9-703b-47b5-b47e-d8d11af6d99f"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"3", ",", " ", "3"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"PencilCardinality", "[", 
      RowBox[{"g", ",", " ", "5"}], "]"}], ",", " ", 
     RowBox[{"Length", " ", "@", " ", 
      RowBox[{"PencilDirections", "[", 
       RowBox[{"g", ",", " ", "5"}], "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"ea2d4f94-f65f-453d-b319-fa3bc258379f"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"8", ",", "8"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"beaf3328-196a-45ac-b1b0-7280306dd340"]
}, Open  ]],

Cell["It is at least the degree.", "ExampleText",ExpressionUUID->"263c2532-5c64-418d-b23c-cb14bc2d9cd6"],

