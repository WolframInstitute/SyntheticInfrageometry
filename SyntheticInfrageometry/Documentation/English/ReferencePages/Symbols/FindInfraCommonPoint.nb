Notebook[{
Cell["FindInfraCommonPoint", "Title",ExpressionUUID->"728b2f09-b016-4135-89ed-9ab895b56827"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"e1f1fe46-3993-46d0-b3ef-094114de64a6"],

Cell["\<\
FindInfraCommonPoint[graph, lines] returns a List of unary InfraPoint[{v}] \
wrappers for the vertices on every listed line, or $Failed. With n / UpTo[n] \
/ All controls multiplicity. Entries may be bare vertex sequences or \
InfraSegment / InfraRay wrappers.\
\>", "Text",ExpressionUUID->"2706ce79-b100-4b68-9898-c2a1746a98e5"],

