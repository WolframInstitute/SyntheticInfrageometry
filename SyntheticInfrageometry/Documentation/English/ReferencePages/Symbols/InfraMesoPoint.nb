Cell["InfraMesoPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"cd97e85d-ce3c-4e77-be67-8bab0eaa6d19"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraMesoPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMesoPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
