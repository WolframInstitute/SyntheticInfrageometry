Cell["\<\
Two vertices at odd distance have no exact midpoint. The answer is a \
mesopoint.\
\>", "ExampleText",ExpressionUUID->"3d2c1bfa-4673-4ba9-b914-a1136f744cca"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"FindInfraMidpoint", "[", 
    RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"c15e3785-bdb3-43f7-81ee-8e17972ecfb0"],

Cell[BoxData[
 RowBox[{"InfraMesoPoint", "[", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"3", "\[Rule]", "6"}], ",", 
    RowBox[{"7", "\[Rule]", "1"}], ",", 
    RowBox[{"8", "\[Rule]", "3"}], ",", 
    RowBox[{"9", "\[Rule]", "3"}], ",", 
    RowBox[{"10", "\[Rule]", "6"}], ",", 
    RowBox[{"21", "\[Rule]", "1"}]}], "\[RightAssociation]"}], 
  "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3555a7b2-d607-4f16-bbd6-133986eaa730"]
}, Open  ]],

Cell["\<\
The accessors read it apart. The support is a region; the entropy says how \
far from sharp it is.\
\>", "ExampleText",ExpressionUUID->"da9dbb51-c130-46d8-ace9-4c80b8ae2c9a"],

