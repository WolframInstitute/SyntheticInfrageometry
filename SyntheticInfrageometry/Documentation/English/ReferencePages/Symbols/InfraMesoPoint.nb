    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "95115dde-4d79-4fd4-bdeb-5a6dd4b9926b"],
 "\[LineSeparator]",
 "is sugar for the association form.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"5191efb6-9dee-418c-bf47-eeedda25104a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
