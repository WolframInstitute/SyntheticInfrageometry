Cell[TextData[{
 "A ",
 StyleBox["bare vertex list is refused",
  FontWeight->"Bold"],
 ". ",
 Cell[BoxData[
  RowBox[{"InfraMesoPoint", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "2"}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9faaafe3-ae1a-4d50-844c-b8177c36178c"],
 " stays inert by design: on a graph with list-valued vertex labels a support \
list and a single label are indistinguishable, and that ambiguity is what the \
three-head split exists to remove."
}], "Notes",ExpressionUUID->"f8b2de24-8c31-4acc-bf48-31e8c1c02157"],

