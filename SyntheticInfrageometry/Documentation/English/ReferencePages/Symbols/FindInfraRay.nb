Cell["\<\
Five rays leave vertex 6 of the grid through its neighbour 7; two stop at the \
corner 4 after three steps, three reach the corner 16 after four. The pool is \
one DAG.\
\>", "ExampleText",ExpressionUUID->"cf7bbe8c-69f0-4774-afde-0927c4206266"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"rays", " ", "=", " ", 
     RowBox[{"FindInfraRay", "[", 
      RowBox[{
       RowBox[{"GridGraph", "[", 
        RowBox[{"{", 
         RowBox[{"4", ",", " ", "4"}], "}"}], "]"}], ",", " ", "6", ",", " ", 
       "7", ",", " ", "All"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
