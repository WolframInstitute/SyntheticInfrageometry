     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "8f6fd17b-4c6e-4d1c-8d0f-ad24c173a9e2"],
 "; the predicate accepts the pool."
}], "ExampleText",ExpressionUUID->"171ff5ff-0e18-48ed-beff-4035c74140a2"],

