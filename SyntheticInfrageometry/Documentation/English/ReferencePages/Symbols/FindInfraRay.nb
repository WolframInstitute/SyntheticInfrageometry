Cell["\<\
How many rays leave the centre of each substrate through a vertex at distance \
5.\
\>", "ExampleText",ExpressionUUID->"83b5d2fb-7838-4ece-a7ab-a9e18c1bcc30"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"FindInfraRay", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}], 
        "[", "\"\<Multiplicity\>\"", "]"}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e453a5b9-a510-426f-9f51-e2ec12ba9680"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "21"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "1280"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "48"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"75fa45ba-c18c-485c-8de5-d1608e17b849"]
}, Open  ]],

Cell["\<\
Three rays from the centre of each substrate. Each starts at the origin and \
runs to the edge of the patch; a bounded count is a random descent, so the \
seed goes in front.\
\>", "ExampleText",ExpressionUUID->"4c265ed6-b3e0-424c-a4f2-2f7ebf3f26bf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"Row", "[", 
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{
          "name", ",", " ", "\"\<Medium\>\"", ",", " ", "\"\<Gray\>\"", ",", 
           " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Labeled", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", "\n", "         ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"FindInfraRay", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
                RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], " ", "->", " ", 
              "$InfraRayColor"}], ",", "\n", "          ", 
             RowBox[{
              RowBox[{"InfraPoint", "[", "a", "]"}], " ", "->", " ", 
              "$InfraPointColor"}]}], "}"}], ",", "\n", "         ", 
           RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", 
           "\n", "         ", 
           RowBox[{"VertexShapeFunction", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
                RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], 
             ")"}]}], ",", "\n", "         ", 
           RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
         "       ", 
         RowBox[{"Text", "[", "name", "]"}]}], "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"1b87760f-04c5-4432-96f7-eb225f76b77b"],

