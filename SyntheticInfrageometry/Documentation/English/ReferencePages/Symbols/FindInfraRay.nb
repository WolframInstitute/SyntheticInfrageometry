Notebook[{
Cell["FindInfraRay", "Title",ExpressionUUID->"342e8a43-3f30-49d7-9938-27336481db19"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"9185f8e8-914c-4ffa-a609-d2d4490f727c"],

Cell["\<\
FindInfraRay[graph, O, v] returns {InfraRay[{ray}]} for one pointed half-line \
from O in v's direction: the half of a maximal geodesic line through O and v \
starting at O and ending at the far inextensible endpoint. \
FindInfraRay[graph, O, v, n] returns a List of n unary InfraRay[{ray}] \
wrappers or $Failed; UpTo[n] / All controls multiplicity. O and v accept \
InfraPoint[{...}] for multi-anchor spread.\
\>", "Text",ExpressionUUID->"8cb32653-edac-4048-8715-7dcda4fc04d4"],

Cell["Setup", "Section",ExpressionUUID->"76965a43-7812-4859-86a2-6d133ff0f0be"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"ae26b2f3-6ff6-490b-903e-eb66af12c200"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"93f6dfd2-a4af-4cac-93a0-37a278b4a625"],

Cell["Related Guides", "Section",ExpressionUUID->"0ce3d007-5352-463b-923d-5b25ace13615"],

