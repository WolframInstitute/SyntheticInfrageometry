Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRay", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"2909b053-5b26-4785-9bb3-e27391959037"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "87f6d1c5-d950-47d3-8fbc-0a8ad5792c60"],
 "\[LineSeparator]",
 "gives one ray from ",
 StyleBox["O", "TI"],
 " through ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic from ",
 StyleBox["O", "TI"],
 " containing ",
 StyleBox["v", "TI"],
 " that cannot be prolonged past its last vertex \[LongDash] as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9afa1f58-ffbd-4b08-9e90-a677aaa7a07c"],
 " wrapper.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"ea646742-0265-484c-a456-11d64a2a8ab6"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd38b0af-7b56-4860-9221-9f41de80e8d4"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " rays or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bd76c84d-314a-40a0-9e28-4e9aa7b0b634"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "589dab6d-6633-4d5f-b7f8-2de411ee643a"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "07502c87-146a-4ada-93dd-343650ecdf7b"],
 " gives the whole class as a pool."
}], "Usage",ExpressionUUID->"ca7700ca-714d-41f1-9f52-71dcae22e621"],

Cell[TextData[{
 "A ray from ",
 StyleBox["O", "TI"],
 " through ",
 StyleBox["v", "TI"],
 " is a geodesic ",
 StyleBox["O \[Ellipsis] v \[Ellipsis] e", "TI"],
 " with ",
 StyleBox["d(O, e) = d(O, v) + d(v, e)", "TI"],
 " such that no neighbour of ",
 StyleBox["e", "TI"],
 " lies one step farther from ",
 StyleBox["O", "TI"],
 ". The first vertex is the origin, which is what makes it a ray rather than \
a line: inextensibility is required at the far end only. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9162b3cc-e133-499c-9ecb-2ea46e0de93b"],
 " is the predicate."
}], "Notes",ExpressionUUID->"5d493fc2-2bce-48da-96c6-66cad31ab2f1"],

Cell[TextData[{
 "Rays are how direction is expressed without a vector space. There is no \
tangent space on a graph, so \"the direction from ",
 StyleBox["O", "TI"],
 " towards ",
 StyleBox["v", "TI"],
 "\" is not a vector but the ",
 StyleBox["family", "TI"],
 " of rays from ",
 StyleBox["O", "TI"],
 " containing ",
 StyleBox["v", "TI"],
 " \[LongDash] and like every other family here it is large. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilDirections"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilDirections", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "fcaa65f6-cf71-43b0-8c87-b75c2017680b"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilCardinality", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "34694620-8bda-4597-8969-a2fd1f946129"],
 " count the rays leaving a vertex, the graph's stand-in for the sphere of \
directions; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/SameDirectionQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3db93f33-707d-4552-8c82-d260472cb9d5"],
 " compares directions."
}], "Notes",ExpressionUUID->"958b2208-8ee3-48c6-9dc6-b58ca44888f2"],

Cell[TextData[{
 "The pool is a single DAG with source ",
 StyleBox["O", "TI"],
 ": the geodesic bundle from ",
 StyleBox["O", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " glued at ",
 StyleBox["v", "TI"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      ButtonBox["O",
       BaseStyle->"Link"], ",", " ", 
      StyleBox["v", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "182b227d-df15-4991-8e57-22ef0b56c4f8"],
 ". The extension set is closed under a farther step, so the sinks of that \
DAG are exactly the inextensible ends and every path from ",
 StyleBox["O", "TI"],
 " to a sink is a ray. There is no compatibility condition on one side, so \
the finder agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "603ae6df-85d4-4a6e-81f0-1dc77d23f5e4"],
 " by construction. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "517f8bc6-388a-44d7-b245-098edecf8a8e"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    StyleBox["dag", "TI"], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b208168c-fdf0-44a2-9c30-61fe6f576779"],
 "; its ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fa9d26fa-a7ac-41e7-8074-23d6c2ae4dfe"],
 " is the path count and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "df60305c-9bab-47a0-a0ac-61df25ab3dac"],
 " lists one length per ray, since rays to different sinks differ in length. \
A bounded count streams rays off the DAG."
}], "Notes",ExpressionUUID->"0be7fefa-8777-4cfb-bf31-00f0c5882dfe"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f5d210ca-f967-4e2e-9932-84075a5fee5f"],
 " is every ray from ",
 StyleBox["O", "TI"],
 " \[LongDash] the pencil. Wrapper anchors such as ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSet"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSet", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "7072c73f-0aef-415a-94d2-daadf2f3dfd5"],
 " spread to one DAG per pair."
}], "Notes",ExpressionUUID->"70f17c20-5954-4c9a-b3a5-27e974f6f019"],

Cell[TextData[{
 "The longest rays are a selection on the result, ",
 Cell[BoxData[
  RowBox[{"SelectInfraWalk", "[", 
   RowBox[{"g", ",", " ", "rays", ",", " ", "All", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<MaxLength\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3b08b844-5f56-4b0a-9daa-4addc533639f"],
 "."
}], "Notes",ExpressionUUID->"3e236f6f-602e-4554-85e0-bbd0ebc7960c"],

