Cell["\<\
How many rays leave the centre of each substrate through a vertex at distance \
5.\
\>", "ExampleText",ExpressionUUID->"39d080d8-0c48-4ed3-bf01-2ced843eb462"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"FindInfraRay", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}], 
        "[", "\"\<Multiplicity\>\"", "]"}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"cca87433-74bc-4d7d-9692-f606375bf182"],

