Notebook[{

Cell[CellGroupData[{
Cell["FindInfraRay", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"0e1fe6c1-4370-45bf-b963-1fb17c651b97"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c57ae74-ffd4-4b92-b85e-913e4e726cdc"],
 "\[LineSeparator]",
 "gives one ray from ",
 StyleBox["O", "TI"],
 " through ",
 StyleBox["v", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] a geodesic from ",
 StyleBox["O", "TI"],
 " containing ",
 StyleBox["v", "TI"],
 " that cannot be prolonged past its last vertex \[LongDash] as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRay"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e937fddb-601f-4099-bc45-b0a8e044c992"],
 " wrapper.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"8b9c1986-07b8-4fd4-8902-d99eb12cec9d"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8d655472-4aab-439d-8317-5792f1094ba1"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " rays or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cce736b4-0fc7-4d9e-88f7-4ee2a937d09b"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60a153c6-7954-461d-86ef-412ef7a0b629"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b94b6c96-d69c-4856-8aa4-95989207d4fb"],
 " gives the whole class as a pool."
}], "Usage",ExpressionUUID->"9083a9a7-f884-44eb-ba86-935b9d0c0cb8"],

Cell[TextData[{
 "A ray from ",
 StyleBox["O", "TI"],
 " through ",
 StyleBox["v", "TI"],
 " is a geodesic ",
 StyleBox["O \[Ellipsis] v \[Ellipsis] e", "TI"],
 " with ",
 StyleBox["d(O, e) = d(O, v) + d(v, e)", "TI"],
 " such that no neighbour of ",
 StyleBox["e", "TI"],
 " lies one step farther from ",
 StyleBox["O", "TI"],
 ". The first vertex is the origin, which is what makes it a ray rather than \
a line: inextensibility is required at the far end only. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "3f43d724-ea95-4002-bbef-766187e0910f"],
 " is the predicate."
}], "Notes",ExpressionUUID->"c37e6f7a-7439-411d-9601-c8c29a6ff652"],

Cell[TextData[{
 "Rays are how direction is expressed without a vector space. There is no \
tangent space on a graph, so \"the direction from ",
 StyleBox["O", "TI"],
 " towards ",
 StyleBox["v", "TI"],
 "\" is not a vector but the ",
 StyleBox["family", "TI"],
 " of rays from ",
 StyleBox["O", "TI"],
 " containing ",
 StyleBox["v", "TI"],
 " \[LongDash] and like every other family here it is large. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilDirections"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilDirections", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "1f45869e-9b6b-4571-b17f-7c3e30de0bfe"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilCardinality", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "c52c601f-705b-4847-9296-2b80ca81e7af"],
 " count the rays leaving a vertex, the graph's stand-in for the sphere of \
directions; ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["SameDirectionQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/SameDirectionQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "9d849907-4f09-4c7f-afe9-eedec4ddbc36"],
 " compares directions."
}], "Notes",ExpressionUUID->"64ec194b-813e-4765-8ef1-e3adf3521679"],

Cell[TextData[{
 "The pool is a single DAG with source ",
 StyleBox["O", "TI"],
 ": the geodesic bundle from ",
 StyleBox["O", "TI"],
 " to ",
 StyleBox["v", "TI"],
 " glued at ",
 StyleBox["v", "TI"],
 " to ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      ButtonBox["O",
       BaseStyle->"Link"], ",", " ", 
      StyleBox["v", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "58726213-a76c-42ab-907b-78b28a128264"],
 ". The extension set is closed under a farther step, so the sinks of that \
DAG are exactly the inextensible ends and every path from ",
 StyleBox["O", "TI"],
 " to a sink is a ray. There is no compatibility condition on one side, so \
the finder agrees with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraRayQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRayQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "0d8d9302-c66b-4f92-99cd-48880fe4d93a"],
 " by construction. ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ff3bb602-8455-4a1e-88a8-745b0bee0d5e"],
 " returns ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    StyleBox["dag", "TI"], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55c5fc30-d8a6-4a43-8b27-aeda54f60f11"],
 "; its ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9acd0173-3373-4de2-97c1-f05a39c14bd1"],
 " is the path count and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6fc573c3-6849-4275-b43c-4a68c4437c66"],
 " lists one length per ray, since rays to different sinks differ in length. \
A bounded count streams rays off the DAG."
}], "Notes",ExpressionUUID->"16252f9f-789e-47e4-a441-24885bfec529"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraRay"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraRay", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["O",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "14d36be9-0c38-4248-989c-9b652b20c279"],
 " is every ray from ",
 StyleBox["O", "TI"],
 " \[LongDash] the pencil. A density anchor ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "01ceee79-b3e7-40af-84ee-4bcff2a898fe"],
 " spreads to one DAG per pair."
}], "Notes",ExpressionUUID->"be15b364-41f7-4859-932b-c942182d3445"],

Cell[TextData[{
 "The longest rays are a selection on the result, ",
 Cell[BoxData[
  RowBox[{"SelectInfraWalk", "[", 
   RowBox[{"g", ",", " ", "rays", ",", " ", "All", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<MaxLength\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "79e17c4b-de34-4c69-becc-b65e74f94393"],
 "."
}], "Notes",ExpressionUUID->"7b353a71-8439-457b-a119-425fcf1a4f0e"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "99f307f0-d347-43ee-8f8b-6bae424f8c76"], Cell["Option", "TableText",
     FontWeight->Bold,ExpressionUUID->"93129d74-01f8-42b6-9657-85d85ff96ebd"],
     Cell["Values", "TableText",
     FontWeight->Bold,ExpressionUUID->"a0d79ab5-449c-44ff-9fa9-cbbfeff8051d"],
     Cell["Meaning", "TableText",
     FontWeight->Bold,ExpressionUUID->"5b040624-9dfb-4b9a-9fbd-b1433208a653"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "3b4919a0-b44b-4650-ab65-bd0c2b039ade"], Cell[TextData[Cell[BoxData[
    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "cbd1c72e-3e46-48dd-a363-6ed85f26ecfc"]], "TableText",ExpressionUUID->
     "ae7d46b5-08e3-424a-a3f6-b8a0bad42688"], Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "372c695c-9273-432e-9969-c7926b366aca"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1e729a86-2b02-4114-bc87-5ba8fae16726"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "c4f4910b-fc3b-491a-9322-42f4e5dd2924"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "63d72586-3008-42ad-a205-fe01dafd2704"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "cc267a77-cd0f-4207-b36d-048fbc324995"]
    }], "TableText",ExpressionUUID->"cee94193-d1fe-48f9-a88c-a8001def5d32"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2670ce05-c521-4c73-b91b-85245923bdfa"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7484e6c5-b91c-48d2-808d-2d25006d9c01"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "45f8f2d0-bb1e-4e78-8850-42ad802221a8"],
     ", the pool; a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a7227469-7416-410a-87d4-239303d971c9"],
     ", which takes the branches of the DAG in candidate order, so the \
count-less call is deterministic. ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b316634c-525d-4c8b-8996-06c953cb2da6"],
     " takes them in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "e2ead821-90b6-40dd-a6ef-b9a611a22b24"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "4707a15a-2b7a-41d3-af26-68954b7758d9"],
     " is accepted and inert, the pool having no frontier to cap."
    }], "TableText",ExpressionUUID->"3c46264c-2c79-4f9e-8476-b6dda70f5980"]}
  }]], "3ColumnTableMod",ExpressionUUID->"c28f0d6f-99fb-4bd5-829b-\
494c401c0a34"],

