Cell["\<\
Every ray begins at its origin, and the distance from the origin grows by one \
at each step.\
\>", "ExampleText",ExpressionUUID->"ba5c20d1-b6f5-4493-9ed1-d9e8660f2799"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{
      RowBox[{"FindInfraRay", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}], 
      "[", "\"\<First\>\"", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", "ray", "]"}], " ", "===", " ", "a"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "&"}], " ", 
       "/@", " ", "ray"}], " ", "===", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{
         RowBox[{"Length", "[", "ray", "]"}], " ", "-", " ", "1"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"67c83e06-bc76-4cdd-837e-91f7b0fa38f6"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"ray$", "::", "shdw"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Symbol", " "}], 
  TagBox["\<\"ray$\"\>",
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"appears", " ", "in", " ", "multiple", " ", "contexts", " "}]}], 
  TagBox[
   RowBox[{"{", 
    RowBox[{"\<\"WolframInstitute`SyntheticInfrageometry`InfraRay`\
PackagePrivate`\"\>", 
     ",", "\<\"WolframInstitute`Infrageometry`Displacements`PackagePrivate`\"\
\>"}], "}"}],
   HoldCompleteForm], 
  RowBox[{";", " ", 
   RowBox[{"definitions", " ", "in", " ", "context", " "}]}], 
  TagBox["\<\"WolframInstitute`SyntheticInfrageometry`InfraRay`PackagePrivate`\
\"\>",
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{
   "may", " ", "shadow", " ", "or", " ", "be", " ", "shadowed", " ", "by", " ",
     "other", " ", 
    RowBox[{"definitions", "."}]}]}]}]], "Message", \
"MSG",ExpressionUUID->"d6625890-480b-4bb7-9c45-78b745f1b30e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"True", ",", "True"}], "}"}]], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"87b06e2d-f768-4ee5-b9ad-27c4a2a80871"]
}, Open  ]],

Cell["\<\
With the origin as its own direction the pool is the whole spray, and its \
rays are the pencil.\
\>", "ExampleText",ExpressionUUID->"12e95c24-65aa-4baf-98db-97d761e0e405"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{
    RowBox[{"FindInfraRay", "[", 
     RowBox[{
      RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1", ",", " ", "1", ",",
       " ", "All"}], "]"}], "[", "\"\<Realizations\>\"", "]"}]}], " ", "===", 
  " ", 
  RowBox[{"Sort", " ", "@", " ", 
   RowBox[{"PencilDirections", "[", 
    RowBox[{
     RowBox[{"CycleGraph", "[", "6", "]"}], ",", " ", "1"}], 
    "]"}]}]}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"8ffb4d32-9f36-4be2-95bf-631f494df3e6"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"020be707-c9cc-4c21-9334-1e45620db470"]
}, Open  ]],

