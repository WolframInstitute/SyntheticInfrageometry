Cell[TextData[{
 "Three rays from the centre of each substrate. Each starts at the origin and \
runs to the edge of the patch; they are drawn off the pool in random order, \
",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6214e187-c9a5-4a06-b668-5945a18bc0be"],
 " being the explicit random call, with the seed in front of it."
}], "ExampleText",ExpressionUUID->"cc86fb67-f91a-4c4e-a662-ff930e20681d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"Row", "[", 
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{
          "name", ",", " ", "\"\<Medium\>\"", ",", " ", "\"\<Gray\>\"", ",", 
           " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Labeled", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", "\n", "         ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"FindInfraRay", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
                RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]}], 
               "]"}], " ", "->", " ", "$InfraRayColor"}], ",", "\n", 
             "          ", 
             RowBox[{
              RowBox[{"InfraPoint", "[", "a", "]"}], " ", "->", " ", 
              "$InfraPointColor"}]}], "}"}], ",", "\n", "         ", 
           RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", 
           "\n", "         ", 
           RowBox[{"VertexShapeFunction", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
                RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], 
             ")"}]}], ",", "\n", "         ", 
           RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
         "       ", 
         RowBox[{"Text", "[", "name", "]"}]}], "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"63e4c2c0-0ce9-40e8-bf2a-0475d60958f3"],

