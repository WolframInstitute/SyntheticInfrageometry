Notebook[{
Cell["FindInfraRay", "Title",ExpressionUUID->"7f823e76-22a3-4de3-8b0f-c380c6dcd6be"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"88ffcd8f-e148-4a73-8007-b778134e8cbc"],

Cell["\<\
FindInfraRay[graph, O, v] returns {InfraRay[{ray}]} for one pointed half-line \
from O in v's direction: the half of a maximal geodesic line through O and v \
starting at O and ending at the far inextensible endpoint. \
FindInfraRay[graph, O, v, n] returns a List of n unary InfraRay[{ray}] \
wrappers or $Failed; UpTo[n] / All controls multiplicity. O and v accept \
InfraPoint[{...}] for multi-anchor spread.\
\>", "Text",ExpressionUUID->"d622b8b0-44dc-4d9c-a722-8f56de28063f"],

Cell["Setup", "Section",ExpressionUUID->"5193d1f1-ec8e-47fe-83f3-1bcaa01970b0"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"849a45e3-3293-4bcd-8089-10d2cd3f863b"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"e68c5870-c816-4b5a-ae25-a261632f5b39"],

Cell["Related Guides", "Section",ExpressionUUID->"b1c6a858-fffd-4cfe-814a-1845728d563c"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"c98aa1cb-ebf2-40d8-b910-f74aff22a954"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"a8584540-f328-4a9d-a9c7-ac0195149a4d"]
