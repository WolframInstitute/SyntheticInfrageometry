Cell["\<\
Every ray begins at its origin, and the distance from the origin grows by one \
at each step.\
\>", "ExampleText",ExpressionUUID->"1f1e10a8-8912-42eb-9b12-01e568b413fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<HexagonalTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",",
        " ", 
       RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], "]"}]}],
     "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"ray", " ", "=", " ", 
     RowBox[{
      RowBox[{"FindInfraRay", "[", 
       RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}], 
      "[", "\"\<First\>\"", "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"First", "[", "ray", "]"}], " ", "===", " ", "a"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"GraphDistance", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "&"}], " ", 
       "/@", " ", "ray"}], " ", "===", " ", 
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", " ", 
        RowBox[{
         RowBox[{"Length", "[", "ray", "]"}], " ", "-", " ", "1"}]}], 
       "]"}]}]}], "}"}]}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"c04ad444-2491-4ff3-9382-17f17ef858a5"],

