Notebook[{
Cell["FindInfraCylinder", "Title",ExpressionUUID->"0e8dcfda-7925-428e-bde3-19867e34cf61"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"11a8dcaf-f143-4244-8bdf-ea2ee37a9bbf"],

Cell["\<\
FindInfraCylinder[graph, axis, r] returns InfraObject[set] for the \
constant-radius rotational set around axis. Defaults to Method -> \"Balls\" \
(the r-neighborhood of the axis, i.e. all v with d(v, c) <= r for some axis \
vertex c); pass Method -> \"Voronoi\" for the flat-capped variant. Inherits \
remaining FindInfraRevolution options.\
\>", "Text",ExpressionUUID->"a46be164-d1cd-47e9-bc4f-55be054df1b6"],

Cell["Setup", "Section",ExpressionUUID->"1cd3f9ef-5682-42db-9622-3e71fc4680f3"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"e75c1954-2a6d-4626-a087-e314c7cc0066"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"8118c78e-7557-4dff-9486-84331b1c9579"],

Cell["Related Guides", "Section",ExpressionUUID->"afe7900a-bedd-41a5-adbd-4ba5e8a337bc"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"3fe41b18-0cfd-4300-86c4-454c18eaff53"],

