Notebook[{
Cell["InfraAngle", "Title",ExpressionUUID->"be22817d-1936-4d0e-aa89-87936b0375b6"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"188f1cea-8540-4d95-a89f-2aad036d55df"],

Cell["\<\
InfraAngle[graph, {q1, p, q2}] returns an angle at p in radians. Option: \
Method (\"Arclength\" (default) -- delete the open ball of radius Min[d(p, \
q1), d(p, q2)] around p and return the shortest q1-q2 path length outside, \
divided by the radius (synthetic radian measure); \"Alexandrov\" -- the \
comparison-triangle angle at p in the Euclidean k = 0 model via the law of \
cosines; {\"Alexandrov\", \"Curvature\" -> k} -- the same angle in M_k^2 \
(spherical / Euclidean / hyperbolic) for arbitrary k). For the raw \
un-arccos'd scalar product use InfraScalarProduct[graph, p, q1, q2].\
\>", "Text",ExpressionUUID->"17dcacf6-40eb-4c19-98a9-7e3f6ddd5d29"],

Cell["Setup", "Section",ExpressionUUID->"c275bf67-a3a7-48b9-aaa1-3a7859ec6492"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"f28f7d41-ee54-4a6b-9032-6da8001a6b61"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"e38bfad7-7e39-4bed-ab7c-3dee0937b664"],

Cell["Related Guides", "Section",ExpressionUUID->"80c1ea78-0e45-4ca1-8885-5fd540ae16f1"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"a0c98a8a-f2f8-4575-ba4a-c39aa33da393"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"954ee631-fdaa-4b28-8023-b40edba902e3"]
},
