Cell["\<\
Three configurations at the centre of a square grid. Opposite arms of a line \
give exactly \[Pi]. The same direction gives exactly 0.\
\>", "ExampleText",ExpressionUUID->"cdee5552-9b63-46c0-9941-a039bfc65901"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraLine", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "far", ",", " ", "1"}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<opposite arms\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",",
            " ", 
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}], ",", "\n", "    ", 
     RowBox[{"\"\<same direction\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",",
            " ", 
           RowBox[{"line", "[", 
            RowBox[{"[", 
             RowBox[{"i", " ", "+", " ", "2"}], "]"}], "]"}]}], "}"}], ",", 
         " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"66e0333d-b9c5-4a88-a634-a4c4d903199d"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"opposite arms\"\>", "\[Rule]", "3.141592653589793`"}], ",", 
   RowBox[{"\<\"same direction\"\>", "\[Rule]", "0.`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"f22ec23c-a6d1-415d-bef2-99d8a6913cd0"]
}, Open  ]],

Cell["\<\
The Alexandrov method is the closed form in three distances, and agrees with \
it exactly.\
\>", "ExampleText",ExpressionUUID->"837ab5df-5b82-4816-8efe-3f7e03f6ee2d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q1", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"q2", " ", "=", " ", 
     RowBox[{"Last", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "4"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"d1", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "q1"}], "]"}]}], ",", " ", 
     RowBox[{"d2", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "c", ",", " ", "q2"}], "]"}]}], ",", " ", 
     RowBox[{"ch", " ", "=", " ", 
      RowBox[{"GraphDistance", "[", 
       RowBox[{"g", ",", " ", "q1", ",", " ", "q2"}], "]"}]}]}], "}"}], ",", 
   "\n", "  ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"N", " ", "@", " ", 
      RowBox[{"InfraAngle", "[", 
       RowBox[{"g", ",", " ", 
        RowBox[{"{", 
         RowBox[{"q1", ",", " ", "c", ",", " ", "q2"}], "}"}], ",", " ", 
        RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], "]"}]}], ",",
      "\n", "   ", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"d1", "^", "2"}], " ", "+", " ", 
         RowBox[{"d2", "^", "2"}], " ", "-", " ", 
         RowBox[{"ch", "^", "2"}]}], ")"}], "/", 
       RowBox[{"(", 
        RowBox[{"2.", " ", "d1", " ", "d2"}], ")"}]}], "]"}]}], "}"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"3cb3ac3d-ae3f-4959-a0a4-b8133d32edf4"],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"q1$", "::", "shdw"}], "MessageName"], 
  RowBox[{":", " "}], 
  RowBox[{"Symbol", " "}], 
  TagBox["\<\"q1$\"\>",
   HoldCompleteForm], 
  RowBox[{" ", 
   RowBox[{"appears", " ", "in", " ", "multiple", " ", "contexts", " "}]}], 
  TagBox[
   RowBox[{"{", 
