Cell["\<\
The two methods answer different questions. On the straight-line case, \
arclength gives 3 where the comparison angle gives \[Pi].\
\>", "ExampleText",ExpressionUUID->"de83cde0-c858-4a53-947f-8bbd4c2f5d33"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"c", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"far", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "c", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"line", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"First", " ", "@", " ", 
       RowBox[{"FindInfraLine", "[", 
        RowBox[{"g", ",", " ", "c", ",", " ", "far", ",", " ", "1"}], 
        "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"i", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"FirstPosition", "[", 
       RowBox[{"line", ",", " ", "c"}], "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"arms", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "-", " ", "4"}], "]"}], "]"}], ",", " ", "c", ",", 
       " ", 
       RowBox[{"line", "[", 
        RowBox[{"[", 
         RowBox[{"i", " ", "+", " ", "4"}], "]"}], "]"}]}], "}"}]}], "}"}], ",",
    "\n", "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Arclength\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", "arms"}], "]"}]}]}], ",", " ", 
     RowBox[{"\"\<Alexandrov\>\"", " ", "->", " ", 
      RowBox[{"N", " ", "@", " ", 
       RowBox[{"InfraAngle", "[", 
        RowBox[{"g", ",", " ", "arms", ",", " ", 
         RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]}], 
        "]"}]}]}]}], "|>"}]}], "]"}]], "Input",
 CellLabel->"In[3]:= ",ExpressionUUID->"e2b9d443-744e-4976-9c14-8848e03e0b33"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Arclength\"\>", "\[Rule]", "3.`"}], ",", 
   RowBox[{"\<\"Alexandrov\"\>", "\[Rule]", "3.141592653589793`"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[3]= ",ExpressionUUID->"f4ab6e5b-f7f2-498d-84cd-57755bf8376a"]
}, Open  ]]
}, Open  ]],

