Notebook[{
Cell["InfraAngle", "Title",ExpressionUUID->"8e2fea82-9b25-4e26-8cca-3d2b8051080d"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"8261958b-ac43-403f-8d89-5841ec039e01"],

Cell["\<\
InfraAngle[graph, {q1, p, q2}] returns an angle at p in radians. Option: \
Method (\"Arclength\" (default) -- delete the open ball of radius Min[d(p, \
q1), d(p, q2)] around p and return the shortest q1-q2 path length outside, \
divided by the radius (synthetic radian measure); \"Alexandrov\" -- the \
comparison-triangle angle at p in the Euclidean k = 0 model via the law of \
cosines; {\"Alexandrov\", \"Curvature\" -> k} -- the same angle in M_k^2 \
(spherical / Euclidean / hyperbolic) for arbitrary k). For the raw \
un-arccos'd scalar product use InfraScalarProduct[graph, p, q1, q2].\
\>", "Text",ExpressionUUID->"f0a30819-e7b5-41fa-ab0e-f2b6612ef7d5"],

Cell["Setup", "Section",ExpressionUUID->"41b9751b-8cdd-427a-a58e-a7499e629d13"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"7f901a6d-dfa4-4bb1-8ff1-76e5bef1e397"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"50d995d2-e95a-4333-9e66-0578dba7131f"],

Cell["Related Guides", "Section",ExpressionUUID->"ed997cc7-5e92-491c-b361-8443300c0581"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"21893c2e-4eec-4645-a411-bd8c72def3fe"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"0ca148ba-8ec9-47b3-b202-a430540d0325"]
},
