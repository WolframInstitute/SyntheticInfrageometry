     "6a27e4db-7a96-489e-a65e-d1c1e5549648"], Cell[
    "Angles are coordinatised by the reals modulo 2\[Pi].", "TableText",
     ExpressionUUID->"537df4de-6ae3-43ea-b562-ffc405e73d81"]}
  }]], "3ColumnTableMod",ExpressionUUID->"96a67d0b-a67c-4a23-b5ed-\
e398daf7a89c"]
}, Open  ]],

