Notebook[{

Cell[CellGroupData[{
Cell["InfraAngle", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"07f5c79f-f1c6-4fa5-b913-040224698596"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraAngle"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraAngle", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["q1", "TI"], ",", " ", 
      StyleBox["p", "TI"], ",", " ", 
      StyleBox["q2", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8575db44-891d-4066-9ac5-cc833fab0d31"],
 "\[LineSeparator]",
 "gives the angle at ",
 StyleBox["p", "TI"],
 " between the directions to ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 ", in radians.",
 "\n"
}], "Usage",ExpressionUUID->"307b7bce-7463-4cee-aecb-2a0528ef43c5"],

Cell[TextData[{
 "Definition, with ",
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Alexandrov\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dca32dac-5d2c-44cb-a2eb-e6edcb55d8f3"],
 ": the angle at ",
 StyleBox["p", "TI"],
 " is the angle at the corresponding corner of the Euclidean triangle with \
the same three side lengths."
}], "Notes",ExpressionUUID->"5cdaa3d1-32b2-4e1e-b356-d7df0a85d2a4"],

Cell[TextData[{
 "Writing ",
 StyleBox["d1 = d(p,q1)", "TI"],
 ", ",
 StyleBox["d2 = d(p,q2)", "TI"],
 " and ",
 StyleBox["c = d(q1,q2)", "TI"],
 ", that is"
}], "Notes",ExpressionUUID->"13ae35fa-fedf-4d35-a1b4-ee8565b86928"],

Cell[TextData[StyleBox["angle = ArcCos[(d1\.b2 + d2\.b2 \[Minus] c\.b2) / (2 \
d1 d2)]", "TI"]], "Notes",ExpressionUUID->"f10cfac6-4291-485f-8b9c-\
364530452ce1"],

Cell[TextData[{
 "This is the comparison angle, and it is a closed form in three distances. \
Nothing else about the graph enters. It always lies in ",
 StyleBox["[0, \[Pi]]", "TI"],
 "."
}], "Notes",ExpressionUUID->"0c73cff6-bc43-488d-ad2b-92ddf5ccb49f"],

Cell[TextData[{
 "Two values come out exactly right. If ",
 StyleBox["q1", "TI"],
 " and ",
 StyleBox["q2", "TI"],
 " lie on opposite arms of one geodesic through ",
 StyleBox["p", "TI"],
 ", then ",
 StyleBox["c = d1 + d2", "TI"],
 " and the angle is exactly \[Pi]. If ",
 StyleBox["q2", "TI"],
 " lies on a geodesic from ",
 StyleBox["p", "TI"],
 " to ",
 StyleBox["q1", "TI"],
 ", then ",
 StyleBox["c = |d1 \[Minus] d2|", "TI"],
 " and the angle is exactly 0."
}], "Notes",ExpressionUUID->"eacd9c0b-e6e7-4b68-8da7-61c5b738a634"],

Cell["\<\
Because only three distances enter, the comparison angle cannot separate \
configurations that share them. On a square grid the metric is \[ScriptL]\.b9 \
and the chord saturates early: two vertices on the same shell of radius 4 can \
be at distance 8 from each other without lying on a common line through the \
centre, and the angle then reads \[Pi] just as a straight line does. This is \
a property of the substrate, not an error.\
\>", "Notes",ExpressionUUID->"07ac5a7a-3d03-462c-a602-80097661bb99"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", 
   RowBox[{"{", 
    RowBox[{"\"\<Alexandrov\>\"", ",", " ", 
     RowBox[{"\"\<Curvature\>\"", " ", "->", " ", "k"}]}], "}"}]}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c70e6df1-b7b2-4200-8ab8-f0d43448333a"],
 " compares in the model plane of curvature ",
 StyleBox["k", "TI"],
 " instead of the Euclidean one."
}], "Notes",ExpressionUUID->"20017ffc-8902-4894-80c5-bb7ef2495bc0"],

Cell[TextData[{
 Cell[BoxData[
  RowBox[{"Method", " ", "->", " ", "\"\<Arclength\>\""}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3718362-8c83-4817-8447-c83c3dba993d"],
 " is the default and computes something different: it takes the arclength \
between the two directions on the boundary around ",
 StyleBox["p", "TI"],
 ", and divides by the radius. It is a synthetic radian measure, not a \
comparison angle, and the two methods do not agree. On a square grid the \
straight-line case gives 3 rather than \[Pi]. It also needs the two arms at \
equal radius to be meaningful, since the radius appears in the denominator."
}], "Notes",ExpressionUUID->"39e1e269-befd-45d6-885c-48db1861dab8"],

Cell[TextData[{
 "The identity worth knowing is with ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraScalarProduct"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraScalarProduct", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "e00b441b-c5bb-446f-a01c-a5e84500a651"],
 ": the Alexandrov angle at curvature ",
 StyleBox["k", "TI"],
 " is ",
 Cell[BoxData["ArcCos"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d06fbbe5-fe1b-46f0-8251-922611312c28"],
 " of the scalar product divided by the two lengths, for every ",
 StyleBox["k", "TI"],
 "."
}], "Notes",ExpressionUUID->"8868b8b1-8442-47ac-9b78-59df6a501419"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"1fc54dd0-a27f-4e1e-b4bb-144d65e0d651"],

