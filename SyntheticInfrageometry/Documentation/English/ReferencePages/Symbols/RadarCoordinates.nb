Notebook[{
Cell["RadarCoordinates", "Title",ExpressionUUID->"fbc3c94c-6e5d-4cd5-8aab-7fab572b0620"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"3ab62928-13a7-452d-8d38-2d2e9fb23d71"],

Cell["\<\
RadarCoordinates[graph, basis, vertex] returns the radar coordinates of \
vertex (distance vector to basis). RadarCoordinates[graph, basis] returns the \
Association for all vertices, so RadarCoordinates[graph, basis][vertex] is \
the natural operator form. Accepts InfraPoint[{...}] as the query point \
(singleton degenerates, multi-vertex returns the list of per-realisation \
vectors) and as basis entries (aggregated by option \"InfraPointAggregation\" \
-> Min (default), Mean, or Max).\
\>", "Text",ExpressionUUID->"eaa7927f-0012-492a-b885-7d23143fcdc0"],

Cell["Setup", "Section",ExpressionUUID->"b30e55dc-4d47-424c-a9f3-0f85892cac29"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"4472574f-8e60-4e0b-bc49-c0d9bf8e9fce"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"1afeb8a8-4269-44ec-ae9c-7b0a28ece566"],

Cell["Related Guides", "Section",ExpressionUUID->"15fa4288-3d7d-4a0f-9f85-d0a233f01024"],

Cell["CoordinatizationGuide", "Item",ExpressionUUID->"3e72cddf-fb97-4f66-bb4e-8980bb39635f"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"03239232-9110-4a36-8bf4-a3cfb8534a85"]
