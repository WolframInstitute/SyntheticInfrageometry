Notebook[{
Cell["InfraMeasure", "Title",ExpressionUUID->"59bbf637-a542-41ec-a904-431c40345d23"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"df0c61dd-fbd2-400a-935d-35435b03be42"],

Cell["\<\
InfraMeasure[obj] returns the vertex occupation measure <|v -> appearances|> \
of an Infra* wrapper -- the marginal of its realization bundle onto its \
vertices. InfraMeasure[graph, obj] is graph-aware and unlocks the edge \
measure. Options \"On\" (\"Vertices\" (default), \"Edges\", \"Both\") and \
Method (\"Occupation\" (default) divides by numReps, the membership measure \
in [0,1]; \"Probability\" divides by total appearances, the distribution \
summing to 1).\
\>", "Text",ExpressionUUID->"32600534-f1b6-4029-9f30-9d849d319715"],

Cell["Setup", "Section",ExpressionUUID->"7323d01e-603c-4871-8cb4-831ad9865db6"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"a3a80d9d-9791-4f50-a7bc-bc5374465c9e"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"962c8dc4-f600-4103-822c-8368ea1360b3"],

Cell["Related Guides", "Section",ExpressionUUID->"a7b6fc11-7758-4ff0-934b-d354d7218210"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"7e92a02d-0f0f-430f-8cde-b679489743df"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"5b28d11b-62b3-4805-9541-4e60a3ee3db7"]
},
