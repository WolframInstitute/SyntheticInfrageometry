Notebook[{
Cell["InfraMeasure", "Title",ExpressionUUID->"cc406704-f9d3-40a5-a047-0bc8beb2e58c"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c638b0a8-7079-4253-8e93-717a40b4deef"],

Cell["\<\
InfraMeasure[obj] returns the normalized vertex visit measure <|v -> \
visits/numReps|> of an Infra* wrapper -- the marginal of its realization \
bundle onto its vertices. InfraMeasure[graph, obj] is graph-aware and unlocks \
the edge measure. Options \"On\" (\"Vertices\" (default), \"Edges\", \
\"Both\") and \"Normalize\" (True (default) divides by numReps; False returns \
raw integer counts).\
\>", "Text",ExpressionUUID->"d255e744-8905-4c62-8ea3-0bdb7b2f53db"],

Cell["Setup", "Section",ExpressionUUID->"309365ec-9f49-4e41-992d-7784aa4560a3"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"9b65b687-0e4d-4695-9c6f-f8627f8aa38f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"270d7839-a24c-4282-851a-b7edba0f0185"],

Cell["Related Guides", "Section",ExpressionUUID->"bc041085-f6b3-4074-80f9-8c4147e23d63"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"85303859-530b-4825-9edb-28a7081d9fb8"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"e5817592-797b-407e-af2c-41f54a32a3e9"]
