Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"9670b858-ceea-41e3-859f-eb6b080e777a"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["SelectInfraPath"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/SelectInfraPath", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
