Notebook[{
Cell["SelectInfraPath", "Title",ExpressionUUID->"283cf082-a8e2-4cdc-a3b6-d1b4714e96df"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"5af424c6-6224-43a4-aaae-8c9af672da52"],

Cell["\<\
SelectInfraPath[graph, paths] returns one path drawn from the bundle treated \
as a finite metric space in path-space. SelectInfraPath[graph, paths, n] \
returns exactly n or $Failed; UpTo[n] returns up to n; All returns the whole \
pool. Options mirror FindInfraPoint: \"From\" (All (default), \"Center\", \
\"Periphery\", \"MostVisited\", anchor -> spec, InfraSegment[{...}] -> spec, \
{\"Min\", scoreFn} / {\"Max\", scoreFn} with user-supplied path-aggregated \
scoreFn[path] returning a comparable value), \"Distance\" (None (default), \
\"Max\", d, {dMin, dMax}), \"Metric\" (\"Hausdorff\" (default), \"Frechet\", \
\"MeanFrechet\"), \"MaxCliques\". Accepts InfraSegment and InfraRay wrappers; \
preserves the wrapper. Operator form SelectInfraPath[graph, n, opts][paths].\
\>", "Text",ExpressionUUID->"b0999132-6ce0-45b8-a415-c1ed00ec9559"],

Cell["Setup", "Section",ExpressionUUID->"77069021-dede-4afc-8f3f-f0ea6e86fd82"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"9f904843-0a8d-45f1-b5f8-c2a98ea3018f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"6df4210b-a16a-43d9-87ca-d8d3d6ec16f1"],

Cell["Related Guides", "Section",ExpressionUUID->"6f2f035e-79d1-4f23-a702-9c2a2e76eef7"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"e0d4023e-b320-4f14-9123-9dfa178b504e"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"5ea55059-7f27-4c1b-9c64-c698b7fe32da"]
},
