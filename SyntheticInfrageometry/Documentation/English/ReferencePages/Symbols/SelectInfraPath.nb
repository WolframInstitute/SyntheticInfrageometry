Notebook[{
Cell["SelectInfraPath", "Title",ExpressionUUID->"822662f7-fce7-4af4-85a9-c9f1e17444ef"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"ec201e4c-d4fe-49a1-878b-30e39a93c03a"],

Cell["\<\
SelectInfraPath[graph, paths] returns one path drawn from the bundle treated \
as a finite metric space in path-space. SelectInfraPath[graph, paths, n] \
returns exactly n or $Failed; UpTo[n] returns up to n; All returns the whole \
pool. Options mirror FindInfraPoint: \"From\" (All (default), \"Center\", \
\"Periphery\", \"MostVisited\", \"MinLength\", \"MaxLength\", anchor -> spec, \
InfraSegment[{...}] -> spec, {\"Min\", scoreFn} / {\"Max\", scoreFn} with \
user-supplied path-aggregated scoreFn[path] returning a comparable value), \
\"Distance\" (None (default), \"Max\", d, {dMin, dMax}), \"Metric\" \
(\"Hausdorff\" (default), \"Frechet\", \"MeanFrechet\"), \"MaxCliques\". \
Accepts InfraSegment and InfraRay wrappers; preserves the wrapper. Operator \
form SelectInfraPath[graph, n, opts][paths].\
\>", "Text",ExpressionUUID->"7ec63acc-0de5-474a-b996-145637a32036"],

Cell["Setup", "Section",ExpressionUUID->"9612a69c-1059-4bfc-9299-641fda405281"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"d54d8056-c2da-4668-ae88-1457338f5f81"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"2df04763-d44a-414b-8d06-37d6e362de08"],

Cell["Related Guides", "Section",ExpressionUUID->"c88483b9-ba5b-4131-ac8f-137fc9da05ac"],

Cell["PathSpaceGuide", "Item",ExpressionUUID->"951374c9-2516-4a61-88f2-41f7f141b052"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"925356fe-8532-4092-8ec1-efd826159a6a"]
},
FrontEndVersion->"15.0 for Mac OS X ARM (64-bit) (May 19, 2026)",
