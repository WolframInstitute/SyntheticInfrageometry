    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["graph", "TI"], ",", " ", 
    StyleBox["paths", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4d448925-c899-45f6-80d2-47e1343ccfa9"],
 "\[LineSeparator]",
 "returns exactly n or $Failed; UpTo[n] returns up to n; All returns the \
whole pool."
}], "Usage",ExpressionUUID->"e8f68364-deb1-43ea-8865-471678dac767"],

