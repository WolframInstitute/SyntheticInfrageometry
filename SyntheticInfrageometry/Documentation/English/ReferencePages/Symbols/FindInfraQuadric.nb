Notebook[{
Cell["FindInfraQuadric", "Title",ExpressionUUID->"1bfc1f94-a7b9-4daa-9e8d-d14a376106ef"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"283535a9-d940-42e0-b94d-bbd7581c650e"],

Cell["\<\
FindInfraQuadric[graph, {p1, ..., pk}, c] returns InfraObject[{ v : sum_i \
d(p_i, v) <= c }], the solid ellipsoid interior with foci p_i. \
FindInfraQuadric[graph, foci, {cMin, cMax}] returns the band { v : cMin <= \
sum_i d(p_i, v) <= cMax }. FindInfraQuadric[graph, foci, c, weights] uses the \
weighted signed-distance sum sum_i w_i d(p_i, v); weights {1, -1} give a \
hyperboloid (one branch via scalar c, two-sided via symmetric band {-c, c}). \
Foci accept bare vertices or InfraPoint wrappers (multi-realisation reduced \
to first).\
\>", "Text",ExpressionUUID->"253f4326-a1fd-4ccc-ad79-3a9136c485ab"],

Cell["Setup", "Section",ExpressionUUID->"427c65d5-3001-48c5-9485-2040e2ceb5a0"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"8b85fae9-cb51-43bc-9375-585fa11ebc24"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"7de515ad-4f09-42c8-b2d5-873a7ec6b301"],

Cell["Related Guides", "Section",ExpressionUUID->"7ff975ac-6583-45d4-b8d9-ff112ccdeebc"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"310f2179-c04f-4228-93a7-f26d19bd33bd"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"43788051-8c87-43bf-9502-920ef96654a0"]
