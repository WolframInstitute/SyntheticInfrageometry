Notebook[{
Cell["InfraPolylineQ", "Title",ExpressionUUID->"6adf03f6-9ed9-44c5-adcf-4b9fee297d48"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"b5fc4618-8188-41b8-a70e-59a71e41babd"],

Cell["\<\
InfraPolylineQ[graph, poly] tests whether poly = {seg1, ..., segk} of unary \
InfraSegment wrappers is a valid polyline in graph: every leg is a geodesic \
and consecutive legs share an endpoint. Accepts the wrapped form \
InfraPolyline[{...}] as well (AllTrue over realisations).\
\>", "Text",ExpressionUUID->"fb0fa4bc-748e-43ce-8add-9e798cf5a369"],

Cell["Setup", "Section",ExpressionUUID->"a28d7cf8-147d-42fd-83e1-c833cdfdacc3"],

