Notebook[{
Cell["InfraPolygon", "Title",ExpressionUUID->"51f2b8d4-5992-4fbc-b46e-78a970770e80"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"05ef0c25-d958-4961-80a8-6644ad1186c8"],

Cell["\<\
InfraPolygon[{poly}] is the unary form, where poly = {seg1, ..., segn} is a \
closed chain of unary InfraSegment sides; InfraPolygon[{poly1, ..., polyk}] \
is the multi-realisation form. Find* returns a List of unary wrappers; wrap \
with InfraPolygon @ ... to collapse to multi via auto-flatten. Accessors \
[\"Sides\"] (the InfraSegment legs per realisation), [\"Length\"] (perimeter \
edge count per realisation), [\"Vertices\"] (corner vertices as unary \
InfraPoints).\
\>", "Text",ExpressionUUID->"221773e3-fa83-4bef-94ee-749eb9da85a5"],

Cell["Setup", "Section",ExpressionUUID->"2d772246-3459-429d-a14b-032d8eb4e54b"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"8eebbcc2-9fbd-4f83-ab37-f66efa56ca4f"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"908d89ed-1500-4bf5-b7cf-67445b042c5c"],

Cell["Related Guides", "Section",ExpressionUUID->"4980f45f-216d-4560-8b69-56cbd7eb0794"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"4615e7d8-7f63-489d-8b8a-f20780c65d43"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"a6525f00-4ae0-4ae4-8cc8-6e3c7344f4bc"]
},
