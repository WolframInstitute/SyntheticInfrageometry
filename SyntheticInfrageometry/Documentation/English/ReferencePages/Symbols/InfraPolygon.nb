Notebook[{
Cell["InfraPolygon", "Title",ExpressionUUID->"512e4c73-4c6e-4ea8-b2e3-a6360f0c49ef"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"bc15455c-3392-4135-86af-7cce99844147"],

Cell["\<\
InfraPolygon[{poly}] is the unary form, where poly = {seg1, ..., segn} is a \
closed chain of unary InfraSegment sides; InfraPolygon[{poly1, ..., polyk}] \
is the multi-realisation form. Find* returns a List of unary wrappers; wrap \
with InfraPolygon @ ... to collapse to multi via auto-flatten. Accessors \
[\"Sides\"] (the InfraSegment legs per realisation), [\"Length\"] (perimeter \
edge count per realisation), [\"Vertices\"] (corner vertices as unary \
InfraPoints).\
\>", "Text",ExpressionUUID->"93a08dd5-72af-49e6-884b-ea01a212336d"],

Cell["Setup", "Section",ExpressionUUID->"858b9d3c-b734-408e-8b8f-8f7793770259"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"177efc48-3bbc-4c8e-bd4f-5d41929273ce"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"147226d5-e7b9-4aa5-98a5-df043de99d3f"],

Cell["Related Guides", "Section",ExpressionUUID->"21317e18-3e78-44a9-b49b-415f8fcc23be"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"8e32d3cf-cb46-49a0-97b0-31924b929255"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"5bc6eeb3-b97e-4f04-96bc-ffe1c8af32e3"]
},
