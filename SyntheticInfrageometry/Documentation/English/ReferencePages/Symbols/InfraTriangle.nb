Notebook[{
Cell["InfraTriangle", "Title",ExpressionUUID->"1b5c45ec-3b86-4391-9bd9-6f009d917f64"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"a278d814-ed38-4a2f-83e5-3260eefb6305"],

Cell["\<\
InfraTriangle[{poly}] is the unary form, where poly = {seg1, seg2, seg3} is a \
closed chain of three unary InfraSegment sides; InfraTriangle[{poly1, ...}] \
is the multi-realisation form. Find* returns a List of unary wrappers; wrap \
with InfraTriangle @ ... to collapse to multi via auto-flatten. Accessors \
[\"Sides\"], [\"Length\"], [\"Vertices\"] as for InfraPolygon.\
\>", "Text",ExpressionUUID->"b5212076-2c59-4bcd-94d7-5d10551c4fc6"],

Cell["Setup", "Section",ExpressionUUID->"7f1d427d-f8be-4583-8164-1b99ab287780"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"cf0e9bbf-7a85-44ad-927e-bad1db25ca30"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"8a4bdc60-ce2a-44e7-8572-c54e5ff23a74"],

Cell["Related Guides", "Section",ExpressionUUID->"06b21dc8-d64f-40f2-92d3-20e1d75b67c0"],

