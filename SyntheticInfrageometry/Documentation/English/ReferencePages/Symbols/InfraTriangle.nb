Notebook[{
Cell["InfraTriangle", "Title",ExpressionUUID->"198c9310-dd70-46c9-9257-331e4e86565c"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"888f8e91-8189-4c12-8fb0-7af963d713eb"],

Cell["\<\
InfraTriangle[{poly}] is the unary form, where poly = {seg1, seg2, seg3} is a \
closed chain of three unary InfraSegment sides; InfraTriangle[{poly1, ...}] \
is the multi-realisation form. Find* returns a List of unary wrappers; wrap \
with InfraTriangle @ ... to collapse to multi via auto-flatten. Accessors \
[\"Sides\"], [\"Length\"], [\"Vertices\"] as for InfraPolygon.\
\>", "Text",ExpressionUUID->"4f81af9a-869b-46e9-99ba-40ed80978983"],

Cell["Setup", "Section",ExpressionUUID->"ef239a51-8a92-4838-b96a-0dba87fb79cc"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"0f8e5d9e-2b6c-4c07-bf34-2a9888c086ce"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"82414262-a2fa-4842-aaac-37751407b690"],

