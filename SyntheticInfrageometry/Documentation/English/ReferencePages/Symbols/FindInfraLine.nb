  FontSize->0.9 Inherited,ExpressionUUID->
  "80056ddc-4fd2-42c7-b21a-7d73ccdc0859"],
 "; only the order in which lines come off the pool differs."
}], "ExampleText",ExpressionUUID->"69db5dad-ad56-4ede-8b42-12b96b106216"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"GridGraph", "[", 
      RowBox[{"{", 
       RowBox[{"4", ",", " ", "4"}], "}"}], "]"}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"SameQ", " ", "@@", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Sort", " ", "@", " ", 
        RowBox[{
         RowBox[{"FindInfraLine", "[", 
          RowBox[{
          "g", ",", " ", "6", ",", " ", "7", ",", " ", "All", ",", " ", 
           RowBox[{"Method", " ", "->", " ", "#"}]}], "]"}], 
         "[", "\"\<Realizations\>\"", "]"}]}], " ", "&"}], " ", "/@", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", "\"\<Greedy\>\"", ",", 
        " ", "\"\<RandomGreedy\>\""}], "}"}]}], ")"}]}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"8590c4e1-dc2f-4403-88d1-6e348d1b75a1"],

Cell[BoxData["True"], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b896d2ee-56a8-4ce7-b3d4-da4c9a320a44"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

