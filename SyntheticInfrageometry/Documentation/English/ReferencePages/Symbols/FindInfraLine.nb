Notebook[{
Cell["FindInfraLine", "Title",ExpressionUUID->"721e9eac-aae4-4a25-8c15-3cb1c5ee071f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"d40196ca-232e-4120-a07c-0eace4775870"],

Cell["\<\
FindInfraLine[graph, p1, p2] returns {InfraLine[{line}]} for one maximal \
geodesic line through p1 and p2. FindInfraLine[graph, segment] returns \
maximal geodesic lines containing segment as a contiguous sub-sequence. \
FindInfraLine[graph, ..., n] / UpTo[n] / All controls multiplicity. Options: \
Properties ({} only at present; raises ::badproperty otherwise), Method \
(\"Exhaustive\" (default; joint-maximal enumeration via findLineExtensions), \
{\"Exhaustive\", \"Pruning\" -> spec}, \"Greedy\" (DFS one realisation, walks \
outward from each endpoint until inextensible)), \"Maximality\" \
(\"Extension\" (default) | \"Diameter\"), \"Direction\" (\"BothSides\" \
(default; extend the middle on both sides), \"Forward\" (extend only past the \
right end, First[segment]/p1 fixed as line start), \"Backward\" (extend only \
past the left end, Last[segment]/p2 fixed as line end)).\
\>", "Text",ExpressionUUID->"9c4e03ff-04eb-47f1-8a85-57be5db0a4c4"],

Cell["Setup", "Section",ExpressionUUID->"ff6362c1-4a82-4045-b51f-c2749565d367"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"6a0c061d-563d-4237-bbdf-71571f65f777"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"bdae2f0e-c15f-4c4d-8c6c-0a611e41f634"],

Cell["Related Guides", "Section",ExpressionUUID->"c4726523-d476-498b-b039-d89e4d8c1103"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"21c4292b-6fed-4298-978a-594b3bc31593"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"6a98cf27-57ff-4f93-ae16-d3116bfadc40"]
},
