   RowBox[{"{", 
    RowBox[{"6", ",", "1", ",", "2", ",", "3"}], "}"}]}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"3f2b1b3a-ffcf-4bd5-ac1e-49a99276b412"]
}, Open  ]],

