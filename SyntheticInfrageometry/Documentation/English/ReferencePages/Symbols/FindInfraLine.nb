Cell["\<\
How many maximal geodesics pass through two vertices at distance 5. \
Uniqueness does not merely fail \[LongDash] on the square grid the family is \
enormous.\
\>", "ExampleText",ExpressionUUID->"1cfe16b7-0cfa-49ca-b2dd-9d26fc1b1e21"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"ExampleGraphData", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], ",", 
       "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Length", " ", "@", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"FindInfraLine", "[", 
          RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], 
          "]"}]}]}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<Plane\>\"", ",", " ", "\"\<Square\>\"", ",", 
        " ", "\"\<Hexagonal\>\""}], "}"}]}], "}"}]}], "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"f5a633bb-315d-4d52-95b3-12305dd1b6bd"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"Plane\"\>", "\[Rule]", "16"}], ",", 
   RowBox[{"\<\"Square\"\>", "\[Rule]", "81600"}], ",", 
   RowBox[{"\<\"Hexagonal\"\>", "\[Rule]", "192"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"b249433b-33d1-4de4-88e2-f89f7cb9f296"]
}, Open  ]],

Cell["\<\
Three of them on each substrate. Each line runs clear across the patch, since \
a geodesic stops only where it can no longer be extended.\
\>", "ExampleText",ExpressionUUID->"3c3ee165-8023-4c8a-9aee-4e83fb525c81"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Row", "[", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"With", "[", "\n", "     ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{"Graph", "[", 
         RowBox[{
          RowBox[{"ExampleGraphData", "[", 
           RowBox[{"name", ",", " ", "\"\<Medium\>\""}], "]"}], ",", " ", 
          RowBox[{"Sequence", " ", "@@", " ", 
           RowBox[{"AmbientGraphStyle", "[", "\"\<Gray\>\"", "]"}]}]}], 
         "]"}]}], "}"}], ",", "\n", "     ", 
      RowBox[{"{", 
       RowBox[{"a", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"{", 
       RowBox[{"b", " ", "=", " ", 
        RowBox[{"First", " ", "@", " ", 
         RowBox[{"Sort", " ", "@", " ", 
          RowBox[{"Select", "[", 
           RowBox[{
            RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"GraphDistance", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
              " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
      "     ", 
      RowBox[{"Labeled", "[", "\n", "       ", 
       RowBox[{
        RowBox[{"InfraSceneHighlight", "[", 
         RowBox[{"g", ",", "\n", "         ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"FindInfraLine", "[", 
              RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
               RowBox[{"UpTo", "[", "3", "]"}]}], "]"}], " ", "->", " ", 
             "$InfraLineColor"}], ",", "\n", "          ", 
            RowBox[{
             RowBox[{"InfraPoint", "[", 
              RowBox[{"{", 
               RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
             "$InfraPointColor"}]}], "}"}], ",", "\n", "         ", 
          RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", "\n",
           "         ", 
          RowBox[{"VertexShapeFunction", " ", "->", " ", 
