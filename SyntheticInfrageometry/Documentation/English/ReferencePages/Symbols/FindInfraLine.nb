    "Method"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "79b4ffe6-45c7-4eb0-acee-8090f419c36c"]], "TableText",ExpressionUUID->
     "9717daa9-1206-4650-a061-1e74f6b1f261"], Cell[TextData[{
