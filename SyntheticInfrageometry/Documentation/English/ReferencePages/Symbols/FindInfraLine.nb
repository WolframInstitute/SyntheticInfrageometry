Notebook[{

Cell[CellGroupData[{
Cell["FindInfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"b9625ad7-2a5e-4828-990d-68b4f80fc51c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e15525a9-6d46-4312-858b-343daab3c58d"],
 "\[LineSeparator]",
 "gives one line through ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " in ",
 StyleBox["g", "TI"],
 " \[LongDash] an inextensible geodesic containing both \[LongDash] as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "65164a2e-020e-420a-8eda-51ead3ca9ac4"],
 " wrapper.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"b9ec21ee-c008-4c1b-abb1-7ed68927ae09"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["segment", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3c893654-5d87-4dbf-985c-c432621afb86"],
 "\[LineSeparator]",
 "gives one line containing ",
 StyleBox["segment", "TI"],
 " as a contiguous subsequence; ",
 StyleBox["segment", "TI"],
 " is a vertex sequence or an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraSegment"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraSegment", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "bfdb8e4c-9da5-40f4-b10a-21acc426b246"],
 " bundle, which extends as a whole.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"4059e617-447f-4b94-a86d-2f84ef845e31"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"], ",", " ", 
    StyleBox["n", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3de398b5-29ae-4cea-8e00-45b8557a0fb8"],
 "\[LineSeparator]",
 "gives exactly ",
 StyleBox["n", "TI"],
 " lines or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "36cebb41-cab6-4da4-9cad-3cbf72b4d6b3"],
 "; ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1f22510b-2269-4e47-929b-fe41057b93e8"],
 " gives up to ",
 StyleBox["n", "TI"],
 "; ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71a7f3f2-1d79-4c42-b53e-ff097caa4da2"],
 " gives the whole class as a pool."
}], "Usage",ExpressionUUID->"06568b11-ac76-42ff-b2c0-8080370a8b37"],

Cell[TextData[{
 "A line is an ",
 StyleBox["inextensible geodesic",
  FontWeight->"Bold"],
 ": a shortest path that no neighbour of either endpoint prolongs. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLineQ"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLineQ", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "4300bdc6-5dab-4ebc-97e7-97abc3f715fb"],
 " is the predicate, and every line returned satisfies it under every ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b02618a-6dbe-44e6-aa95-c152b33e0aeb"],
 "."
}], "Notes",ExpressionUUID->"9ab63d62-1ef7-43d1-954a-6191dbf57192"],

Cell["\<\
That is the intrinsic reading of Euclid's second postulate \[LongDash] \
produce a finite straight line continuously \[LongDash] and it is where the \
analogy with the plane breaks hardest. In the plane two points determine one \
line. On a lattice they determine an enormous family: below, two vertices at \
distance 5 on a 313-vertex square-tiling patch lie on 5 242 880 lines, \
against 6144 on the hexagonal tiling and 1386 on the irregular mesh.\
\>", "Notes",ExpressionUUID->"50b56c47-31a6-42b1-b443-d84c7d003056"],

Cell[TextData[{
 "Everything is read off the distance matrix. Write ",
 StyleBox["d", "TI"],
 " for ",
 StyleBox["d(a, b)", "TI"],
 ". A pair of ends (",
 StyleBox["s", "TI"],
 ", ",
 StyleBox["e", "TI"],
 ") is ",
 StyleBox["admissible",
  FontWeight->"Bold"],
 " when ",
 StyleBox["d(s, e) = d(s, a) + d + d(b, e)", "TI"],
 " \[LongDash] the concatenation of any geodesics ",
 StyleBox["s\[Ellipsis]a", "TI"],
 ", ",
 StyleBox["a\[Ellipsis]b", "TI"],
 ", ",
 StyleBox["b\[Ellipsis]e", "TI"],
 " is then a geodesic, whichever geodesics are used \[LongDash] and no \
neighbour of ",
 StyleBox["s", "TI"],
 " or ",
 StyleBox["e", "TI"],
 " prolongs ",
 StyleBox["d(s, e)", "TI"],
 ". The candidate ends are the vertices of the two extension graphs ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["b", "TI"], ",", " ", 
      StyleBox["a", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dc9c6c79-7c45-4955-ab23-69565fca0994"],
 " and ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["GeodesicExtensionGraph"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/\
GeodesicExtensionGraph", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["a", "TI"], ",", " ", 
      StyleBox["b", "TI"]}], "}"}]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4a960d3f-c4bc-433b-b626-b10c1f73063f"],
 ". Admissibility on each side alone is not enough: on the 6-cycle through \
the edge 1\[Dash]2 the ends 5 and 4 are each admissible, but ",
 StyleBox["d(5, 4) = 1", "TI"],
 ", so the pool is two DAGs ",
 StyleBox["plus", "TI"],
 " a compatibility relation, and there are three lines through that edge, not \
four."
}], "Notes",ExpressionUUID->"ec9540f6-edb8-4bd8-93a9-7bc01e929379"],

Cell[TextData[{
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "60149c07-4f07-4a44-8708-a4419178f4da"],
 " returns the ",
 StyleBox["pool",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["dag1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f56c96-afe5-4bd1-ae4e-0e40b52a738a"],
 ", one geodesic DAG per admissible pair of ends, whose source-to-sink paths \
are exactly the lines with those ends. ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Multiplicity\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "43e531a0-8059-41bd-9f2e-ee50b46c480d"],
 ", ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Length\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "051667b6-b392-4d4a-873d-2d3d77a47e8e"],
 " (one number per DAG) and ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Measure\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0df6225a-8f20-4f95-add3-1043092e27de"],
 " are read off the DAGs by dynamic programming, without enumeration; ",
 Cell[BoxData[
  RowBox[{"[", "\"\<Realizations\>\"", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "20798c82-263f-4240-a825-f800aadc3f2f"],
 " enumerates on demand. A bounded count streams lines off the admissible \
pairs."
}], "Notes",ExpressionUUID->"8470b96b-26dc-4d90-98cc-5c504a7243c6"],

Cell[TextData[{
 "Because admissibility reads only the ends, a whole geodesic bundle extends \
as one object: ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "90cea96c-96a9-4d0c-a1a7-df2b62f96eae"],
 " is ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["ExtendInfraSegment"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/ExtendInfraSegment", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["seg", "TI"], ",", " ", 
    ButtonBox["Infinity",
     BaseStyle->"Link"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "30662c31-a6ca-4bf9-8a0a-e20ab298e5c6"],
 ", the extension pool with no budget."
}], "Notes",ExpressionUUID->"fbcce1de-b548-4a47-a57d-a9ae1bd03dfb"],

Cell[TextData[{
 "The longest lines are a selection on the result, ",
 Cell[BoxData[
  RowBox[{"SelectInfraWalk", "[", 
   RowBox[{"g", ",", " ", "lines", ",", " ", "All", ",", " ", 
    RowBox[{"\"\<From\>\"", " ", "->", " ", "\"\<MaxLength\>\""}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ee0060db-16ca-4b89-b92d-7a03fca0635c"],
 ", which reads the lengths off the pool and keeps the pool form."
}], "Notes",ExpressionUUID->"38e0f33a-3efd-4b8b-8844-fbd552b2a295"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "763cbd1f-b77d-4a9c-a7cd-ebd745506b0d"], Cell["Option", "TableText",
