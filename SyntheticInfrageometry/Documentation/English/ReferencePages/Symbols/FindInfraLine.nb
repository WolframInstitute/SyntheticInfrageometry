Cell["\<\
How many lines pass through two vertices at distance 5. Uniqueness does not \
merely fail \[LongDash] on the square tiling the family is enormous, and the \
pool counts it without enumerating a single line.\
\>", "ExampleText",ExpressionUUID->"f6b223ac-4ae5-4eaf-abe7-b112998c446c"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Association", " ", "@", " ", 
  RowBox[{"Table", "[", "\n", "   ", 
   RowBox[{
    RowBox[{"name", " ", "->", " ", 
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{"name", ",", " ", "\"\<Medium\>\"", ",", " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{
        RowBox[{"FindInfraLine", "[", 
         RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", "All"}], "]"}], 
        "[", "\"\<Multiplicity\>\"", "]"}]}], "]"}]}], ",", "\n", "   ", 
    RowBox[{"{", 
     RowBox[{"name", ",", " ", 
      RowBox[{"{", 
       RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
        " ", "\"\<SquareTilingGraph\>\"", ",", 
        " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], 
   "]"}]}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"dae268a7-6190-42e3-b063-635acf9a6a13"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"SquareMeshGraph\"\>", "\[Rule]", "1386"}], ",", 
   RowBox[{"\<\"SquareTilingGraph\"\>", "\[Rule]", "5242880"}], ",", 
   RowBox[{"\<\"HexagonalTilingGraph\"\>", "\[Rule]", "6144"}]}], 
  "\[RightAssociation]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"86ad4d96-0bc8-427b-b088-5d21c6e67ddd"]
}, Open  ]],

Cell[TextData[{
 "Three of them on each substrate, drawn off the pool in random order: ",
 Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1fb5ddd0-6013-4f94-92e4-abc9595bb132"],
 " is the explicit random call, and the seed goes in front of it."
}], "ExampleText",ExpressionUUID->"d19595ba-97bd-4617-a56d-aac719dd5c11"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SeedRandom", "[", "1", "]"}], ";", " ", 
  RowBox[{"Row", "[", 
   RowBox[{"Table", "[", "\n", "   ", 
    RowBox[{
     RowBox[{"With", "[", "\n", "     ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"g", " ", "=", " ", 
         RowBox[{"InfraSubstrate", "[", 
          RowBox[{
          "name", ",", " ", "\"\<Medium\>\"", ",", " ", "\"\<Gray\>\"", ",", 
           " ", 
           RowBox[{"\"\<KeepCoordinates\>\"", " ", "->", " ", "True"}]}], 
          "]"}]}], "}"}], ",", "\n", "     ", 
       RowBox[{"{", 
        RowBox[{"a", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"{", 
        RowBox[{"b", " ", "=", " ", 
         RowBox[{"First", " ", "@", " ", 
          RowBox[{"Sort", " ", "@", " ", 
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
             RowBox[{
              RowBox[{
               RowBox[{"GraphDistance", "[", 
                RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==",
                " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", 
       "     ", 
       RowBox[{"Labeled", "[", "\n", "       ", 
        RowBox[{
         RowBox[{"InfraSceneHighlight", "[", 
          RowBox[{"g", ",", "\n", "         ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"FindInfraLine", "[", 
               RowBox[{"g", ",", " ", "a", ",", " ", "b", ",", " ", 
                RowBox[{"UpTo", "[", "3", "]"}], ",", " ", 
                RowBox[{"Method", " ", "->", " ", "\"\<RandomGreedy\>\""}]}], 
               "]"}], " ", "->", " ", "$InfraLineColor"}], ",", "\n", 
             "          ", 
             RowBox[{
              RowBox[{"InfraSet", "[", 
               RowBox[{"{", 
                RowBox[{"a", ",", " ", "b"}], "}"}], "]"}], " ", "->", " ", 
              "$InfraPointColor"}]}], "}"}], ",", "\n", "         ", 
           RowBox[{"\"\<PointSizeRange\>\"", " ", "->", " ", "15"}], ",", 
           "\n", "         ", 
           RowBox[{"VertexShapeFunction", " ", "->", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"AbsolutePointSize", "[", "2.2", "]"}], ",", " ", 
                RowBox[{"Point", "[", "#", "]"}]}], "}"}], " ", "&"}], 
             ")"}]}], ",", "\n", "         ", 
           RowBox[{"ImageSize", " ", "->", " ", "250"}]}], "]"}], ",", "\n", 
         "       ", 
         RowBox[{"Text", "[", "name", "]"}]}], "]"}]}], "]"}], ",", "\n", 
     "   ", 
     RowBox[{"{", 
      RowBox[{"name", ",", " ", 
       RowBox[{"{", 
        RowBox[{"\"\<SquareMeshGraph\>\"", ",", 
         " ", "\"\<SquareTilingGraph\>\"", ",", 
         " ", "\"\<HexagonalTilingGraph\>\""}], "}"}]}], "}"}]}], "]"}], 
   "]"}]}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"97855bfa-ded2-4141-887b-a35deb2c2558"],

