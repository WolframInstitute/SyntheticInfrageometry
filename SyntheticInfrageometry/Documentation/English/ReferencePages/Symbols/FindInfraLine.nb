Cell[CellGroupData[{
Cell["FindInfraLine", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"749a5969-9bc9-4faa-9af8-912ab5e5c5f1"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["a", "TI"], ",", " ", 
    StyleBox["b", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d811cd2e-9838-48fa-a527-a1f763fce70c"],
 "\[LineSeparator]",
 "gives the maximal geodesic lines through ",
 StyleBox["a", "TI"],
 " and ",
 StyleBox["b", "TI"],
 " in ",
 StyleBox["g", "TI"],
 ", as an ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraLine"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraLine", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "efc42a03-a0a1-4e71-9b1f-c56a4f0e7c92"],
 " wrapper.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"aa138fcc-03cc-4ffd-97c8-615d1821dcce"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["segment", "TI"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9cb37b50-687f-46d7-9131-c63e12c1ae54"],
 "\[LineSeparator]",
 "gives the maximal lines containing ",
 StyleBox["segment", "TI"],
 " as a contiguous subsequence.",
 "\n",
 "A count ",
 StyleBox["n", "TI"],
 " gives exactly ",
 StyleBox["n", "TI"],
 " realisations or ",
 Cell[BoxData["$Failed"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "addfee8a-867e-4b86-ac29-dfd5a71e76e1"],
 ", ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4207d8af-24ba-40af-9136-62a6c854dbef"],
 " up to ",
 StyleBox["n", "TI"],
 ", ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "27905a8b-e51a-4868-922c-e12bad4bbbba"],
 " (the default) all of them."
}], "Usage",ExpressionUUID->"be4d0849-ec6b-4f13-a712-504def567a90"],

Cell[TextData[{
 "A line is an ",
 StyleBox["inclusion-maximal geodesic",
  FontWeight->"Bold"],
 ": a shortest path that cannot be extended at either end and still be a \
shortest path."
}], "Notes",ExpressionUUID->"73e04591-f054-4b50-91d8-9276a66e4d9d"],

Cell[TextData[{
 "That is the intrinsic reading of Euclid's second postulate \[LongDash] \
produce a finite straight line continuously \[LongDash] and it is where the \
analogy with the plane breaks hardest. In the plane two points determine one \
line. On a lattice they determine an enormous family: below, two vertices at \
distance 5 on a 177-vertex square grid lie on ",
 StyleBox["81600",
  FontWeight->"Bold"],
 " maximal geodesics, against 192 on the hexagonal tiling and 16 on the \
irregular mesh."
}], "Notes",ExpressionUUID->"2a1d55d2-0904-4854-8721-f4a8f5f4df49"],

Cell[TextData[{
 "So ",
 Cell[BoxData["All"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7ca9167b-2a85-4b47-9d18-ddb54ec49d03"],
 " is combinatorially dangerous on a lattice, and ",
 Cell[BoxData[
  RowBox[{"UpTo", "[", "n", "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "731c8dbf-4389-46b7-8a81-a96150810c96"],
 " is the honest default for a picture. The count itself is the interesting \
invariant \[LongDash] see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["LineCount"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/LineCount", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "5a2ca659-ab53-4828-b645-9ab2d63751c7"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["PencilCardinality"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/PencilCardinality", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "44f79007-1c6f-4592-be01-181934b82247"],
 " for the summaries built on it."
}], "Notes",ExpressionUUID->"2109e708-00a2-4307-9716-30a5d37bcb1d"],

Cell[TextData[{
 "Option ",
 Cell[BoxData["\"\<Maximality\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "93d491eb-ef4a-4bab-8670-daff4ddc1a7f"],
 " takes ",
 Cell[BoxData["\"\<Extension\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "befef8bb-b48f-460d-84d9-901b15818a52"],
 " (default; inextensible) or ",
 Cell[BoxData["\"\<Diameter\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a310fada-c871-455a-850c-70adc2dac34d"],
 ". Option ",
 Cell[BoxData["\"\<Direction\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "02439821-47b4-4c61-aea4-827897e5f333"],
 " takes ",
 Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5472b5b5-7204-42d8-a052-91616041e3b3"],
 " (default), ",
 Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "376b96bb-bb73-41cb-bc50-120f3eece873"],
 " or ",
 Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c0e29ce8-0b95-4b81-aa0f-e5f5112baf19"],
 ". Option ",
 Cell[BoxData["Method"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "081442dd-1e01-4a14-8d12-bf219638c9c6"],
 " takes ",
 Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3fa0bbd-5b3e-435f-9a4f-7afe65e92999"],
 " (default) or ",
 Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c9e0a115-7b19-4a51-a893-0f9a7a93d21b"],
 ", which returns one realisation without backtracking."
}], "Notes",ExpressionUUID->"389ec7b6-6914-4bc5-af96-6c438ffebf58"],

Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"36c0676a-60ae-4e05-adaa-39e78e332f99"],

