Cell["Corresponding notions in the classical axiom systems:", "Notes",ExpressionUUID->"1c379a0a-832f-4e90-95f1-a9a62f67cad0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e4f325bb-defa-4679-a092-5ed013f2f0cd"], Cell["System", "TableText",
     FontWeight->Bold,ExpressionUUID->"91f6cdf2-dc7f-4414-8631-51e91cb32285"],
     Cell["Name", "TableText",
     FontWeight->Bold,ExpressionUUID->"5eec43c4-ed6f-4ab2-8863-4a7802429e84"],
     Cell["Statement", "TableText",
     FontWeight->Bold,ExpressionUUID->"1d37019c-2cff-4216-86b4-6a2c77233e8d"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "bb1c4ac1-29d7-4c77-8281-e39685bb7927"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "eda0717f-d6bc-40f0-93c8-0f4a7a182edf"], Cell[
    "Postulate 2", "TableText",ExpressionUUID->
     "2fc63d71-da55-4a28-a91a-e6a728c78608"], Cell["\<\
To produce a finite straight-line continuously in a straight-line.\
\>", "TableText",ExpressionUUID->"723ea192-7bd7-4f85-b7c5-11c627eef1da"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "323e681c-4437-498a-9d7f-76e22422db49"], Cell[
    "Euclid", "TableText",ExpressionUUID->
     "b0981060-3776-4d8f-8b04-8bb132c9096f"], Cell[
    "Postulate 5", "TableText",ExpressionUUID->
     "7dbc7cac-e99d-447d-899a-46bba4c14a6a"], Cell["\<\
The parallel postulate, which quantifies over lines and so is a statement \
about this family.\
\>", "TableText",ExpressionUUID->"451cd9c9-bde8-4a30-94f6-d340b163e979"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "88273384-faaa-4af2-8ef8-6afc4447e21a"], Cell[
    "Hilbert", "TableText",ExpressionUUID->
     "6e36fb4f-bfa5-4539-bb01-c8a5640117bd"], Cell[
    "I.1, I.2", "TableText",ExpressionUUID->
     "63c8a7a1-97c5-429f-992b-f7ec1e240eea"], Cell[
    "Two distinct points determine one and only one line.", "TableText",
     ExpressionUUID->"1e465d01-8607-470b-a5ff-105d94783493"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "abfa9742-4cce-4180-ab73-165754952859"], Cell[
    "Tarski", "TableText",ExpressionUUID->
     "811cf4a1-d72f-47d3-9f9d-9f283a84284f"], Cell[
    "(derived)", "TableText",ExpressionUUID->
