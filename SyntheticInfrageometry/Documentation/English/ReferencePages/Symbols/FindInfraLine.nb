      "98815f2b-cf40-4e43-9c37-cd29a2b075b8"],
     " (default), ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "62e822c3-3fe5-4ea4-ad7b-6c618bb9b9fb"],
     ", ",
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{"\"\<Exhaustive\>\"", ",", " ", 
        RowBox[{"\"\<Pruning\>\"", " ", "->", " ", "spec"}]}], "}"}]], 
      "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "a21de83f-0a77-4d67-82d1-ea1e33ad1904"],
     ", ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "07f6db09-87e1-4dda-957d-dd24c98919ee"],
     ", ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "92493b3c-209a-48df-a4d4-51dba556d25e"]
    }], "TableText",ExpressionUUID->"65f37129-5d9d-4127-84ac-65607bcb9312"], 
    Cell[TextData[{
     Cell[BoxData["Automatic"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1ebf2841-540d-4ce5-916e-1d175f135588"],
     " resolves by the count: ",
     Cell[BoxData["All"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ed105b25-0a69-4ca4-9638-f21cf8f145cc"],
     " to ",
     Cell[BoxData["\"\<Exhaustive\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "f941624b-827d-444e-ba22-f8899dc5de39"],
     ", the pool; a bounded or absent count to ",
     Cell[BoxData["\"\<Greedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2a6565b5-f349-451d-9a69-37cefed32ad8"],
     ", which takes the admissible pairs and the branches of each DAG in \
candidate order, so the count-less call is deterministic. ",
     Cell[BoxData["\"\<RandomGreedy\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b0273fcf-51b5-4cfb-8a8c-b54c3a977de4"],
     " takes them in random order, seeded by an ambient ",
     Cell[BoxData["SeedRandom"], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7dd135e5-fab2-4977-8fc3-4196ea045337"],
     ". The class is the same under every value; ",
     Cell[BoxData["\"\<Pruning\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "7cbd34ce-51ca-44f4-9146-aa5c7a188c69"],
     " is accepted and inert, the pool having no frontier to cap."
    }], "TableText",ExpressionUUID->"5b7e5212-7506-49a5-99d0-ca4360afdf15"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "2facb8fd-88b9-4017-af84-057218a69d3a"], Cell[TextData[Cell[
    BoxData["\"\<Direction\>\""], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "87baf644-d1b1-4b83-a7d2-c5be824f05de"]], "TableText",ExpressionUUID->
     "8fb6fed8-5106-4c08-9e36-46b0c9261df5"], Cell[TextData[{
     Cell[BoxData["\"\<BothSides\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "1851eb8e-ddd4-4a80-b497-555fabfabb53"],
     " (default), ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "2898f477-39aa-4e70-b7f4-252d0f63c159"],
     ", ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "bda4b8b2-8619-4d16-90e4-96de68d23460"]
    }], "TableText",ExpressionUUID->"e0217606-301a-4f0a-8947-aa82dd8fc651"], 
    Cell[TextData[{
     "which ends may move: ",
     Cell[BoxData["\"\<Forward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "b67aac57-64e9-48ff-8b2c-a182179731ed"],
     " keeps ",
     StyleBox["a", "TI"],
     " and extends past ",
     StyleBox["b", "TI"],
     " only, ",
     Cell[BoxData["\"\<Backward\>\""], "InlineFormula",
      FontSize->0.9 Inherited,ExpressionUUID->
      "ce6b1ba2-696b-4c81-8ad3-9aabc739ad73"],
     " keeps ",
     StyleBox["b", "TI"],
     " and extends before ",
     StyleBox["a", "TI"],
     " only."
    }], "TableText",ExpressionUUID->"b167f025-79f5-439c-91a8-b1865f108e14"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "7de20bd3-be5f-429e-90dd-5a5779ceaf1b"], Cell[TextData[Cell[BoxData[
    "Properties"], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "ec0b501b-fd0c-42a1-8485-4dc74778989a"]], "TableText",ExpressionUUID->
     "ac78701a-9730-4450-ad6e-195577a5b5e3"], Cell[TextData[Cell[BoxData[
     RowBox[{"{", "}"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "45827d5f-1b4c-49ea-8a1a-b091dceda09e"]], "TableText",ExpressionUUID->
     "04735682-38ca-4953-84ca-809e49f7e885"], Cell[TextData[{
     "only the empty list; a rule on the extension is a local law and lives \
