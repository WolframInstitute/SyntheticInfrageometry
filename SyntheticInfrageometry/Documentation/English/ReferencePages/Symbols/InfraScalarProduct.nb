Notebook[{
Cell["InfraScalarProduct", "Title",ExpressionUUID->"895448e8-fbce-4bb2-946e-5eb98d8fe1d0"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"38b2dbdb-7c70-4e2b-adc2-e87e8421d379"],

Cell["\<\
InfraScalarProduct[graph, o, u, v] returns the base-point-relative scalar \
product of u and v with respect to o. Option: Method (\"Alexandrov\" \
(default) -- d(o,u) d(o,v) cos(theta_0) which collapses to (d(o,u)^2 + \
d(o,v)^2 - d(u,v)^2)/2; {\"Alexandrov\", \"Curvature\" -> k} -- same with \
spherical / hyperbolic law of cosines in M_k^2; \"Parallelogram\" -- \
polarization identity (||u+v||^2 - ||u-v||^2)/4 via \
FindInfraLinearCombination).\
\>", "Text",ExpressionUUID->"26bc9af3-1a69-48da-ad9a-97ac2e86b55e"],

Cell["Setup", "Section",ExpressionUUID->"ff485c69-c859-44ed-a348-3e7963f4293e"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"e0b9be8b-bb71-4b12-b89a-e00f7911d8c7"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"2dd2e6ff-ab0d-485d-9162-e6f5462a0d58"],

Cell["Related Guides", "Section",ExpressionUUID->"5296b886-a775-4e41-a9d7-77f048155896"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"6261f167-4c9e-455b-a5bd-1a4f0da7d4ae"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"3fa7d3d6-65a4-4225-9f1b-14182b37a22e"]
},
