Notebook[{
Cell["InfraScalarProduct", "Title",ExpressionUUID->"2ca83dbc-1eda-4ab2-b600-704bce13d5af"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c38059ab-d0a2-4ba5-8440-272287562911"],

Cell["\<\
InfraScalarProduct[graph, o, u, v] returns the base-point-relative scalar \
product of u and v with respect to o. Option: Method (\"Alexandrov\" \
(default) -- d(o,u) d(o,v) cos(theta_0) which collapses to (d(o,u)^2 + \
d(o,v)^2 - d(u,v)^2)/2; {\"Alexandrov\", \"Curvature\" -> k} -- same with \
spherical / hyperbolic law of cosines in M_k^2; \"Parallelogram\" -- \
polarization identity (||u+v||^2 - ||u-v||^2)/4 via \
FindInfraLinearCombination).\
\>", "Text",ExpressionUUID->"a652bbaf-3f6a-405c-8bd6-c4f2fd76bc9c"],

Cell["Setup", "Section",ExpressionUUID->"bc5639e9-c6ae-4575-8df0-ea42992202d5"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"0825f4c7-58a8-4f38-946f-1281ce084981"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"56f6f501-857d-4734-a513-ca4ff60d4314"],

Cell["Related Guides", "Section",ExpressionUUID->"cc74378f-7e2d-483f-923d-776ad2bd0193"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"99bca3b8-d543-4de5-a677-18d886896c08"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"f37e1dde-7caa-4a95-acdd-87a1e1447fe0"]
},
