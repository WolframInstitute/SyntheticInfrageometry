Notebook[{
Cell["InfraCurvature", "Title",ExpressionUUID->"dcacf392-2f50-4df8-a328-2dfa07319c3f"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"13c1b4bf-4033-4bcd-b3d4-67e9938a1ba9"],

Cell["\<\
InfraCurvature[graph, v] returns the local Alexandrov upper-curvature bound \
at v: L^2 times the supremum of per-triangle CAT bounds over all triangles \
whose three vertices sit inside B_L(v), with L = GraphDiameter[graph] by \
default. Option: \"Radius\" (Automatic | Integer L) selects the ball radius; \
reported curvature is rescaled by L^2 to match the (edge / L)^-2 unit \
convention. InfraCurvature[graph] returns an Association[v -> kappa_v] over \
all vertices.\
\>", "Text",ExpressionUUID->"5c04a5f1-3b1a-48a6-ab16-682edbcd48d0"],

Cell["Setup", "Section",ExpressionUUID->"32246c07-05fe-409e-94b5-c75bca94d9cf"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"4a0b8ca6-45e6-48ce-b8f4-ecc437d7a1ca"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"006bce90-460e-4df8-a6bd-8fd853fca283"],

Cell["Related Guides", "Section",ExpressionUUID->"7f58bba3-1934-4b28-bc5d-46f5d37edcc5"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"ce4a16f2-36a1-4268-8314-12e24adbf946"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"2cb03ac6-d193-40fc-85aa-2ced76005cd2"]
},
