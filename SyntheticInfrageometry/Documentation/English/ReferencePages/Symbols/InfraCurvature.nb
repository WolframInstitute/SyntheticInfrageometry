Notebook[{
Cell["InfraCurvature", "Title",ExpressionUUID->"bd55389a-426c-4345-b4cc-7bf429ece53b"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"da438cca-5396-41a9-8d6f-2ec0f6c5b0d2"],

Cell["\<\
InfraCurvature[graph, v] returns the local Alexandrov upper-curvature bound \
at v: L^2 times the supremum of per-triangle CAT bounds over all triangles \
whose three vertices sit inside B_L(v), with L = GraphDiameter[graph] by \
default. Option: \"Radius\" (Automatic | Integer L) selects the ball radius; \
reported curvature is rescaled by L^2 to match the (edge / L)^-2 unit \
convention. InfraCurvature[graph] returns an Association[v -> kappa_v] over \
all vertices.\
\>", "Text",ExpressionUUID->"817a3638-a8a3-4f65-9660-87a212290a4b"],

Cell["Setup", "Section",ExpressionUUID->"0eb76076-7b87-4ef3-8cb7-9f2f38b27a03"],

Cell["Load the paclet.", "CodeText",ExpressionUUID->"a80a6bf9-9bf8-4c69-9c8b-8226e08f0f00"],

Cell[BoxData[
 RowBox[{"Needs", "[", "\"\<WolframInstitute`SyntheticInfrageometry`\>\"", 
  "]"}]], "Code",
 InitializationCell->
  True,ExpressionUUID->"0ca12a3a-1dc1-4b7e-b30d-79502e28c394"],

Cell["Related Guides", "Section",ExpressionUUID->"e331cb6a-6cd5-47e4-b81b-a0a7e110a18f"],

Cell["EuclideanGeometryGuide", "Item",ExpressionUUID->"ec39ed85-018b-4c93-98eb-29425075ffdb"],

Cell["SyntheticInfrageometryGuide", "Item",ExpressionUUID->"6e858f10-9e52-405b-b100-c3a3655f99ea"]
},
