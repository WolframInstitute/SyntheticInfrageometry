Notebook[{
Cell["FindSegmentHull", "Title",ExpressionUUID->"631a3f61-16c4-497f-8363-c730fc622993"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"c7693a5c-2dfd-469d-8883-1b2833893d04"],

Cell["\<\
FindSegmentHull[graph, S] returns the smallest superset of S closed under \
MetricInterval (the segment operator), as a sorted vertex list. Option \
\"LineStructure\" (None (default), or an InfraLineStructure / list of lines) \
closes under the chosen-geodesic stretch on that fixed family instead of all \
geodesics.\
\>", "Text",ExpressionUUID->"71175140-ccdf-4cc7-86a1-1216f2cae35a"],

Cell["Setup", "Section",ExpressionUUID->"6d868cd6-430b-4d5f-ba8b-a2cea22d843f"],

