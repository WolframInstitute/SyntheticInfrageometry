     "4ed8674e-7933-46d7-8abb-a4dfd32241a6"], Cell[TextData[Cell[BoxData[
     RowBox[{"InfraEffectivePoint", "[", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"v", " ", "->", " ", "m"}], ",", " ", "\[Ellipsis]"}], "|>"}],
       "]"}]], "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3da145d8-1977-47ca-925f-6457cf91db8d"]], "TableText",ExpressionUUID->
     "81b15ca0-93f0-41d2-b85b-63d673c8fd54"]}
  }]], "2ColumnTableMod",ExpressionUUID->"ac4f1e52-b95f-4ed4-8dc5-\
e3e047fab2fd"],

Cell[TextData[{
 "The vertex label is carried verbatim, including a list label such as ",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{"i", ",", " ", "j"}], "}"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4f6c50bb-9d60-44ae-8533-045b99f7c335"],
 " on a grid or tessellation. This is the reason the atom exists: while one \
head served as both atom and container, ",
 Cell[BoxData[
  RowBox[{"InfraPoint", "[", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "1"}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5feddc74-e67c-47e9-98a1-19c0b02f81e6"],
 " was ambiguous on such a graph and silently produced a point supported on a \
vertex that was not in the graph."
}], "Notes",ExpressionUUID->"eed25ba2-3cb2-4698-adb8-e90ad921628a"],

