Cell[TextData[{
 "Graph-keyed invariants such as ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"\"\<BallVolumes\>\"", ",", " ", "g"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8da6077b-235e-471f-a544-bdeb7ed077aa"],
 " and ",
 Cell[BoxData[
  RowBox[{"[", 
   RowBox[{"\"\<Dimension\>\"", ",", " ", "g"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c3f61c4c-53e6-40c4-b4a6-371d4fe02c05"],
 " return the bare numbers for that vertex; the same accessors on an ",
 Cell[BoxData["InfraSet"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0687cc40-b206-4072-bbdd-890d3ee13953"],
 " return one row per vertex, which is the rectangular shape statistics \
compose over."
}], "Notes",ExpressionUUID->"9a9a6540-d6fc-44b6-bbde-5468f5ddf4c1"],

