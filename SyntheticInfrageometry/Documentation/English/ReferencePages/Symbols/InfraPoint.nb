     "a4506d38-c88d-40a8-8b87-f3bf30adfd99"]], "TableText",ExpressionUUID->
     "6ac03d0b-baac-4dfa-ace0-b7e703a8b463"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "f0866c12-8bb5-4f80-a4de-9dc3e54778f2"], Cell[
    "several candidate points", "TableText",ExpressionUUID->
     "9566d271-765f-4fee-b926-20be925798f1"], Cell[TextData[{
     Cell[BoxData[
      RowBox[{"{", 
       RowBox[{
        RowBox[{"InfraPoint", "[", "a", "]"}], ",", " ", 
