Cell["\<\
An atom answers invariants with bare numbers; a set of points answers with \
one row each.\
\>", "ExampleText",ExpressionUUID->"4dd977e6-808c-479e-93d5-e9dd23361fe5"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"InfraSubstrate", "[", 
      RowBox[{"\"\<SquareTilingGraph\>\"", ",", " ", "\"\<Medium\>\"", ",", 
