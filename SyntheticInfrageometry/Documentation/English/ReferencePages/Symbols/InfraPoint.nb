Cell["A point finder returns atoms \[LongDash] one, or a list.", "ExampleText",ExpressionUUID->"c66c62c1-ddf7-4a64-bdc0-fce6603c3fc2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
