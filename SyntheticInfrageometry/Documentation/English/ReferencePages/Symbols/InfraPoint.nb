Cell["\<\
Definition: an infra-point is one vertex of the substrate, wrapped so that it \
carries geometry.\
\>", "Notes",ExpressionUUID->"a592774a-42ef-47d3-9f74-9cfa83ba3720"],

Cell[TextData[{
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "8c08880c-9873-4c72-8950-40f9cb4cb853"],
 " is the ",
 StyleBox["atom",
  FontWeight->"Bold"],
 " of the point ontology. A construction on a graph rarely has one answer, \
but the multiplicity does not live in this head: a family of candidate points \
is a vertex ",
 Cell[BoxData["List"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c047fcae-b331-4d70-81f5-22119dd6c03b"],
 ", and a measure on vertices is a density ",
 Cell[BoxData[
  RowBox[{"<|", 
   RowBox[{"v", " ", "->", " ", "m"}], "|>"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "94b6c4b1-2ee0-4f21-8686-43f743b34e74"],
 "."
}], "Notes",ExpressionUUID->"6e28f0ca-4046-4c87-9ca4-e01709a533c0"],

Cell[BoxData[GridBox[{
   {Cell["      ", "ModInfo",ExpressionUUID->
     "043df8f0-777d-4988-8c74-f2052ac8db5e"], Cell["you have", "TableText",
     FontWeight->Bold,ExpressionUUID->"effadcb5-a532-49ec-87ad-1f6d4bd5217f"],
     Cell["use", "TableText",
     FontWeight->Bold,ExpressionUUID->"b0a92b43-f942-4cf3-b71f-ada8c0ae5e7d"]},
