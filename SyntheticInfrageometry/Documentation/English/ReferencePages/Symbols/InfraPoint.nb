      FontSize->0.9 Inherited,ExpressionUUID->
      "502212ed-1053-4b25-9aeb-f66e28a03446"],
     " \[LongDash] a plain list"
    }], "TableText",ExpressionUUID->"b7d15d57-0b04-4ef0-8d00-2958c201c31b"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "e903216b-03e8-45ce-8249-7db31f86ca2e"], Cell[
    "a region of vertices", "TableText",ExpressionUUID->
     "02ed738f-a0d8-46a6-805a-df4aa294a2af"], Cell[TextData[Cell[BoxData[
     RowBox[{"InfraSet", "[", 
      RowBox[{"{", 
       RowBox[{"a", ",", " ", "b", ",", " ", "\[Ellipsis]"}], "}"}], "]"}]], 
     "InlineFormula",
     FontSize->0.9 Inherited,ExpressionUUID->
     "3af5b173-921a-4ee1-8f88-909b9333ccea"]], "TableText",ExpressionUUID->
     "2a1f5c21-f505-474c-a605-5a8d4aa5573c"]},
   {Cell["      ", "ModInfo",ExpressionUUID->
     "b8d79ac3-6ffb-41d9-8a61-af8f02f62fa8"], Cell[
