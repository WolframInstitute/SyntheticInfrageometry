Cell[CellGroupData[{
Cell["InfraPoint", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5bc99b31-a7b7-473f-877c-cf92de404441"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"{", 
    RowBox[{
     StyleBox["v1", "TI"], ",", " ", "\[Ellipsis]", ",", " ", 
     StyleBox["vk", "TI"]}], "}"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab9cf41e-aacd-401f-98f7-5a06b5cf5162"],
 "\[LineSeparator]",
 "is a point given by a set of candidate vertices.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"c107d93e-3c03-4d61-be17-2ac630a471ca"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{
      StyleBox["v", "TI"], " ", "->", " ", 
      StyleBox["m", "TI"]}], ",", " ", "\[Ellipsis]"}], "|>"}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a2c74ec7-3ff4-4ace-a8e1-445f649b29e8"],
 "\[LineSeparator]",
 "is a measured point: each candidate carries a weight.",
 "\n",
 Cell["   ", "ModInfo",ExpressionUUID->"927d9e64-cd9c-4e55-b2ac-7efa02ca70ac"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["InfraPoint"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraPoint", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      StyleBox["v1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      StyleBox["m1", "TI"], ",", " ", "\[Ellipsis]"}], "}"}]}], "]"}]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9aa80947-79d8-40a3-a663-dc05763f2012"],
 "\[LineSeparator]",
 "is sugar for the association form."
}], "Usage",ExpressionUUID->"76101967-c2af-4ab5-9710-1d8236978264"],

Cell["\<\
Definition: an infra-point is a set of vertices, optionally with a weight on \
each.\
\>", "Notes",ExpressionUUID->"3280177d-c823-410b-a8fb-8a69dbfdc780"],

Cell[TextData[{
 "A construction on a graph rarely has one answer. It has a family of \
admissible answers. ",
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dec4878a-2ba5-449c-ac41-85bd8c2f3f13"],
 " holds that family as one object."
}], "Notes",ExpressionUUID->"7f609e74-9d57-4479-8337-38a5c1f78d7d"],

Cell[TextData[{
 Cell[BoxData["InfraPoint"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "e07a5355-a2a1-4af1-80bc-14c2b2c6a391"],
 " is the only wrapper that carries a measure. Its realisations are vertices, \
so a weight per realisation is a weight per vertex. Every other ",
 Cell[BoxData[
  RowBox[{"Infra", "*"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "acd1107a-e3d8-4e3a-a661-37f50b090f58"],
 " head is a plain set of realisations. For those, a vertex measure is a \
lossy projection, computed on demand by ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["InfraMeasure"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/InfraMeasure", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "86ef564e-f91b-4849-961e-d6fc10f1d6bc"],
 "."
}], "Notes",ExpressionUUID->"d199f175-1a7b-4427-885d-f6e6d937f680"],

Cell["\<\
Weights count. They are not probabilities put in by hand. A weight of 6 means \
six geodesics chose that vertex.\
\>", "Notes",ExpressionUUID->"0481a245-f27a-4f5f-a6af-5f212deb9872"],

Cell[TextData[{
 "Weights are created at a projection. ",
 Cell[BoxData[
  RowBox[{"seg", "[", 
   RowBox[{"[", "i", "]"}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5b139f08-4db0-493d-9864-9638fced6c51"],
 " is one. ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["FindInfraMidpoint"]], 
    "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraMidpoint", 
    "WolframInstitute/SyntheticInfrageometry Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFormula"]], "InlineFormula",ExpressionUUID->
  "36732548-d255-41a0-b9a3-2e0127f18a2b"],
 " is another. Weights on an input point do not flow through a construction: \
a construction reads the support and ignores the weights."
}], "Notes",ExpressionUUID->"03ec3605-0eac-4ade-953e-4966c75c55cc"],

Cell["Accessors:", "Notes",ExpressionUUID->"4cf8b3e0-0bda-4699-b426-9d3703aec0ca"],

