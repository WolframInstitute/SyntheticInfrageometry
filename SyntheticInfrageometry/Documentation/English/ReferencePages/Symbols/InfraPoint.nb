Cell["\<\
Two vertices at odd distance have no exact midpoint. The result is a measured \
point with six candidates.\
\>", "ExampleText",ExpressionUUID->"1963b652-8c33-4075-acde-624754db5e55"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"FindInfraMidpoint", "[", 
    RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "]"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"0d3838f3-2dd3-4823-afa5-027450415573"],

Cell[BoxData[
 RowBox[{"InfraPoint", "[", 
  RowBox[{"\[LeftAssociation]", 
   RowBox[{
    RowBox[{"3", "\[Rule]", "6"}], ",", 
    RowBox[{"7", "\[Rule]", "1"}], ",", 
    RowBox[{"8", "\[Rule]", "3"}], ",", 
    RowBox[{"9", "\[Rule]", "3"}], ",", 
    RowBox[{"10", "\[Rule]", "6"}], ",", 
    RowBox[{"21", "\[Rule]", "1"}]}], "\[RightAssociation]"}], 
  "]"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"1cf144af-1174-4031-81b5-b90df1290154"]
}, Open  ]],

Cell["\<\
The accessors read that object apart. The measure is the weights divided by \
the mass, so it sums to 1.\
\>", "ExampleText",ExpressionUUID->"4ee5b2a3-b6f9-4152-88d7-b3b898303aa1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"With", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"g", " ", "=", " ", 
     RowBox[{"ExampleGraphData", "[", 
      RowBox[{"\"\<Square\>\"", ",", " ", "\"\<Medium\>\""}], "]"}]}], "}"}], 
   ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"a", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"GraphCenter", "[", "g", "]"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"b", " ", "=", " ", 
     RowBox[{"First", " ", "@", " ", 
      RowBox[{"Sort", " ", "@", " ", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"VertexList", "[", "g", "]"}], ",", " ", 
         RowBox[{
          RowBox[{
           RowBox[{"GraphDistance", "[", 
            RowBox[{"g", ",", " ", "a", ",", " ", "#"}], "]"}], " ", "==", 
           " ", "5"}], " ", "&"}]}], "]"}]}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"{", 
    RowBox[{"m", " ", "=", " ", 
     RowBox[{"FindInfraMidpoint", "[", 
      RowBox[{"g", ",", " ", "a", ",", " ", "b"}], "]"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<support\>\"", " ", "->", " ", 
      RowBox[{"m", "[", "\"\<Support\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<weights\>\"", " ", "->", " ", 
      RowBox[{"m", "[", "\"\<Weights\>\"", "]"}]}], ",", " ", 
     RowBox[{"\"\<mass\>\"", " ", "->", " ", 
      RowBox[{"m", "[", "\"\<Mass\>\"", "]"}]}], ",", "\n", "    ", 
     RowBox[{"\"\<measure total\>\"", " ", "->", " ", 
      RowBox[{"Total", " ", "@", " ", 
       RowBox[{"Values", " ", "@", " ", 
        RowBox[{"m", "[", "\"\<Measure\>\"", "]"}]}]}]}]}], "|>"}]}], 
  "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"45f35182-d077-47d6-8be8-ebef27526818"],

Cell[BoxData[
 RowBox[{
