Cell["InfraEllipticShell", "Title",ExpressionUUID->"7bad3267-b788-4e1f-b043-d450c4329647"],

Cell["[LLM Generated]", "Subtitle",ExpressionUUID->"01115c7a-07e6-491d-b03f-33e3e1ac4a0c"],

Cell["\<\
InfraEllipticShell[{set}] is the unary form (one elliptic-shell vertex set); \
InfraEllipticShell[{set1, ..., setk}] is the multi-realisation form. Find* \
returns a List of unary wrappers; wrap with InfraEllipticShell @ ... to \
collapse to multi via auto-flatten.\
\>", "Text",ExpressionUUID->"753baf89-77d0-40e0-837e-91196aa3cec8"],

