Cell["\<\
The 6-cycle has six lines, one per antipodal pair of ends; a path has one.\
\>", "ExampleText",ExpressionUUID->"864649ae-5a68-4621-980d-7c54bed53e78"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"LineCount", "[", 
    RowBox[{"CycleGraph", "[", "6", "]"}], "]"}], ",", " ", 
   RowBox[{"LineCount", "[", 
    RowBox[{"PathGraph", "[", 
     RowBox[{"Range", "[", "5", "]"}], "]"}], "]"}]}], "}"}]], "Input",
 CellLabel->"In[1]:= ",ExpressionUUID->"e34d137e-ebbb-4656-b1a1-cd3e9329b2d3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"6", ",", "1"}], "}"}]], "Output",
 CellLabel->"Out[1]= ",ExpressionUUID->"e9cbdb52-7c84-4b7a-a94c-f10de798f139"]
}, Open  ]],

Cell["The 3 \[Times] 3 grid has twelve.", "ExampleText",ExpressionUUID->"9f77fd1f-d152-4829-a34f-63136b9950ee"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LineCount", "[", 
  RowBox[{"GridGraph", "[", 
   RowBox[{"{", 
    RowBox[{"3", ",", " ", "3"}], "}"}], "]"}], "]"}]], "Input",
 CellLabel->"In[2]:= ",ExpressionUUID->"561ce8e4-39ea-49db-8cb1-f03f39d97912"],

Cell[BoxData["12"], "Output",
 CellLabel->"Out[2]= ",ExpressionUUID->"31218240-6ead-47f5-9915-cfe02fc55a5b"]
}, Open  ]]
}, Open  ]],

