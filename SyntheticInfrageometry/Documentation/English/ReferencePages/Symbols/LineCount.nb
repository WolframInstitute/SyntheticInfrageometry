Notebook[{

Cell[CellGroupData[{
Cell["LineCount", "ObjectName",
 CellID->1224892054,ExpressionUUID->"8393d601-4014-44ba-afc9-60862df940ec"],

Cell[TextData[{
 Cell["   ", "ModInfo",ExpressionUUID->"5c61d291-bb20-43ca-9a3c-28b98a41085c"],
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["LineCount"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/LineCount", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   StyleBox["g", "TI"], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f0ab6267-8fa7-4df2-9397-233f94bdf12d"],
 "\[LineSeparator]",
 "gives the number of distinct lines in ",
 StyleBox["g", "TI"],
 " \[LongDash] inextensible geodesics, counted up to reversal.",
 "\n"
}], "Usage",ExpressionUUID->"6351d294-ce43-4f71-ad3c-1a4551cc6ee9"],

Cell[TextData[{
 "A line and its reverse are one line. The count enumerates ",
 Cell[BoxData[
  RowBox[{
   TemplateBox[{
     Cell[
      TextData["FindInfraLine"]], 
     "paclet:WolframInstitute/SyntheticInfrageometry/ref/FindInfraLine", 
     "WolframInstitute/SyntheticInfrageometry Package Symbol"},
    "PackageLink",
    BaseStyle->"InlineFormula"], "[", 
   RowBox[{
    StyleBox["g", "TI"], ",", " ", 
    StyleBox["u", "TI"], ",", " ", 
    StyleBox["v", "TI"], ",", " ", 
    ButtonBox["All",
     BaseStyle->"Link"]}], "]"}]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "baee6664-33a9-49c8-befb-2c32b0655e80"],
 " over every pair of vertices and deduplicates, so it is exponential on \
lattices; it is meant for small graphs, where it is the coarsest invariant of \
the incidence structure."
}], "Notes",ExpressionUUID->"69df9969-21ff-4e7e-983c-f49bd1c43907"]
}, Open  ]],

